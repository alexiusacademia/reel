// cos(m * pi / 64) as the integers of the HEVC transform matrix, for m
// 0..32 (8.6.4.2): every entry of the 32x32 matrix is one of these with a
// sign, and smaller transforms use every 2nd, 4th or 8th row.
let hevcCosTable: [Int] = [
    64, 90, 90, 90, 89, 88, 87, 85, 83, 82, 80, 78, 75, 73, 70, 67,
    64, 61, 57, 54, 50, 46, 43, 38, 36, 31, 25, 22, 18, 13, 9, 4, 0,
]

// The 32x32 transform matrix transMatrix[k][n] (k the frequency row),
// flattened k * 32 + n.
fn hevcMakeTransMatrix() -> [Int] {
    var m: [Int] = []
    let t = hevcCosTable
    for k in 0..32 {
        for n in 0..32 {
            var a = ((2 * n + 1) * k) % 128
            if a > 64 {
                a = 128 - a
            }
            var sign = 1
            if a > 32 {
                a = 64 - a
                sign = -1
            }
            m.append(sign * t[a])
        }
    }
    m
}

// Up-right diagonal scan of a blkSize x blkSize block (6.5.3): positions
// as x + y * blkSize in scan order.
fn hevcDiagScan(_ blkSize: Int) -> [Int] {
    var out: [Int] = []
    var x = 0
    var y = 0
    while out.count < blkSize * blkSize {
        while y >= 0 {
            if x < blkSize && y < blkSize {
                out.append(x + y * blkSize)
            }
            y -= 1
            x += 1
        }
        y = x
        x = 0
    }
    out
}

// Horizontal (6.5.4) and vertical (6.5.5) scans.
fn hevcHorScan(_ blkSize: Int) -> [Int] {
    var out: [Int] = []
    for y in 0..blkSize {
        for x in 0..blkSize {
            out.append(x + y * blkSize)
        }
    }
    out
}

fn hevcVerScan(_ blkSize: Int) -> [Int] {
    var out: [Int] = []
    for x in 0..blkSize {
        for y in 0..blkSize {
            out.append(x + y * blkSize)
        }
    }
    out
}
