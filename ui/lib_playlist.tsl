// The playlist panel beside the picture (`PlaylistPanel`): a header with
// the count and total length and buttons for Shuffle and Repeat (showing
// their state), Add, Save and Clear; then the rows, each with a grip to
// drag it to another place, the title and length, a mark on the one
// playing, and a remove button. Click selects a row, a double click
// plays it; Return plays the selected row, Delete/Backspace removes it,
// the arrow keys move the selection. Rows are built lazily, so long
// playlists stay quick. Dark, like the player.
//
// The panel changes `items` and `current` itself (reorder, remove, clear),
// keeping `current` on the item that plays, and then calls `onChanged`.
//
// Author: Alexius Academia
// Date: 2026-10-26

public view PlaylistPanel(items: bind [String], current: bind Int, titles: [String: String] = [:], durations: [String: Float] = [:], shuffle: Bool = false, loopMode: Int = 0, onPlay: fn(Int), onAdd: fn(), onSave: fn(), onShuffle: fn(), onLoop: fn(), onChanged: fn() = {}) {
    state selected = -1
    state lastTap = -1
    state lastTapTime = -100.0

    VStack(spacing: 0, alignment: .leading) {
        HStack(spacing: 2) {
            VStack(spacing: 1, alignment: .leading) {
                Text("Playlist").font(size: 13, weight: .bold).color(.white)
                Text(plSummary()).font(size: 10).color(libDarkDim).lineLimit(1)
            }
            Spacer()
            LibDarkButton(svg: svgShuffle(), tip: if shuffle { "Shuffle is on" } else { "Shuffle is off" }, on: shuffle) { onShuffle() }
            LibDarkButton(svg: if loopMode == 2 { svgRepeatOne() } else { svgRepeat() }, tip: plLoopTip(), on: loopMode > 0) { onLoop() }
            LibDarkButton(svg: svgLibPlus(), tip: "Add files…") { onAdd() }
            LibDarkButton(svg: svgLibSave(), tip: "Save the playlist…") { onSave() }
                .disabled(items.isEmpty)
            LibDarkButton(svg: svgLibTrash(), tip: "Clear the playlist") { plClear() }
                .disabled(items.isEmpty)
        }
        .padding(horizontal: 8, vertical: 6)
        if items.isEmpty {
            VStack(spacing: 6) {
                Spacer()
                Svg(svgPlaylist()).color(libDarkDim).frame(width: 30, height: 30)
                Text("The playlist is empty.\nDrop files on the window, or click +.")
                    .font(size: 12)
                    .color(libDarkDim)
                    .textAlignment(.center)
                Spacer()
            }
            .frame(maxWidth: .infinity, maxHeight: .infinity)
        } else {
            Scroll {
                LazyVStack(count: items.count, rowHeight: 30) { i in
                    LibPlaylistRow(index: i, title: plTitle(i), duration: durations[items[i]] ?? -1.0, playing: i == current, selected: i == selected, move: { from, to in plMove(from, to) }, onTap: { plTapped(i) }, onRemove: { plRemove(i) })
                }
            }
        }
    }
    .frame(maxHeight: .infinity)
    .background(libDarkPanel)
    .onKeyEvent { e in plKey(e) }

    fn plTitle(_ i: Int) -> String {
        let p = items[i]
        if let t = titles[p] {
            if !t.isEmpty {
                return t
            }
        }
        libStem(p.fileName)
    }

    fn plSummary() -> String {
        let n = items.count
        var ds: [Float] = []
        for p in items {
            ds.append(durations[p] ?? -1.0)
        }
        let (total, unknown) = libTotalDuration(ds)
        let count = if n == 1 { "1 item" } else { "{n} items" }
        if total <= 0.0 {
            return count
        }
        "{count} · {libDurationText(total)}{if unknown > 0 { "+" } else { "" }}"
    }

    fn plLoopTip() -> String {
        match loopMode {
            1 -> "Repeat: all (click for one)"
            2 -> "Repeat: one (click for off)"
            _ -> "Repeat: off (click for all)"
        }
    }

    fn plTapped(_ i: Int) {
        let t = now()
        if lastTap == i && t - lastTapTime < 0.45 {
            lastTap = -1
            onPlay(i)
            return
        }
        lastTap = i
        lastTapTime = t
        selected = i
    }

    fn plMove(_ from: Int, _ to: Int) {
        let n = items.count
        if from < 0 || from >= n || to == from || to == from + 1 {
            return
        }
        let cur = libMovedIndex(current, from: from, to: to, count: n)
        let sel = libMovedIndex(selected, from: from, to: to, count: n)
        items = libMoved(items, from: from, to: to)
        current = cur
        selected = sel
        lastTap = -1
        onChanged()
    }

    fn plRemove(_ i: Int) {
        if i < 0 || i >= items.count {
            return
        }
        items.remove(at: i)
        current = libIndexAfterRemove(current, removed: i)
        selected = if selected == i { min(i, items.count - 1) } else { libIndexAfterRemove(selected, removed: i) }
        lastTap = -1
        onChanged()
    }

    fn plClear() {
        items = []
        current = -1
        selected = -1
        onChanged()
    }

    fn plKey(_ e: KeyEvent) {
        match e.key {
            "up", "down", "home", "end", "pageup", "pagedown" -> {
                let to = libMoveSelection(selected, key: e.key, count: items.count)
                if to >= 0 {
                    selected = to
                    scrollTo(to)
                }
            }
            "enter" -> {
                if selected >= 0 && selected < items.count {
                    onPlay(selected)
                }
            }
            "backspace", "delete" -> plRemove(selected)
            _ -> {}
        }
    }
}

// One row of the playlist. Dropping a row on the upper half of another
// puts it before that one, on the lower half after it.
view LibPlaylistRow(index: Int, title: String, duration: Float, playing: Bool, selected: Bool, move: fn(Int, Int), onTap: fn(), onRemove: fn()) {
    state targeted = false

    HStack(spacing: 6) {
        Svg(svgLibGrip()).color(.rgb(90, 90, 90)).frame(width: 10, height: 14).tooltip("Drag to reorder")
        Svg(svgPlay())
            .color(libAccent)
            .frame(width: 9, height: 9)
            .opacity(if playing { 1.0 } else { 0.0 })
        Text(title)
            .font(size: 12, weight: if playing { .bold } else { .regular })
            .color(if playing { libAccent } else { libDarkText })
            .lineLimit(1)
        Spacer()
        Text(libDurationText(duration)).font(size: 11).color(libDarkDim)
        Svg(svgLibX())
            .color(libDarkDim)
            .frame(width: 17, height: 17)
            .padding(3)
            .hoverBackground(.rgb(70, 70, 70), radius: 4)
            .onTap { onRemove() }
            .tooltip("Remove from the playlist")
            .accessibilityLabel("Remove {title}")
    }
    .padding(horizontal: 6, vertical: 4)
    .background(if targeted { libAccentSoft } else if selected { .rgb(52, 52, 52) } else { .clear }, radius: 4)
    .border(if targeted { libAccent } else { .clear }, width: 1, radius: 4)
    .hoverBackground(libDarkHover, radius: 4)
    .padding(horizontal: 4)
    .onTap { onTap() }
    .draggable("{index}")
    .dropTarget(isTargeted: targeted) { payload, x, y in
        let from = parseInt(payload).valueOr(-1)
        move(from, if y > 11.0 { index + 1 } else { index })
    }
    .accessibilityLabel(if playing { "{title}, playing" } else { title })
}
