// The sidebar icon of a group.
public fn libGroupSvg(_ group: String) -> String {
    match group {
        "movies" -> svgFilm()
        "tv" -> svgLibTv()
        "music" -> svgMusic()
        "other" -> svgLibLayers()
        "history" -> svgLibHistory()
        "playlists" -> svgLibListMusic()
        _ -> svgLibLibrary()
    }
}

// The placeholder icon for a file without a thumbnail.
public fn libKindSvg(kind: String, group: String) -> String {
    if group == "tv" {
        return svgLibTv()
    }
    if kind == "audio" || group == "music" {
        return svgMusic()
    }
    svgFilm()
}

// Reel's accent and the dark panels' colours (as in main.tsl).
public let libAccent = Color.rgb(242, 140, 26)
public let libAccentSoft = Color.rgba(242, 140, 26, 0.18)
public let libDarkBar = Color.rgb(31, 31, 31)
public let libDarkPanel = Color.rgb(23, 23, 23)
public let libDarkText = Color.rgb(217, 217, 217)
public let libDarkDim = Color.rgb(140, 140, 140)
public let libDarkHover = Color.rgb(45, 45, 45)
public let libDarkCard = Color.rgb(38, 38, 38)
public let libTrack = Color.rgb(89, 89, 89)

// A thumbnail drawn to fit `width`×`height` (letterboxed on `back`), or
// the placeholder icon when there's none. `key` must change when the
// picture shown changes (the canvas keeps its drawing otherwise): pass
// something that names the item, like its id.
public view LibThumbView(thumb: LibThumb, placeholder: String, width: Float, height: Float, key: Int, back: Color = .rgb(38, 38, 38), iconColor: Color = .rgb(110, 110, 110), radius: Float = 6) {
    Canvas(redraw: key * 4 + (if thumb.isEmpty { 0 } else { 1 })) { g in
        g.save()
        g.beginPath()
        g.rect(x: 0, y: 0, width: g.width, height: g.height, radius: radius)
        g.clipPath()
        g.fillRect(x: 0, y: 0, width: g.width, height: g.height, color: back)
        if thumb.isEmpty {
            let side = min(g.width, g.height) * 0.42
            g.svg(text: placeholder, x: (g.width - side) / 2.0, y: (g.height - side) / 2.0, width: side, height: side, color: iconColor)
        } else {
            let tw = Float(thumb.width)
            let th = Float(thumb.height)
            // Fill the box (cropping the longer side a little), as posters do.
            let k = max(g.width / tw, g.height / th)
            let w = tw * k
            let h = th * k
            g.image(pixels: thumb.pixels, pixelWidth: thumb.width, pixelHeight: thumb.height, x: (g.width - w) / 2.0, y: (g.height - h) / 2.0, width: w, height: h)
        }
        g.restore()
    }
    .frame(width: width, height: height)
}

// A thin progress bar (0…1) in the accent colour, as wide as it's given
// (give it a .frame(width:)).
public view LibProgressBar(fraction: Float, height: Float = 3, track: Color = .rgb(89, 89, 89)) {
    Canvas(redraw: Int(fraction * 1000.0)) { g in
        g.fillRect(x: 0, y: 0, width: g.width, height: g.height, color: track, radius: g.height / 2.0)
        g.fillRect(x: 0, y: 0, width: g.width * max(0.0, min(fraction, 1.0)), height: g.height, color: Color.rgb(242, 140, 26), radius: g.height / 2.0)
    }
    .frame(height: height)
    .accessibilityLabel("{Int(fraction * 100.0 + 0.5)}% played")
}

// An SVG icon button for the dark panels (a smaller SvgButton).
public view LibDarkButton(svg: String, tip: String, size: Float = 15, on: Bool = false, action: fn()) {
    Svg(svg)
        .color(if on { Color.rgb(242, 140, 26) } else { Color.rgb(217, 217, 217) })
        .frame(width: size + 10.0, height: size + 10.0)
        .padding(5)
        .hoverBackground(.rgb(64, 64, 64), radius: 5)
        .onTap { action() }
        .tooltip(tip)
        .accessibilityLabel(tip)
}

// The same for the system-coloured Library window.
public view LibButton(svg: String, tip: String, size: Float = 16, on: Bool = false, action: fn()) {
    Svg(svg)
        .color(if on { Color.rgb(242, 140, 26) } else { Color.secondary })
        .frame(width: size + 10.0, height: size + 10.0)
        .padding(5)
        .hoverBackground(.lightGray, radius: 5)
        .onTap { action() }
        .tooltip(tip)
        .accessibilityLabel(tip)
}
