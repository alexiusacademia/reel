// Icons of the library views (sidebar groups, layout and sort buttons,
// list actions), as SVG from the Lucide set (ISC license) in
// currentColor, like ui/icons.tsl, plus the shared colours and small
// building blocks the library views use: a drawn thumbnail with a
// placeholder, a thin progress bar, and the dark panel's icon button.
//
// Author: Alexius Academia
// Date: 2026-10-26

public fn svgLibTv() -> String { lucide("<rect width='20' height='15' x='2' y='7' rx='2' ry='2'/><polyline points='17 2 12 7 7 2'/>") }
public fn svgLibLayers() -> String { lucide("<path d='M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z'/><path d='m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65'/><path d='m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65'/>") }
