// Character tables for the legacy text encodings decodeAs reads (see
// encodings.tsl). Generated by build/scratch/subs/gen/gen_tables.py, do not edit.
//
// Sources: the WHATWG Encoding Standard's index files
// (https://encoding.spec.whatwg.org/, index-*.txt, CC BY 4.0) for the
// Windows code pages, KOI8-R/U, Shift_JIS/EUC-JP (jis0208, jis0212),
// GBK/GB18030 (gb18030 and gb18030 ranges), Big5 and EUC-KR; and the Unicode
// Consortium's mapping files (https://www.unicode.org/Public/MAPPINGS/ISO8859/,
// Unicode terms of use) for ISO 8859-1…16. Mapping data only, no code.
//
// Each table is base64 text (long list literals compile slowly): single-byte
// tables are 128 code points (bytes 0x80…0xFF) as uint16 LE, 0 = unmapped;
// the CJK indexes are code points by WHATWG pointer, uint16 LE (Big5: 3 bytes
// LE, it reaches beyond the BMP), 0 = no character.
//
// Author: Alexius Academia
// Date: 2026-10-26

// The single-byte encodings, in the order of encSingleTables.
let encSingleNames = ["windows-1250", "windows-1251", "windows-1252", "windows-1253", "windows-1254", "windows-1255", "windows-1256", "windows-1257", "windows-1258", "windows-874", "koi8-r", "koi8-u", "iso-8859-1", "iso-8859-2", "iso-8859-3", "iso-8859-4", "iso-8859-5", "iso-8859-6", "iso-8859-7", "iso-8859-8", "iso-8859-9", "iso-8859-10", "iso-8859-11", "iso-8859-13", "iso-8859-14", "iso-8859-15", "iso-8859-16"]

// All single-byte tables one after another, 256 bytes each.
let encSingleTables = ""

// index jis0208 (Shift_JIS, EUC-JP), 11104 pointers.
let encJis0208Text = ""

// index jis0212 (EUC-JP 0x8F sequences), 7211 pointers.
let encJis0212Text = ""

// index gb18030 (GBK and GB18030 two-byte sequences), 23940 pointers.
let encGb18030Text = ""

// index gb18030 ranges: 207 (pointer, code point) pairs as uint32 LE.
let encGbRangesText = ""

// index Big5, 19782 pointers, 3 bytes each.
let encBig5Text = ""

// index EUC-KR, 23750 pointers.
let encEucKrText = ""
