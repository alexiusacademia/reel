// WebVTT (.vtt) files, after W3C "WebVTT: The Web Video Text Tracks
// Format": the "WEBVTT" header, cue blocks (optional identifier, timing
// line with cue settings, text), and NOTE / STYLE / REGION blocks, which
// are skipped. Cue settings (§4.4): line, position, align, size; vertical
// and region are ignored. Cue text tags (§4.2.2): <b> <i> <u> <c.class>
// (the default colour classes), <v> <lang> <ruby>/<rt>, timestamps.
//
// Also MP4 'wvtt' samples (ISO/IEC 14496-30 §7): boxes 'vttc' holding
// 'payl' (the text) and 'sttg' (the settings), 'vtte' for "no cue".
//
// Author: Alexius Academia
// Date: 2026-10-25

// Applies WebVTT cue settings ("line:10% align:start size:50%") to a cue.
fn vttSettings(_ cue: Cue, _ settings: String) -> Cue {
    var c = cue
    var col = 1
    var row = 0
    var lineSet = false
    for w in settings.words() {
        let colon = w.find(":") ?? -1
        if colon <= 0 {
            continue
        }
        let key = w.substring(from: 0, to: colon)
        let value = w.substring(from: colon + 1, to: w.count)
        let parts = value.split(",")
        let v = parts[0]
        if key == "align" {
            if v == "start" || v == "left" {
                col = 0
            } else if v == "end" || v == "right" {
                col = 2
            } else {
                col = 1
            }
        } else if key == "line" {
            if v.hasSuffix("%") {
                if let p = Float(v.substring(from: 0, to: v.count - 1)) {
                    c.y = (p / 100.0).clamped(min: 0.0, max: 1.0)
                    // line-align: start (the default) puts the cue's top
                    // at the line, center its middle, end its bottom.
                    let la = if parts.count > 1 { parts[1] } else { "start" }
                    row = if la == "end" { 0 } else if la == "center" || la == "middle" { 1 } else { 2 }
                    lineSet = true
                }
            } else if let n = Int(v) {
                // A line number: 0 is the top line, −1 the bottom one.
                if n >= 0 {
                    row = 2
                    c.marginV = c.marginV + Float(n) * c.fontSize
                } else {
                    row = 0
                    c.marginV = c.marginV + Float(-1 - n) * c.fontSize
                }
                lineSet = true
            }
        } else if key == "position" {
            if v.hasSuffix("%") {
                if let p = Float(v.substring(from: 0, to: v.count - 1)) {
                    c.x = (p / 100.0).clamped(min: 0.0, max: 1.0)
                }
            }
            if parts.count > 1 {
                let pa = parts[1]
                if pa == "line-left" || pa == "start" {
                    col = 0
                } else if pa == "line-right" || pa == "end" {
                    col = 2
                } else {
                    col = 1
                }
            }
        } else if key == "size" {
            if v.hasSuffix("%") {
                if let p = Float(v.substring(from: 0, to: v.count - 1)) {
                    c.width = (p / 100.0).clamped(min: 0.0, max: 1.0)
                }
            }
        }
    }
    if !lineSet {
        row = 0
    }
    // Numpad: row 0 bottom (1–3), 1 middle (4–6), 2 top (7–9).
    c.align = row * 3 + col + 1
    c
}

// One WebVTT cue's text and settings as a cue.
fn vttCue(_ text: String, settings: String, start: Float, end: Float) -> Cue {
    var b = subsPlainBuilder(start: start, end: end)
    b.cue = vttSettings(b.cue, settings)
    b = subsHtmlText(b, text, vtt: true)
    b.finish()
}

// "00:01.500 --> 00:02.000 align:start" → (start, end, settings).
fn vttTiming(_ line: String) -> (Float, Float, String)? {
    let arrow = line.find("-->") ?? -1
    if arrow < 0 {
        return nil
    }
    let s = subsClock(line.substring(from: 0, to: arrow))
    let rest = line.substring(from: arrow + 3, to: line.count).trim()
    let words = rest.words()
    if words.isEmpty || s < 0.0 {
        return nil
    }
    let e = subsClock(words[0])
    if e < 0.0 {
        return nil
    }
    let settings = rest.substring(from: words[0].count, to: rest.count).trim()
    (s, e, settings)
}

fn parseVtt(_ text: String) -> Result<SubTrack> {
    var track = SubTrack(format: "webvtt")
    let lines = subsSplitLines(text)
    if lines.isEmpty || !lines[0].trim().hasPrefix("WEBVTT") {
        return .failure(error: Error("not a WebVTT file: it doesn't start with WEBVTT"))
    }
    let n = lines.count
    var i = 1
    // The header runs to the first blank line.
    while i < n && !lines[i].trim().isEmpty {
        if lines[i].contains("-->") {
            break
        }
        i += 1
    }
    var id = 1
    while i < n {
        while i < n && lines[i].trim().isEmpty {
            i += 1
        }
        if i >= n {
            break
        }
        // One block, to the next blank line.
        var block: [String] = []
        while i < n && !lines[i].trim().isEmpty {
            block.append(lines[i])
            i += 1
        }
        let first = block[0].trim()
        if first.hasPrefix("NOTE") || first == "STYLE" || first == "REGION" || first.hasPrefix("STYLE ") || first.hasPrefix("REGION ") {
            continue
        }
        var at = 0
        if !block[0].contains("-->") {
            at = 1
        }
        if at >= block.count {
            continue
        }
        if let (s, e, settings) = vttTiming(block[at]) {
            let body = block.dropFirst(at + 1).joined(separator: "\n")
            var cue = vttCue(body, settings: settings, start: s, end: e)
            cue.id = id
            id += 1
            if e > s && !cue.spans.isEmpty {
                track.cues.append(cue)
            }
        } else {
            track.warnings.append("bad WebVTT cue timing: {block[at]}")
        }
    }
    track.cues = track.cues.sorted(by: { a, b in a.start < b.start })
    Result.ok(value: track)
}

// An MP4 'wvtt' sample: 'vttc' boxes (one per cue showing) with 'payl'
// text and 'sttg' settings, or 'vtte' (nothing showing). Plain text
// (Matroska S_TEXT/WEBVTT blocks) is one cue.
fn vttPacket(_ data: Data, start: Float, end: Float) -> [Cue] {
    var out: [Cue] = []
    if data.count >= 8 {
        let kind = data.slice(from: 4, to: 8).latin1
        if kind == "vttc" || kind == "vtte" || kind == "vtta" {
            var at = 0
            while at + 8 <= data.count {
                let size = data.uint32(at: at, bigEndian: true)
                let k = data.slice(from: at + 4, to: at + 8).latin1
                if size < 8 || at + size > data.count {
                    break
                }
                if k == "vttc" {
                    var text = ""
                    var settings = ""
                    var p = at + 8
                    while p + 8 <= at + size {
                        let s2 = data.uint32(at: p, bigEndian: true)
                        let k2 = data.slice(from: p + 4, to: p + 8).latin1
                        if s2 < 8 || p + s2 > at + size {
                            break
                        }
                        let body = subsPacketText(data.slice(from: p + 8, to: p + s2))
                        if k2 == "payl" {
                            text = body
                        } else if k2 == "sttg" {
                            settings = body
                        }
                        p += s2
                    }
                    let cue = vttCue(text, settings: settings, start: start, end: end)
                    if !cue.spans.isEmpty {
                        out.append(cue)
                    }
                }
                at += size
            }
            return out
        }
    }
    let cue = vttCue(subsPacketText(data), settings: "", start: start, end: end)
    if !cue.spans.isEmpty {
        out.append(cue)
    }
    out
}
