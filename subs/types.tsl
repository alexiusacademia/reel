// The subtitle module's values: a Span is a run of text in one style, a
// Cue is what is shown on screen from one time to another (styled text, or
// a bitmap for PGS/DVD subtitles), and a SubTrack is a whole subtitle file
// or track. Also the timing helpers activeCues, shifted and replaceCues.
//
// Everything about where and how big things are is resolution-free:
// margins, positions and font sizes are fractions of the video's size, so
// the same cue draws right at any window size (see draw.tsl).
//
// Author: Alexius Academia
// Date: 2026-10-25

// rgba packed r<<24 | g<<16 | b<<8 | a (a = 255 opaque), as g.image takes.
public let white = 0xFFFFFFFF
public let black = 0x000000FF

// A time far in the future: the end of a bitmap cue whose end isn't known
// yet (PGS and DVD subtitles end when the next composition comes).
public let openEnd = 1.0e9

// The default text size (line height) as a fraction of the video's
// height: ASS's default style (16 at PlayResY 288), which is what ffmpeg
// and libass use for SRT and WebVTT too.
public let defaultFontSize = 16.0 / 288.0
// Default outline width and margins (ffmpeg's default ASS style: Outline 1,
// MarginL/R/V 10 at 384×288).
public let defaultBorder = 1.0 / 288.0
public let defaultMarginH = 10.0 / 384.0
public let defaultMarginV = 10.0 / 288.0

public struct Span {
    text: String
    bold: Bool = false
    italic: Bool = false
    underline: Bool = false
    strike: Bool = false
    // Fill colour (rgba packed).
    color: Int = 0xFFFFFFFF
    // Outline colour (rgba packed).
    outline: Int = 0x000000FF
    // Shadow colour (rgba packed).
    shadow: Int = 0x00000080
    // Font family; "" = the default (the system's sans-serif font).
    font: String = ""
    // Text size relative to the cue's fontSize (1.0 = the style's size).
    size: Float = 1.0
    // Outline width and shadow offset as fractions of the video's height.
    border: Float = 0.0034722222222222222
    shadowDepth: Float = 0.0
    // ASS \fscx / \fscy as factors (only scaleY changes the drawn size).
    scaleX: Float = 1.0
    scaleY: Float = 1.0
    // Extra room after each letter (ASS \fsp), fraction of video height.
    spacing: Float = 0.0
}

// A picture subtitle (PGS, DVD): `x, y, w, h` in the pixels of a frame of
// `frameWidth × frameHeight` (the size the subtitle was made for, usually
// the video's), `pixels` rgba packed as g.image takes them.
public struct SubBitmap {
    x: Int = 0
    y: Int = 0
    w: Int = 0
    h: Int = 0
    pixels: [Int] = []
    frameWidth: Int = 0
    frameHeight: Int = 0
}

public struct Cue {
    // Seconds.
    start: Float
    end: Float
    // The text; a span whose text is "\n" breaks the line.
    spans: [Span] = []
    // Where it sits, numpad layout: 1–3 bottom, 4–6 middle, 7–9 top;
    // 1/4/7 left, 2/5/8 centre, 3/6/9 right.
    align: Int = 2
    // Margins as fractions of the video's width (L, R) and height (V).
    marginL: Float = 0.026041666666666668
    marginR: Float = 0.026041666666666668
    marginV: Float = 0.034722222222222224
    // A position (0…1 of the video's width/height) that the alignment
    // point of the text is put at; −1 = not positioned (use the margins).
    x: Float = -1.0
    y: Float = -1.0
    // ASS style name and layer (higher layers are drawn on top).
    style: String = ""
    layer: Int = 0
    // Seconds of fading in after start and out before end.
    fadeIn: Float = 0.0
    fadeOut: Float = 0.0
    bitmap: SubBitmap = SubBitmap()
    // The line height of size-1.0 text, as a fraction of video height.
    fontSize: Float = 0.05555555555555555
    // ASS \move: the position goes from (x, y) to (moveX, moveY) between
    // moveT1 and moveT2 seconds after start (both 0: the whole cue).
    moveX: Float = -1.0
    moveY: Float = -1.0
    moveT1: Float = 0.0
    moveT2: Float = 0.0
    // ASS BorderStyle: 1 outline + shadow, 3 an opaque box (in the
    // outline colour) behind each line.
    borderStyle: Int = 1
    // Widest a line may be, fraction of the video's width (WebVTT size:);
    // −1 = the width between the margins.
    width: Float = -1.0
    // ASS WrapStyle: 0 smart, 1 end-of-line, 2 no wrapping, 3 smart
    // (lower line wider).
    wrapStyle: Int = 0
    // Rotation in degrees, counter-clockwise (ASS \frz, style Angle).
    angle: Float = 0.0
    // PGS/DVD: shown even when subtitles are off (forced).
    forced: Bool = false
    // A box behind each line in this colour (rgba; its alpha is the box's
    // opacity), 0 = none: the "background" of a TextStyle (style.tsl).
    boxColor: Int = 0
    // A decoder may send a cue again with the same id (> 0) once it knows
    // more (a bitmap cue's real end): the new one replaces the old. See
    // replaceCues.
    id: Int = 0
}

public struct SubTrack {
    cues: [Cue] = []
    // "srt" "webvtt" "ass" "ssa" "tx3g" "text" "pgs" "dvdsub".
    format: String = ""
    // The coordinate space of the script (ASS PlayResX/Y); for other
    // formats 384×288 as ffmpeg/libass use them.
    playResX: Int = 384
    playResY: Int = 288
    // Problems found while reading (bad lines skipped).
    warnings: [String] = []
    // The text encoding a file was read in (loadFile, parseBytes) and how
    // sure the detection was (1 when chosen or certain).
    encoding: String = ""
    encodingConfidence: Float = 0.0
}

// The cues showing at a time, in drawing order (layer, then start).
public fn activeCues(_ track: SubTrack, at: Float) -> [Cue] {
    var out: [Cue] = []
    for c in track.cues {
        if c.start <= at && at < c.end {
            out.append(c)
        }
    }
    sortCues(out)
}

// The cues sorted by layer and start, stable.
public fn sortCues(_ cues: [Cue]) -> [Cue] {
    cues.sorted(by: { a, b in a.layer < b.layer || (a.layer == b.layer && a.start < b.start) })
}

// The track with every cue `by` seconds later (negative: earlier), for a
// subtitle delay setting.
public fn shifted(_ track: SubTrack, by: Float) -> SubTrack {
    var out = track
    for c in out.cues {
        c.start += by
        if c.end < openEnd {
            c.end += by
        }
    }
    out
}

// Adds cues from a decoder to a list: a cue with the id of one already
// there (id > 0) replaces it, others are added.
public fn replaceCues(_ cues: [Cue], _ more: [Cue]) -> [Cue] {
    var out = cues
    for c in more {
        var done = false
        if c.id > 0 {
            var i = out.count - 1
            while i >= 0 {
                if out[i].id == c.id {
                    out[i] = c
                    done = true
                    break
                }
                i -= 1
            }
        }
        if !done {
            out.append(c)
        }
    }
    out
}

// All the text of a cue, with "\n" between lines: for tests, search and
// a screen reader.
public fn plainText(_ cue: Cue) -> String {
    var s = ""
    for sp in cue.spans {
        s += sp.text
    }
    s
}

// The packed rgba of red, green, blue and alpha (each 0…255).
public fn rgba(_ r: Int, _ g: Int, _ b: Int, _ a: Int = 255) -> Int {
    (r & 255) << 24 | (g & 255) << 16 | (b & 255) << 8 | (a & 255)
}
