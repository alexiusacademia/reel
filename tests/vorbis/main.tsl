// Tests for the Vorbis decoder, all compared with ffmpeg's decoded
// samples:
//   - the IMDCT against its definition;
//   - tests/fixtures/vorbis.ogg (ffmpeg's own encoder);
//   - tests/vorbis/fixtures: short cuts of libvorbis streams from FFmpeg's
//     FATE suite (6 channels, floor 0 with residue 0, mono) and an ffmpeg
//     high-quality noise stream (made by tests/vorbis/make_fixtures.sh);
//   - the whole FATE Vorbis suite when it has been downloaded into
//     build/scratch/vorbis/fate (references made with ffmpeg -f f32le);
//   - headers in Track.extra (core's form and Xiph lacing) or in the
//     stream, comments, reset, and damaged packets.
//
// Author: Alexius Academia
// Date: 2026-10-25

import "../../vorbis"
import "../../core"
import "../../testkit"

struct Decoded {
    data: [Float] = []
    rate: Int = 0
    channels: Int = 0
    layout: [String] = []
    seconds: Float = 0.0
    warnings: [String] = []
    ok: Bool = false
    error: String = ""
    // Output frames of each audio packet.
    perPacket: [Int] = []
    lastGranule: Int = -1
}

fn trackWith(_ extra: Data) -> core.Track {
    var t = core.Track(index: 0, kind: .audio, codec: "vorbis")
    t.extra = extra
    t
}

// Decodes every packet of an Ogg Vorbis file. Headers go in through
// Track.extra (core's form, or `extra` when given) when `extraHeaders`,
// else as packets.
fn decodeOgg(_ file: Data, extraHeaders: Bool = true, extra: Data = Data()) -> Decoded {
    var out = Decoded()
    let packets = oggPackets(file)
    if packets.count < 3 {
        out.error = "fewer than 3 packets"
        return out
    }
    var first = 0
    var track = trackWith(extra)
    if extraHeaders && extra.isEmpty {
        track.extra = vorbis.joinHeaders([packets[0].data, packets[1].data, packets[2].data])
    }
    if extraHeaders {
        first = 3
    }
    match vorbis.newDecoder(track) {
        .ok(dec) -> {
            var d = dec
            let start = now()
            var all: [Float] = []
            for i in first..packets.count {
                let s = d.decode(packets[i].data, pts: 0)
                all += s.data
                if s.channels > 0 {
                    out.channels = s.channels
                    out.rate = s.rate
                }
                if i >= 3 {
                    out.perPacket.append(s.frames)
                }
                if packets[i].granule >= 0 {
                    out.lastGranule = packets[i].granule
                }
            }
            let tail = d.flush()
            all += tail.data
            out.seconds = now() - start
            out.data = all
            out.layout = d.layout
            out.warnings = d.warnings
            if out.channels == 0 {
                out.channels = d.channels
                out.rate = d.rate
            }
            out.ok = true
        }
        .failure(e) -> {
            out.error = e.message
        }
    }
    out
}

// Little-endian float32 samples from a file (ffmpeg -f f32le).
fn readF32(_ path: String) -> [Float] {
    let data = readData(path) ?? Data()
    var out: [Float] = []
    var i = 0
    while i + 4 <= data.count {
        out.append(data.float32(at: i))
        i += 4
    }
    out
}

struct Match {
    offset: Int = 0
    snr: Float = 0.0
    frames: Int = 0
}

// The best alignment (in frames, within ±4096) of decoded samples against
// a reference, and the SNR over all the frames both have there. A positive
// offset means the reference has that many frames more at its start.
fn bestMatch(_ allGot: [Float], _ want: [Float], _ channels: Int) -> Match {
    var m = Match()
    if channels <= 0 || allGot.isEmpty || want.isEmpty {
        return m
    }
    // The reference may be only the first frames of the stream.
    let got = allGot.prefix(min(allGot.count, want.count))
    // Search on a window in the middle (where there is sound), trying
    // offsets nearest 0 first so that ties keep the smallest shift.
    let gotFrames = got.count / channels
    let winStart = (gotFrames / 2) * channels
    let winLen = min(8192 * channels, got.count - winStart)
    var bestNoise = -1.0
    var best = 0
    for step in 0..8193 {
        let off = if step % 2 == 0 { step / 2 } else { -(step + 1) / 2 }
        var noise = 0.0
        var i = 0
        var count = 0
        while i < winLen {
            let j = winStart + i + off * channels
            if j >= 0 && j < want.count {
                let d = got[winStart + i] - want[j]
                noise += d * d
                count += 1
            }
            i += 1
            if bestNoise >= 0.0 && noise >= bestNoise {
                break
            }
        }
        if count > winLen / 2 && (bestNoise < 0.0 || noise < bestNoise) {
            bestNoise = noise
            best = off
        }
    }
    m.offset = best
    var signal = 0.0
    var noise = 0.0
    var n = 0
    for i in 0..got.count {
        let j = i + best * channels
        if j >= 0 && j < want.count {
            let d = got[i] - want[j]
            signal += want[j] * want[j]
            noise += d * d
            n += 1
        }
    }
    m.frames = n / channels
    m.snr = if noise == 0.0 { 150.0 } else if signal == 0.0 { 0.0 } else { 10.0 * log10(signal / noise) }
    m
}

// Packs bits least significant first, as Vorbis does.
struct BitWriter {
    bytes: [Int] = []
    acc: Int = 0
    held: Int = 0

    fn put(_ value: Int, _ bits: Int) {
        for i in 0..bits {
            acc = acc | (((value >> i) & 1) << held)
            held += 1
            if held == 8 {
                bytes.append(acc)
                acc = 0
                held = 0
            }
        }
    }

    // A codeword, first bit first ("10" is put(1), put(0)).
    fn code(_ bits: String) {
        for ch in bits.characters {
            put(if ch == "1" { 1 } else { 0 }, 1)
        }
    }

    data: Data {
        if held > 0 { Data(bytes: bytes + [acc]) } else { Data(bytes: bytes) }
    }
}

// Feeds damaged copies of real packets (cut, bytes flipped, random) to a
// decoder; true when it never stopped, made no NaNs, and decodes the clean
// stream as before after a reset.
fn fuzz(_ headers: [Data], _ audio: [Data], rounds: Int, _ clean: [Float]) -> Bool {
    match vorbis.newDecoder(trackWith(vorbis.joinHeaders(headers))) {
        .ok(dec) -> {
            var dd = dec
            var seed = 12345
            var nan = false
            for round in 0..rounds {
                var bytes = audio[round % audio.count].bytes
                seed = seed.wrappingMultiply(6364136223846793005).wrappingAdd(1442695040888963407)
                let kind = (seed >> 33) & 3
                if kind == 0 {
                    bytes = bytes.prefix(((seed >> 40) & 0xffff) % (bytes.count + 1))
                } else if kind == 1 {
                    for k in 0..4 {
                        let at = ((seed >> (8 + k * 8)) & 0xffff) % max(1, bytes.count)
                        if !bytes.isEmpty {
                            bytes[at] = bytes[at] ^ ((seed >> (k * 5)) & 0xff)
                        }
                    }
                } else if kind == 2 {
                    var junk: [Int] = []
                    for k in 0..(((seed >> 20) & 255) + 1) {
                        junk.append(((seed >> (k % 40)) ^ (k * 37)) & 0xfe)
                    }
                    bytes = junk
                }
                let s = dd.decode(Data(bytes: bytes), pts: 0)
                for v in s.data {
                    if v.isNaN {
                        nan = true
                    }
                }
            }
            dd.reset()
            var again: [Float] = []
            for p in audio {
                again += dd.decode(p, pts: 0).data
            }
            !nan && again == clean
        }
        .failure(_) -> false
    }
}

// A Vorbis comment packet with the given "KEY=value" strings.
fn commentPacket(_ vendor: String, _ items: [String], prefix: Data) -> Data {
    var p = prefix
    let v = Data(text: vendor)
    p += Data(bytes: v.count.bytes(count: 4))
    p += v
    p += Data(bytes: items.count.bytes(count: 4))
    for s in items {
        let d = Data(text: s)
        p += Data(bytes: d.count.bytes(count: 4))
        p += d
    }
    p
}

fn main() {
    var passed = 0
    var total = 0
    fn check(_ ok: Bool, _ what: String) {
        total += 1
        if ok { passed += 1 } else { print("FAIL: {what}") }
    }

    // --- The fast IMDCT against its definition (section 4.3.7). ---
    for n in [64, 256, 2048] {
        var x: [Float] = []
        for k in 0..(n / 2) {
            x.append(sin(Float(k * k % 97) * 0.37) * 0.5)
        }
        let fast = vorbis.fastImdct(x)
        let slow = vorbis.slowImdct(x)
        var err = 0.0
        for i in 0..n {
            err = max(err, abs(fast[i] - slow[i]))
        }
        check(err < 1e-9, "fast IMDCT of {n} matches the definition (max error {err})")
    }

    // --- tests/fixtures/vorbis.ogg (ffmpeg's encoder). ---
    let file = testkit.fixture("vorbis.ogg")
    let packets = oggPackets(file)
    let headers = [packets[0].data, packets[1].data, packets[2].data]
    let d = decodeOgg(file)
    check(d.ok, "vorbis.ogg decodes ({d.error})")
    check(d.rate == 44100 && d.channels == 2 && d.layout == ["FL", "FR"], "vorbis.ogg is 44100 Hz stereo FL FR ({d.rate} {d.channels})")
    check(d.warnings.isEmpty, "vorbis.ogg decodes without warnings ({d.warnings.count})")
    let want = testkit.referenceSamples("vorbis.ogg")
    let m = bestMatch(d.data, want, 2)
    print("vorbis.ogg: {d.data.count / 2} frames (last granule {d.lastGranule}), ffmpeg {want.count / 2}, offset {m.offset}, SNR {m.snr.formatted(decimals: 1)} dB")
    check(m.snr >= 90.0, "vorbis.ogg SNR {m.snr} >= 90 dB")
    check(m.offset == 0, "vorbis.ogg lines up with ffmpeg at offset 0 ({m.offset})")
    // The first packet only primes; then each gives 2048/4 + 2048/4.
    check(d.perPacket.count > 2 && d.perPacket[0] == 0 && d.perPacket[1] == 1024, "first packet primes, second gives 1024 frames")
    // ffmpeg trims the end at the last granule position; the decoder
    // gives whole blocks (the container's packet durations say the rest).
    check(d.data.count / 2 >= d.lastGranule && d.data.count / 2 - d.lastGranule < 2048, "decoded frames cover the last granule {d.lastGranule}")
    check(want.count / 2 == d.lastGranule, "ffmpeg's samples end at the last granule")

    // Speed on vorbis.ogg.
    let audioSec = Float(d.data.count / 2) / 44100.0
    print("time vorbis vorbis.ogg: {Int(d.seconds * 1000.0)} ms for {audioSec.formatted(decimals: 2)} s ({(audioSec / max(d.seconds, 1e-6)).formatted(decimals: 0)}x real time)")

    // Track.extra as Matroska's Xiph-laced CodecPrivate (ffmpeg's
    // extradata) gives the same samples.
    let ref = testkit.loadRef("vorbis.ogg")
    let laced = testkit.hexToData(ref.tracks[0].extraHex)
    let split = vorbis.splitHeaders(laced)
    check(split.count == 3 && split[2] == headers[2], "Xiph-laced extra splits into the 3 headers")
    let dl = decodeOgg(file, extraHeaders: true, extra: laced)
    check(dl.ok && dl.data == d.data, "Xiph-laced extra decodes the same")
    // Headers as packets, with an empty extra.
    let ds = decodeOgg(file, extraHeaders: false)
    check(ds.ok && ds.data == d.data && ds.rate == 44100, "headers in the stream decode the same")
    // Headers in extra and again as packets: no change either.
    var both: [Float] = []
    match vorbis.newDecoder(trackWith(vorbis.joinHeaders(headers))) {
        .ok(dec) -> {
            var dd = dec
            check(dd.rate == 44100 && dd.channels == 2 && dd.delay == 0, "rate, channels and delay known after newDecoder")
            for p in packets {
                both += dd.decode(p.data, pts: 0).data
            }
            check(dd.warnings.isEmpty, "repeated headers make no warnings")
        }
        .failure(e) -> check(false, "newDecoder: {e.message}")
    }
    check(both == d.data, "headers repeated as packets decode the same")

    // pts is passed through.
    match vorbis.newDecoder(trackWith(vorbis.joinHeaders(headers))) {
        .ok(dec) -> {
            var dd = dec
            let s0 = dd.decode(packets[3].data, pts: -1024)
            let s = dd.decode(packets[4].data, pts: 0)
            let s2 = dd.decode(packets[5].data, pts: 1024)
            check(s0.frames == 0 && s.pts == 0 && s2.pts == 1024 && s2.frames == 1024 && s2.rate == 44100 && s2.layout == ["FL", "FR"], "samples carry the packet's pts, rate and layout")
        }
        .failure(e) -> check(false, "newDecoder: {e.message}")
    }

    // reset(): the next packet primes again, then the output is exactly
    // what a continuous decode gives from there.
    match vorbis.newDecoder(trackWith(vorbis.joinHeaders(headers))) {
        .ok(dec) -> {
            var dd = dec
            for i in 3..20 {
                dd.decode(packets[i].data, pts: 0)
            }
            dd.reset()
            let primed = dd.decode(packets[30].data, pts: 0)
            var after: [Float] = []
            for i in 31..40 {
                after += dd.decode(packets[i].data, pts: 0).data
            }
            // Packet 31's output starts after the output of packets 3…30.
            var start = 0
            for i in 0..28 {
                start += d.perPacket[i]
            }
            let expected = d.data.slice(from: start * 2, to: start * 2 + after.count)
            check(primed.frames == 0 && after.count > 0 && after == expected, "after reset the decoder primes and then matches a continuous decode")
        }
        .failure(e) -> check(false, "newDecoder: {e.message}")
    }

    // Damaged packets never stop the program; decoding goes on.
    var audioPackets: [Data] = []
    for i in 3..packets.count {
        audioPackets.append(packets[i].data)
    }
    check(fuzz(headers, audioPackets, rounds: 3000, d.data), "vorbis.ogg: 3000 damaged packets decode without stopping or NaNs, then the stream as before")
    for name in ["floor0", "surround6", "mono"] {
        let pk = oggPackets(readData("tests/vorbis/fixtures/{name}.ogg") ?? Data())
        var audio: [Data] = []
        for i in 3..pk.count {
            audio.append(pk[i].data)
        }
        let clean = decodeOgg(readData("tests/vorbis/fixtures/{name}.ogg") ?? Data()).data
        check(fuzz([pk[0].data, pk[1].data, pk[2].data], audio, rounds: 1500, clean), "{name}.ogg: damaged packets decode without stopping")
    }
    // Damaged setup headers: refused or accepted, never a stop.
    var seed = 99
    var setupsOk = 0
    for round in 0..400 {
        var bytes = headers[2].bytes
        seed = seed.wrappingMultiply(6364136223846793005).wrappingAdd(1442695040888963407)
        let at = 7 + ((seed >> 20) & 0xffffff) % (bytes.count - 7)
        bytes[at] = bytes[at] ^ (1 << ((seed >> 50) & 7))
        if round % 3 == 0 {
            bytes = bytes.prefix(at)
        }
        match vorbis.newDecoder(trackWith(vorbis.joinHeaders([headers[0], headers[1], Data(bytes: bytes)]))) {
            .ok(dec) -> {
                var dd = dec
                for i in 3..20 {
                    dd.decode(packets[i].data, pts: 0)
                }
                setupsOk += 1
            }
            .failure(_) -> {
                setupsOk += 0
            }
        }
    }
    check(true, "400 damaged setup headers never stop the program ({setupsOk} accepted)")

    // --- Codebooks (section 3.2.1) the fixtures don't have. ---
    // Sparse, lookup type 2 with sequence_p: entries 0 "0", 1 unused,
    // 2 "10", 3 "11"; values min -1, delta 0.5, multiplicands 0…7.
    var w = BitWriter()
    w.put(0x564342, 24)
    w.put(2, 16)
    w.put(4, 24)
    w.put(0, 1)
    w.put(1, 1)
    w.put(1, 1)
    w.put(0, 5)
    w.put(0, 1)
    w.put(1, 1)
    w.put(1, 5)
    w.put(1, 1)
    w.put(1, 5)
    w.put(2, 4)
    w.put(0x80000000 | (788 << 21) | 1, 32)
    w.put((787 << 21) | 1, 32)
    w.put(3, 4)
    w.put(1, 1)
    for v in 0..8 {
        w.put(v, 4)
    }
    var st = BitWriter()
    st.code("10")
    st.code("0")
    st.code("11")
    st.code("0")
    match vorbis.testCodebook(w.data, st.data, count: 5) {
        .ok(res) -> {
            check(res.0 == [2, 0, 3, 0, 0], "sparse book decodes 2 0 3 0 ({res.0.count})")
            check(res.1 == [-1.0, -1.5, 0.0, 0.5, 1.0, 2.5, 2.0, 4.5], "lookup type 2 with sequence_p values")
        }
        .failure(e) -> check(false, "lookup type 2 book: {e.message}")
    }
    // Ordered lengths and lookup type 1: 9 entries of 2 dimensions over 3
    // values; lengths 3 (entries 0…5) and 4 (6…8).
    var w1 = BitWriter()
    w1.put(0x564342, 24)
    w1.put(2, 16)
    w1.put(9, 24)
    w1.put(1, 1)
    w1.put(2, 5)
    w1.put(6, 4)
    w1.put(3, 2)
    w1.put(1, 4)
    w1.put(788 << 21, 32)
    w1.put((788 << 21) | 1, 32)
    w1.put(1, 4)
    w1.put(0, 1)
    for v in [0, 1, 2] {
        w1.put(v, 2)
    }
    var st1 = BitWriter()
    st1.code("1101")
    st1.code("100")
    st1.code("000")
    st1.code("1110")
    match vorbis.testCodebook(w1.data, st1.data, count: 4) {
        .ok(res) -> {
            check(res.0 == [7, 4, 0, 8], "ordered book decodes 7 4 0 8")
            check(res.1.count == 18 && res.1[14] == 1.0 && res.1[15] == 2.0 && res.1[16] == 2.0 && res.1[17] == 2.0, "lookup type 1 values (entry 7 = 1 2, entry 8 = 2 2)")
        }
        .failure(e) -> check(false, "lookup type 1 book: {e.message}")
    }
    // A single-entry book: every read gives entry 0 and takes one bit.
    var w2 = BitWriter()
    w2.put(0x564342, 24)
    w2.put(1, 16)
    w2.put(1, 24)
    w2.put(0, 1)
    w2.put(0, 1)
    w2.put(0, 5)
    w2.put(0, 4)
    match vorbis.testCodebook(w2.data, Data(bytes: [0b101]), count: 9) {
        .ok(res) -> check(res.0.prefix(8) == [0, 0, 0, 0, 0, 0, 0, 0] && res.0[8] == -1, "single-entry book reads one bit each time")
        .failure(e) -> check(false, "single-entry book: {e.message}")
    }
    // Overfull lengths are refused.
    var w3 = BitWriter()
    w3.put(0x564342, 24)
    w3.put(1, 16)
    w3.put(3, 24)
    w3.put(0, 1)
    w3.put(0, 1)
    for _ in 0..3 {
        w3.put(0, 5)
    }
    w3.put(0, 4)
    check(!vorbis.testCodebook(w3.data, Data(), count: 1).isOk(), "three 1-bit codewords are refused")

    match vorbis.newDecoder(trackWith(Data(bytes: [0, 0, 0, 5, 1, 2, 3, 4, 5]))) {
        .ok(_) -> check(false, "bad extra is refused")
        .failure(e) -> check(!e.message.isEmpty, "bad extra is refused with a reason")
    }
    var bad = vorbis.joinHeaders([headers[0], headers[1], headers[2].slice(from: 0, to: headers[2].count / 2)])
    check(!vorbis.newDecoder(trackWith(bad)).isOk(), "a cut setup header is refused")
    bad = vorbis.joinHeaders([headers[0], headers[1]])
    check(!vorbis.newDecoder(trackWith(bad)).isOk(), "two headers are refused")

    // Block sizes for demuxers: prev/4 + cur/4 is each packet's output.
    if let bi = vorbis.blockInfo(vorbis.joinHeaders(headers)) {
        var okSizes = true
        var prevSize = 0
        for i in 3..packets.count {
            let size = vorbis.packetBlockSize(bi, packets[i].data)
            let expect = if prevSize == 0 { 0 } else { prevSize / 4 + size / 4 }
            if expect != d.perPacket[i - 3] {
                okSizes = false
            }
            prevSize = size
        }
        check(okSizes && vorbis.packetBlockSize(bi, headers[0]) == 0, "packetBlockSize times every packet as the decoder does")
    } else {
        check(false, "blockInfo reads the headers")
    }
    let fb = vorbis.blockInfo(vorbis.joinHeaders([oggPackets(readData("tests/vorbis/fixtures/mono.ogg") ?? Data())[0].data, oggPackets(readData("tests/vorbis/fixtures/mono.ogg") ?? Data())[1].data, oggPackets(readData("tests/vorbis/fixtures/mono.ogg") ?? Data())[2].data]))
    check(fb?.blocksize0 == 256 && fb?.blocksize1 == 2048, "blockInfo of a libvorbis stream: 256/2048")

    // --- Comments (section 5). ---
    let tags = vorbis.parseComments(headers[1])
    check(tags["vendor"] == "Lavf62.12.102" && (tags["encoder"] ?? "").hasPrefix("Lavc") && tags.count == 2, "vorbis.ogg comment header: vendor and encoder ({tags["encoder"] ?? "-"})")
    let vorbisPrefix = Data(bytes: [3, 0x76, 0x6f, 0x72, 0x62, 0x69, 0x73])
    let cp = commentPacket("Xiph.Org libVorbis I 20200704 (Reducing Environment)", ["TITLE=Tone", "Artist=Ada", "ARTIST=Grace", "TRACKNUMBER=3", "DESCRIPTION=hello", "ALBUM ARTIST=Both", "café=é"], prefix: vorbisPrefix)
    let t2 = vorbis.parseComments(cp + Data(bytes: [1]))
    check(t2["title"] == "Tone" && t2["artist"] == "Ada; Grace" && t2["track"] == "3", "comments: title, repeated artist, track number")
    check(t2["comment"] == "hello" && t2["albumartist"] == "Both" && t2["café"] == "é", "comments: description, album artist, UTF-8")
    let opusTags = commentPacket("libopus 1.5", ["TITLE=Opus"], prefix: Data(text: "OpusTags"))
    check(vorbis.parseComments(opusTags)["title"] == "Opus", "OpusTags comments")
    let bare = commentPacket("reference libFLAC", ["GENRE=Test"], prefix: Data())
    check(vorbis.parseComments(bare)["genre"] == "Test", "bare comment block (FLAC)")
    check(vorbis.parseComments(vorbisPrefix + Data(bytes: [255, 255, 255, 255])).isEmpty, "damaged comments give no tags")
    // METADATA_BLOCK_PICTURE: a FLAC picture block in base64.
    var block = Data(bytes: (3).bytes(count: 4, bigEndian: true))
    let mime = Data(text: "image/png")
    block += Data(bytes: mime.count.bytes(count: 4, bigEndian: true)) + mime
    block += Data(bytes: (0).bytes(count: 4, bigEndian: true))
    block += Data(bytes: [0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 24, 0, 0, 0, 0])
    let image = Data(bytes: [0x89, 0x50, 0x4e, 0x47, 1, 2, 3])
    block += Data(bytes: image.count.bytes(count: 4, bigEndian: true)) + image
    check(vorbis.pictureFromComment(block.base64) == image, "METADATA_BLOCK_PICTURE gives the image")
    let info = vorbis.streamInfo(trackWith(vorbis.joinHeaders(headers)))
    check(info.hasPrefix("Vorbis, 44100 Hz, stereo"), "streamInfo: {info}")

    // --- Our own fixtures: cuts of libvorbis streams and ffmpeg noise. ---
    let own: [(String, Int, [String])] = [
        ("surround6", 6, ["FL", "FR", "FC", "LFE", "BL", "BR"]),
        ("floor0", 2, ["FL", "FR"]),
        ("mono", 1, ["FC"]),
        ("noise", 2, ["FL", "FR"]),
    ]
    for (name, chans, layout) in own {
        let r = decodeOgg(readData("tests/vorbis/fixtures/{name}.ogg") ?? Data())
        let w = readF32("tests/vorbis/fixtures/{name}.f32")
        let mm = bestMatch(r.data, w, chans)
        print("{name}.ogg: {r.rate} Hz {r.channels} ch, {mm.frames} frames compared, offset {mm.offset}, SNR {mm.snr.formatted(decimals: 1)} dB")
        check(r.ok && r.channels == chans && r.layout == layout, "{name}.ogg: {chans} channels in WAV order")
        check(mm.snr >= 90.0 && mm.offset == 0 && mm.frames > 4000, "{name}.ogg SNR {mm.snr} >= 90 dB at offset 0")
        check(r.warnings.isEmpty, "{name}.ogg decodes without warnings")
    }

    // --- The FATE suite's libvorbis streams, when downloaded. ---
    let fate = "build/scratch/vorbis/fate"
    let names = ["1.0-test_small", "1.0.1-test_small", "6", "beta3-test_small", "beta4-test_small",
        "chain-test1_small", "chain-test2_small", "highrate-test_small", "lsp-test_small",
        "lsp-test2_small", "lsp-test3_small", "lsp-test4_small", "mono_small", "moog_small",
        "rc1-test_small", "rc2-test_small", "rc2-test2_small", "rc3-test_small", "sleepzor_small",
        "test-short2_small", "vorbis_chapter_extension_demo"]
    var audioSeconds = 0.0
    var decodeSeconds = 0.0
    var found = 0
    var worst = 150.0
    for name in names {
        let path = joinPath(fate, name + ".ogg")
        if !fileExists(path) {
            continue
        }
        found += 1
        let r = decodeOgg(readData(path) ?? Data())
        let w = readF32(joinPath(fate, name + ".f32"))
        let mm = bestMatch(r.data, w, r.channels)
        print("fate {name}: {r.rate} Hz {r.channels} ch, {r.data.count / max(1, r.channels)} frames, ffmpeg {w.count / max(1, r.channels)}, offset {mm.offset}, SNR {mm.snr.formatted(decimals: 1)} dB")
        check(r.ok && mm.snr >= 90.0 && mm.offset == 0, "fate {name} SNR {mm.snr} >= 90 dB at offset 0 ({r.error})")
        worst = min(worst, mm.snr)
        if r.rate > 0 {
            audioSeconds += Float(r.data.count / max(1, r.channels)) / Float(r.rate)
            decodeSeconds += r.seconds
        }
    }
    if found == 0 {
        print("note: FATE Vorbis files not in {fate}; skipped")
    } else {
        print("fate: {found} files, worst SNR {worst.formatted(decimals: 1)} dB")
    }
    if decodeSeconds > 0.0 {
        print("time vorbis fate suite: {Int(decodeSeconds * 1000.0)} ms for {audioSeconds.formatted(decimals: 1)} s of audio ({(audioSeconds / decodeSeconds).formatted(decimals: 0)}x real time)")
    }

    print("vorbis: {passed} of {total} passed")
}
