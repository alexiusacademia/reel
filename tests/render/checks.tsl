// Helpers of the render test: the check tally, ffmpeg references, the
// exact colour formulas, test pictures and test sounds.
//
// Author: Alexius Academia
// Date: 2026-10-25

import "../../render"
import "../../core"
import "../../testkit"

struct Tally {
    passed: Int = 0
    total: Int = 0

    fn check(_ ok: Bool, _ what: String) {
        total += 1
        if ok {
            passed += 1
        } else {
            print("FAIL: {what}")
        }
    }
}

fn ms(_ t: Float) -> Float {
    (now() - t) * 1000.0
}

fn f2(_ x: Float) -> String {
    x.formatted(decimals: 2)
}

// An ffmpeg reference picture: RGB bytes.
fn loadRgb(_ name: String) -> [Int] {
    let z = readData("tests/render/fixtures/" + name + ".rgb.z") ?? Data()
    let d = z.decompressed() ?? Data()
    d.bytes
}

// Largest and mean channel difference between packed RGBA pixels and RGB
// bytes.
fn compareRgb(_ px: [Int], _ rgb: [Int]) -> (Int, Float) {
    if px.count * 3 != rgb.count {
        return (999, 999.0)
    }
    var worst = 0
    var sum = 0
    var i = 0
    while i < px.count {
        let p = px[i]
        let d0 = abs(((p >> 24) & 255) - rgb[3 * i])
        let d1 = abs(((p >> 16) & 255) - rgb[3 * i + 1])
        let d2 = abs(((p >> 8) & 255) - rgb[3 * i + 2])
        worst = max(worst, d0, d1, d2)
        sum += d0 + d1 + d2
        i += 1
    }
    (worst, Float(sum) / Float(max(3 * px.count, 1)))
}

// PSNR in dB of RGBA pixels against RGB bytes.
fn psnrRgb(_ px: [Int], _ rgb: [Int]) -> Float {
    var sum = 0
    for i in 0..px.count {
        let p = px[i]
        for c in 0..3 {
            let d = ((p >> (24 - 8 * c)) & 255) - rgb[3 * i + c]
            sum += d * d
        }
    }
    if sum == 0 {
        return 99.0
    }
    10.0 * log10(255.0 * 255.0 * Float(3 * px.count) / Float(sum))
}

// A 160×120 crop at (80, 60) of a 320×240 picture, through the plane
// offsets.
fn cropOf(_ p: core.Picture) -> core.Picture {
    var c = p
    c.width = 160
    c.height = 120
    c.yOffset = 60 * p.yStride + 80
    let cy = if p.chroma == .yuv420 { 30 } else { 60 }
    let cx = if p.chroma == .yuv444 { 80 } else { 40 }
    c.cOffset = cy * p.cStride + cx
    c
}

// One chroma column's value at luma row y (4:2:0 rows mix 3:1).
fn chromaColumn(_ p: core.Picture, _ j: Int, _ y: Int, _ plane: Int) -> Float {
    if p.chroma != .yuv420 {
        return Float(if plane == 0 { p.cb(j, y) } else { p.cr(j, y) })
    }
    let ch = p.chromaHeight
    let k = y / 2
    let k2 = if y % 2 == 0 { max(k - 1, 0) } else { min(k + 1, ch - 1) }
    let a = if plane == 0 { p.cb(j, k) } else { p.cr(j, k) }
    let b = if plane == 0 { p.cb(j, k2) } else { p.cr(j, k2) }
    (3.0 * Float(a) + Float(b)) / 4.0
}

fn quantise(_ v: Float) -> Int {
    max(0, min(255, Int(floor(v * 255.0 + 0.5))))
}

// The exact conversion of one pixel, in Floats (Kr/Kb from the standards,
// the same chroma siting and interpolation as the renderer).
fn exactPixel(_ p: core.Picture, _ x: Int, _ y: Int, kr: Float, kb: Float) -> (Int, Int, Int) {
    let s = Float(1 << (p.depth - 8))
    let top = Float((1 << p.depth) - 1)
    let yy = Float(p.luma(x, y))
    var cb = 128.0 * s
    var cr = 128.0 * s
    if p.chroma == .yuv444 {
        cb = chromaColumn(p, x, y, 0)
        cr = chromaColumn(p, x, y, 1)
    } else if p.chroma != .gray {
        if x % 2 == 0 {
            cb = chromaColumn(p, x / 2, y, 0)
            cr = chromaColumn(p, x / 2, y, 1)
        } else {
            let j = x / 2
            let j2 = min(j + 1, p.chromaWidth - 1)
            cb = (chromaColumn(p, j, y, 0) + chromaColumn(p, j2, y, 0)) / 2.0
            cr = (chromaColumn(p, j, y, 1) + chromaColumn(p, j2, y, 1)) / 2.0
        }
    }
    var ey = 0.0
    var pb = 0.0
    var pr = 0.0
    if p.fullRange {
        ey = yy / top
        pb = (cb - 128.0 * s) / top
        pr = (cr - 128.0 * s) / top
    } else {
        ey = (yy - 16.0 * s) / (219.0 * s)
        pb = (cb - 128.0 * s) / (224.0 * s)
        pr = (cr - 128.0 * s) / (224.0 * s)
    }
    let kg = 1.0 - kr - kb
    let r = ey + 2.0 * (1.0 - kr) * pr
    let b = ey + 2.0 * (1.0 - kb) * pb
    let g = (ey - kr * r - kb * b) / kg
    (quantise(r), quantise(g), quantise(b))
}

// Largest channel difference of a whole conversion from exactPixel.
fn exactError(_ p: core.Picture, _ px: [Int], kr: Float, kb: Float) -> Int {
    if px.count != p.width * p.height {
        return 999
    }
    var worst = 0
    for y in 0..p.height {
        for x in 0..p.width {
            let (r, g, b) = exactPixel(p, x, y, kr: kr, kb: kb)
            let v = px[y * p.width + x]
            worst = max(worst, abs(((v >> 24) & 255) - r), abs(((v >> 16) & 255) - g), abs(((v >> 8) & 255) - b))
        }
    }
    worst
}

// A plane scaled up by bilinear interpolation (for making big natural
// test pictures from the small fixtures).
fn upscalePlane(_ src: [Int], _ sw: Int, _ sh: Int, _ dw: Int, _ dh: Int) -> [Int] {
    var out: [Int] = []
    for y in 0..dh {
        let fy = (Float(y) + 0.5) * Float(sh) / Float(dh) - 0.5
        let y0 = max(0, min(Int(floor(fy)), sh - 1))
        let y1 = min(y0 + 1, sh - 1)
        let wy = max(0.0, fy - Float(y0))
        for x in 0..dw {
            let fx = (Float(x) + 0.5) * Float(sw) / Float(dw) - 0.5
            let x0 = max(0, min(Int(floor(fx)), sw - 1))
            let x1 = min(x0 + 1, sw - 1)
            let wx = max(0.0, fx - Float(x0))
            let a = Float(src[y0 * sw + x0]) * (1.0 - wx) + Float(src[y0 * sw + x1]) * wx
            let b = Float(src[y1 * sw + x0]) * (1.0 - wx) + Float(src[y1 * sw + x1]) * wx
            out.append(Int(floor(a * (1.0 - wy) + b * wy + 0.5)))
        }
    }
    out
}

fn bigPicture(_ small: core.Picture, _ w: Int, _ h: Int) -> core.Picture {
    var p = core.Picture(width: w, height: h)
    p.yStride = w
    p.cStride = w / 2
    p.y = upscalePlane(small.y, small.width, small.height, w, h)
    p.u = upscalePlane(small.u, small.chromaWidth, small.chromaHeight, w / 2, h / 2)
    p.v = upscalePlane(small.v, small.chromaWidth, small.chromaHeight, w / 2, h / 2)
    p.matrix = .bt709
    p
}

// A flat 8×8 picture of one colour, converted; the pixel in the middle.
fn flatPixel(_ yv: Int, _ cb: Int, _ cr: Int, _ m: core.ColorMatrix) -> Int {
    var p = core.blankPicture(width: 8, height: 8)
    p.y = core.filled(64, yv)
    p.u = core.filled(16, cb)
    p.v = core.filled(16, cr)
    p.matrix = m
    render.toRgba(p, width: 8, height: 8)[27]
}

fn near(_ px: Int, _ r: Int, _ g: Int, _ b: Int) -> Bool {
    abs(((px >> 24) & 255) - r) <= 1 && abs(((px >> 16) & 255) - g) <= 1 && abs(((px >> 8) & 255) - b) <= 1 && (px & 255) == 255
}

fn nearPixel(_ a: Int, _ b: Int) -> Bool {
    near(a, (b >> 24) & 255, (b >> 16) & 255, (b >> 8) & 255)
}

// The ideal sweep at time t (as tone() makes it).
fn sweepAt(_ t: Float, f0: Float, f1: Float, seconds: Float, amp: Float) -> Float {
    let k = (f1 - f0) / seconds
    amp * sin(2.0 * pi * (f0 * t + 0.5 * k * t * t))
}

// A sine (or a linear sweep when f1 != f0) as interleaved samples, the
// same on every channel.
fn tone(rate: Int, channels: Int, seconds: Float, f0: Float, f1: Float, amp: Float) -> core.Samples {
    var s = core.Samples(rate: rate, channels: channels)
    let n = Int(Float(rate) * seconds)
    for i in 0..n {
        let v = sweepAt(Float(i) / Float(rate), f0: f0, f1: f1, seconds: seconds, amp: amp)
        for _ in 0..channels {
            s.data.append(v)
        }
    }
    s.layout = core.defaultLayout(channels)
    s
}

// The frequency of a tone in one channel, from its rising zero crossings
// (interpolated) between `from` and `to` frames.
fn zeroCrossingHz(_ s: core.Samples, channel: Int, from: Int, to: Int) -> Float {
    var first = -1.0
    var last = -1.0
    var count = 0
    let c = s.channels
    var i = max(from, 1)
    while i < min(to, s.frames) {
        let a = s.data[(i - 1) * c + channel]
        let b = s.data[i * c + channel]
        if a < 0.0 && b >= 0.0 {
            let t = Float(i - 1) + a / (a - b)
            if first < 0.0 {
                first = t
            } else {
                count += 1
            }
            last = t
        }
        i += 1
    }
    if count == 0 {
        return 0.0
    }
    Float(count) * Float(s.rate) / (last - first)
}

fn joinSamples(_ a: core.Samples, _ b: core.Samples) -> core.Samples {
    var out = a
    out.data.appendAll(b.data)
    out
}

// Frames from..to of a block.
fn part(_ s: core.Samples, _ from: Int, _ to: Int) -> core.Samples {
    var blk = core.Samples(rate: s.rate, channels: s.channels, layout: s.layout)
    blk.data = s.data.slice(from: from * s.channels, to: to * s.channels)
    blk
}

// Largest difference between two sample lists (999 when the counts
// differ).
fn maxDiff(_ a: [Float], _ b: [Float]) -> Float {
    if a.count != b.count {
        return 999.0
    }
    var worst = 0.0
    for i in 0..a.count {
        worst = max(worst, abs(a[i] - b[i]))
    }
    worst
}
