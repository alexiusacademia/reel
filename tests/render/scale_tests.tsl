// The render test's scaling and transform checks, and the speed of
// toRgba on HD pictures.
//
// Author: Alexius Academia
// Date: 2026-10-25

import "../../render"
import "../../core"
import "../../testkit"

fn scalingTests(_ t: bind Tally, _ full: core.Picture) {
    var base = cropOf(full)
    base.matrix = .bt601
    var renderer = render.newRenderer()
    let scaledCases: [(String, Int, Int)] = [("m2_601_tv_107x80", 107, 80), ("m2_601_tv_256x192", 256, 192), ("m2_601_tv_40x30_area", 40, 30)]
    for (name, w, h) in scaledCases {
        let px = renderer.toRgba(base, width: w, height: h)
        let ref = loadRgb(name)
        let (worst, mean) = compareRgb(px, ref)
        let db = if px.count * 3 == ref.count { psnrRgb(px, ref) } else { 0.0 }
        print("scale {name} vs ffmpeg: PSNR {f2(db)} dB, mean {f2(mean)}, max {worst}")
        t.check(db >= 38.0 && mean <= 1.5, "{name}: PSNR {f2(db)} dB vs ffmpeg (≥ 38)")
    }
    // A flat picture stays flat at any size.
    var flatPic = core.blankPicture(width: 64, height: 48)
    flatPic.y = core.filled(64 * 48, 120)
    flatPic.u = core.filled(32 * 24, 90)
    flatPic.v = core.filled(32 * 24, 170)
    flatPic.matrix = .bt601
    let flatColour = render.toRgba(flatPic, width: 64, height: 48)[0]
    var flatOk = true
    for (w, h) in [(13, 7), (200, 150), (64, 24), (8, 6), (5, 3)] {
        for sm in [true, false] {
            let px = render.toRgba(flatPic, width: w, height: h, smooth: sm)
            if px.count != w * h || !px.all(where: { v in nearPixel(v, flatColour) }) {
                flatOk = false
            }
        }
    }
    t.check(flatOk, "a flat picture stays flat when scaled")
    // A one-pixel checkerboard shrunk (area) averages to mid gray.
    var checker = core.blankPicture(width: 64, height: 64, chroma: .gray)
    checker.matrix = .bt709
    checker.fullRange = true
    for y in 0..64 {
        for x in 0..64 {
            checker.y[y * 64 + x] = if (x + y) % 2 == 0 { 0 } else { 254 }
        }
    }
    let shrunk = render.toRgba(checker, width: 16, height: 16)
    t.check(shrunk.all(where: { v in abs(((v >> 24) & 255) - 127) <= 1 }), "checkerboard shrunk 4× is mid gray (area)")
    let halfSize = render.toRgba(checker, width: 32, height: 32)
    t.check(halfSize.all(where: { v in abs(((v >> 24) & 255) - 127) <= 1 }), "checkerboard shrunk 2× is mid gray (area)")
    // A ramp scaled up 2× stays a ramp (bilinear).
    var ramp = core.blankPicture(width: 32, height: 4, chroma: .gray)
    ramp.fullRange = true
    for y in 0..4 {
        for x in 0..32 {
            ramp.y[y * 32 + x] = x * 8
        }
    }
    let up = render.toRgba(ramp, width: 64, height: 8)
    var rampOk = true
    for x in 1..63 {
        // Output x shows source position (x + 0.5)/2 − 0.5.
        let want = ((Float(x) + 0.5) / 2.0 - 0.5) * 8.0
        let got = (up[2 * 64 + x] >> 24) & 255
        if abs(Float(got) - want) > 1.0 {
            rampOk = false
        }
    }
    t.check(rampOk, "bilinear 2× of a ramp is linear")
    // Nearest 2× repeats each pixel of the same-size picture (up to the
    // coarser arithmetic of the scaled path).
    let same = render.toRgba(base, width: 160, height: 120)
    let near2 = render.toRgba(base, width: 320, height: 240, smooth: false)
    var nearOk = near2.count == 320 * 240
    for y in 0..240 {
        for x in 0..320 {
            if nearOk && !nearPixel(near2[y * 320 + x], same[(y / 2) * 160 + x / 2]) {
                nearOk = false
            }
        }
    }
    t.check(nearOk, "nearest 2× repeats the same-size pixels")
    let fit = render.fitSize(base, boxW: 1000, boxH: 300)
    t.check(fit.0 == 400 && fit.1 == 300, "fitSize keeps the aspect ratio")
    var anamorphic = base
    anamorphic.sarNum = 4
    anamorphic.sarDen = 3
    let fit2 = render.fitSize(anamorphic, boxW: 2000, boxH: 120)
    t.check(fit2.0 == 213 && fit2.1 == 120, "fitSize uses the sample aspect ratio")
}

fn transformTests(_ t: bind Tally, _ full: core.Picture) {
    var base = cropOf(full)
    base.matrix = .bt601
    // Rotation.
    let grid = [1, 2, 3, 4, 5, 6]          // 3 × 2: 1 2 3 / 4 5 6
    t.check(render.rotate(grid, width: 3, height: 2, degrees: 90) == [4, 1, 5, 2, 6, 3], "rotate 90")
    t.check(render.rotate(grid, width: 3, height: 2, degrees: 180) == [6, 5, 4, 3, 2, 1], "rotate 180")
    t.check(render.rotate(grid, width: 3, height: 2, degrees: 270) == [3, 6, 2, 5, 1, 4], "rotate 270")
    t.check(render.rotate(grid, width: 3, height: 2, degrees: -90) == [3, 6, 2, 5, 1, 4], "rotate −90")
    t.check(render.rotate(grid, width: 3, height: 2, degrees: 360) == grid, "rotate 360")
    let rsz = render.rotatedSize(width: 3, height: 2, degrees: 90)
    t.check(rsz.0 == 2 && rsz.1 == 3, "rotatedSize")
    let same = render.toRgba(base, width: 160, height: 120)
    t.check(render.rotate(render.rotate(same, width: 160, height: 120, degrees: 90), width: 120, height: 160, degrees: 270) == same, "rotate 90 then 270 is the same")

    // Deinterlacing.
    var inter = core.blankPicture(width: 16, height: 8, chroma: .gray)
    for y in 0..8 {
        for x in 0..16 {
            // Top field: a diagonal edge (x > y bright); bottom field junk.
            inter.y[y * 16 + x] = if y % 2 == 1 { if x % 2 == 0 { 255 } else { 0 } } else if x > y { 200 } else { 50 }
        }
    }
    let de = render.deinterlace(inter)
    var evenKept = true
    var noJunk = true
    for y in 0..8 {
        for x in 0..16 {
            let v = de.luma(x, y)
            if y % 2 == 0 && v != inter.luma(x, y) {
                evenKept = false
            }
            if v != 50 && v != 200 && v != 125 {
                noJunk = false
            }
        }
    }
    t.check(evenKept, "deinterlace keeps the top field")
    t.check(noJunk, "deinterlace rebuilds the bottom field from the top")
    // Rows 2 and 4 have the edge between x = 2/3 and 4/5: on row 3, ELA
    // joins them along the diagonal, so x = 3 is dark and x = 4 bright.
    t.check(de.luma(3, 3) == 50 && de.luma(4, 3) == 200, "edge-directed interpolation follows a diagonal ({de.luma(3, 3)}, {de.luma(4, 3)})")
    t.check(de.luma(9, 3) == 200 && de.luma(1, 3) == 50, "deinterlace away from the edge")
    let bl = render.deinterlace(inter, blend: true)
    t.check(bl.luma(4, 2) == (inter.luma(4, 1) + 2 * inter.luma(4, 2) + inter.luma(4, 3) + 2) / 4, "blend mixes 1, 2, 1")
    let de420 = render.deinterlace(base)
    t.check(de420.width == 160 && de420.u.count == base.u.count && testkit.psnr(de420, base) > 20.0, "deinterlace a 4:2:0 picture")
}

fn speedTests(_ t: bind Tally, _ full: core.Picture) {
    // Natural pictures: the fixture scaled up to 1080p and 720p.
    let hd = bigPicture(full, 1920, 1080)
    let hd720 = bigPicture(full, 1280, 720)
    var best1 = 1e9
    var best2 = 1e9
    var best3 = 1e9
    var best4 = 1e9
    var best5 = 1e9
    var best6 = 1e9
    var keep: [Int] = []
    var t0 = now()
    var rr = render.newRenderer()
    for _ in 0..12 {
        t0 = now()
        keep = rr.toRgba(hd, width: 1920, height: 1080)
        best1 = min(best1, ms(t0))
    }
    var r2 = render.newRenderer()
    for _ in 0..12 {
        t0 = now()
        keep = r2.toRgba(hd, width: 1280, height: 720)
        best2 = min(best2, ms(t0))
    }
    var r3 = render.newRenderer()
    for _ in 0..12 {
        t0 = now()
        keep = r3.toRgba(hd720, width: 1280, height: 720)
        best3 = min(best3, ms(t0))
    }
    for _ in 0..6 {
        t0 = now()
        keep = render.toRgba(hd, width: 1920, height: 1080)
        best4 = min(best4, ms(t0))
        t0 = now()
        keep = render.toRgba(hd, width: 1280, height: 720)
        best5 = min(best5, ms(t0))
    }
    var r4 = render.newRenderer()
    for _ in 0..6 {
        t0 = now()
        keep = r4.toRgba(hd, width: 960, height: 540)
        best6 = min(best6, ms(t0))
    }
    // The same picture with less saturation, so that no channel needs
    // clamping (the test pattern above is 93 % out of range).
    var mild = hd
    for i in 0..mild.y.count {
        mild.y[i] = 40 + (mild.y[i] - 16) * 3 / 4
    }
    for i in 0..mild.u.count {
        mild.u[i] = 128 + (mild.u[i] - 128) / 3
        mild.v[i] = 128 + (mild.v[i] - 128) / 3
    }
    var rm = render.newRenderer()
    var best7 = 1e9
    var best8 = 1e9
    for _ in 0..12 {
        t0 = now()
        keep = rm.toRgba(mild, width: 1920, height: 1080)
        best7 = min(best7, ms(t0))
    }
    var rm2 = render.newRenderer()
    for _ in 0..12 {
        t0 = now()
        keep = rm2.toRgba(mild, width: 1280, height: 720)
        best8 = min(best8, ms(t0))
    }
    print("time toRgba 1920×1080 → 1920×1080: {f2(best1)} ms (in-range colours: {f2(best7)} ms)")
    print("time toRgba 1920×1080 → 1280×720: {f2(best2)} ms (in-range colours: {f2(best8)} ms)")
    print("time toRgba 1280×720 → 1280×720: {f2(best3)} ms")
    print("time toRgba 1920×1080 → 960×540 (area): {f2(best6)} ms")
    print("time toRgba without a Renderer, 1080p same size: {f2(best4)} ms, → 720p: {f2(best5)} ms")
    t.check(keep.count == 1280 * 720, "big pictures convert")
    t0 = now()
    let rot = render.rotate(rr.out, width: 1920, height: 1080, degrees: 90)
    print("time rotate 1080p 90°: {Int(ms(t0))} ms")
    t0 = now()
    let dein = render.deinterlace(hd)
    print("time deinterlace 1080p: {Int(ms(t0))} ms")
    t.check(rot.count == 1920 * 1080 && dein.y.count == hd.y.count, "big transforms")
}
