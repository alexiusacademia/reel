// Tests of the VP9 decoder (module vp9): every picture of every clip must
// have the md5 ffmpeg's (libvpx-exact) decoder gives it.
//
//   tests/fixtures/vp9.webm          the shared fixture (Matroska packets)
//   tests/vp9/fixtures/*.ivf         8/10/12-bit, 4:4:4, 4:2:2, tiles,
//                                    row-mt, alt-ref superframes, compound,
//                                    lossless, odd size, error resilient,
//                                    a size change (made by make.sh)
//   build/conformance/vp9/ivf/*.ivf  the libvpx test vectors with their
//                                    .md5 files (tests/vp9/fixtures/
//                                    conformance.sh downloads them); a
//                                    representative set by default, all
//                                    314 with VP9_CONFORMANCE=all
// plus damaged packets (must never stop the program), reset after a seek,
// skipNonReference, the two-stage pipeline, streamInfo, and timings of the
// parser and reconstructor at 720p and 1080p, 8 and 10 bit
// (build/scratch/vp9/clips, made by make.sh).
//
// Author: Alexius Academia
// Date: 2026-10-25

import "../../vp9"
import "../../core"
import "../../testkit"

struct T {
    passed: Int = 0
    total: Int = 0

    fn check(_ ok: Bool, _ what: String) {
        total += 1
        if ok {
            passed += 1
        } else {
            print("FAIL: {what}")
        }
    }
}

// An IVF file's frames.
struct Ivf {
    width: Int = 0
    height: Int = 0
    packets: [Data] = []
}

fn readIvf(_ path: String) -> Ivf {
    var out = Ivf()
    let d = readData(path) ?? Data()
    if d.count < 32 {
        return out
    }
    out.width = d.uint16(at: 12)
    out.height = d.uint16(at: 14)
    var at = d.uint16(at: 6)
    while at + 12 <= d.count {
        let sz = d.uint32(at: at)
        at += 12
        if at + sz > d.count {
            break
        }
        out.packets.append(d.slice(from: at, to: at + sz))
        at += sz
    }
    out
}

// md5s from an ffmpeg framemd5 file.
fn framemd5(_ path: String) -> [String] {
    var out: [String] = []
    for line in (readFile(path) ?? "").lines() {
        if line.hasPrefix("#") {
            continue
        }
        let parts = line.split(",")
        if parts.count >= 6 {
            out.append(parts[5].trim())
        }
    }
    out
}

// md5s from a libvpx .md5 file ("<md5>  <name>").
fn vpxMd5(_ path: String) -> [String] {
    var out: [String] = []
    for line in (readFile(path) ?? "").lines() {
        let parts = line.trim().split(" ")
        if parts.count >= 1 && parts[0].count == 32 {
            out.append(parts[0])
        }
    }
    out
}

// The md5 of a picture as libvpx/ffmpeg hash it. 4:4:0 streams come out
// as 4:4:4 with every chroma row twice; hash their own rows.
fn md5Of(_ p: core.Picture, _ is440: Bool) -> String {
    if !is440 {
        return testkit.pictureMd5(p)
    }
    var b: [Int] = []
    let wide = p.depth > 8
    let ch = (p.height + 1) / 2
    for pl in 0..3 {
        let n = if pl == 0 { p.height } else { ch }
        for y in 0..n {
            for x in 0..p.width {
                var s = 0
                if pl == 0 {
                    s = p.y[p.yOffset + y * p.yStride + x]
                } else if pl == 1 {
                    s = p.u[p.cOffset + 2 * y * p.cStride + x]
                } else {
                    s = p.v[p.cOffset + 2 * y * p.cStride + x]
                }
                if wide {
                    b.append(s & 255)
                    b.append(s >> 8)
                } else {
                    b.append(s)
                }
            }
        }
    }
    Data(bytes: b).hash("md5").hex
}

// What a clip used, from its frame headers.
struct Seen {
    pictures: Int = 0
    mismatches: Int = 0
    firstBad: Int = -1
    frames: Int = 0
    superframes: Int = 0
    hidden: Int = 0
    maxTileColsLog2: Int = 0
    maxTileRowsLog2: Int = 0
    compound: Bool = false
    lossless: Bool = false
    errorRes: Bool = false
    sizes: Int = 0
    depth: Int = 0
    warnings: Int = 0
}

// Decodes packets through the two stages, comparing each picture's md5.
fn decodeAll(_ packets: [Data], _ want: [String], _ is440: Bool) -> Seen {
    var s = Seen()
    var pl = vp9.newPipeline(core.Track(index: 0, kind: .video, codec: "vp9")).value() ?? vp9.Pipeline()
    var lastW = 0
    for (i, pk) in packets.enumerated() {
        let step = vp9.parseStep(pl.parser, pk, pts: i, dts: i, key: false)
        pl.parser = step.parser
        if step.frames.count > 1 {
            s.superframes += 1
        }
        for f in step.frames {
            s.frames += 1
            let h = f.hdr
            if f.kind == 0 && !h.show {
                s.hidden += 1
            }
            s.maxTileColsLog2 = max(s.maxTileColsLog2, h.tileColsLog2)
            s.maxTileRowsLog2 = max(s.maxTileRowsLog2, h.tileRowsLog2)
            if h.compPredMode != 0 {
                s.compound = true
            }
            if h.lossless && f.kind == 0 {
                s.lossless = true
            }
            if h.errorRes {
                s.errorRes = true
            }
            if f.kind == 0 && h.width != lastW {
                s.sizes += 1
                lastW = h.width
            }
            if f.kind == 0 {
                s.depth = h.bitDepth
            }
        }
        let rs = vp9.reconstructStep(pl.reconstructor, step.frames)
        pl.reconstructor = rs.reconstructor
        for p in rs.pictures {
            let got = md5Of(p, is440)
            if s.pictures >= want.count || got != want[s.pictures] {
                s.mismatches += 1
                if s.firstBad < 0 {
                    s.firstBad = s.pictures
                }
            }
            s.pictures += 1
        }
    }
    s.warnings = pl.parser.warnings.count + pl.reconstructor.warnings.count
    s
}

let conformanceSet: [String] = [
    "vp90-2-00-quantizer-00", "vp90-2-00-quantizer-17", "vp90-2-00-quantizer-38", "vp90-2-00-quantizer-63",
    "vp90-2-01-sharpness-1", "vp90-2-01-sharpness-4", "vp90-2-01-sharpness-7",
    "vp90-2-02-size-08x08", "vp90-2-02-size-10x16", "vp90-2-02-size-18x34", "vp90-2-02-size-34x66",
    "vp90-2-02-size-66x66", "vp90-2-02-size-130x132", "vp90-2-02-size-178x180",
    "vp90-2-03-size-196x226", "vp90-2-03-size-202x210", "vp90-2-03-size-226x198", "vp90-2-03-deltaq",
    "vp90-2-05-resize", "vp90-2-06-bilinear", "vp90-2-07-frame_parallel",
    "vp90-2-08-tile_1x2", "vp90-2-08-tile_1x4_frame_parallel", "vp90-2-08-tile-4x4", "vp90-2-08-tile-4x1",
    "vp90-2-09-aq2", "vp90-2-09-lf_deltas", "vp90-2-09-subpixel-00",
    "vp90-2-10-show-existing-frame", "vp90-2-10-show-existing-frame2",
    "vp90-2-11-size-351x287", "vp90-2-11-size-352x287",
    "vp90-2-12-droppable_1", "vp90-2-13-largescaling",
    "vp90-2-14-resize-fp-tiles-1-2", "vp90-2-14-resize-fp-tiles-16-8", "vp90-2-14-resize-10frames-fp-tiles-8-4-2-1",
    "vp90-2-15-segkey", "vp90-2-15-segkey_adpq", "vp90-2-16-intra-only", "vp90-2-17-show-existing-frame",
    "vp90-2-18-resize", "vp90-2-19-skip", "vp90-2-19-skip-01", "vp90-2-19-skip-02",
    "vp90-2-20-big_superframe-01", "vp90-2-20-big_superframe-02",
    "vp90-2-21-resize_inter_320x180_5_1-2", "vp90-2-21-resize_inter_640x360_7_3-4",
    "vp90-2-22-svc_1280x720_3",
    "vp91-2-04-yuv422", "vp91-2-04-yuv440", "vp91-2-04-yuv444",
    "vp92-2-20-10bit-yuv420", "vp92-2-20-12bit-yuv420",
    "vp93-2-20-10bit-yuv422", "vp93-2-20-10bit-yuv440", "vp93-2-20-12bit-yuv444",
]

fn main() {
    var t = T()

    // ---- the shared WebM fixture (Matroska block headers skipped) ----
    let ref = testkit.loadRef("vp9.webm")
    let file = testkit.fixture("vp9.webm")
    let media = testkit.mediaFromRef(file, ref)
    let want = testkit.frameMd5s("vp9.webm")
    var webmPackets: [Data] = []
    var vtrack = -1
    for tr in media.tracks {
        if tr.codec == "vp9" {
            vtrack = tr.index
        }
    }
    t.check(vtrack >= 0, "vp9.webm has a vp9 track")
    for pk in media.packets {
        if pk.track != vtrack {
            continue
        }
        // ffprobe's pos is the Block start: track number (1 byte here),
        // 2-byte timecode, flags; the frame follows and is pk.size long.
        webmPackets.append(file.slice(from: pk.offset + 4, to: pk.offset + 4 + pk.size))
    }
    let ws = decodeAll(webmPackets, want, false)
    t.check(ws.pictures == want.count && ws.mismatches == 0, "vp9.webm: {ws.pictures} pictures, {ws.mismatches} md5 mismatches (first {ws.firstBad}) of {want.count}")
    if vtrack >= 0 {
        let tr = media.tracks[vtrack]
        let info = vp9.streamInfo(tr)
        t.check(info.hasPrefix("VP9") && info.contains("320×240"), "streamInfo: \"{info}\"")
        var mk = core.Track(index: 0, kind: .video, codec: "vp9")
        mk.width = 1920
        mk.height = 1080
        mk.extra = Data(bytes: [1, 1, 2, 2, 1, 40, 3, 1, 10, 4, 1, 1])
        let mi = vp9.streamInfo(mk)
        t.check(mi == "VP9 Profile 2, 1920×1080, 10-bit", "streamInfo with Matroska CodecPrivate: \"{mi}\"")
        mk.extra = Data(bytes: [1, 0, 0, 0, 1, 31, 0x86, 1, 1, 1, 0, 0])
        let vi = vp9.streamInfo(mk)
        t.check(vi == "VP9 Profile 1, 1920×1080, 8-bit 4:4:4", "streamInfo with vpcC: \"{vi}\"")
        let fi = vp9.frameInfo(webmPackets[0])
        t.check(fi == "VP9 Profile 0, 320×240, 8-bit", "frameInfo: \"{fi}\"")
        // The ordinary Decoder gives the same pictures.
        var d = vp9.newDecoder(tr).value() ?? vp9.Decoder()
        var same = 0
        var n = 0
        for (i, pk) in webmPackets.enumerated() {
            for p in d.decode(pk, pts: i * 40, dts: i * 40, key: i == 0) {
                if n < want.count && testkit.pictureMd5(p) == want[n] && p.pts == i * 40 {
                    same += 1
                }
                if n == 0 {
                    t.check(p.key && p.depth == 8 && p.chroma == .yuv420 && p.width == 320 && p.height == 240, "first picture: key, 8-bit 4:2:0 320×240")
                    t.check(p.matrix == .bt601 || p.matrix == .bt709, "matrix set")
                }
                n += 1
            }
        }
        t.check(same == want.count, "Decoder: {same} of {want.count} pictures right with their pts")
        // Reset (a seek back to the start, then to the middle with no
        // keyframe: nothing until a keyframe comes).
        d.reset()
        var afterReset = 0
        for (i, pk) in webmPackets.enumerated() {
            if i < 10 {
                continue
            }
            afterReset += d.decode(pk, pts: i, dts: i, key: false).count
        }
        t.check(afterReset == 0, "after reset nothing is shown before a keyframe ({afterReset})")
        d.reset()
        var again = 0
        for (i, pk) in webmPackets.enumerated() {
            for p in d.decode(pk, pts: i, dts: i, key: i == 0) {
                if again < want.count && testkit.pictureMd5(p) == want[again] {
                    again += 1
                }
            }
        }
        t.check(again == want.count, "after reset, decoding from the keyframe: {again} of {want.count} right")
    }

    // ---- the clips made by tests/vp9/fixtures/make.sh ----
    let fx = "tests/vp9/fixtures"
    let clips = ["vp9_8bit", "vp9_10bit", "vp9_12bit", "vp9_444", "vp9_422_10bit", "vp9_tiles", "vp9_rowmt",
                 "vp9_altref", "vp9_lossless", "vp9_odd", "vp9_errres", "vp9_compound", "vp9_sizes"]
    for name in clips {
        let path = joinPath(fx, name + ".ivf")
        if !fileExists(path) {
            t.check(false, "{name}.ivf is missing: run tests/vp9/fixtures/make.sh")
            continue
        }
        let ivf = readIvf(path)
        let w = framemd5(path + ".framemd5")
        let s = decodeAll(ivf.packets, w, false)
        t.check(s.pictures == w.count && s.mismatches == 0 && w.count > 0, "{name}: {s.pictures} pictures, {s.mismatches} md5 mismatches (first {s.firstBad}) of {w.count}")
        if name == "vp9_10bit" || name == "vp9_422_10bit" {
            t.check(s.depth == 10, "{name} is 10-bit ({s.depth})")
        }
        if name == "vp9_12bit" {
            t.check(s.depth == 12, "{name} is 12-bit ({s.depth})")
        }
        if name == "vp9_tiles" {
            // (ffmpeg's libvpx-vp9 ignores -tile-rows; tile rows are in the
            // test vectors vp90-2-08-tile-4x4 and tile-4x1.)
            t.check(s.maxTileColsLog2 == 2, "{name} has 4 tile columns ({s.maxTileColsLog2})")
        }
        if name == "vp9_altref" {
            t.check(s.superframes > 0 && s.hidden > 0, "{name} has superframes with hidden frames ({s.superframes}, {s.hidden})")
        }
        if name == "vp9_compound" {
            t.check(s.compound, "{name} uses compound prediction")
        }
        if name == "vp9_lossless" {
            t.check(s.lossless, "{name} is lossless")
        }
        if name == "vp9_errres" {
            t.check(s.errorRes, "{name} is error resilient")
        }
        if name == "vp9_sizes" {
            t.check(s.sizes == 2, "{name} changes size ({s.sizes} sizes)")
        }
    }

    // ---- damage never stops the program ----
    let base = readIvf(joinPath(fx, "vp9_altref.ivf"))
    if base.packets.count > 10 {
        var d = vp9.Decoder()
        var shown = 0
        var seed = 12345
        for (i, pk) in base.packets.enumerated() {
            var bytes = pk.bytes
            if i % 3 == 1 {
                // Flip bytes after the first few.
                for _ in 0..8 {
                    seed = (seed * 1103515245 + 12345) & 0x7fffffff
                    let at = 3 + seed % max(1, bytes.count - 3)
                    if at < bytes.count {
                        bytes[at] = (bytes[at] ^ (seed >> 8)) & 255
                    }
                }
            }
            if i % 7 == 3 {
                bytes = bytes.prefix(bytes.count / 3)
            }
            if i % 11 == 5 {
                bytes = []
            }
            shown += d.decode(Data(bytes: bytes), pts: i, dts: i, key: false).count
        }
        t.check(shown > 0 && !d.warnings.isEmpty, "damaged packets: decoding went on ({shown} pictures, {d.warnings.count} warnings)")
        // Random garbage of every size.
        var g = vp9.Decoder()
        for n in 0..300 {
            var b: [Int] = []
            for _ in 0..(n * 7 % 400) {
                seed = (seed * 1103515245 + 12345) & 0x7fffffff
                b.append((seed >> 7) & 255)
            }
            if n % 5 == 0 && b.count > 0 {
                b[0] = 0x82
            }
            g.decode(Data(bytes: b), pts: n, dts: n, key: false)
        }
        t.check(true, "random packets: no crash")
        // A truncated keyframe, then the rest: concealed, no crash.
        var k = vp9.Decoder()
        var kp = 0
        for (i, pk) in base.packets.enumerated() {
            let b = if i == 0 { pk.slice(from: 0, to: pk.count / 2) } else { pk }
            kp += k.decode(b, pts: i, dts: i, key: i == 0).count
        }
        t.check(true, "truncated keyframe: {kp} pictures, no crash")
    }

    // ---- skipNonReference: frames with refresh_frame_flags 0 aren't shown ----
    let drop = "build/conformance/vp9/ivf/vp90-2-12-droppable_1.ivf"
    if fileExists(drop) {
        let ivf = readIvf(drop)
        var d = vp9.Decoder()
        d.skipNonReference = true
        var full = vp9.Decoder()
        var a = 0
        var b = 0
        var sameRef = true
        for (i, pk) in ivf.packets.enumerated() {
            let pa = d.decode(pk, pts: i, dts: i, key: false)
            let pb = full.decode(pk, pts: i, dts: i, key: false)
            a += pa.count
            b += pb.count
            if pa.count == 1 && pb.count == 1 && testkit.pictureMd5(pa[0]) != testkit.pictureMd5(pb[0]) {
                sameRef = false
            }
        }
        t.check(a < b && sameRef, "skipNonReference: {a} of {b} pictures, the rest unchanged")
    }

    // ---- libvpx test vectors ----
    let conf = "build/conformance/vp9/ivf"
    if !fileExists(conf) {
        print("note: {conf} not found (tests/vp9/fixtures/conformance.sh); test vectors skipped")
    } else {
        let all = environment("VP9_CONFORMANCE") ?? "" == "all"
        var names: [String] = []
        if all {
            for n in listFolder(conf) ?? [] {
                if n.hasSuffix(".ivf") {
                    names.append(n.substring(from: 0, to: n.count - 4))
                }
            }
        } else {
            names = conformanceSet
        }
        var ok = 0
        let tc = now()
        for n in names {
            var md5 = joinPath("build/conformance/vp9", n + ".webm.md5")
            if !fileExists(md5) {
                md5 = joinPath("build/conformance/vp9", n + ".ivf.md5")
            }
            let w = vpxMd5(md5)
            let ivf = readIvf(joinPath(conf, n + ".ivf"))
            let s = decodeAll(ivf.packets, w, n.contains("440"))
            let good = s.pictures == w.count && s.mismatches == 0 && w.count > 0
            if good {
                ok += 1
            }
            t.check(good, "test vector {n}: {s.pictures} pictures, {s.mismatches} mismatches (first {s.firstBad}) of {w.count}")
        }
        print("test vectors: {ok} of {names.count} bit-exact")
        print("time vp9 test vectors: {Int((now() - tc) * 1000.0)} ms")
    }

    // ---- timings ----
    let clipDir = "build/scratch/vp9/clips"
    for (name, what) in [("t720", "720p 8-bit"), ("t1080", "1080p 8-bit"), ("t720_10", "720p 10-bit"), ("t1080_10", "1080p 10-bit")] {
        let path = joinPath(clipDir, name + ".ivf")
        if !fileExists(path) {
            print("note: {path} not found (tests/vp9/fixtures/make.sh); timing skipped")
            continue
        }
        let ivf = readIvf(path)
        let w = framemd5(joinPath(clipDir, name + ".framemd5"))
        var pl = vp9.newPipeline(core.Track(index: 0, kind: .video, codec: "vp9")).value() ?? vp9.Pipeline()
        var tp = 0.0
        var tr = 0.0
        var n = 0
        var bad = 0
        for (i, pk) in ivf.packets.enumerated() {
            let t0 = now()
            let fs = pl.parser.parse(pk, pts: i, dts: i, key: false)
            let t1 = now()
            var pics: [core.Picture] = []
            for f in fs {
                pics += pl.reconstructor.reconstruct(f)
            }
            tp += t1 - t0
            tr += now() - t1
            if !pics.isEmpty {
                if n >= w.count || testkit.pictureMd5(pics[pics.count - 1]) != w[n] {
                    bad += 1
                }
                n += 1
            }
        }
        t.check(bad == 0 && n == w.count, "{name}: {n} pictures, {bad} md5 mismatches")
        let pn = Float(max(n, 1))
        print("time vp9 {what} parse: {(tp * 1000.0 / pn).formatted(decimals: 1)} ms per picture")
        print("time vp9 {what} reconstruct: {(tr * 1000.0 / pn).formatted(decimals: 1)} ms per picture")
    }

    print("vp9: {t.passed} of {t.total} passed")
}
