// Tests for the player engine: opening, video frames, sound chunks,
// seeking and speed, on the shared fixtures.
//
// Author: Alexius Academia
// Date: 2026-10-25

import "../../core"
import "../../play"
import "../../testkit"
import "../../av1"
import "../../net"

async fn main() {
    var passed = 0
    var total = 0
    fn check(_ ok: Bool, _ what: String) {
        total += 1
        if ok { passed += 1 } else { print("FAIL: {what}") }
    }
    let folder = "build/scratch/play"
    createFolder(folder)

    // Opening and choosing tracks.
    match play.openSource(testkit.fixturePath("mpeg2.mpg")) {
        .ok(src) -> {
            check(src.video >= 0 && src.audio >= 0, "mpeg2.mpg tracks {src.video} {src.audio}")
            // Video: all 50 frames, in time order, scaled into a box.
            match play.newVideoPump(src.media, track: src.video) {
                .ok(p0) -> {
                    var pump = p0
                    pump.boxW = 160
                    pump.boxH = 160
                    var frames: [play.VideoFrame] = []
                    var rounds = 0
                    while !pump.done && rounds < 100 {
                        frames.appendAll(pump.run(src.file, src.media, count: 8))
                        rounds += 1
                    }
                    check(frames.count == 50, "mpeg2 frames {frames.count}")
                    check(frames.count > 0 && frames[0].width == 160 && frames[0].height == 120 && frames[0].pixels.count == 160 * 120, "fitted size")
                    var ordered = true
                    for i in 1..frames.count {
                        if frames[i].time <= frames[i - 1].time { ordered = false }
                    }
                    check(ordered, "frames in time order")
                    print("time mpeg2 320x240 decode+convert: {Int(pump.decodeMs + pump.convertMs)} ms for {pump.pictures} pictures")
                    // Exact seek: the first frame after seeking to 1.0 s is at 1.0 s.
                    pump.seek(src.media, to: 1.0)
                    let after = pump.run(src.file, src.media, count: 3)
                    check(after.count == 3 && abs(after[0].time - 1.0) < 0.021, "seek to 1.0")
                }
                .failure(e) -> check(false, "video pump: {e.message}")
            }
            // Sound: chunks that add up to the track's length.
            match play.newAudioPump(src.media, track: src.audio, folder: folder) {
                .ok(a0) -> {
                    var pump = a0
                    var chunks: [play.AudioChunk] = []
                    var guardCount = 0
                    while guardCount < 20 {
                        guardCount += 1
                        if let c = pump.chunk(src.file, src.media) {
                            chunks.append(c)
                            if c.last { break }
                        } else {
                            break
                        }
                    }
                    var sum = 0.0
                    for c in chunks { sum += c.length }
                    check(chunks.count >= 2 && abs(sum - 2.0) < 0.1, "mp2 chunks add to {sum} s in {chunks.count}")
                    check(chunks.count >= 2 && abs(chunks[1].start - chunks[0].start - chunks[0].length) < 0.001, "chunks follow on: {chunks[0].start} {chunks[1].start} {chunks[0].length}")
                    check(fileExists(chunks[0].path) && (fileSize(chunks[0].path) ?? 0) > 44 + 48000 * 4, "chunk written with overlap")
                }
                .failure(e) -> check(false, "audio pump: {e.message}")
            }
        }
        .failure(e) -> check(false, "open mpeg2.mpg: {e.message}")
    }

    // AV1 in stages with film grain left to the converter's step: the same
    // pictures as ffmpeg (libdav1d) once the grain is added.
    for name in ["av1_grain.ivf", "av1_grain10.ivf", "aom_grain444.ivf"] {
        let path = "tests/av1/fixtures/" + name
        match play.openSource(path) {
            .ok(src) -> {
                match play.newStages(src.media, track: src.video) {
                    .ok(st0) -> {
                        var st = st0
                        var got: [String] = []
                        var grained = 0
                        while !st.parser.done {
                            let batch = st.parser.run(src.file, src.media, count: 3)
                            let r = play.reconstructStage(st.luma, batch)
                            st.luma = r.rec
                            for (i, pic) in r.pictures.enumerated() {
                                var out = pic
                                if i < r.grains.count && r.grains[i].apply {
                                    out = av1.applyFilmGrain(pic, r.grains[i])
                                    grained += 1
                                }
                                got.append(testkit.pictureMd5(out))
                            }
                        }
                        let want = readFile(path + ".framemd5") ?? ""
                        var wantMd5s: [String] = []
                        for line in want.lines() {
                            let parts = line.split(",")
                            if !line.hasPrefix("#") && parts.count >= 6 {
                                wantMd5s.append(parts[5].trim())
                            }
                        }
                        check(grained > 0 && got == wantMd5s, "{name}: staged with deferred grain, {got.count} pictures ({grained} grained) vs {wantMd5s.count}")
                    }
                    .failure(e) -> check(false, "stages {name}: {e.message}")
                }
            }
            .failure(e) -> check(false, "open {name}: {e.message}")
        }
    }

    // Thumbnails of the keyframe before a time, for any codec.
    for name in ["h264_main_bframes.mp4", "hevc.mp4", "vp9.webm", "av1.mkv", "mpeg2.mpg"] {
        match play.openSource(testkit.fixturePath(name)) {
            .ok(src) -> {
                if src.video < 0 {
                    check(false, "{name}: no video")
                } else {
                    let t0 = now()
                    let th = play.thumbnailAt(src.file, src.media, track: src.video, seconds: 1.0, width: 160)
                    let ms = Int((now() - t0) * 1000.0)
                    if let tb = th {
                        check(tb.width == 160 && tb.height > 0 && tb.pixels.count == 160 * tb.height && tb.time <= 1.05, "{name}: thumbnail {tb.width}×{tb.height} at {tb.time}")
                        print("time thumbnail {name}: {ms} ms")
                    } else {
                        check(false, "{name}: no thumbnail")
                    }
                }
            }
            .failure(e) -> check(false, "open {name}: {e.message}")
        }
    }

    // Scene scan over keyframes: a clip of two sources joined at 3 s.
    match play.openSource("tests/play/fixtures/cut.mp4") {
        .ok(src) -> {
            var scan = play.newSceneScan(src.media, track: src.video)
            while !scan.done {
                scan.step(src.file, src.media, count: 2)
            }
            check(scan.keys.count == 6, "cut.mp4: {scan.keys.count} keyframes")
            check(scan.cuts.count == 2 && abs(scan.cuts[1] - 3.0) < 0.05, "cut.mp4: cuts {scan.cuts}")
            check(scan.scenes.count == scan.cuts.count && scan.scenes[0].pixels.count > 0, "cut.mp4: scene thumbnails")
            let ch = scan.chapters(duration: src.media.duration)
            check(ch.count == 2, "cut.mp4: {ch.count} scene chapters")
        }
        .failure(e) -> check(false, "open cut.mp4: {e.message}")
    }

    // A network stream (HLS over file://): segments arrive while the
    // pumps decode; running out of packets waits instead of ending.
    let url = net.asUrl(currentFolder() + "/tests/net/fixtures/hls_ts/master.m3u8")
    match await net.openSession(url) {
        .ok(s0) -> {
            var s = s0
            // The first segment, then start.
            while s.buffer.media.packets.isEmpty {
                if let f = s.nextFetch(now: now()) {
                    let r = await net.fetch(f)
                    s.deliver(f, r, now: now())
                } else {
                    break
                }
            }
            let media0 = s.buffer.media
            let v = play.pickTrack(media0, .video, playable: { c in play.canDecodeVideo(c) })
            let a = play.pickTrack(media0, .audio, playable: { c in play.canDecodeAudio(c) })
            check(v >= 0 && a >= 0, "stream tracks {v} {a}")
            match play.newStages(media0, track: v) {
                .ok(st0) -> {
                    var st = st0
                    var pictures = 0
                    var waits = 0
                    var guard = 0
                    while !st.parser.done && guard < 200 {
                        guard += 1
                        st.parser.growing = !s.buffer.ended
                        let batch = st.parser.run(s.buffer.file, s.buffer.media, count: 3)
                        let luma = st.luma.run(batch)
                        let pics = if st.split { play.mergeStages(media0.tracks[v].codec, luma, st.chroma.run(batch)) } else { luma }
                        pictures += pics.count
                        if pics.isEmpty && !st.parser.done {
                            waits += 1
                            // Out of packets: the next segment.
                            if let f = s.nextFetch(now: now()) {
                                let r = await net.fetch(f)
                                s.deliver(f, r, now: now())
                            }
                        }
                    }
                    check(pictures == 150 && waits >= 2, "stream: {pictures} pictures of 150, waited {waits} times")
                }
                .failure(e) -> check(false, "stream stages: {e.message}")
            }
            match play.newAudioPump(s.buffer.media, track: a, folder: "build/scratch/play") {
                .ok(ap0) -> {
                    var ap = ap0
                    ap.growing = !s.buffer.ended
                    var secs = 0.0
                    var n = 0
                    while n < 20 {
                        n += 1
                        if let c = ap.chunk(s.buffer.file, s.buffer.media, seconds: 1.0) {
                            secs += c.length
                            if c.last {
                                break
                            }
                        } else if ap.starved {
                            check(false, "audio starved after the whole stream loaded")
                            break
                        } else {
                            break
                        }
                    }
                    check(abs(secs - 6.0) < 0.1, "stream audio: {secs} s of 6")
                }
                .failure(e) -> check(false, "stream audio: {e.message}")
            }
        }
        .failure(e) -> check(false, "open stream: {e.message}")
    }

    print("play: {passed} of {total} passed")
}
