// Tests for the wma module: decodes WMA 1/2 clips made by
// tests/wma/make_fixtures.sh and the downloaded samples in
// build/conformance/wma/ (WMA 2 from Microsoft's encoders, WMA 9 Pro up to
// 7.1 and 24-bit, WMA 9 Lossless) through demux/asf.tsl, and compares the
// samples with ffmpeg's (F.a.f32) by SNR after finding the best alignment;
// WMA Lossless also bit for bit against ffmpeg's 32-bit output (F.a.s32).
// Prints × real time for WMA 2 stereo and WMA Pro 5.1.
//
// Author: Alexius Academia
// Date: 2026-10-25

import "../../wma"
import "../../demux"
import "../../core"
import "../../testkit"

struct Tally {
    passed: Int = 0
    total: Int = 0

    fn check(_ ok: Bool, _ what: String) {
        total += 1
        if ok {
            passed += 1
        } else {
            print("FAIL: {what}")
        }
    }
}

struct Decoded {
    samples: [Float] = []
    rate: Int = 0
    channels: Int = 0
    layout: [String] = []
    codec: String = ""
    ms: Float = 0.0
    error: String = ""
    warnings: [String] = []
    packets: Int = 0
}

// Decodes the first audio track of an ASF file, flush included.
fn decodeFile(_ path: String, change: Int = 0) -> Decoded {
    var out = Decoded()
    let file = readData(path) ?? Data()
    var media = core.Media()
    match demux.open(file, name: path.fileName) {
        .ok(m) -> {
            media = m
        }
        .failure(e) -> {
            out.error = e.message
            return out
        }
    }
    var track = -1
    for t in media.tracks {
        if t.kind == .audio && track < 0 {
            track = t.index
        }
    }
    if track < 0 {
        out.error = "no audio track"
        return out
    }
    out.codec = media.tracks[track].codec
    match wma.newDecoder(media.tracks[track]) {
        .failure(e) -> {
            out.error = e.message
            return out
        }
        .ok(d) -> {
            var dec = d
            var packets: [Data] = []
            for p in media.packets {
                if p.track == track {
                    packets.append(core.packetBytes(file, media, p))
                }
            }
            let started = now()
            for (i, b) in packets.enumerated() {
                var bytes = b
                if change == 1 {
                    bytes = damage(bytes, seed: i * 7919 + 17, every: 40)
                } else if change == 2 {
                    bytes = bytes.slice(from: 0, to: bytes.count / 2)
                } else if change == 3 && i == packets.count / 2 {
                    dec.reset()
                }
                let s = dec.decode(bytes, pts: 0)
                out.samples += s.data
                out.packets += 1
            }
            out.samples += dec.flush().data
            out.ms = (now() - started) * 1000.0
            // Drop the priming frames the decoder says to, as the player will.
            let drop = min(dec.delay * dec.channels, out.samples.count)
            out.samples = out.samples.slice(from: drop, to: out.samples.count)
            out.rate = dec.rate
            out.channels = dec.channels
            out.layout = dec.layout
            out.warnings = dec.warnings
        }
    }
    out
}

// Flips pseudo-random bytes of a packet (about one in `every`).
fn damage(_ d: Data, seed: Int, every: Int) -> Data {
    var b = d.bytes
    var rnd = seed
    for i in 0..b.count {
        rnd = (rnd * 1103515245 + 12345) & 0x7fffffff
        if rnd % every == 0 {
            b[i] = (b[i] ^ (rnd >> 8)) & 0xff
        }
    }
    Data(bytes: b)
}

fn readF32(_ path: String) -> [Float] {
    let data = readData(path) ?? Data()
    var out: [Float] = []
    var i = 0
    while i + 4 <= data.count {
        out.append(data.float32(at: i))
        i += 4
    }
    out
}

fn readS32(_ path: String) -> [Int] {
    let data = readData(path) ?? Data()
    var out: [Int] = []
    var i = 0
    while i + 4 <= data.count {
        out.append(data.int32(at: i))
        i += 4
    }
    out
}

// The offset (in frames, reference minus ours) where our samples line up
// best with the reference, searched within ±range frames on the loudest
// 2048-frame window; ties go to the smaller offset.
fn bestOffset(_ got: [Float], _ want: [Float], channels: Int, range: Int) -> Int {
    let frames = got.count / channels
    let wantFrames = want.count / channels
    let win = min(2048, max(frames / 2, 64))
    var mid = 0
    var loudest = -1.0
    var at = 0
    while at + win <= frames {
        var e = 0.0
        var i = at * channels
        while i < (at + win) * channels {
            e += got[i] * got[i]
            i += 7
        }
        if e > loudest {
            loudest = e
            mid = at
        }
        at += win / 2
    }
    var best = 0
    var bestErr = -1.0
    for off in (-range)..(range + 1) {
        let r0 = mid + off
        if r0 < 0 || r0 + win > wantFrames {
            continue
        }
        var err = 0.0
        var i = 0
        let a = mid * channels
        let b = r0 * channels
        let n = win * channels
        while i < n {
            let d = got[a + i] - want[b + i]
            err += d * d
            i += 1
        }
        if bestErr < 0.0 || err < bestErr || (err == bestErr && abs(off) < abs(best)) {
            bestErr = err
            best = off
        }
    }
    best
}

fn alignedSnr(_ got: [Float], _ want: [Float], channels: Int, offset: Int) -> Float {
    if offset >= 0 {
        return testkit.snr(got, want, offset: offset * channels)
    }
    testkit.snr(got.slice(from: -offset * channels, to: got.count), want)
}

struct Case {
    path: String
    ref: String
    // Lowest SNR accepted, in dB.
    minSnr: Float = 90.0
    // The bit-exact reference (lossless), or "".
    s32: String = ""
    // Print × real time with this label.
    speed: String = ""
}

fn checkCase(_ c: Case, _ t: bind Tally) {
    let name = c.path.fileName
    let want = readF32(c.ref)
    if want.isEmpty {
        return
    }
    let d = decodeFile(c.path)
    if !d.error.isEmpty {
        t.check(false, "{name}: {d.error}")
        return
    }
    t.check(d.channels > 0 && !d.samples.isEmpty, "{name}: decoded something ({d.samples.count} samples, {d.warnings.count} warnings {d.warnings})")
    if d.channels <= 0 || d.samples.isEmpty {
        return
    }
    let off = bestOffset(d.samples, want, channels: d.channels, range: 4096)
    let s = alignedSnr(d.samples, want, channels: d.channels, offset: off)
    let frames = d.samples.count / d.channels
    let wantFrames = want.count / d.channels
    print("{name}: {d.codec} {d.rate} Hz {d.channels} ch, SNR {s.formatted(decimals: 1)} dB at offset {off}, {frames} frames (ffmpeg {wantFrames})")
    t.check(s >= c.minSnr, "{name}: SNR {s.formatted(decimals: 1)} dB < {c.minSnr}")
    // (A file cut short ends in a partial block, which is skipped.)
    let real = d.warnings.filter { w in !w.contains("shorter than a block") }
    t.check(real.isEmpty, "{name}: warnings {d.warnings}")
    if !c.s32.isEmpty {
        let ints = readS32(c.s32)
        var same = 0
        var n = 0
        var first = -1
        var i = 0
        let shift = off * d.channels
        while i < d.samples.count && i + shift < ints.count {
            if i + shift >= 0 {
                let mine = Int(round(d.samples[i] * 2147483648.0))
                if mine == ints[i + shift] {
                    same += 1
                } else if first < 0 {
                    first = i
                }
                n += 1
            }
            i += 1
        }
        t.check(same == n && n > 0, "{name}: bit-exact {same} of {n} samples (first difference at {first})")
    }
    if !c.speed.isEmpty && d.ms > 0.0 {
        let seconds = Float(frames) / Float(max(d.rate, 1))
        print("time {c.speed}: {Int(d.ms)} ms for {seconds.formatted(decimals: 2)} s ({(seconds * 1000.0 / d.ms).formatted(decimals: 0)}× real time)")
    }
}

// Whether the file's first audio track is one this module decodes.
fn isWma(_ path: String) -> Bool {
    let file = readData(path) ?? Data()
    match demux.open(file, name: path.fileName) {
        .ok(m) -> {
            for t in m.tracks {
                if t.kind == .audio {
                    return t.codec == "wmav1" || t.codec == "wmav2" || t.codec == "wmapro" || t.codec == "wmalossless"
                }
            }
            false
        }
        .failure(_) -> false
    }
}

fn main() {
    var t = Tally()
    let fx = "tests/wma/fixtures/"
    var cases: [Case] = []
    for name in listFolder(fx) ?? [] {
        if name.hasSuffix(".wma") {
            cases.append(Case(path: fx + name, ref: fx + name + ".a.f32"))
        }
    }
    let conf = "build/conformance/wma/"
    let refs = "build/scratch/wma/refs/"
    for name in listFolder(conf) ?? [] {
        if !(name.hasSuffix(".wma") || name.hasSuffix(".wmv") || name.hasSuffix(".asf")) {
            continue
        }
        if !fileExists(refs + name + ".a.f32") {
            continue
        }
        let s32 = if fileExists(refs + name + ".a.s32") { refs + name + ".a.s32" } else { "" }
        var c = Case(path: conf + name, ref: refs + name + ".a.f32", s32: s32)
        if name == "asf_with_chapters_cut.wmv" {
            c.speed = "wmav2 stereo"
        }
        if name == "wmv-surroundtest_720p.wmv" {
            c.speed = "wmapro 5.1"
        }
        if name == "luckynight-partial.wma" {
            c.speed = "wmalossless stereo"
        }
        cases.append(c)
    }
    for c in cases {
        if isWma(c.path) {
            checkCase(c, t)
        }
    }
    // Damaged packets never stop the decoders.
    var damaged = [fx + "v2_music_48k.wma", fx + "v1_music_64k.wma"]
    for name in ["Beethovens_9th-1_small.wma", "master_audio_2.0_24bit.wma"] {
        if fileExists(conf + name) {
            damaged.append(conf + name)
        }
    }
    for path in damaged {
        for change in 1..4 {
            let d = decodeFile(path, change: change)
            var finite = true
            for v in d.samples {
                if !v.isFinite || abs(v) > 64.0 {
                    finite = false
                }
            }
            t.check(d.error.isEmpty && finite && d.packets > 0, "{path.fileName} damaged input {change}: decodes on ({d.error}, finite and in range: {finite}, {d.packets} packets)")
        }
    }
    t.check(wma.vlcSelfTest() == 0, "Huffman tables decode every code back")
    t.check(wma.streamInfo(core.Track(index: 0, kind: .audio, codec: "wmav2", bitrate: 128000, sampleRate: 44100, channels: 2)) == "WMA 2, 44.1 kHz, stereo, 128 kb/s", "streamInfo")
    print("wma: {t.passed} of {t.total} passed")
}
