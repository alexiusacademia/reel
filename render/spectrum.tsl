// The audio visualiser's spectrum for the render module: the levels of
// log-spaced frequency bands of the most recent sound.
//
// The last N frames (N a power of two up to 2048) are mixed to mono,
// Hann-windowed and transformed by an iterative radix-2 FFT (Cooley–Tukey,
// decimation in time with bit-reversed input order). A band's level is the
// strongest bin in it, in dB relative to a full-scale sine (whose Hann-
// windowed peak bin is N/4), mapped from −70…0 dB onto 0…1. Bands run
// from 20 Hz (or the first bin) to the Nyquist frequency, each the same
// ratio wide.
//
// Author: Alexius Academia
// Date: 2026-10-25

import "../core"

// The lowest level shown, in dB below full scale.
let levelFloorDb = 70.0

// In-place FFT of re/im (count a power of two).
public fn fft(_ re: bind [Float], _ im: bind [Float]) {
    let n = re.count
    if n < 2 {
        return
    }
    // Bit-reversed order.
    var j = 0
    for i in 1..n {
        var bit = n >> 1
        while (j & bit) != 0 {
            j = j ^ bit
            bit = bit >> 1
        }
        j = j | bit
        if i < j {
            let tr = re[i]
            re[i] = re[j]
            re[j] = tr
            let ti = im[i]
            im[i] = im[j]
            im[j] = ti
        }
    }
    // Butterflies, with the twiddles of each stage made by rotation.
    var len = 2
    while len <= n {
        let ang = -2.0 * pi / Float(len)
        let wr = cos(ang)
        let wi = sin(ang)
        let halfLen = len / 2
        var start = 0
        while start < n {
            var cr = 1.0
            var ci = 0.0
            for k in 0..halfLen {
                let a = start + k
                let b = a + halfLen
                let xr = re[b] * cr - im[b] * ci
                let xi = re[b] * ci + im[b] * cr
                re[b] = re[a] - xr
                im[b] = im[a] - xi
                re[a] = re[a] + xr
                im[a] = im[a] + xi
                let nr = cr * wr - ci * wi
                ci = cr * wi + ci * wr
                cr = nr
            }
            start += len
        }
        len = len * 2
    }
}

// `bands` levels from 0 to 1, lowest frequencies first.
public fn levels(_ s: core.Samples, bands: Int) -> [Float] {
    var out: [Float] = []
    if bands <= 0 {
        return out
    }
    let c = max(1, s.channels)
    let frames = s.data.count / c
    var n = 2048
    while n > frames && n > 32 {
        n = n / 2
    }
    if frames < n || s.rate <= 0 {
        for _ in 0..bands {
            out.append(0.0)
        }
        return out
    }
    var re: [Float] = []
    var im: [Float] = []
    let first = frames - n
    for i in 0..n {
        var m = 0.0
        let base = (first + i) * c
        for ch in 0..c {
            m += s.data[base + ch]
        }
        let w = 0.5 - 0.5 * cos(2.0 * pi * Float(i) / Float(n))
        re.append(m / Float(c) * w)
        im.append(0.0)
    }
    fft(re, im)
    let binHz = Float(s.rate) / Float(n)
    let lowHz = max(20.0, binHz)
    let highHz = Float(s.rate) / 2.0
    let ratio = highHz / lowHz
    let fullScale = Float(n) / 4.0
    for b in 0..bands {
        let f0 = lowHz * pow(ratio, Float(b) / Float(bands))
        let f1 = lowHz * pow(ratio, Float(b + 1) / Float(bands))
        var k0 = Int(floor(f0 / binHz + 0.5))
        var k1 = Int(floor(f1 / binHz + 0.5))
        k0 = max(1, min(k0, n / 2))
        k1 = max(k0 + 1, min(k1, n / 2 + 1))
        var best = 0.0
        for k in k0..k1 {
            let p = re[k] * re[k] + im[k] * im[k]
            if p > best {
                best = p
            }
        }
        let mag = sqrt(best) / fullScale
        let db = if mag > 0.0 { 20.0 * log10(mag) } else { -1000.0 }
        out.append(max(0.0, min(1.0, (db + levelFloorDb) / levelFloorDb)))
    }
    out
}
