// Deinterlacing of decoded pictures (core.Picture, depth 8 to 12, 4:2:0,
// 4:2:2, 4:4:4 and gray).
//
// An interlaced picture holds two fields woven together: the even rows
// (top field) were shot at one moment and the odd rows (bottom field)
// half a frame later; `Picture.topFieldFirst` says which came first.
// Shown as they are ("weave"), moving edges comb. The modes here:
//
//   off      weave: the picture as it is.
//   bob      each field alone, its missing rows rebuilt from the rows
//            above and below by edge-directed interpolation ("ELA", edge
//            line average: of the three pairs of samples through the
//            missing one, \ | /, the pair that differs least is averaged,
//            kept between the vertical neighbours). Single rate shows the
//            first field of each picture; double rate both fields.
//   blend    every row mixed (1, 2, 1)/4 with its neighbours: no combs,
//            some ghosting; single rate only.
//   adaptive Reel's motion-adaptive deinterlacer (below), single or
//            double rate.
//
// The adaptive mode, written from the general idea of motion-adaptive
// deinterlacing (temporal interpolation where the picture is still,
// spatial where it moves) and not from any program's code:
//   * For each missing sample of the field being shown, the two samples
//     at the same place in the fields of the other parity just before and
//     just after it in time are averaged: the "temporal" estimate. Where
//     nothing moves this restores the full vertical detail.
//   * Motion is measured there as the larger of (a) the difference of
//     those two samples (one frame apart) and (b) the mean difference of
//     the samples above and below in this field and in the field of the
//     same parity one frame earlier. The larger of this pixel's and its
//     left neighbour's measure is used, so a moving edge isn't missed at
//     one sample.
//   * The "spatial" estimate is ELA (as in bob), extended to two more
//     directions (two samples sideways) when a one-sample diagonal matches
//     better than the vertical pair, for shallow edges.
//   * Where it moves, the result is the mean of the spatial estimate and
//     the temporal one limited to the range of the samples above and
//     below (the median of those three: a vertical-temporal median keeps
//     detail that is still in place inside a moving area). On the test
//     clips this gains 0.3–1.3 dB over the spatial estimate alone.
//   * Motion below a low threshold takes the temporal estimate, above a
//     high one the moving estimate; in between the two are mixed
//     linearly, so there is no hard switching to flicker.
//   * Chroma uses the same rule with a plain vertical average as the
//     spatial estimate (in interlaced 4:2:0 the chroma rows alternate
//     between the fields too, MPEG-2 6.1.1.8).
//
// Field timing for double rate: the first field keeps the picture's time;
// the second gets the mid-point to the next picture (pts likewise), so it
// is shown when the next picture arrives (one picture of latency). Single
// rate has no latency. The first picture after `reset` (a seek) has no
// earlier field, so it is interpolated spatially.
//
// Author: Alexius Academia
// Date: 2026-10-26

import "../core"

public enum DeinterlaceMode {
    off, bob, blend, adaptive
}

// A picture with the time (seconds) the player should show it at.
public struct Field {
    picture: core.Picture
    time: Float
}

// Streaming deinterlacer: keeps the previous picture (and, for double
// rate, the one whose second field is still to come). Plain data, so the
// player can keep it in its Converter and hand it to background work.
public struct Deinterlacer {
    mode: DeinterlaceMode = .adaptive
    doubleRate: Bool = false
    // Only deinterlace pictures marked interlaced (Picture.interlaced);
    // false = every picture.
    auto: Bool = true
    // Motion thresholds of the adaptive mode, in 8-bit steps (scaled for
    // deeper pictures): temporal below `still`, spatial above `moving`.
    still: Int = 6
    moving: Int = 20
    // The picture before `held` (or before the next one), and the picture
    // whose second field is still to be shown (double rate).
    prev: [core.Picture] = []
    held: [core.Picture] = []
    heldTime: Float = 0.0
    // Seconds between pictures, last seen (for the last second field).
    step: Float = 0.04

    // Forget the pictures held (after a seek).
    fn reset() {
        prev = []
        held = []
    }

    // Whether a picture would be deinterlaced.
    fn wants(_ p: core.Picture) -> Bool {
        mode != .off && (!auto || p.interlaced) && p.height >= 4 && !p.y.isEmpty
    }

    // Takes the next decoded picture (in display order) and returns the
    // pictures ready to show, in order: none, one, or (double rate) two.
    fn push(_ p: core.Picture, time: Float) -> [Field] {
        var out: [Field] = []
        let doubled = doubleRate && (mode == .bob || mode == .adaptive)
        if !held.isEmpty {
            // The held picture's second field, now that the next is known.
            let h = held[0]
            if time > heldTime {
                step = time - heldTime
            }
            let mid = if time > heldTime { (heldTime + time) / 2.0 } else { heldTime + step / 2.0 }
            out.append(Field(picture: secondField(h, p, true), time: mid))
            prev = [h]
            held = []
        }
        if !wants(p) {
            prev = [p]
            out.append(Field(picture: p, time: time))
            return out
        }
        var first = p
        if mode == .blend {
            first = blendPicture(p)
        } else if mode == .bob {
            first = deintPicture(p, p, p, p, p.topFieldFirst, false, false)
        } else {
            let has = !prev.isEmpty
            let pv = if has { prev[0] } else { p }
            // First field: the other parity's rows come from the previous
            // picture and from this one.
            first = deintPicture(p, pv, p, pv, p.topFieldFirst, has && sameShape(pv, p), true)
        }
        if doubled {
            first = halfDuration(first)
        }
        out.append(Field(picture: first, time: time))
        if doubled {
            held = [p]
            heldTime = time
        } else {
            prev = [p]
        }
        out
    }

    // The pictures still held at the end of the stream.
    fn flush() -> [Field] {
        var out: [Field] = []
        if !held.isEmpty {
            let h = held[0]
            out.append(Field(picture: secondField(h, h, false), time: heldTime + step / 2.0))
            prev = [h]
            held = []
        }
        out
    }

    // The second field of `h` (shown between h and `next`).
    fn secondField(_ h: core.Picture, _ next: core.Picture, _ hasNext: Bool) -> core.Picture {
        var pic = h
        if mode == .bob {
            pic = deintPicture(h, h, h, h, !h.topFieldFirst, false, false)
        } else {
            let hasPrev = !prev.isEmpty && sameShape(prev[0], h)
            let ok = hasNext && hasPrev && sameShape(next, h)
            let pv = if hasPrev { prev[0] } else { h }
            // Second field: the other parity's rows come from this picture
            // and the next one; same-parity motion from the previous one.
            pic = deintPicture(h, h, if ok { next } else { h }, pv, !h.topFieldFirst, ok, true)
        }
        pic = halfDuration(pic)
        if hasNext && next.pts != core.noTime && h.pts != core.noTime && next.pts > h.pts {
            pic.pts = h.pts + (next.pts - h.pts) / 2
        } else if h.pts != core.noTime && h.duration > 0 {
            pic.pts = h.pts + h.duration / 2
        }
        pic
    }

    // One field of `cur` made whole. `keepTop`: the field shown is the top
    // one (even rows kept, odd rows rebuilt). With `temporal`, missing
    // rows come from tA/tB (the other parity's fields before and after),
    // with motion against `ref` (this parity one frame earlier); without,
    // they're interpolated spatially. `adaptive` false = bob.
    fn deintPicture(_ cur: core.Picture, _ tA: core.Picture, _ tB: core.Picture, _ ref: core.Picture, _ keepTop: Bool, _ temporal: Bool, _ adaptive: Bool) -> core.Picture {
        var out = cur
        out.interlaced = false
        let missing = if keepTop { 1 } else { 0 }
        let depth = max(8, min(cur.depth, 16))
        let t1 = still << (depth - 8)
        let t2 = max(moving << (depth - 8), t1 + 1)
        let useT = temporal && adaptive
        out.y = deintPlane(cur.y, tA.y, tB.y, ref.y, cur.yOffset, cur.yStride, cur.width, cur.height, missing, useT, true, t1, t2)
        if cur.chroma != .gray && !cur.u.isEmpty && !cur.v.isEmpty {
            let cw = cur.chromaWidth
            let ch = cur.chromaHeight
            if ch >= 2 {
                out.u = deintPlane(cur.u, tA.u, tB.u, ref.u, cur.cOffset, cur.cStride, cw, ch, missing, useT, false, t1, t2)
                out.v = deintPlane(cur.v, tA.v, tB.v, ref.v, cur.cOffset, cur.cStride, cw, ch, missing, useT, false, t1, t2)
            }
        }
        out
    }
}

public fn newDeinterlacer(mode: DeinterlaceMode = .adaptive, doubleRate: Bool = false) -> Deinterlacer {
    Deinterlacer(mode: mode, doubleRate: doubleRate)
}

// The mode named "off", "bob", "blend" or "adaptive" (others: adaptive).
public fn deinterlaceMode(_ name: String) -> DeinterlaceMode {
    match name.lowercase() {
        "off" -> .off
        "weave" -> .off
        "bob" -> .bob
        "blend" -> .blend
        "linear" -> .blend
        _ -> .adaptive
    }
}

// One picture deinterlaced on its own (no neighbours): bob of the first
// field, or blend. For a stream, keep a Deinterlacer.
public fn deinterlaced(_ p: core.Picture, mode: DeinterlaceMode = .bob) -> core.Picture {
    if p.height < 4 || p.y.isEmpty || mode == .off {
        return p
    }
    if mode == .blend {
        return blendPicture(p)
    }
    var d = Deinterlacer(mode: .bob, auto: false)
    d.deintPicture(p, p, p, p, p.topFieldFirst, false, false)
}

// Whether two pictures have the same planes' shape (temporal
// interpolation needs that).
fn sameShape(_ a: core.Picture, _ b: core.Picture) -> Bool {
    a.width == b.width && a.height == b.height && a.yStride == b.yStride && a.yOffset == b.yOffset && a.cStride == b.cStride && a.cOffset == b.cOffset && a.chroma == b.chroma && a.y.count == b.y.count && a.u.count == b.u.count && a.v.count == b.v.count
}

fn halfDuration(_ p: core.Picture) -> core.Picture {
    var q = p
    q.duration = p.duration / 2
    q
}

// Every row of every plane mixed (1, 2, 1)/4 with its neighbours.
fn blendPicture(_ p: core.Picture) -> core.Picture {
    var out = p
    out.interlaced = false
    out.y = blendRows(p.y, p.yOffset, p.yStride, p.width, p.height)
    if p.chroma != .gray && !p.u.isEmpty && !p.v.isEmpty && p.chromaHeight >= 2 {
        out.u = blendRows(p.u, p.cOffset, p.cStride, p.chromaWidth, p.chromaHeight)
        out.v = blendRows(p.v, p.cOffset, p.cStride, p.chromaWidth, p.chromaHeight)
    }
    out
}

fn blendRows(_ plane: [Int], _ offset: Int, _ stride: Int, _ w: Int, _ h: Int) -> [Int] {
    var out = plane
    for row in 0..h {
        let o = offset + row * stride
        let a = offset + max(row - 1, 0) * stride
        let b = offset + min(row + 1, h - 1) * stride
        var x = 0
        while x < w {
            out[o + x] = (plane[a + x] + 2 * plane[o + x] + plane[b + x] + 2) >> 2
            x += 1
        }
    }
    out
}

// The plane with its rows of parity `missing` rebuilt (see the top of the
// file). cur: this picture; tA/tB: the other parity's samples before and
// after (temporal); ref: the same parity one frame earlier. `ela`: edge-
// directed spatial estimate (luma) rather than a vertical average.
fn deintPlane(_ cur: [Int], _ tA: [Int], _ tB: [Int], _ ref: [Int], _ off: Int, _ stride: Int, _ w: Int, _ h: Int, _ missing: Int, _ temporal: Bool, _ ela: Bool, _ t1: Int, _ t2: Int) -> [Int] {
    var out = cur
    // Mixing weight between the thresholds, 16-bit fixed point.
    let k = 65536 / (t2 - t1)
    var row = missing
    while row < h {
        let o = off + row * stride
        // The field's rows above and below (one of them at the edges).
        let a = off + (if row > 0 { row - 1 } else { row + 1 }) * stride
        let b = off + (if row + 1 < h { row + 1 } else { row - 1 }) * stride
        var mLeft = 0
        var x = 0
        while x < w {
            let up = cur[a + x]
            let dn = cur[b + x]
            var tm = 0
            var m = 0
            if temporal {
                let ta = tA[o + x]
                let tb = tB[o + x]
                tm = (ta + tb + 1) >> 1
                let ms = (abs(up - ref[a + x]) + abs(dn - ref[b + x])) >> 1
                let m0 = max(abs(ta - tb), ms)
                m = max(m0, mLeft)
                mLeft = m0
                if m <= t1 {
                    // Still: the other field's samples, full detail.
                    out[o + x] = tm
                    x += 1
                    continue
                }
            }
            // Spatial estimate: the vertical mean, or an edge direction
            // if one fits better.
            var sp = (up + dn + 1) >> 1
            let lo = min(up, dn)
            let hi = max(up, dn)
            if ela && x >= 2 && x + 2 < w {
                var best = abs(up - dn)
                let l1 = cur[a + x - 1]
                let r1 = cur[a + x + 1]
                let dl1 = cur[b + x - 1]
                let dr1 = cur[b + x + 1]
                let d1 = abs(l1 - dr1)
                let d2 = abs(r1 - dl1)
                if d1 < best && d1 <= d2 {
                    best = d1
                    sp = (l1 + dr1 + 1) >> 1
                    // A shallower "\" edge two samples across.
                    let d3 = abs(cur[a + x - 2] - cur[b + x + 2])
                    if d3 < best {
                        sp = (cur[a + x - 2] + cur[b + x + 2] + 1) >> 1
                    }
                    sp = max(lo, min(sp, hi))
                } else if d2 < best {
                    best = d2
                    sp = (r1 + dl1 + 1) >> 1
                    let d4 = abs(cur[a + x + 2] - cur[b + x - 2])
                    if d4 < best {
                        sp = (cur[a + x + 2] + cur[b + x - 2] + 1) >> 1
                    }
                    sp = max(lo, min(sp, hi))
                }
            }
            if !temporal {
                out[o + x] = sp
                x += 1
                continue
            }
            // Moving: the mean of the spatial estimate and the temporal one
            // limited to the vertical neighbours' range (a vertical-temporal
            // median), which keeps some detail ELA alone loses.
            let mv = (sp + max(lo, min(tm, hi)) + 1) >> 1
            if m >= t2 {
                out[o + x] = mv
            } else {
                out[o + x] = tm + (((mv - tm) * (m - t1) * k) >> 16)
            }
            x += 1
        }
        row += 2
    }
    out
}
