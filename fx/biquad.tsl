// Second-order (biquad) filter designs and their frequency responses.
//
// Peaking filters follow Robert Bristow-Johnson's "Cookbook formulae for
// audio EQ biquad filter coefficients" (the Audio EQ Cookbook):
//   A = 10^(dBgain/40), w0 = 2π f0/Fs,
//   alpha = sin(w0)·sinh(ln(2)/2 · BW · w0/sin(w0))   (BW in octaves)
//   b0 = 1 + alpha·A, b1 = −2cos(w0), b2 = 1 − alpha·A
//   a0 = 1 + alpha/A, a1 = −2cos(w0), a2 = 1 − alpha/A
// normalised by a0. The filters run in transposed direct form II.
//
// The K-weighting filters of ITU-R BS.1770-4 (a high shelf for the head's
// acoustic effect, then the "RLB" high-pass) use the coefficients printed
// in the recommendation at 48 kHz. For other rates they are made by the
// bilinear transform from the analogue prototype the published
// coefficients correspond to (shelf: f0 ≈ 1681.97 Hz, gain ≈ +4.0 dB,
// Q ≈ 0.7072; high-pass: f0 ≈ 38.135 Hz, Q ≈ 0.5003), which gives back
// the printed numbers at 48 kHz.
//
// Author: Alexius Academia
// Date: 2026-10-26

public struct Biquad {
    b0: Float = 1.0
    b1: Float = 0.0
    b2: Float = 0.0
    a1: Float = 0.0
    a2: Float = 0.0

    // |H(e^jw)| at frequency f for sample rate fs.
    fn magnitude(_ f: Float, _ fs: Float) -> Float {
        let w = 2.0 * pi * f / fs
        let c1 = cos(w)
        let s1 = sin(w)
        let c2 = cos(2.0 * w)
        let s2 = sin(2.0 * w)
        // Numerator and denominator at z = e^{-jw}.
        let nr = b0 + b1 * c1 + b2 * c2
        let ni = -(b1 * s1 + b2 * s2)
        let dr = 1.0 + a1 * c1 + a2 * c2
        let di = -(a1 * s1 + a2 * s2)
        sqrt((nr * nr + ni * ni) / (dr * dr + di * di))
    }

    // The response in dB.
    fn db(_ f: Float, _ fs: Float) -> Float {
        20.0 * log10(max(magnitude(f, fs), 1e-30))
    }
}

// The Cookbook's peaking EQ: `gain` dB at f0, bandwidth bw octaves.
public fn peaking(f0: Float, gain: Float, bw: Float, rate: Float) -> Biquad {
    let w0 = 2.0 * pi * f0 / rate
    let alpha = sin(w0) * sinh(log(2.0) / 2.0 * bw * w0 / sin(w0))
    peakingFrom(cos(w0), alpha, gain)
}

// The same, from cos(w0) and alpha (which don't depend on the gain, so a
// gain ramp only redoes this part).
public fn peakingFrom(_ cw: Float, _ alpha: Float, _ gain: Float) -> Biquad {
    let a = pow(10.0, gain / 40.0)
    let a0 = 1.0 + alpha / a
    Biquad(b0: (1.0 + alpha * a) / a0, b1: -2.0 * cw / a0, b2: (1.0 - alpha * a) / a0, a1: -2.0 * cw / a0, a2: (1.0 - alpha / a) / a0)
}

fn sinh(_ x: Float) -> Float {
    (exp(x) - exp(-x)) / 2.0
}

// K-weighting stage 1 (the high shelf) for a sample rate.
public fn kShelf(_ rate: Float) -> Biquad {
    if abs(rate - 48000.0) < 0.5 {
        // ITU-R BS.1770-4, Table 1.
        return Biquad(b0: 1.53512485958697, b1: -2.69169618940638, b2: 1.19839281085285, a1: -1.69065929318241, a2: 0.73248077421585)
    }
    kShelfDesigned(rate)
}

// The shelf made by the bilinear transform (also used to check the table).
public fn kShelfDesigned(_ rate: Float) -> Biquad {
    let f0 = 1681.974450955533
    let g = 3.999843853973347
    let q = 0.7071752369554196
    let k = tan(pi * f0 / rate)
    let vh = pow(10.0, g / 20.0)
    let vb = pow(vh, 0.4996667741545416)
    let a0 = 1.0 + k / q + k * k
    Biquad(b0: (vh + vb * k / q + k * k) / a0, b1: 2.0 * (k * k - vh) / a0, b2: (vh - vb * k / q + k * k) / a0, a1: 2.0 * (k * k - 1.0) / a0, a2: (1.0 - k / q + k * k) / a0)
}

// K-weighting stage 2 (the RLB high-pass) for a sample rate.
public fn kHighpass(_ rate: Float) -> Biquad {
    if abs(rate - 48000.0) < 0.5 {
        // ITU-R BS.1770-4, Table 2.
        return Biquad(b0: 1.0, b1: -2.0, b2: 1.0, a1: -1.99004745483398, a2: 0.99007225036621)
    }
    kHighpassDesigned(rate)
}

// The high-pass made by the bilinear transform (also used to check the
// table in tests). Its numerator is 1, −2, 1 as in the recommendation.
public fn kHighpassDesigned(_ rate: Float) -> Biquad {
    let f0 = 38.13547087602444
    let q = 0.5003270373238773
    let k = tan(pi * f0 / rate)
    let d = 1.0 + k / q + k * k
    Biquad(b0: 1.0, b1: -2.0, b2: 1.0, a1: 2.0 * (k * k - 1.0) / d, a2: (1.0 - k / q + k * k) / d)
}
