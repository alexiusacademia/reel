// Data for a visualiser: band levels on a log frequency scale and a short
// waveform, from the latest output.
//
// The chain keeps the last 2048 frames of its output as mono (the mean of
// the channels) in a ring; `bands` windows them (Hann), takes a radix-2
// FFT and gives, for each of N bands spaced evenly in log frequency from
// 30 Hz to 16 kHz (or the Nyquist frequency), the band's strongest bin
// as a level from 0 (−80 dBFS or less) to 1 (0 dBFS: a full-scale sine).
// `waveform` gives min/max pairs of the same frames in N buckets.
// Both run only when asked (once per chunk is plenty), so keeping the
// ring is the only per-sample cost.
//
// Author: Alexius Academia
// Date: 2026-10-26

import "../core"

public let visualFrames = 2048
let visualFloorDb = -80.0

public struct Visual {
    rate: Int = 48000
    ring: [Float] = []
    pos: Int = 0
    re: [Float] = []
    im: [Float] = []
    cosT: [Float] = []
    sinT: [Float] = []
    window: [Float] = []

    fn setup(_ r: Int) {
        rate = r
        ring = []
        re = []
        im = []
        cosT = []
        sinT = []
        window = []
        let n = visualFrames
        for i in 0..n {
            ring.append(0.0)
            re.append(0.0)
            im.append(0.0)
            window.append(0.5 - 0.5 * cos(2.0 * pi * Float(i) / Float(n)))
        }
        for i in 0..(n / 2) {
            cosT.append(cos(2.0 * pi * Float(i) / Float(n)))
            sinT.append(-sin(2.0 * pi * Float(i) / Float(n)))
        }
        pos = 0
    }

    fn clear() {
        for i in 0..ring.count {
            ring[i] = 0.0
        }
    }

    // Keeps the block's frames (as mono).
    fn add(_ d: [Float], _ c: Int) {
        let n = ring.count
        if n == 0 || c <= 0 {
            return
        }
        let frames = d.count / c
        var f = max(0, frames - n)
        var p = pos
        let inv = 1.0 / Float(c)
        while f < frames {
            var m = 0.0
            let base = f * c
            for ch in 0..c {
                m += d[base + ch]
            }
            ring[p] = m * inv
            p += 1
            if p == n {
                p = 0
            }
            f += 1
        }
        pos = p
    }

    // N band levels, 0 … 1.
    fn bands(_ count: Int) -> [Float] {
        var out: [Float] = []
        if count <= 0 {
            return out
        }
        let n = visualFrames
        if ring.count != n {
            for _ in 0..count {
                out.append(0.0)
            }
            return out
        }
        for i in 0..n {
            re[i] = ring[(pos + i) % n] * window[i]
            im[i] = 0.0
        }
        fft()
        let binHz = Float(rate) / Float(n)
        let lo = 30.0
        let hi = min(16000.0, Float(rate) / 2.0)
        // A full-scale sine gives |X| = n/4 with a Hann window.
        let full = Float(n) / 4.0
        for b in 0..count {
            let f0 = lo * pow(hi / lo, Float(b) / Float(count))
            let f1 = lo * pow(hi / lo, Float(b + 1) / Float(count))
            var k0 = Int(floor(f0 / binHz + 0.5))
            var k1 = Int(floor(f1 / binHz + 0.5))
            k0 = max(1, min(k0, n / 2 - 1))
            k1 = max(k0, min(k1, n / 2 - 1))
            var best = 0.0
            for k in k0..(k1 + 1) {
                let m = re[k] * re[k] + im[k] * im[k]
                if m > best {
                    best = m
                }
            }
            let db = 10.0 * log10(max(best, 1e-30) / (full * full))
            out.append(max(0.0, min(1.0, (db - visualFloorDb) / -visualFloorDb)))
        }
        out
    }

    // `points` (min, max) pairs over the kept frames, oldest first.
    fn waveform(_ points: Int) -> [Float] {
        var out: [Float] = []
        let n = ring.count
        if points <= 0 || n == 0 {
            return out
        }
        for b in 0..points {
            let s = b * n / points
            let e = max(s + 1, (b + 1) * n / points)
            var lo = 1e9
            var hi = -1e9
            for i in s..e {
                let v = ring[(pos + i) % n]
                lo = min(lo, v)
                hi = max(hi, v)
            }
            out.append(lo)
            out.append(hi)
        }
        out
    }

    // In-place radix-2 FFT of re/im (decimation in time).
    fn fft() {
        let n = re.count
        var j = 0
        for i in 1..n {
            var bit = n >> 1
            while (j & bit) != 0 {
                j = j ^ bit
                bit = bit >> 1
            }
            j = j ^ bit
            if i < j {
                let tr = re[i]
                re[i] = re[j]
                re[j] = tr
                let ti = im[i]
                im[i] = im[j]
                im[j] = ti
            }
        }
        var len = 2
        while len <= n {
            let half = len / 2
            let stride = n / len
            var s = 0
            while s < n {
                for k in 0..half {
                    let wr = cosT[k * stride]
                    let wi = sinT[k * stride]
                    let a = s + k
                    let b = a + half
                    let xr = re[b] * wr - im[b] * wi
                    let xi = re[b] * wi + im[b] * wr
                    re[b] = re[a] - xr
                    im[b] = im[a] - xi
                    re[a] = re[a] + xr
                    im[a] = im[a] + xi
                }
                s += len
            }
            len = len * 2
        }
    }
}

// Band levels of a piece of sound (its last 2048 frames), 0 … 1.
public fn levels(_ s: core.Samples, bands: Int) -> [Float] {
    var v = Visual()
    v.setup(max(1, s.rate))
    v.add(s.data, s.channels)
    v.bands(bands)
}

// (min, max) pairs of a piece of sound (mono) in `points` buckets.
public fn waveform(_ s: core.Samples, points: Int) -> [Float] {
    var out: [Float] = []
    let c = max(1, s.channels)
    let n = s.data.count / c
    if points <= 0 || n == 0 {
        return out
    }
    for b in 0..points {
        let st = b * n / points
        let e = max(st + 1, (b + 1) * n / points)
        var lo = 1e9
        var hi = -1e9
        for f in st..min(e, n) {
            var m = 0.0
            for ch in 0..c {
                m += s.data[f * c + ch]
            }
            m = m / Float(c)
            lo = min(lo, m)
            hi = max(hi, m)
        }
        out.append(lo)
        out.append(hi)
    }
    out
}
