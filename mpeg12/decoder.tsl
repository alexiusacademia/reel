// MPEG-1 and MPEG-2 video decoder (ISO/IEC 11172-2 and ISO/IEC 13818-2
// Main profile): the public Decoder. It splits packets at start codes,
// reads the sequence, GOP and picture headers and their extensions
// (13818-2 6.2.2 and 6.2.3), runs the engine over each picture's slices,
// pairs field pictures into frames, keeps the two reference frames and
// hands pictures out in display order (a reference frame is held until
// the next one is decoded, as 13818-2 7.12 describes; B frames go out at
// once).
//
// Pictures carry the pts of the packet holding their picture header;
// when a packet has none, the previous picture's pts plus one frame
// duration is used.
//
// Author: Alexius Academia
// Date: 2026-10-25

import "../core"

public struct Decoder {
    e: M12Engine = M12Engine()
    // When true, B pictures are not decoded.
    skipNonReference: Bool = false
    // Damage found (decoding goes on).
    warnings: [String] = []

    timescale: Int = 90000

    // Sequence header and extensions.
    haveSeq: Bool = false
    seenSeqExt: Bool = false
    width: Int = 0
    height: Int = 0
    aspectCode: Int = 1
    fpsNum: Int = 0
    fpsDen: Int = 1
    trackFpsNum: Int = 0
    trackFpsDen: Int = 1
    progressiveSeq: Bool = true
    lowDelay: Bool = false
    chromaFmt: Int = 1
    profileLevel: Int = 0
    displayW: Int = 0
    displayH: Int = 0
    matrixCode: Int = 0
    seqIntra: [Int] = []
    seqInter: [Int] = []
    closedGop: Bool = false

    // Picture header state.
    hdrPending: Bool = false
    picPts: Int = core.noTime
    repeatFirstField: Bool = false

    // The picture being decoded.
    inPicture: Bool = false
    skipping: Bool = false

    // Field pairing and the frame being completed.
    fieldPending: Bool = false
    frameType: Int = 1
    framePts: Int = core.noTime
    frameRff: Bool = false
    firstStructure: Int = 3

    // Reference frames, and planes free for the next picture.
    older: M12Frame = M12Frame()
    newer: M12Frame = M12Frame()
    spare: M12Frame = M12Frame()
    olderValid: Bool = false
    newerValid: Bool = false
    held: Bool = false
    heldPts: Int = core.noTime
    heldKey: Bool = false
    heldRff: Bool = false
    waitKey: Bool = true

    out: [core.Picture] = []
    lastPts: Int = core.noTime

    // Decodes one packet (any number of start-code units, normally one
    // picture with the headers before it) and returns the pictures that
    // are ready, in display order.
    fn decode(_ packet: Data, pts: Int, dts: Int, key: Bool) -> [core.Picture] {
        let n = packet.count
        var starts: [Int] = []
        var i = 0
        while i + 3 < n {
            let b2 = packet[i + 2]
            if b2 > 1 {
                i += 3
            } else if b2 == 1 && packet[i] == 0 && packet[i + 1] == 0 {
                starts.append(i)
                i += 3
            } else {
                i += 1
            }
        }
        var ptsUsed = false
        for k in 0..starts.count {
            let at = starts[k]
            let code = packet[at + 3]
            let from = at + 4
            let to = if k + 1 < starts.count { starts[k + 1] } else { n }
            if code >= 0x01 && code <= 0xAF {
                if hdrPending {
                    startPicture()
                }
                if inPicture && !skipping {
                    if !e.decodeSlice(packet, from: from, to: to, code: code, verticalSize: height) {
                        e.errors += 1
                    }
                }
            } else if code == 0x00 {
                finishPicture()
                parsePictureHeader(packet, from, to)
                picPts = if ptsUsed { core.noTime } else { pts }
                ptsUsed = true
            } else if code == 0xB3 {
                finishPicture()
                parseSequenceHeader(packet, from, to)
            } else if code == 0xB5 {
                parseExtension(packet, from, to)
            } else if code == 0xB8 {
                finishPicture()
                parseGop(packet, from, to)
            } else if code == 0xB7 {
                finishPicture()
            }
        }
        // A picture whose last macroblock row arrived is complete; one
        // that isn't may go on in the next packet.
        if inPicture && (skipping || e.doneCount >= e.mbw * e.picMbRows) {
            finishPicture()
        }
        takeOut()
    }

    // The pictures still held, at the end of the stream.
    fn flush() -> [core.Picture] {
        finishPicture()
        if fieldPending {
            fieldPending = false
            completeFrame()
        }
        if held {
            emit(newer, heldPts, heldKey, heldRff)
            held = false
        }
        takeOut()
    }

    // After a seek: forgets the references and held pictures and waits
    // for an I picture.
    fn reset() {
        inPicture = false
        skipping = false
        hdrPending = false
        fieldPending = false
        held = false
        olderValid = false
        newerValid = false
        waitKey = true
        out = []
        lastPts = core.noTime
    }

    fn takeOut() -> [core.Picture] {
        let r = out
        out = []
        r
    }

    fn warn(_ s: String) {
        if warnings.count < 100 {
            warnings.append(s)
        }
    }

    // ---- Headers ----

    // sequence_header() (6.2.2.1). Quantiser matrices come in zig-zag
    // order and go back to their defaults unless loaded.
    fn parseSequenceHeader(_ d: Data, _ from: Int, _ to: Int) {
        var r = core.bitReaderRange(d, from: from, to: to)
        let w = r.bits(12)
        let h = r.bits(12)
        aspectCode = r.bits(4)
        let frc = r.bits(4)
        r.skip(18)
        let marker = r.bits(1)
        r.skip(10 + 1)
        var intra = m12DefaultIntra
        if r.bits(1) == 1 {
            intra = core.zeros(64)
            for k in 0..64 {
                intra[m12ZigZag[k]] = r.bits(8)
            }
        }
        var inter = core.filled(64, 16)
        if r.bits(1) == 1 {
            for k in 0..64 {
                inter[m12ZigZag[k]] = r.bits(8)
            }
        }
        if r.overrun || w == 0 || h == 0 || marker != 1 {
            warn("damaged sequence header")
            return
        }
        width = w
        height = h
        if frc >= 1 && frc <= 8 {
            fpsNum = m12FrameRates[frc * 2]
            fpsDen = m12FrameRates[frc * 2 + 1]
        }
        seqIntra = intra
        seqInter = inter
        e.qIntra = intra
        e.qIntraC = intra
        e.qInter = inter
        e.qInterC = inter
        // MPEG-2 until proven otherwise only by its sequence extension.
        e.mpeg2 = false
        seenSeqExt = false
        progressiveSeq = true
        chromaFmt = 1
        haveSeq = true
    }

    fn parseExtension(_ d: Data, _ from: Int, _ to: Int) {
        var r = core.bitReaderRange(d, from: from, to: to)
        let id = r.bits(4)
        if id == 1 {
            // sequence_extension() (6.2.2.3).
            profileLevel = r.bits(8)
            progressiveSeq = r.bits(1) == 1
            chromaFmt = r.bits(2)
            if chromaFmt == 0 {
                chromaFmt = 1
            }
            width = width | (r.bits(2) << 12)
            height = height | (r.bits(2) << 12)
            r.skip(12 + 1 + 8)
            lowDelay = r.bits(1) == 1
            let en = r.bits(2)
            let ed = r.bits(5)
            if fpsNum > 0 {
                fpsNum = fpsNum * (en + 1)
                fpsDen = fpsDen * (ed + 1)
            }
            e.mpeg2 = true
            seenSeqExt = true
        } else if id == 2 {
            // sequence_display_extension() (6.2.2.4).
            r.skip(3)
            if r.bits(1) == 1 {
                r.skip(16)
                matrixCode = r.bits(8)
            }
            displayW = r.bits(14)
            r.skip(1)
            displayH = r.bits(14)
        } else if id == 3 {
            // quant_matrix_extension() (6.2.3.2): loading a luma matrix
            // also sets the chroma one.
            if r.bits(1) == 1 {
                var m = core.zeros(64)
                for k in 0..64 {
                    m[m12ZigZag[k]] = r.bits(8)
                }
                e.qIntra = m
                e.qIntraC = m
            }
            if r.bits(1) == 1 {
                var m = core.zeros(64)
                for k in 0..64 {
                    m[m12ZigZag[k]] = r.bits(8)
                }
                e.qInter = m
                e.qInterC = m
            }
            if r.bits(1) == 1 {
                var m = core.zeros(64)
                for k in 0..64 {
                    m[m12ZigZag[k]] = r.bits(8)
                }
                e.qIntraC = m
            }
            if r.bits(1) == 1 {
                var m = core.zeros(64)
                for k in 0..64 {
                    m[m12ZigZag[k]] = r.bits(8)
                }
                e.qInterC = m
            }
        } else if id == 8 {
            // picture_coding_extension() (6.2.3.1).
            for k in 0..4 {
                e.fcode[k] = r.bits(4)
            }
            e.dcPrec = r.bits(2)
            e.structure = r.bits(2)
            if e.structure == 0 {
                warn("picture_structure 0, taken as a frame")
                e.structure = 3
            }
            e.topFieldFirst = r.bits(1) == 1
            e.framePredFrameDct = r.bits(1) == 1
            e.concealMv = r.bits(1) == 1
            e.qScaleType = r.bits(1)
            e.intraVlc = r.bits(1)
            e.altScan = r.bits(1) == 1
            repeatFirstField = r.bits(1) == 1
        }
    }

    fn parseGop(_ d: Data, _ from: Int, _ to: Int) {
        var r = core.bitReaderRange(d, from: from, to: to)
        r.skip(25)
        closedGop = r.bits(1) == 1
    }

    // picture_header() (6.2.3); the MPEG-2 coding extension that follows
    // overrides the MPEG-1 fields.
    fn parsePictureHeader(_ d: Data, _ from: Int, _ to: Int) {
        var r = core.bitReaderRange(d, from: from, to: to)
        r.skip(10)
        e.picType = r.bits(3)
        r.skip(16)
        e.fullPelF = false
        e.fullPelB = false
        var ff = 1
        var bf = 1
        if e.picType == 2 || e.picType == 3 {
            e.fullPelF = r.bits(1) == 1
            ff = r.bits(3)
        }
        if e.picType == 3 {
            e.fullPelB = r.bits(1) == 1
            bf = r.bits(3)
        }
        e.fcode = [ff, ff, bf, bf]
        e.structure = 3
        e.dcPrec = 0
        e.framePredFrameDct = true
        e.concealMv = false
        e.qScaleType = 0
        e.intraVlc = 0
        e.altScan = false
        e.topFieldFirst = true
        repeatFirstField = false
        hdrPending = true
    }

    // ---- Pictures and frames ----

    // Sets the engine up for the coded size when it changed.
    fn ensureGeometry() -> Bool {
        if width * height > m12MaxArea || width > 8192 || height > 8192 {
            return false
        }
        let mbw = (width + 15) / 16
        let mbh = if progressiveSeq || !e.mpeg2 { (height + 15) / 16 } else { 2 * ((height + 31) / 32) }
        if mbw != e.mbw || mbh != e.mbh || chromaFmt != e.chromaFmt || e.ySize == 0 {
            e.setup(mbWidth: mbw, mbHeight: mbh, chroma: chromaFmt)
            olderValid = false
            newerValid = false
            held = false
            fieldPending = false
            older = M12Frame()
            newer = M12Frame()
            spare = M12Frame()
        }
        true
    }

    fn startPicture() {
        hdrPending = false
        inPicture = true
        skipping = false
        if !haveSeq {
            skipping = true
            return
        }
        if !ensureGeometry() {
            warn("picture size {width}×{height} is too large")
            skipping = true
            return
        }
        let type = e.picType
        let structure = e.structure
        if fieldPending {
            // The second field: the other parity of the same frame.
            let compatible = (frameType == 3) == (type == 3)
            if structure != 3 && structure != firstStructure && compatible {
                e.secondField = true
                if type == 2 {
                    // The first field, for predictions from it: a
                    // snapshot shares the planes until the second field
                    // writes them.
                    e.ffY = e.curY
                    e.ffU = e.curU
                    e.ffV = e.curV
                    if newerValid {
                        e.setFwd(newer)
                    } else {
                        e.fwdY = e.ffY
                        e.fwdU = e.ffU
                        e.fwdV = e.ffV
                    }
                }
                fieldStart()
                return
            }
            warn("unpaired field")
            fieldPending = false
            completeFrame()
        }
        e.secondField = false
        if type < 1 || type > 3 {
            warn("picture type {type} not supported, skipped")
            skipping = true
            return
        }
        if waitKey && type != 1 {
            skipping = true
            return
        }
        if type == 3 && (skipNonReference || !newerValid || (!olderValid && !closedGop)) {
            skipping = true
            return
        }
        if type == 2 && !newerValid {
            skipping = true
            return
        }
        if type == 1 {
            waitKey = false
        }
        // Decode into planes no reference uses.
        if spare.y.count != e.ySize || spare.u.count != e.cSize {
            spare = M12Frame(y: core.filled(e.ySize, 128), u: core.filled(e.cSize, 128), v: core.filled(e.cSize, 128))
        }
        e.curY = spare.y
        e.curU = spare.u
        e.curV = spare.v
        spare = M12Frame()
        e.release()
        if type == 3 {
            e.setFwd(if olderValid { older } else { newer })
            e.setBwd(newer)
        } else if newerValid {
            e.setFwd(newer)
        }
        firstStructure = structure
        frameType = type
        framePts = picPts
        frameRff = repeatFirstField
        fieldStart()
    }

    fn fieldStart() {
        e.serial += 1
        e.doneCount = 0
        if e.structure != 3 {
            e.usage[m12UseFieldPicture] += 1
        }
        if e.mpeg2 {
            if e.altScan {
                e.usage[11] += 1
            }
            if e.intraVlc == 1 {
                e.usage[12] += 1
            }
            if e.qScaleType == 1 {
                e.usage[13] += 1
            }
        }
    }

    // Pictures and macroblocks that used each coding tool, as
    // "name: count" lines (tests and the media info window).
    fn toolsUsed() -> [String] {
        var out: [String] = []
        for i in 0..e.usage.count {
            if e.usage[i] > 0 {
                out.append("{m12Tools[i]}: {e.usage[i]}")
            }
        }
        out
    }

    fn finishPicture() {
        if !inPicture {
            return
        }
        inPicture = false
        if skipping {
            skipping = false
            return
        }
        let total = e.mbw * e.picMbRows
        if e.doneCount < total {
            let from = if e.fwdY.isEmpty { -1 } else { 0 }
            let missing = e.conceal(from)
            if missing > 0 {
                warn("{missing} of {total} macroblocks missing or damaged, concealed")
            }
        }
        if e.structure != 3 && !e.secondField {
            fieldPending = true
            return
        }
        fieldPending = false
        completeFrame()
    }

    // A whole frame is decoded: I and P frames become the newest
    // reference (and the previous one is shown), B frames are shown.
    fn completeFrame() {
        let f = M12Frame(y: e.curY, u: e.curU, v: e.curV)
        e.curY = []
        e.curU = []
        e.curV = []
        e.release()
        if frameType != 3 {
            if held {
                emit(newer, heldPts, heldKey, heldRff)
            }
            if !older.y.isEmpty {
                spare = older
            }
            older = newer
            olderValid = newerValid
            newer = f
            newerValid = true
            held = true
            heldPts = framePts
            heldKey = frameType == 1
            heldRff = frameRff
            if lowDelay {
                emit(newer, heldPts, heldKey, heldRff)
                held = false
            }
        } else {
            emit(f, framePts, false, frameRff)
            spare = f
        }
    }

    // One frame's duration in track ticks (0 when the rate is unknown).
    frameDuration: Int {
        let num = if fpsNum > 0 { fpsNum } else { trackFpsNum }
        let den = if fpsNum > 0 { fpsDen } else { trackFpsDen }
        if num <= 0 || den <= 0 {
            return 0
        }
        timescale * den / num
    }

    // Hands a frame out as a picture. Its planes are shared with the
    // decoder, which copies them only if it writes them again while the
    // picture is still held.
    fn emit(_ f: M12Frame, _ pts: Int, _ key: Bool, _ rff: Bool) {
        var p = core.Picture(width: width, height: height)
        p.chroma = if chromaFmt == 1 { core.Chroma.yuv420 } else if chromaFmt == 2 { core.Chroma.yuv422 } else { core.Chroma.yuv444 }
        p.y = f.y
        p.u = f.u
        p.v = f.v
        p.yStride = e.yStride
        p.cStride = e.cStride
        p.matrix = colorMatrix
        p.key = key
        // Interlaced MPEG-2 (progressive_sequence 0): fields to deinterlace.
        p.interlaced = e.mpeg2 && !progressiveSeq
        p.topFieldFirst = e.topFieldFirst
        let (sn, sd) = sar
        p.sarNum = sn
        p.sarDen = sd
        var dur = frameDuration
        if rff {
            dur = if progressiveSeq && e.mpeg2 { dur * 2 } else { dur * 3 / 2 }
        }
        p.duration = dur
        var t = pts
        if t == core.noTime && lastPts != core.noTime && frameDuration > 0 {
            t = lastPts + frameDuration
        }
        p.pts = t
        lastPts = t
        out.append(p)
    }

    colorMatrix: core.ColorMatrix {
        if matrixCode == 1 || matrixCode == 7 {
            return core.ColorMatrix.bt709
        }
        if matrixCode == 4 || matrixCode == 5 || matrixCode == 6 {
            return core.ColorMatrix.bt601
        }
        core.guessMatrix(width: width, height: height)
    }

    // The pixel shape: MPEG-1 gives it directly (11172-2 Table 2-D.4),
    // MPEG-2 gives the display aspect ratio (13818-2 Table 6-3).
    sar: (Int, Int) {
        if !e.mpeg2 {
            if aspectCode >= 1 && aspectCode <= 14 {
                return m12Approx(10000, m12Mpeg1Aspect[aspectCode], 255)
            }
            return (1, 1)
        }
        if aspectCode < 2 || aspectCode > 4 || width == 0 || height == 0 {
            return (1, 1)
        }
        let an = if aspectCode == 2 { 4 } else if aspectCode == 3 { 16 } else { 221 }
        let ad = if aspectCode == 2 { 3 } else if aspectCode == 3 { 9 } else { 100 }
        // The display extension's size counts when it gives a usual
        // display shape (4:3 or 16:9); otherwise the coded size, as
        // ffmpeg does (streams often get the display size wrong).
        if displayW > 0 && displayH > 0 {
            let dn = an * displayH * width
            let dd = ad * displayW * height
            if dn * 3 == dd * 4 || dn * 9 == dd * 16 {
                return m12Reduce(an * displayH, ad * displayW)
            }
        }
        m12Reduce(an * height, ad * width)
    }

    // A one-line description for the media info window, e.g.
    // "MPEG-2 Main@Main, 720×576, 4:2:0, interlaced".
    info: String {
        if !haveSeq {
            return "MPEG video"
        }
        var s = if e.mpeg2 { "MPEG-2" } else { "MPEG-1" }
        if e.mpeg2 && profileLevel > 0 {
            let profiles = ["?", "High", "Spatial", "SNR", "Main", "Simple", "?", "?"]
            let lv = profileLevel & 15
            let level = if lv == 4 { "High" } else if lv == 6 { "High 1440" } else if lv == 8 { "Main" } else if lv == 10 { "Low" } else { "?" }
            if profileLevel & 0x80 != 0 {
                s += " 4:2:2 profile"
            } else {
                s += " {profiles[(profileLevel >> 4) & 7]}@{level}"
            }
        }
        let chroma = if chromaFmt == 1 { "4:2:0" } else if chromaFmt == 2 { "4:2:2" } else { "4:4:4" }
        s += ", {width}×{height}, {chroma}"
        if e.mpeg2 && !progressiveSeq {
            s += ", interlaced"
        }
        s
    }
}

// The largest picture decoded, in samples (4096 × 2304; the three
// frames then take about 340 MB).
let m12MaxArea = 4096 * 2304

// A frame's three planes.
struct M12Frame {
    y: [Int] = []
    u: [Int] = []
    v: [Int] = []
}

fn m12Gcd(_ a: Int, _ b: Int) -> Int {
    var x = a
    var y = b
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    x
}

fn m12Reduce(_ a: Int, _ b: Int) -> (Int, Int) {
    if a <= 0 || b <= 0 {
        return (1, 1)
    }
    let g = m12Gcd(a, b)
    (a / g, b / g)
}

// The fraction closest to a / b whose terms are at most `limit` (by
// continued fractions, as ffmpeg's av_reduce, so pixel shapes read the
// same: 10000/9157 → 178/163).
fn m12Approx(_ a: Int, _ b: Int, _ limit: Int) -> (Int, Int) {
    let (rn, rd) = m12Reduce(a, b)
    if rn <= limit && rd <= limit {
        return (rn, rd)
    }
    var num = rn
    var den = rd
    var p0 = 0
    var q0 = 1
    var p1 = 1
    var q1 = 0
    while den != 0 {
        var x = num / den
        let next = num - den * x
        let p2 = x * p1 + p0
        let q2 = x * q1 + q0
        if p2 > limit || q2 > limit {
            if p1 != 0 {
                x = (limit - p0) / p1
            }
            if q1 != 0 {
                x = min(x, (limit - q0) / q1)
            }
            if den * (2 * x * q1 + q0) > num * q1 {
                p1 = x * p1 + p0
                q1 = x * q1 + q0
            }
            break
        }
        p0 = p1
        q0 = q1
        p1 = p2
        q1 = q2
        num = den
        den = next
    }
    if q1 == 0 {
        return (1, 1)
    }
    (p1, q1)
}

// A decoder for an "mpeg1" or "mpeg2" track. `track.extra` may hold the
// sequence header (and extensions) when the container stores them apart.
public fn newDecoder(_ track: core.Track) -> Result<Decoder> {
    if track.codec != "mpeg1" && track.codec != "mpeg2" {
        return .failure(error: Error("not an MPEG-1/2 video track: {track.codec}"))
    }
    var d = Decoder()
    d.timescale = if track.timescale > 0 { track.timescale } else { 90000 }
    d.trackFpsNum = track.fpsNum
    d.trackFpsDen = track.fpsDen
    d.width = track.width
    d.height = track.height
    if !track.extra.isEmpty {
        let none = d.decode(track.extra, pts: core.noTime, dts: core.noTime, key: false)
        if !none.isEmpty {
            d.warn("pictures in the track's extra data")
        }
    }
    return .ok(value: d)
}

// The description of a track's stream (profile, level, size, chroma),
// read from its sequence header in `extra` or in the first packet.
public fn videoInfo(_ track: core.Track, firstPacket: Data = Data()) -> String {
    match newDecoder(track) {
        .ok(d) -> {
            var dec = d
            if !dec.haveSeq && !firstPacket.isEmpty {
                let pics = dec.decode(firstPacket, pts: core.noTime, dts: core.noTime, key: true)
                if pics.count > 1 {
                    dec.warn("more than one picture")
                }
            }
            dec.info
        }
        .failure(_) -> "MPEG video"
    }
}
