// Macroblock type flags (Tables B.2 to B.4).
let m12Quant = 1
let m12Fwd = 2
let m12Bwd = 4
let m12Pattern = 8
let m12Intra = 16

// Table B.2, macroblock_type in I pictures.
let m12MbTypeICodes = [1, 1, 16, 1, 2, 17]
// Table B.3, macroblock_type in P pictures.
let m12MbTypePCodes = [1, 1, 10, 1, 2, 8, 1, 3, 2, 3, 5, 16, 2, 5, 11, 1, 5, 9, 1, 6, 17]
// Table B.4, macroblock_type in B pictures.
let m12MbTypeBCodes = [2, 2, 6, 3, 2, 14, 2, 3, 4, 3, 3, 12, 2, 4, 2, 3, 4, 10, 3, 5, 16, 2, 5, 15, 3, 6, 11, 2, 6, 13, 1, 6, 17]

// Builds a lookup table from (code, length, value) triples. Layout:
// [0] = root bits R, [1] = longest code L, then 2^R root entries, then
// sub-tables. An entry is value * 32 + length (0 = no such code), or
// -(index * 32 + extra bits) pointing at a sub-table indexed by the next
// bits after the first R.
fn m12Build(_ codes: [Int], rootBits: Int) -> [Int] {
    var maxLen = 0
    var i = 0
    while i < codes.count {
        maxLen = max(maxLen, codes[i + 1])
        i += 3
    }
    let r = min(rootBits, maxLen)
    var t = [r, maxLen]
    for _ in 0..(1 << r) {
        t.append(0)
    }
    // Long codes: how many extra bits each root prefix needs.
    var extra = core.zeros(1 << r)
    i = 0
    while i < codes.count {
        let len = codes[i + 1]
        if len > r {
            let prefix = codes[i] >> (len - r)
            extra[prefix] = max(extra[prefix], len - r)
        }
        i += 3
    }
    for p in 0..(1 << r) {
        if extra[p] > 0 {
            let at = t.count
            t[2 + p] = -(at * 32 + extra[p])
            for _ in 0..(1 << extra[p]) {
                t.append(0)
            }
        }
    }
    i = 0
    while i < codes.count {
        let code = codes[i]
        let len = codes[i + 1]
        let entry = codes[i + 2] * 32 + len
        if len <= r {
            // Fill every root slot that starts with this code.
            let first = code << (r - len)
            for k in 0..(1 << (r - len)) {
                t[2 + first + k] = entry
            }
        } else {
            let prefix = code >> (len - r)
            let e = -t[2 + prefix]
            let at = e >> 5
            let k = e & 31
            let rest = code & ((1 << (len - r)) - 1)
            let first = rest << (k - (len - r))
            for j in 0..(1 << (k - (len - r))) {
                t[at + first + j] = entry
            }
        }
        i += 3
    }
    t
}

let m12DctZero = m12Build(m12DctZeroCodes, rootBits: 8)
let m12DctOne = m12Build(m12DctOneCodes, rootBits: 8)
let m12Mba = m12Build(m12MbaCodes, rootBits: 8)
let m12Cbp = m12Build(m12CbpCodes, rootBits: 9)
let m12Motion = m12Build(m12MotionCodes, rootBits: 10)
let m12DcLuma = m12Build(m12DcLumaCodes, rootBits: 9)
let m12DcChroma = m12Build(m12DcChromaCodes, rootBits: 10)
let m12MbTypeI = m12Build(m12MbTypeICodes, rootBits: 2)
let m12MbTypeP = m12Build(m12MbTypePCodes, rootBits: 6)
let m12MbTypeB = m12Build(m12MbTypeBCodes, rootBits: 6)

