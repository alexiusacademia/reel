// The ProRes slice engine (SMPTE RDD 36 §7): reads one slice's entropy
// coded coefficients (DC differences, then the run/level pairs of all its
// blocks interleaved, §7.1.1), scales them by the quantisation matrix
// times the slice's quantiser (§7.2), and runs the inverse DCT into the
// picture planes (§7.3). The integer IDCT is ffmpeg's ("simple IDCT"
// with ProRes' extra scaling), so pictures match ffmpeg bit for bit:
// 10-bit output for the 4:2:2 profiles, 12-bit for 4444 and 4444 XQ.
//
// Hot state lives in fields of PrEngine and is read by its methods
// (Tessel calls between methods are cheap; lists passed around are not).
//
// Author: Alexius Academia
// Date: 2026-10-25

struct PrEngine {
    // Planes of the frame (whole macroblocks; interlaced frames have both
    // fields' rows) and the one being written (swapped in from y/u/v).
    y: [Int] = []
    u: [Int] = []
    v: [Int] = []
    pl: [Int] = []
    // The other set of planes (the previous frame).
    sy: [Int] = []
    su: [Int] = []
    sv: [Int] = []
    yStride: Int = 0
    cStride: Int = 0
    // 12-bit output (4444 profiles), else 10-bit.
    deep: Bool = false
    // 4:4:4 chroma, else 4:2:2.
    full: Bool = false

    // Coefficients of up to 32 blocks (a slice of 8 macroblocks of 4
    // blocks), raster order, already scaled; zero between slices.
    blk: [Int] = []
    // Per block: the last coded scan index (rowsUpTo turns it into the
    // rows that may hold nonzero coefficients).
    rows: [Int] = []
    tmp: [Int] = []
    // Scan order (raster position of the i-th coefficient) and, per
    // coded index, the bit of its row.
    scan: [Int] = []
    rowsUpTo: [Int] = []
    // Quantisation matrices (luma 0…63, chroma 64…127, raster order) and
    // the same times the slice's quantiser.
    qmat: [Int] = []
    qs: [Int] = []

    // Codeword lookup: for each codebook byte, the start of its table in
    // cbt (or -1), and per 12-bit prefix len << 16 | value (0 = too long).
    cbStart: [Int] = []
    cbt: [Int] = []
    dcCb: [Int] = []
    runCb: [Int] = []
    levCb: [Int] = []
    // cbt offsets of the run codebook for each previous run (0…15) and of
    // the level codebook for each previous level (0…9).
    runOff: [Int] = []
    levOff: [Int] = []
    // Run, level and sign in one lookup: for each state (previous run
    // 0…15 × 10 + previous level 0…9) the start of its table in ctab;
    // entries are length | negative << 5 | run << 6 | (level + 1) << 18 |
    // the next state's table start << 32, or 0 when the three don't fit
    // in 12 bits.
    comboOff: [Int] = []
    ctab: [Int] = []

    // Bit reader over d[bp…be): bits in the low bc bits of bb.
    d: Data = Data()
    bp: Int = 0
    be: Int = 0
    bb: Int = 0
    bc: Int = 0
    endBits: Int = 0
    bad: Bool = false

    fn setup() {
        blk = prZeros(32 * 64)
        rows = prZeros(32)
        tmp = prZeros(64)
        qmat = prZeros(128)
        qs = prZeros(128)
        rowsUpTo = prZeros(64)
        dcCb = prDcCb
        runCb = prRunCb
        levCb = prLevelCb
        setScan(false)
        cbStart = prFilled(256, -1)
        cbt = []
        let size = 1 << prLookBits
        for cb in prAllCbs {
            cbStart[cb] = cbt.count
            for p in 0..size {
                cbt.append(prTableEntry(cb, p))
            }
        }
        runOff = []
        for cb in runCb {
            runOff.append(cbStart[cb])
        }
        levOff = []
        for cb in levCb {
            levOff.append(cbStart[cb])
        }
        // One combined table per distinct (run codebook, level codebook);
        // each entry also holds the table offset of the state it leads to.
        comboOff = []
        ctab = []
        var pairs: [Int] = []
        var pairOff: [Int] = []
        for st in 0..160 {
            let pair = runCb[st / 10] * 256 + levCb[st % 10]
            var at = -1
            for k in 0..pairs.count {
                if pairs[k] == pair {
                    at = pairOff[k]
                }
            }
            if at < 0 {
                at = pairs.count * size
                pairs.append(pair)
                pairOff.append(at)
            }
            comboOff.append(at)
        }
        for k in 0..pairs.count {
            let rcb = pairs[k] >> 8
            let lcb = pairs[k] & 255
            for p in 0..size {
                var e = prComboEntry(rcb, lcb, p)
                if e != 0 {
                    let run = (e >> 6) & 4095
                    let level = (e >> 18) & 16383
                    e = e | (comboOff[min(run, 15) * 10 + min(level, 9)] << 32)
                }
                ctab.append(e)
            }
        }
    }

    fn setScan(_ interlaced: Bool) {
        scan = if interlaced { prInterlacedScan } else { prProgressiveScan }
        var m = 0
        for i in 0..64 {
            m = m | (1 << (scan[i] >> 3))
            rowsUpTo[i] = m
        }
    }

    // ---- Bits ----

    fn startBits(_ data: Data, _ from: Int, _ size: Int) {
        d = data
        bp = from
        be = from + size
        bb = 0
        bc = 0
        endBits = be * 8
    }

    // Loads bytes until more than 48 bits are held (zeros past the end).
    fn refill() {
        if bc <= 32 && bp + 4 <= be {
            // Four bytes at once: up to 64 bits held (the top ones are
            // shifted out as C would; only the low bc bits are used).
            bb = (bb << 32) | d.uint32(at: bp, bigEndian: true)
            bp += 4
            bc += 32
            return
        }
        while bc <= 48 {
            var byte = 0
            if bp < be {
                byte = d[bp]
            }
            bb = (bb << 8) | byte
            bp += 1
            bc += 8
        }
    }

    // One codeword of the given codebook (§7.1.1.1). Returns -1 for a
    // code ffmpeg also rejects (more than 31 bits).
    fn code(_ cb: Int) -> Int {
        if bc < 33 {
            refill()
        }
        let e = cbt[cbStart[cb] + ((bb >> (bc - 12)) & 4095)]
        if e != 0 {
            bc -= e >> 16
            return e & 0xffff
        }
        longCode(cb)
    }

    fn longCode(_ cb: Int) -> Int {
        if bc < 32 {
            refill()
        }
        let buf = (bb >> (bc - 32)) & 0xffffffff
        let sw = cb & 3
        let rice = cb >> 5
        let ex = (cb >> 2) & 7
        var q = 0
        while q < 32 && (buf >> (31 - q)) & 1 == 0 {
            q += 1
        }
        if q > sw {
            let bits = ex - sw + (q << 1)
            if bits > 31 {
                bad = true
                return -1
            }
            bc -= bits
            return (buf >> (32 - bits)) - (1 << ex) + ((sw + 1) << rice)
        }
        if rice > 0 {
            let len = q + 1 + rice
            bc -= len
            return (q << rice) + ((buf >> (32 - len)) & ((1 << rice) - 1))
        }
        bc -= q + 1
        q
    }

    // ---- Coefficients (§7.1.1) ----

    // Reads the coefficients of `count` blocks (a power of two) of one
    // plane from data[from…from+size); q0 is 0 for luma, 64 for chroma.
    // False when the data is damaged.
    fn coefficients(_ data: Data, _ from: Int, _ size: Int, _ count: Int, _ log2: Int, _ q0: Int) -> Bool {
        startBits(data, from, size)
        bad = false
        // DC coefficients (§7.1.1.2): the first coded directly, the rest
        // as differences whose sign flips with the code's low bit.
        var c = code(0xB8)
        if c < 0 {
            return false
        }
        var prev = prWrap16((c >> 1) ^ -(c & 1))
        let qdc = qs[q0]
        blk[0] = prWrap16(prev * qdc)
        rows[0] = 0
        c = 5
        var sign = 0
        for b in 1..count {
            c = code(dcCb[min(c, 6)])
            if c < 0 {
                return false
            }
            if c != 0 {
                sign = sign ^ -(c & 1)
            } else {
                sign = 0
            }
            prev = prWrap16(prev + ((((c + 1) >> 1) ^ sign) - sign))
            blk[b << 6] = prWrap16(prev * qdc)
            rows[b] = 0
        }
        // AC coefficients (§7.1.1.3, §7.1.1.4): runs and levels in scan
        // order, block-interleaved (position = index * count + block).
        // rows[b] keeps the block's last coded index. The bit reader's
        // state is kept in locals here (the hot loop), and handed back to
        // the fields around the rare long codes.
        var run = 4
        var level = 2
        let maxPos = 64 << log2
        let mask = count - 1
        var pos = mask
        var off = comboOff[min(run, 15) * 10 + min(level, 9)]
        var cache = bb
        var cnt = bc
        var at = bp
        let end = be
        let endB = endBits
        while true {
            if cnt < 33 {
                if at + 4 <= end {
                    cache = (cache << 32) | data.uint32(at: at, bigEndian: true)
                    at += 4
                    cnt += 32
                } else {
                    while cnt <= 48 {
                        var byte = 0
                        if at < end {
                            byte = data[at]
                        }
                        cache = (cache << 8) | byte
                        at += 1
                        cnt += 8
                    }
                }
            }
            let left = endB - (at * 8 - cnt)
            if left < 32 {
                if left <= 0 || ((cache >> (cnt - 32)) & 0xffffffff) == 0 {
                    break
                }
            }
            // Run, level and sign together when all three fit in the
            // next 12 bits (the usual case), else one by one.
            let e = ctab[off + ((cache >> (cnt - 12)) & 4095)]
            var neg = false
            if e != 0 {
                cnt -= e & 31
                run = (e >> 6) & 4095
                level = (e >> 18) & 16383
                neg = (e & 32) != 0
                off = e >> 32
            } else {
                bb = cache
                bc = cnt
                bp = at
                run = code(runCb[min(run, 15)])
                if run < 0 {
                    return false
                }
                let l = code(levCb[min(level, 9)])
                if l < 0 {
                    return false
                }
                level = l + 1
                if bc < 1 {
                    refill()
                }
                bc -= 1
                neg = ((bb >> bc) & 1) == 1
                cache = bb
                cnt = bc
                at = bp
                off = comboOff[min(run, 15) * 10 + min(level, 9)]
            }
            pos += run + 1
            if pos >= maxPos {
                return false
            }
            let i = pos >> log2
            let j = scan[i]
            let b = pos & mask
            var val = level * qs[q0 + j]
            if neg {
                val = -val
            }
            if val > 32767 || val < -32768 {
                val = prWrap16(val)
            }
            blk[(b << 6) + j] = val
            rows[b] = i
        }
        true
    }

    // Zeroes every block (after damage left coefficients behind).
    fn clearBlocks() {
        for i in 0..blk.count {
            blk[i] = 0
        }
        for i in 0..32 {
            rows[i] = 0
        }
    }

    // ---- Inverse DCT and output (§7.3) ----

    // Transforms block b and writes it to pl at off (stride in samples),
    // leaving the block zero. 10-bit: ffmpeg's prores_idct_10 (rows keep
    // 2 bits more than its 10-bit simple IDCT: shift 15; columns 18);
    // 12-bit: its int16 12-bit simple IDCT. 8192 added to the DC row
    // centres the output; it's clipped to 4…1019 (or 4…4091).
    fn put(_ b: Int, _ off: Int, _ stride: Int) {
        let m = rowsUpTo[rows[b]]
        rows[b] = 0
        if deep {
            idct12(b, m, off, stride)
        } else {
            idct10(b, m, off, stride)
        }
    }

    // Generated by tests/prores/genidct.py (ffmpeg's simple IDCT: rows
    // shift 15, columns 18, output clipped to 4…1019).
    fn idct10(_ b: Int, _ m: Int, _ off: Int, _ stride: Int) {
        let s = b << 6
        var r0c0 = 0
        var r0c1 = 0
        var r0c2 = 0
        var r0c3 = 0
        var r0c4 = 0
        var r0c5 = 0
        var r0c6 = 0
        var r0c7 = 0
        var r1c0 = 0
        var r1c1 = 0
        var r1c2 = 0
        var r1c3 = 0
        var r1c4 = 0
        var r1c5 = 0
        var r1c6 = 0
        var r1c7 = 0
        var r2c0 = 0
        var r2c1 = 0
        var r2c2 = 0
        var r2c3 = 0
        var r2c4 = 0
        var r2c5 = 0
        var r2c6 = 0
        var r2c7 = 0
        var r3c0 = 0
        var r3c1 = 0
        var r3c2 = 0
        var r3c3 = 0
        var r3c4 = 0
        var r3c5 = 0
        var r3c6 = 0
        var r3c7 = 0
        var r4c0 = 0
        var r4c1 = 0
        var r4c2 = 0
        var r4c3 = 0
        var r4c4 = 0
        var r4c5 = 0
        var r4c6 = 0
        var r4c7 = 0
        var r5c0 = 0
        var r5c1 = 0
        var r5c2 = 0
        var r5c3 = 0
        var r5c4 = 0
        var r5c5 = 0
        var r5c6 = 0
        var r5c7 = 0
        var r6c0 = 0
        var r6c1 = 0
        var r6c2 = 0
        var r6c3 = 0
        var r6c4 = 0
        var r6c5 = 0
        var r6c6 = 0
        var r6c7 = 0
        var r7c0 = 0
        var r7c1 = 0
        var r7c2 = 0
        var r7c3 = 0
        var r7c4 = 0
        var r7c5 = 0
        var r7c6 = 0
        var r7c7 = 0
        if true {
            let x0 = blk[s]
            let x1 = blk[s + 1]
            let x2 = blk[s + 2]
            let x3 = blk[s + 3]
            let x4 = blk[s + 4]
            let x5 = blk[s + 5]
            let x6 = blk[s + 6]
            let x7 = blk[s + 7]
            blk[s] = 0
            blk[s + 1] = 0
            blk[s + 2] = 0
            blk[s + 3] = 0
            blk[s + 4] = 0
            blk[s + 5] = 0
            blk[s + 6] = 0
            blk[s + 7] = 0
            if (x1 | x2 | x3 | x4 | x5 | x6 | x7) == 0 {
                let v = ((((x0 + 1) >> 1) + 32768) & 65535) - 32768 + 8192
                r0c0 = v
                r0c1 = v
                r0c2 = v
                r0c3 = v
                r0c4 = v
                r0c5 = v
                r0c6 = v
                r0c7 = v
            } else {
                var a0 = 16384 * x0 + 16384
                var a1 = a0
                var a2 = a0
                var a3 = a0
                a0 += 21407 * x2
                a1 += 8867 * x2
                a2 -= 8867 * x2
                a3 -= 21407 * x2
                var b0 = 22725 * x1 + 19265 * x3
                var b1 = 19265 * x1 - 4520 * x3
                var b2 = 12873 * x1 - 22725 * x3
                var b3 = 4520 * x1 - 12873 * x3
                if (x4 | x5 | x6 | x7) != 0 {
                    a0 += 16384 * x4 + 8867 * x6
                    a1 += -16384 * x4 - 21407 * x6
                    a2 += -16384 * x4 + 21407 * x6
                    a3 += 16384 * x4 - 8867 * x6
                    b0 += 12873 * x5 + 4520 * x7
                    b1 += -22725 * x5 - 12873 * x7
                    b2 += 4520 * x5 + 19265 * x7
                    b3 += 19265 * x5 - 22725 * x7
                }
                r0c0 = ((((a0 + b0) >> 15) + 32768) & 65535) - 32768 + 8192
                r0c1 = ((((a1 + b1) >> 15) + 32768) & 65535) - 32768 + 8192
                r0c2 = ((((a2 + b2) >> 15) + 32768) & 65535) - 32768 + 8192
                r0c3 = ((((a3 + b3) >> 15) + 32768) & 65535) - 32768 + 8192
                r0c4 = ((((a3 - b3) >> 15) + 32768) & 65535) - 32768 + 8192
                r0c5 = ((((a2 - b2) >> 15) + 32768) & 65535) - 32768 + 8192
                r0c6 = ((((a1 - b1) >> 15) + 32768) & 65535) - 32768 + 8192
                r0c7 = ((((a0 - b0) >> 15) + 32768) & 65535) - 32768 + 8192
            }
        }
        if (m & 2) != 0 {
            let x0 = blk[s + 8]
            let x1 = blk[s + 8 + 1]
            let x2 = blk[s + 8 + 2]
            let x3 = blk[s + 8 + 3]
            let x4 = blk[s + 8 + 4]
            let x5 = blk[s + 8 + 5]
            let x6 = blk[s + 8 + 6]
            let x7 = blk[s + 8 + 7]
            blk[s + 8] = 0
            blk[s + 8 + 1] = 0
            blk[s + 8 + 2] = 0
            blk[s + 8 + 3] = 0
            blk[s + 8 + 4] = 0
            blk[s + 8 + 5] = 0
            blk[s + 8 + 6] = 0
            blk[s + 8 + 7] = 0
            if (x1 | x2 | x3 | x4 | x5 | x6 | x7) == 0 {
                let v = ((((x0 + 1) >> 1) + 32768) & 65535) - 32768
                r1c0 = v
                r1c1 = v
                r1c2 = v
                r1c3 = v
                r1c4 = v
                r1c5 = v
                r1c6 = v
                r1c7 = v
            } else {
                var a0 = 16384 * x0 + 16384
                var a1 = a0
                var a2 = a0
                var a3 = a0
                a0 += 21407 * x2
                a1 += 8867 * x2
                a2 -= 8867 * x2
                a3 -= 21407 * x2
                var b0 = 22725 * x1 + 19265 * x3
                var b1 = 19265 * x1 - 4520 * x3
                var b2 = 12873 * x1 - 22725 * x3
                var b3 = 4520 * x1 - 12873 * x3
                if (x4 | x5 | x6 | x7) != 0 {
                    a0 += 16384 * x4 + 8867 * x6
                    a1 += -16384 * x4 - 21407 * x6
                    a2 += -16384 * x4 + 21407 * x6
                    a3 += 16384 * x4 - 8867 * x6
                    b0 += 12873 * x5 + 4520 * x7
                    b1 += -22725 * x5 - 12873 * x7
                    b2 += 4520 * x5 + 19265 * x7
                    b3 += 19265 * x5 - 22725 * x7
                }
                r1c0 = ((((a0 + b0) >> 15) + 32768) & 65535) - 32768
                r1c1 = ((((a1 + b1) >> 15) + 32768) & 65535) - 32768
                r1c2 = ((((a2 + b2) >> 15) + 32768) & 65535) - 32768
                r1c3 = ((((a3 + b3) >> 15) + 32768) & 65535) - 32768
                r1c4 = ((((a3 - b3) >> 15) + 32768) & 65535) - 32768
                r1c5 = ((((a2 - b2) >> 15) + 32768) & 65535) - 32768
                r1c6 = ((((a1 - b1) >> 15) + 32768) & 65535) - 32768
                r1c7 = ((((a0 - b0) >> 15) + 32768) & 65535) - 32768
            }
        }
        if (m & 4) != 0 {
            let x0 = blk[s + 16]
            let x1 = blk[s + 16 + 1]
            let x2 = blk[s + 16 + 2]
            let x3 = blk[s + 16 + 3]
            let x4 = blk[s + 16 + 4]
            let x5 = blk[s + 16 + 5]
            let x6 = blk[s + 16 + 6]
            let x7 = blk[s + 16 + 7]
            blk[s + 16] = 0
            blk[s + 16 + 1] = 0
            blk[s + 16 + 2] = 0
            blk[s + 16 + 3] = 0
            blk[s + 16 + 4] = 0
            blk[s + 16 + 5] = 0
            blk[s + 16 + 6] = 0
            blk[s + 16 + 7] = 0
            if (x1 | x2 | x3 | x4 | x5 | x6 | x7) == 0 {
                let v = ((((x0 + 1) >> 1) + 32768) & 65535) - 32768
                r2c0 = v
                r2c1 = v
                r2c2 = v
                r2c3 = v
                r2c4 = v
                r2c5 = v
                r2c6 = v
                r2c7 = v
            } else {
                var a0 = 16384 * x0 + 16384
                var a1 = a0
                var a2 = a0
                var a3 = a0
                a0 += 21407 * x2
                a1 += 8867 * x2
                a2 -= 8867 * x2
                a3 -= 21407 * x2
                var b0 = 22725 * x1 + 19265 * x3
                var b1 = 19265 * x1 - 4520 * x3
                var b2 = 12873 * x1 - 22725 * x3
                var b3 = 4520 * x1 - 12873 * x3
                if (x4 | x5 | x6 | x7) != 0 {
                    a0 += 16384 * x4 + 8867 * x6
                    a1 += -16384 * x4 - 21407 * x6
                    a2 += -16384 * x4 + 21407 * x6
                    a3 += 16384 * x4 - 8867 * x6
                    b0 += 12873 * x5 + 4520 * x7
                    b1 += -22725 * x5 - 12873 * x7
                    b2 += 4520 * x5 + 19265 * x7
                    b3 += 19265 * x5 - 22725 * x7
                }
                r2c0 = ((((a0 + b0) >> 15) + 32768) & 65535) - 32768
                r2c1 = ((((a1 + b1) >> 15) + 32768) & 65535) - 32768
                r2c2 = ((((a2 + b2) >> 15) + 32768) & 65535) - 32768
                r2c3 = ((((a3 + b3) >> 15) + 32768) & 65535) - 32768
                r2c4 = ((((a3 - b3) >> 15) + 32768) & 65535) - 32768
                r2c5 = ((((a2 - b2) >> 15) + 32768) & 65535) - 32768
                r2c6 = ((((a1 - b1) >> 15) + 32768) & 65535) - 32768
                r2c7 = ((((a0 - b0) >> 15) + 32768) & 65535) - 32768
            }
        }
        if (m & 8) != 0 {
            let x0 = blk[s + 24]
            let x1 = blk[s + 24 + 1]
            let x2 = blk[s + 24 + 2]
            let x3 = blk[s + 24 + 3]
            let x4 = blk[s + 24 + 4]
            let x5 = blk[s + 24 + 5]
            let x6 = blk[s + 24 + 6]
            let x7 = blk[s + 24 + 7]
            blk[s + 24] = 0
            blk[s + 24 + 1] = 0
            blk[s + 24 + 2] = 0
            blk[s + 24 + 3] = 0
            blk[s + 24 + 4] = 0
            blk[s + 24 + 5] = 0
            blk[s + 24 + 6] = 0
            blk[s + 24 + 7] = 0
            if (x1 | x2 | x3 | x4 | x5 | x6 | x7) == 0 {
                let v = ((((x0 + 1) >> 1) + 32768) & 65535) - 32768
                r3c0 = v
                r3c1 = v
                r3c2 = v
                r3c3 = v
                r3c4 = v
                r3c5 = v
                r3c6 = v
                r3c7 = v
            } else {
                var a0 = 16384 * x0 + 16384
                var a1 = a0
                var a2 = a0
                var a3 = a0
                a0 += 21407 * x2
                a1 += 8867 * x2
                a2 -= 8867 * x2
                a3 -= 21407 * x2
                var b0 = 22725 * x1 + 19265 * x3
                var b1 = 19265 * x1 - 4520 * x3
                var b2 = 12873 * x1 - 22725 * x3
                var b3 = 4520 * x1 - 12873 * x3
                if (x4 | x5 | x6 | x7) != 0 {
                    a0 += 16384 * x4 + 8867 * x6
                    a1 += -16384 * x4 - 21407 * x6
