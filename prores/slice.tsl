    // ---- A slice (§6.3, §7) ----

    // Decodes the slice at data[at…at+size) covering `count` macroblocks
    // from (mbX, mbY). field: -1 for a progressive frame, else 0 for the
    // top field's rows, 1 for the bottom's. False when damaged.
    fn slice(_ data: Data, _ at: Int, _ size: Int, _ mbX: Int, _ mbY: Int, _ count: Int, _ field: Int) -> Bool {
        let hdr = data[at] >> 3
        var q = max(1, min(224, data[at + 1]))
        if q > 128 {
            q = (q - 96) << 2
        }
        let ySize = data.uint16(at: at + 2, bigEndian: true)
        let uSize = data.uint16(at: at + 4, bigEndian: true)
        var vSize = size - ySize - uSize - hdr
        if hdr > 7 {
            vSize = data.uint16(at: at + 6, bigEndian: true)
        }
        if vSize < 0 || hdr + ySize + uSize + vSize > size {
            return false
        }
        for i in 0..128 {
            qs[i] = prWrap16(qmat[i] * q)
        }
        let p = at + hdr
        var ys = yStride
        var cs = cStride
        var yOff = (mbY << 4) * ys + (mbX << 4)
        let cmbW = if full { 16 } else { 8 }
        var cOff = (mbY << 4) * cs + mbX * cmbW
        if field >= 0 {
            ys = ys * 2
            cs = cs * 2
            yOff = (mbY << 4) * ys + (mbX << 4) + field * yStride
            cOff = (mbY << 4) * cs + mbX * cmbW + field * cStride
        }
        let log2Mb = prLog2(count)
        // Luma: four 8×8 blocks per macroblock, in raster order.
        var ok = coefficients(data, p, ySize, count << 2, log2Mb + 2, 0)
        if !ok {
            clearBlocks()
            return false
        }
        swapIn(0)
        var o = yOff
        for mb in 0..count {
            let b = mb << 2
            put(b, o, ys)
            put(b + 1, o + 8, ys)
            put(b + 2, o + 8 * ys, ys)
            put(b + 3, o + 8 * ys + 8, ys)
            o += 16
        }
        swapIn(0)
        // Chroma: two blocks per macroblock (4:2:2, top then bottom) or
        // four (4:4:4: left column top, bottom, then the right column).
        let cl2 = if full { 2 } else { 1 }
        let cCount = count << cl2
        for plane in 1..3 {
            let from = if plane == 1 { p + ySize } else { p + ySize + uSize }
            let len = if plane == 1 { uSize } else { vSize }
            if len > 0 {
                ok = coefficients(data, from, len, cCount, log2Mb + cl2, 64)
                if !ok {
                    clearBlocks()
                    return false
                }
            } else {
                // Some encoders leave chroma empty for gray pictures.
                for b in 0..cCount {
                    rows[b] = 0
                }
            }
            swapIn(plane)
            o = cOff
            var b = 0
            for _ in 0..count {
                put(b, o, cs)
                put(b + 1, o + 8 * cs, cs)
                b += 2
                o += 8
                if full {
                    put(b, o, cs)
                    put(b + 1, o + 8 * cs, cs)
                    b += 2
                    o += 8
                }
            }
            swapIn(plane)
        }
        true
    }

    // Makes the spare set of planes the current one.
    fn rotate() {
        var t = y
        y = sy
        sy = t
        t = u
        u = su
        su = t
        t = v
        v = sv
        sv = t
    }

    // Copies a slice's macroblocks from the previous frame's planes.
    fn concealSlice(_ mbX: Int, _ mbY: Int, _ count: Int, _ field: Int) {
        let step = if field >= 0 { 2 } else { 1 }
        let first = if field >= 0 { field } else { 0 }
        let cw = if full { 16 } else { 8 }
        for r in 0..16 {
            let row = (mbY * 16 + r) * step + first
            let ya = row * yStride + mbX * 16
            if ya + count * 16 <= y.count && ya + count * 16 <= sy.count {
                for x in 0..count * 16 {
                    y[ya + x] = sy[ya + x]
                }
            }
            let ca = row * cStride + mbX * cw
            if ca + count * cw <= u.count && ca + count * cw <= su.count {
                for x in 0..count * cw {
                    u[ca + x] = su[ca + x]
                    v[ca + x] = sv[ca + x]
                }
            }
        }
    }

    // Swaps plane 0 (y), 1 (u) or 2 (v) with pl; called again to put it
    // back.
    fn swapIn(_ plane: Int) {
        if plane == 0 {
            let t = y
            y = pl
            pl = t
        } else if plane == 1 {
            let t = u
            u = pl
            pl = t
        } else {
            let t = v
            v = pl
            pl = t
        }
    }
}

// The table entry for a 12-bit prefix p of a codeword in codebook cb:
// length << 16 | value, or 0 when the code is longer than 12 bits.
fn prTableEntry(_ cb: Int, _ p: Int) -> Int {
    let buf = p << 20
    let sw = cb & 3
    let rice = cb >> 5
    let ex = (cb >> 2) & 7
    var q = 0
    while q < 12 && (buf >> (31 - q)) & 1 == 0 {
        q += 1
    }
    if q >= 12 {
        return 0
    }
    var len = 0
    var val = 0
    if q > sw {
        len = ex - sw + (q << 1)
        if len > 12 {
            return 0
        }
        val = (buf >> (32 - len)) - (1 << ex) + ((sw + 1) << rice)
    } else if rice > 0 {
        len = q + 1 + rice
        if len > 12 {
            return 0
        }
        val = (q << rice) + ((buf >> (32 - len)) & ((1 << rice) - 1))
    } else {
        len = q + 1
        val = q
    }
    (len << 16) | val
}

// The combined run/level/sign entry for a 12-bit prefix p.
fn prComboEntry(_ rcb: Int, _ lcb: Int, _ p: Int) -> Int {
    let r = prTableEntry(rcb, p)
    if r == 0 {
        return 0
    }
    let rlen = r >> 16
    let rest = (p << rlen) & 4095
    let l = prTableEntry(lcb, rest)
    if l == 0 {
        return 0
    }
    let llen = l >> 16
    let len = rlen + llen + 1
    if len > 12 {
        return 0
    }
    let neg = (p >> (12 - len)) & 1
    len | (neg << 5) | ((r & 0xffff) << 6) | (((l & 0xffff) + 1) << 18)
}

// A value as C's int16_t keeps it.
fn prWrap16(_ v: Int) -> Int {
    ((v + 32768) & 65535) - 32768
}

fn prLog2(_ n: Int) -> Int {
    var k = 0
    while (1 << (k + 1)) <= n {
        k += 1
    }
    k
}

fn prZeros(_ n: Int) -> [Int] {
    prFilled(n, 0)
}

fn prFilled(_ n: Int, _ v: Int) -> [Int] {
    var out: [Int] = []
    for _ in 0..n {
        out.append(v)
    }
    out
}
