// Constant tables of Apple ProRes (SMPTE RDD 36): the two coefficient
// scan orders (§7.1.3, progressive and interlaced frames), the adaptive
// codebook choices for DC differences, run lengths and levels (§7.1.1.2
// to §7.1.1.4), and the integer IDCT's weights.
//
// A codebook byte packs a Rice/exp-Golomb hybrid code (§7.1.1.1): bits 7…5
// are the Rice order k, bits 4…2 the exp-Golomb order, bits 1…0 the
// "switch" length (codes with more leading zeros are exp-Golomb).
//
// Author: Alexius Academia
// Date: 2026-10-25

// Scan order: the raster position (row * 8 + column) of the i-th coded
// coefficient of a block.
let prProgressiveScan: [Int] = [
    0, 1, 8, 9, 2, 3, 10, 11,
    16, 17, 24, 25, 18, 19, 26, 27,
    4, 5, 12, 20, 13, 6, 7, 14,
    21, 28, 29, 22, 15, 23, 30, 31,
    32, 33, 40, 48, 41, 34, 35, 42,
    49, 56, 57, 50, 43, 36, 37, 44,
    51, 58, 59, 52, 45, 38, 39, 46,
    53, 60, 61, 54, 47, 55, 62, 63
]

let prInterlacedScan: [Int] = [
    0, 8, 1, 9, 16, 24, 17, 25,
    2, 10, 3, 11, 18, 26, 19, 27,
    32, 40, 33, 34, 41, 48, 56, 49,
    42, 35, 43, 50, 57, 58, 51, 59,
    4, 12, 5, 6, 13, 20, 28, 21,
    14, 7, 15, 22, 29, 36, 44, 37,
    30, 23, 31, 38, 45, 52, 60, 53,
    46, 39, 47, 54, 61, 62, 55, 63
]

// The first DC coefficient's codebook, then the codebook for each next DC
// difference chosen by the previous difference's code (capped at 6).
let prFirstDcCb = 0xB8
let prDcCb: [Int] = [0x04, 0x28, 0x28, 0x4D, 0x4D, 0x70, 0x70]
// Codebooks for a run chosen by the previous run (capped at 15), and for
// a level chosen by the previous level (capped at 9).
let prRunCb: [Int] = [0x06, 0x06, 0x05, 0x05, 0x04, 0x29, 0x29, 0x29, 0x29, 0x28, 0x28, 0x28, 0x28, 0x28, 0x28, 0x4C]
let prLevelCb: [Int] = [0x04, 0x0A, 0x05, 0x06, 0x04, 0x28, 0x28, 0x28, 0x28, 0x4C]

// Every codebook the decoder uses (each gets a lookup table).
let prAllCbs: [Int] = [0xB8, 0x04, 0x28, 0x4D, 0x70, 0x06, 0x05, 0x29, 0x4C, 0x0A]

// Bits looked up at once when reading a codeword.
let prLookBits = 12
