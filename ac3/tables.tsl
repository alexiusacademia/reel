// Bit allocation parameters (Tables 7.6 to 7.11).
let ac3SlowDecayTab: [Int] = [0x0f, 0x11, 0x13, 0x15]
let ac3FastDecayTab: [Int] = [0x3f, 0x53, 0x67, 0x7b]
