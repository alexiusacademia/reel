// One SILK channel decoder (mid or side): RFC 6716 sections 4.2.7.3 to
// 4.2.8 — frame header symbols, excitation pulses, parameter decoding,
// LTP/LPC synthesis — plus packet loss concealment and comfort noise
// (libopus silk/decode_indices.c, decode_pulses.c, shell_coder.c,
// code_signs.c, decode_parameters.c, decode_pitch.c, decode_core.c,
// decode_frame.c, decoder_set_fs.c, PLC.c, CNG.c).
//
// Signal types (section 4.2.7.3): 0 inactive, 1 unvoiced, 2 voiced.
// Conditional coding: 0 independent, 1 independent without LTP scaling,
// 2 conditional (deltas from the previous frame).
//
// Author: Alexius Academia
// Date: 2026-10-25

let silkHarmAttQ15 = [32440, 31130]
let silkPLCRandAttenuateVQ15 = [31130, 26214]
let silkPLCRandAttenuateUVQ15 = [32440, 29491]

struct SilkChannel {
    // --- Frame setup (decoder_set_fs) ---
    fsKHz: Int = 0
    fsAPIHz: Int = 0
    nbSubfr: Int = 0
    frameLength: Int = 0
    subfrLength: Int = 0
    ltpMemLength: Int = 0
    lpcOrder: Int = 0
    // Wideband NLSF codebook (16 coefficients) instead of NB/MB (10).
    wideband: Bool = false
    pitchLagLowBitsICDF: [Int] = []
    pitchContourICDF: [Int] = []
    resampler: SilkResampler = SilkResampler()

    // --- Decoder state ---
    prevGainQ16: Int = 65536
    excQ14: [Int] = []
    sLPCQ14Buf: [Int] = []
    outBuf: [Int] = []
    lagPrev: Int = 0
    lastGainIndex: Int = 0
    prevNLSFQ15: [Int] = []
    firstFrameAfterReset: Bool = true
    nFramesDecoded: Int = 0
    nFramesPerPacket: Int = 0
    ecPrevSignalType: Int = 0
    ecPrevLagIndex: Int = 0
    vadFlags: [Int] = [0, 0, 0]
    lbrrFlag: Int = 0
    lbrrFlags: [Int] = [0, 0, 0]
    lossCnt: Int = 0
    prevSignalType: Int = 0

    // --- Side information of the current frame (SideInfoIndices) ---
    signalType: Int = 0
    quantOffsetType: Int = 0
    gainsIndices: [Int] = [0, 0, 0, 0]
    nlsfIndices: [Int] = []
    nlsfInterpCoefQ2: Int = 4
    lagIndex: Int = 0
    contourIndex: Int = 0
    perIndex: Int = 0
    ltpIndex: [Int] = [0, 0, 0, 0]
    ltpScaleIndex: Int = 0
    seed: Int = 0

    // --- Decoder control (silk_decoder_control), per frame ---
    ctlPitchL: [Int] = [0, 0, 0, 0]
    ctlGainsQ16: [Int] = [0, 0, 0, 0]
    // Two rows of 16: the first and second half of the frame.
    ctlPredCoefQ12: [Int] = []
    ctlLTPCoefQ14: [Int] = []
    ctlLTPScaleQ14: Int = 0

    // --- Comfort noise (silk_CNG_struct) ---
    cngExcBufQ14: [Int] = []
    cngSmthNLSFQ15: [Int] = []
    cngSynthState: [Int] = []
    cngSmthGainQ16: Int = 0
    cngRandSeed: Int = 3176576
    cngFsKHz: Int = 0

    // --- Packet loss concealment (silk_PLC_struct) ---
    plcPitchLQ8: Int = 0
    plcLTPCoefQ14: [Int] = [0, 0, 0, 0, 0]
    plcPrevLPCQ12: [Int] = []
    plcLastFrameLost: Bool = false
    plcRandSeed: Int = 0
    plcRandScaleQ14: Int = 0
    plcConcEnergy: Int = 0
    plcConcEnergyShift: Int = 0
    plcPrevLTPScaleQ14: Int = 0
    plcPrevGainQ16: [Int] = [65536, 65536]
    plcFsKHz: Int = 0
    plcNbSubfr: Int = 2
    plcSubfrLength: Int = 20

    // --- Scratch ---
    pulses: [Int] = []
    sumPulses: [Int] = []
    nLshifts: [Int] = []
    xq: [Int] = []
    sLTP: [Int] = []
    sLTPQ15: [Int] = []
    resQ14: [Int] = []
    sLPCQ14: [Int] = []
    nlsfQ15: [Int] = []
    nlsf0Q15: [Int] = []
    ecIx: [Int] = []
    predQ8: [Int] = []
    resQ10: [Int] = []

    // silk_init_decoder / silk_reset_decoder: everything back to the start.
    fn initState() {
        fsKHz = 0
        fsAPIHz = 0
        nbSubfr = 0
        frameLength = 0
        subfrLength = 0
        ltpMemLength = 0
        lpcOrder = 0
        wideband = false
        pitchLagLowBitsICDF = silkUniform4ICDF
        pitchContourICDF = silkPitchContourNBICDF
        resampler = SilkResampler()
        prevGainQ16 = 65536
        excQ14 = silkZeros(320)
        sLPCQ14Buf = silkZeros(16)
        outBuf = silkZeros(480)
        lagPrev = 0
        lastGainIndex = 0
        prevNLSFQ15 = silkZeros(16)
        firstFrameAfterReset = true
        nFramesDecoded = 0
        nFramesPerPacket = 0
        ecPrevSignalType = 0
        ecPrevLagIndex = 0
        vadFlags = [0, 0, 0]
        lbrrFlag = 0
        lbrrFlags = [0, 0, 0]
        lossCnt = 0
        prevSignalType = 0
        signalType = 0
        quantOffsetType = 0
        gainsIndices = [0, 0, 0, 0]
        nlsfIndices = silkZeros(17)
        nlsfInterpCoefQ2 = 0
        lagIndex = 0
        contourIndex = 0
        perIndex = 0
        ltpIndex = [0, 0, 0, 0]
        ltpScaleIndex = 0
        seed = 0
        ctlPitchL = [0, 0, 0, 0]
        ctlGainsQ16 = [0, 0, 0, 0]
        ctlPredCoefQ12 = silkZeros(32)
        ctlLTPCoefQ14 = silkZeros(20)
        ctlLTPScaleQ14 = 0
        cngExcBufQ14 = silkZeros(320)
        cngSmthNLSFQ15 = silkZeros(16)
        cngSynthState = silkZeros(16)
        cngSmthGainQ16 = 0
        cngRandSeed = 3176576
        cngFsKHz = 0
        plcPitchLQ8 = 0
        plcLTPCoefQ14 = [0, 0, 0, 0, 0]
        plcPrevLPCQ12 = silkZeros(16)
        plcLastFrameLost = false
        plcRandSeed = 0
        plcRandScaleQ14 = 0
        plcConcEnergy = 0
        plcConcEnergyShift = 0
        plcPrevLTPScaleQ14 = 0
        plcPrevGainQ16 = [65536, 65536]
        plcFsKHz = 0
        plcNbSubfr = 2
        plcSubfrLength = 20
        pulses = silkZeros(336)
        sumPulses = silkZeros(21)
        nLshifts = silkZeros(21)
        xq = silkZeros(320)
        sLTP = silkZeros(320)
        sLTPQ15 = silkZeros(640)
        resQ14 = silkZeros(80)
        sLPCQ14 = silkZeros(96)
        nlsfQ15 = silkZeros(16)
        nlsf0Q15 = silkZeros(16)
        ecIx = silkZeros(16)
        predQ8 = silkZeros(16)
        resQ10 = silkZeros(16)
    }

    // silk_decoder_set_fs (output always 48 kHz).
    fn setFs(_ newFsKHz: Int) {
        subfrLength = 5 * newFsKHz
        let newFrameLength = nbSubfr * subfrLength
        if fsKHz != newFsKHz || fsAPIHz != 48000 {
            resampler.setup(fsInHz: newFsKHz * 1000)
            fsAPIHz = 48000
        }
        if fsKHz != newFsKHz || newFrameLength != frameLength {
            if newFsKHz == 8 {
                pitchContourICDF = if nbSubfr == 4 { silkPitchContourNBICDF } else { silkPitchContour10MsNBICDF }
            } else {
                pitchContourICDF = if nbSubfr == 4 { silkPitchContourICDF } else { silkPitchContour10MsICDF }
            }
            if fsKHz != newFsKHz {
                ltpMemLength = 20 * newFsKHz
                if newFsKHz == 8 || newFsKHz == 12 {
                    lpcOrder = 10
                    wideband = false
                } else {
                    lpcOrder = 16
                    wideband = true
                }
                if newFsKHz == 16 {
                    pitchLagLowBitsICDF = silkUniform8ICDF
                } else if newFsKHz == 12 {
                    pitchLagLowBitsICDF = silkUniform6ICDF
                } else {
                    pitchLagLowBitsICDF = silkUniform4ICDF
                }
                firstFrameAfterReset = true
                lagPrev = 100
                lastGainIndex = 10
                prevSignalType = 0
                for i in 0..480 {
                    outBuf[i] = 0
                }
                for i in 0..16 {
                    sLPCQ14Buf[i] = 0
                }
            }
            fsKHz = newFsKHz
            frameLength = newFrameLength
        }
    }

    // NLSF unpacking (section 4.2.7.5.2, silk_NLSF_unpack): which entropy
    // table each stage-2 index uses, and the backward predictor.
    fn nlsfUnpack(_ cb1Index: Int) {
        let order = lpcOrder
        let sel = if wideband { silkNLSFCB2SELECTWB } else { silkNLSFCB2SELECTNBMB }
        let pred = if wideband { silkNLSFPREDWBQ8 } else { silkNLSFPREDNBMBQ8 }
        var at = cb1Index * order / 2
        var i = 0
        while i < order {
            let entry = sel[at]
            at += 1
            ecIx[i] = ((entry >> 1) & 7) * 9
            predQ8[i] = pred[i + (entry & 1) * (order - 1)]
            ecIx[i + 1] = ((entry >> 5) & 7) * 9
            predQ8[i + 1] = pred[i + ((entry >> 4) & 1) * (order - 1) + 1]
            i += 2
        }
    }

    // silk_decode_indices (section 4.2.7.3 to 4.2.7.7).
    fn decodeIndices(_ rc: bind OpusRange, _ frameIndex: Int, _ decodeLBRR: Bool, _ condCoding: Int) {
        // Frame type and quantisation offset (4.2.7.3).
        var ix = 0
        if decodeLBRR || vadFlags[frameIndex] != 0 {
            ix = rc.icdf(silkTypeOffsetVADICDF, 8) + 2
        } else {
            ix = rc.icdf(silkTypeOffsetNoVADICDF, 8)
        }
        signalType = ix >> 1
        quantOffsetType = ix & 1

        // Subframe gains (4.2.7.4).
        if condCoding == 2 {
            gainsIndices[0] = rc.icdf(silkDeltaGainICDF, 8)
        } else {
            gainsIndices[0] = rc.icdfAt(silkGainICDF, signalType * 8, 8) << 3
            gainsIndices[0] += rc.icdf(silkUniform8ICDF, 8)
        }
        for i in 1..nbSubfr {
            gainsIndices[i] = rc.icdf(silkDeltaGainICDF, 8)
        }

        // NLSF indices (4.2.7.5.1-2).
        let cb1ICDF = if wideband { silkNLSFCB1ICDFWB } else { silkNLSFCB1ICDFNBMB }
        let cb2ICDF = if wideband { silkNLSFCB2ICDFWB } else { silkNLSFCB2ICDFNBMB }
        nlsfIndices[0] = rc.icdfAt(cb1ICDF, (signalType >> 1) * 32, 8)
        nlsfUnpack(nlsfIndices[0])
        for i in 0..lpcOrder {
            var v = rc.icdfAt(cb2ICDF, ecIx[i], 8)
            if v == 0 {
                v -= rc.icdf(silkNLSFEXTICDF, 8)
            } else if v == 8 {
                v += rc.icdf(silkNLSFEXTICDF, 8)
            }
            nlsfIndices[i + 1] = v - 4
        }
        // NLSF interpolation (4.2.7.5.5).
        if nbSubfr == 4 {
            nlsfInterpCoefQ2 = rc.icdf(silkNLSFInterpolationFactorICDF, 8)
        } else {
            nlsfInterpCoefQ2 = 4
        }

        if signalType == 2 {
            // Pitch lags (4.2.7.6.1).
            var absolute = true
            if condCoding == 2 && ecPrevSignalType == 2 {
                var delta = rc.icdf(silkPitchDeltaICDF, 8)
                if delta > 0 {
                    delta -= 9
                    lagIndex = ecPrevLagIndex + delta
                    absolute = false
                }
            }
            if absolute {
                lagIndex = rc.icdf(silkPitchLagICDF, 8) * (fsKHz >> 1)
                lagIndex += rc.icdf(pitchLagLowBitsICDF, 8)
            }
            ecPrevLagIndex = lagIndex
            contourIndex = rc.icdf(pitchContourICDF, 8)
            // LTP filter (4.2.7.6.2).
            perIndex = rc.icdf(silkLTPPerIndexICDF, 8)
            for k in 0..nbSubfr {
                if perIndex == 0 {
                    ltpIndex[k] = rc.icdf(silkLTPGainICDF0, 8)
                } else if perIndex == 1 {
                    ltpIndex[k] = rc.icdf(silkLTPGainICDF1, 8)
                } else {
                    ltpIndex[k] = rc.icdf(silkLTPGainICDF2, 8)
                }
            }
            // LTP scaling (4.2.7.6.3).
            if condCoding == 0 {
                ltpScaleIndex = rc.icdf(silkLTPscaleICDF, 8)
            } else {
                ltpScaleIndex = 0
            }
        }
        ecPrevSignalType = signalType
        // LCG seed (4.2.7.7).
        seed = rc.icdf(silkUniform4ICDF, 8)
    }

    // silk_shell_decoder (section 4.2.7.8.3): splits `total` pulses over
    // 16 positions from pulses[base].
    fn shellDecode(_ rc: bind OpusRange, _ base: Int, _ total: Int) {
        let p3a = silkShellSplit(rc, total, silkShellCodeTable3)
        let p3b = total - p3a
        let p2a = silkShellSplit(rc, p3a, silkShellCodeTable2)
        let p2b = p3a - p2a
        var p1a = silkShellSplit(rc, p2a, silkShellCodeTable1)
        var p1b = p2a - p1a
        var c = silkShellSplit(rc, p1a, silkShellCodeTable0)
        pulses[base] = c
        pulses[base + 1] = p1a - c
        c = silkShellSplit(rc, p1b, silkShellCodeTable0)
        pulses[base + 2] = c
        pulses[base + 3] = p1b - c
        p1a = silkShellSplit(rc, p2b, silkShellCodeTable1)
        p1b = p2b - p1a
        c = silkShellSplit(rc, p1a, silkShellCodeTable0)
        pulses[base + 4] = c
        pulses[base + 5] = p1a - c
        c = silkShellSplit(rc, p1b, silkShellCodeTable0)
        pulses[base + 6] = c
        pulses[base + 7] = p1b - c
        let q2a = silkShellSplit(rc, p3b, silkShellCodeTable2)
        let q2b = p3b - q2a
        p1a = silkShellSplit(rc, q2a, silkShellCodeTable1)
        p1b = q2a - p1a
        c = silkShellSplit(rc, p1a, silkShellCodeTable0)
        pulses[base + 8] = c
        pulses[base + 9] = p1a - c
        c = silkShellSplit(rc, p1b, silkShellCodeTable0)
        pulses[base + 10] = c
        pulses[base + 11] = p1b - c
        p1a = silkShellSplit(rc, q2b, silkShellCodeTable1)
        p1b = q2b - p1a
        c = silkShellSplit(rc, p1a, silkShellCodeTable0)
        pulses[base + 12] = c
        pulses[base + 13] = p1a - c
        c = silkShellSplit(rc, p1b, silkShellCodeTable0)
        pulses[base + 14] = c
        pulses[base + 15] = p1b - c
    }

    // silk_decode_pulses (section 4.2.7.8): rate level, pulse counts,
    // shell coding, LSBs and signs, into pulses[0..<frameLength].
    fn decodePulses(_ rc: bind OpusRange, _ sigType: Int, _ qOffType: Int, _ len: Int) {
        let rateLevel = rc.icdfAt(silkRateLevelsICDF, (sigType >> 1) * 9, 8)
        var iter = len >> 4
        if iter * 16 < len {
            iter += 1
        }
        for i in 0..iter {
            nLshifts[i] = 0
            var s = rc.icdfAt(silkPulsesPerBlockICDF, rateLevel * 18, 8)
            while s == 17 {
                nLshifts[i] += 1
                let skipLast = if nLshifts[i] == 10 { 1 } else { 0 }
                s = rc.icdfAt(silkPulsesPerBlockICDF, 9 * 18 + skipLast, 8)
            }
            sumPulses[i] = s
        }
        for i in 0..iter {
            if sumPulses[i] > 0 {
                shellDecode(rc, i * 16, sumPulses[i])
            } else {
                for k in 0..16 {
                    pulses[i * 16 + k] = 0
                }
            }
        }
        // LSBs (4.2.7.8.4).
        for i in 0..iter {
            let nLS = nLshifts[i]
            if nLS > 0 {
                for k in 0..16 {
                    var q = pulses[i * 16 + k]
                    for _ in 0..nLS {
                        q = (q << 1) + rc.icdf(silkLsbICDF, 8)
                    }
                    pulses[i * 16 + k] = q
                }
                sumPulses[i] = sumPulses[i] | (nLS << 5)
            }
        }
        // Signs (4.2.7.8.6, silk_decode_signs).
        let signBase = 7 * (qOffType + (sigType << 1))
        let blocks = (len + 8) >> 4
        for i in 0..blocks {
            let p = sumPulses[i]
            if p > 0 {
                let v = silkSignICDF[signBase + min(p & 31, 6)]
                for j in 0..16 {
                    let q = pulses[i * 16 + j]
                    if q > 0 {
                        if silkDecodeTwo(rc, v) == 0 {
                            pulses[i * 16 + j] = -q
                        }
                    }
                }
            }
        }
    }

    // silk_gains_dequant (section 4.2.7.4).
    fn gainsDequant(_ conditional: Bool) {
        for k in 0..nbSubfr {
            if k == 0 && !conditional {
                lastGainIndex = max(gainsIndices[k], lastGainIndex - 16)
            } else {
                let indTmp = gainsIndices[k] - 4
                let threshold = 2 * 36 - 64 + lastGainIndex
                if indTmp > threshold {
                    lastGainIndex += (indTmp << 1) - threshold
                } else {
                    lastGainIndex += indTmp
                }
            }
            lastGainIndex = silkLimit(lastGainIndex, 0, 63)
            ctlGainsQ16[k] = silkLog2Lin(min(((1907825 * lastGainIndex) >> 16) + 2090, 3967))
        }
    }

    // silk_NLSF_decode (section 4.2.7.5.3): the NLSFs of this frame into
    // nlsfQ15.
    fn nlsfDecode() {
        let order = lpcOrder
        nlsfUnpack(nlsfIndices[0])
        // Predictive residual dequantiser.
        let stepQ16 = if wideband { 9830 } else { 11796 }
        var outQ10 = 0
        var i = order - 1
        while i >= 0 {
            let predQ10 = (outQ10 * predQ8[i]) >> 8
            outQ10 = nlsfIndices[i + 1] << 10
            if outQ10 > 0 {
                outQ10 -= 102
            } else if outQ10 < 0 {
                outQ10 += 102
            }
            outQ10 = silkI16(predQ10 + ((outQ10 * stepQ16) >> 16))
            resQ10[i] = outQ10
            i -= 1
        }
        let cb = if wideband { silkNLSFCB1WBQ8 } else { silkNLSFCB1NBMBQ8 }
        let wght = if wideband { silkNLSFCB1WBWghtQ9 } else { silkNLSFCB1WghtQ9 }
        let base = nlsfIndices[0] * order
        for k in 0..order {
            let tmp = (resQ10[k] << 14) / wght[base + k] + (cb[base + k] << 7)
            nlsfQ15[k] = silkLimit(tmp, 0, 32767)
        }
        let deltaMin = if wideband { silkNLSFDELTAMINWBQ15 } else { silkNLSFDELTAMINNBMBQ15 }
        silkNLSFStabilize(nlsfQ15, deltaMin, order)
    }

    // silk_decode_parameters (sections 4.2.7.4 to 4.2.7.6).
    fn decodeParameters(_ condCoding: Int) {
        gainsDequant(condCoding == 2)
        nlsfDecode()
        silkNLSF2A(ctlPredCoefQ12, 16, nlsfQ15, lpcOrder)
        if firstFrameAfterReset {
            nlsfInterpCoefQ2 = 4
        }
        if nlsfInterpCoefQ2 < 4 {
            for i in 0..lpcOrder {
                nlsf0Q15[i] = prevNLSFQ15[i] + ((nlsfInterpCoefQ2 * (nlsfQ15[i] - prevNLSFQ15[i])) >> 2)
            }
            silkNLSF2A(ctlPredCoefQ12, 0, nlsf0Q15, lpcOrder)
        } else {
            for i in 0..lpcOrder {
                ctlPredCoefQ12[i] = ctlPredCoefQ12[16 + i]
            }
        }
        for i in 0..lpcOrder {
            prevNLSFQ15[i] = nlsfQ15[i]
        }
        // Bandwidth expansion after a loss (BWE_AFTER_LOSS_Q16).
        if lossCnt != 0 {
            silkBwExpander(ctlPredCoefQ12, 0, lpcOrder, 63570)
            silkBwExpander(ctlPredCoefQ12, 16, lpcOrder, 63570)
        }
        if signalType == 2 {
            // Pitch lags (silk_decode_pitch).
            var cbk: [Int] = []
            var cbkSize = 0
            if fsKHz == 8 {
                if nbSubfr == 4 {
                    cbk = silkCBLagsStage2
                    cbkSize = 11
                } else {
                    cbk = silkCBLagsStage210Ms
                    cbkSize = 3
                }
            } else {
                if nbSubfr == 4 {
                    cbk = silkCBLagsStage3
                    cbkSize = 34
                } else {
                    cbk = silkCBLagsStage310Ms
                    cbkSize = 12
                }
            }
            let minLag = 2 * fsKHz
            let maxLag = 18 * fsKHz
            let lag = minLag + lagIndex
            for k in 0..nbSubfr {
                ctlPitchL[k] = silkLimit(lag + cbk[k * cbkSize + contourIndex], minLag, maxLag)
            }
            // LTP coefficients.
            let vq = if perIndex == 0 { silkLTPGainVq0 } else if perIndex == 1 { silkLTPGainVq1 } else { silkLTPGainVq2 }
            for k in 0..nbSubfr {
                let ix = ltpIndex[k]
                for i in 0..5 {
                    ctlLTPCoefQ14[k * 5 + i] = vq[ix * 5 + i] << 7
                }
            }
            ctlLTPScaleQ14 = silkLTPScalesTableQ14[ltpScaleIndex]
        } else {
            for k in 0..nbSubfr {
                ctlPitchL[k] = 0
            }
            for i in 0..(5 * nbSubfr) {
                ctlLTPCoefQ14[i] = 0
            }
            perIndex = 0
            ctlLTPScaleQ14 = 0
        }
    }

    // silk_decode_core (section 4.2.7.9): excitation, LTP and LPC
    // synthesis into xq[0..<frameLength].
    fn decodeCore() {
        let offsetQ10 = silkQuantizationOffsetsQ10[(signalType >> 1) * 2 + quantOffsetType]
        let interpFlag = nlsfInterpCoefQ2 < 4
        // Excitation (4.2.7.8.6-7).
        var randSeed = seed
        for i in 0..frameLength {
            randSeed = silkI32(907633515 + randSeed * 196314165)
            var e = pulses[i] << 14
            if e > 0 {
                e -= 80 << 4
            } else if e < 0 {
                e += 80 << 4
            }
            e += offsetQ10 << 4
            if randSeed < 0 {
                e = -e
            }
            excQ14[i] = e
            randSeed = silkI32(randSeed + pulses[i])
        }
        for i in 0..16 {
            sLPCQ14[i] = sLPCQ14Buf[i]
        }
        var excAt = 0
        var xqAt = 0
        var sLTPBufIdx = ltpMemLength
        let order = lpcOrder
        for k in 0..nbSubfr {
            let aFrom = 16 * (k >> 1)
            let bFrom = k * 5
            var sigType = signalType
            let gainQ10 = ctlGainsQ16[k] >> 6
            var invGainQ31 = silkInverse32VarQ(ctlGainsQ16[k], 47)
            var gainAdjQ16 = 65536
            if ctlGainsQ16[k] != prevGainQ16 {
                gainAdjQ16 = silkDiv32VarQ(prevGainQ16, ctlGainsQ16[k], 16)
                for i in 0..16 {
                    sLPCQ14[i] = silkSMULWW(gainAdjQ16, sLPCQ14[i])
                }
            }
            prevGainQ16 = ctlGainsQ16[k]
            // Avoid an abrupt switch from voiced concealment to unvoiced.
            if lossCnt != 0 && prevSignalType == 2 && signalType != 2 && k < 2 {
                for i in 0..5 {
                    ctlLTPCoefQ14[bFrom + i] = 0
                }
                ctlLTPCoefQ14[bFrom + 2] = 4096
                sigType = 2
                ctlPitchL[k] = lagPrev
            }
            var lag = 0
            if sigType == 2 {
                lag = ctlPitchL[k]
                if k == 0 || (k == 2 && interpFlag) {
                    // Re-whiten the past output with the new coefficients.
                    let startIdx = ltpMemLength - lag - order - 2
                    if k == 2 {
                        for i in 0..(2 * subfrLength) {
                            outBuf[ltpMemLength + i] = xq[i]
                        }
                    }
                    silkLPCAnalysisFilter(sLTP, startIdx, outBuf, startIdx + k * subfrLength, ctlPredCoefQ12, aFrom, ltpMemLength - startIdx, order)
                    if k == 0 {
                        // LTP scaling (4.2.7.6.3).
                        invGainQ31 = silkI32(silkSMULWB(invGainQ31, ctlLTPScaleQ14) << 2)
                    }
                    for i in 0..(lag + 2) {
                        sLTPQ15[sLTPBufIdx - i - 1] = silkSMULWB(invGainQ31, sLTP[ltpMemLength - i - 1])
                    }
                } else if gainAdjQ16 != 65536 {
                    for i in 0..(lag + 2) {
                        sLTPQ15[sLTPBufIdx - i - 1] = silkSMULWW(gainAdjQ16, sLTPQ15[sLTPBufIdx - i - 1])
                    }
                }
            }
            // Long-term prediction (4.2.7.9.1).
            var presFromRes = false
            if sigType == 2 {
                let b0 = ctlLTPCoefQ14[bFrom]
                let b1 = ctlLTPCoefQ14[bFrom + 1]
                let b2 = ctlLTPCoefQ14[bFrom + 2]
                let b3 = ctlLTPCoefQ14[bFrom + 3]
                let b4 = ctlLTPCoefQ14[bFrom + 4]
                var p = sLTPBufIdx - lag + 2
                for i in 0..subfrLength {
                    var ltp = 2
                    ltp += (sLTPQ15[p] * b0) >> 16
                    ltp += (sLTPQ15[p - 1] * b1) >> 16
                    ltp += (sLTPQ15[p - 2] * b2) >> 16
                    ltp += (sLTPQ15[p - 3] * b3) >> 16
                    ltp += (sLTPQ15[p - 4] * b4) >> 16
                    ltp = silkI32(ltp)
                    p += 1
                    let r = silkI32(excQ14[excAt + i] + (ltp << 1))
                    resQ14[i] = r
                    sLTPQ15[sLTPBufIdx] = silkI32(r << 1)
                    sLTPBufIdx += 1
                }
                presFromRes = true
            }
            // Short-term prediction (4.2.7.9.2).
            for i in 0..subfrLength {
                var pred = order >> 1
                let s = 16 + i
                for j in 0..order {
                    pred += (sLPCQ14[s - 1 - j] * ctlPredCoefQ12[aFrom + j]) >> 16
                }
                pred = silkI32(pred)
                let pres = if presFromRes { resQ14[i] } else { excQ14[excAt + i] }
                let v = silkAddSat32(pres, silkLshiftSat32(pred, 4))
                sLPCQ14[s] = v
                xq[xqAt + i] = silkSat16(silkRshiftRound(silkSMULWW(v, gainQ10), 8))
            }
            for i in 0..16 {
                sLPCQ14[i] = sLPCQ14[subfrLength + i]
            }
            excAt += subfrLength
            xqAt += subfrLength
        }
        for i in 0..16 {
            sLPCQ14Buf[i] = sLPCQ14[i]
        }
    }

    // silk_PLC_Reset.
    fn plcReset() {
        plcPitchLQ8 = frameLength << 7
        plcPrevGainQ16 = [65536, 65536]
        plcSubfrLength = 20
        plcNbSubfr = 2
    }

    // silk_PLC_update: remember what a good frame looked like.
    fn plcUpdate() {
        prevSignalType = signalType
        var ltpGain = 0
        if signalType == 2 {
            var j = 0
            while j * subfrLength < ctlPitchL[nbSubfr - 1] {
                if j == nbSubfr {
                    break
                }
                var temp = 0
                for i in 0..5 {
                    temp += ctlLTPCoefQ14[(nbSubfr - 1 - j) * 5 + i]
                }
                if temp > ltpGain {
                    ltpGain = temp
                    for i in 0..5 {
                        plcLTPCoefQ14[i] = ctlLTPCoefQ14[(nbSubfr - 1 - j) * 5 + i]
                    }
                    plcPitchLQ8 = ctlPitchL[nbSubfr - 1 - j] << 8
                }
                j += 1
            }
            for i in 0..5 {
                plcLTPCoefQ14[i] = 0
            }
            plcLTPCoefQ14[2] = ltpGain
            if ltpGain < 11469 {
                let scaleQ10 = (11469 << 10) / max(ltpGain, 1)
                for i in 0..5 {
                    plcLTPCoefQ14[i] = silkI16(silkSMULBB(plcLTPCoefQ14[i], scaleQ10) >> 10)
                }
            } else if ltpGain > 15565 {
                let scaleQ14 = (15565 << 14) / max(ltpGain, 1)
                for i in 0..5 {
                    plcLTPCoefQ14[i] = silkI16(silkSMULBB(plcLTPCoefQ14[i], scaleQ14) >> 14)
                }
            }
        } else {
            plcPitchLQ8 = (fsKHz * 18) << 8
            for i in 0..5 {
                plcLTPCoefQ14[i] = 0
            }
        }
        for i in 0..lpcOrder {
            plcPrevLPCQ12[i] = ctlPredCoefQ12[16 + i]
        }
        plcPrevLTPScaleQ14 = ctlLTPScaleQ14
        plcPrevGainQ16[0] = ctlGainsQ16[nbSubfr - 2]
        plcPrevGainQ16[1] = ctlGainsQ16[nbSubfr - 1]
        plcSubfrLength = subfrLength
        plcNbSubfr = nbSubfr
    }

    // silk_PLC_conceal: extrapolates a lost frame into xq.
    fn plcConceal() {
        let prevGainQ10a = plcPrevGainQ16[0] >> 6
        let prevGainQ10b = plcPrevGainQ16[1] >> 6
        if firstFrameAfterReset {
            for i in 0..16 {
                plcPrevLPCQ12[i] = 0
            }
        }
        // Energies of the last two subframes' excitation (silk_PLC_energy).
        var excBuf = silkZeros(2 * subfrLength)
        for k in 0..2 {
            let g = if k == 0 { prevGainQ10a } else { prevGainQ10b }
            for i in 0..subfrLength {
                excBuf[k * subfrLength + i] = silkSat16(silkSMULWW(excQ14[i + (k + nbSubfr - 2) * subfrLength], g) >> 8)
            }
        }
        let (energy1, shift1) = silkSumSqrShift(excBuf, 0, subfrLength)
        let (energy2, shift2) = silkSumSqrShift(excBuf, subfrLength, subfrLength)
        var randFrom = 0
        if (energy1 >> shift2) < (energy2 >> shift1) {
            randFrom = max(0, (plcNbSubfr - 1) * plcSubfrLength - 128)
        } else {
            randFrom = max(0, plcNbSubfr * plcSubfrLength - 128)
        }
        var randScaleQ14 = plcRandScaleQ14
        let att = min(1, lossCnt)
        let harmGainQ15 = silkHarmAttQ15[att]
        var randGainQ15 = if prevSignalType == 2 { silkPLCRandAttenuateVQ15[att] } else { silkPLCRandAttenuateUVQ15[att] }
        // LPC concealment: bandwidth-expanded previous LPC (BWE_COEF 0.99).
        silkBwExpander(plcPrevLPCQ12, 0, lpcOrder, 64881)
        if lossCnt == 0 {
            randScaleQ14 = 1 << 14
            if prevSignalType == 2 {
                for i in 0..5 {
                    randScaleQ14 -= plcLTPCoefQ14[i]
                }
                randScaleQ14 = max(3277, randScaleQ14)
                randScaleQ14 = silkI16((silkI16(randScaleQ14) * silkI16(plcPrevLTPScaleQ14)) >> 14)
            } else {
                let invGain = silkLPCInversePredGain(plcPrevLPCQ12, 0, lpcOrder)
                var down = min((1 << 30) >> 3, invGain)
                down = max((1 << 30) >> 8, down)
                down = down << 3
                randGainQ15 = silkSMULWB(down, randGainQ15) >> 14
            }
        }
        var randSeed = plcRandSeed
        var lag = silkRshiftRound(plcPitchLQ8, 8)
        var sLTPBufIdx = ltpMemLength
        // Re-whiten the LTP state.
        let idx0 = ltpMemLength - lag - lpcOrder - 2
        silkLPCAnalysisFilter(sLTP, idx0, outBuf, idx0, plcPrevLPCQ12, 0, ltpMemLength - idx0, lpcOrder)
        var invGainQ30 = silkInverse32VarQ(plcPrevGainQ16[1], 46)
        invGainQ30 = min(invGainQ30, silkInt32Max >> 1)
        for i in (idx0 + lpcOrder)..ltpMemLength {
            sLTPQ15[i] = silkSMULWB(invGainQ30, sLTP[i])
        }
        // LTP synthesis.
        for _ in 0..nbSubfr {
            var p = sLTPBufIdx - lag + 2
            for _ in 0..subfrLength {
                var ltp = 2
                ltp += (sLTPQ15[p] * plcLTPCoefQ14[0]) >> 16
                ltp += (sLTPQ15[p - 1] * plcLTPCoefQ14[1]) >> 16
                ltp += (sLTPQ15[p - 2] * plcLTPCoefQ14[2]) >> 16
                ltp += (sLTPQ15[p - 3] * plcLTPCoefQ14[3]) >> 16
                ltp += (sLTPQ15[p - 4] * plcLTPCoefQ14[4]) >> 16
                ltp = silkI32(ltp)
                p += 1
                randSeed = silkI32(907633515 + randSeed * 196314165)
                let ri = (randSeed >> 25) & 127
                sLTPQ15[sLTPBufIdx] = silkI32(silkSMLAWB(ltp, excQ14[randFrom + ri], randScaleQ14) << 2)
                sLTPBufIdx += 1
            }
            for j in 0..5 {
                plcLTPCoefQ14[j] = (harmGainQ15 * plcLTPCoefQ14[j]) >> 15
            }
            randScaleQ14 = (randScaleQ14 * randGainQ15) >> 15
            plcPitchLQ8 = silkSMLAWB(plcPitchLQ8, plcPitchLQ8, 655)
            plcPitchLQ8 = min(plcPitchLQ8, (18 * fsKHz) << 8)
            lag = silkRshiftRound(plcPitchLQ8, 8)
        }
        // LPC synthesis, in place over sLTPQ15 from ltpMemLength - 16.
        let base = ltpMemLength - 16
        for i in 0..16 {
            sLTPQ15[base + i] = sLPCQ14Buf[i]
        }
        for i in 0..frameLength {
            var pred = lpcOrder >> 1
            let s = base + 16 + i
            for j in 0..lpcOrder {
                pred += (sLTPQ15[s - 1 - j] * plcPrevLPCQ12[j]) >> 16
            }
            pred = silkI32(pred)
            let v = silkAddSat32(sLTPQ15[s], silkLshiftSat32(pred, 4))
            sLTPQ15[s] = v
            xq[i] = silkSat16(silkRshiftRound(silkSMULWW(v, prevGainQ10b), 8))
        }
        for i in 0..16 {
            sLPCQ14Buf[i] = sLTPQ15[base + frameLength + i]
        }
        plcRandSeed = randSeed
        plcRandScaleQ14 = randScaleQ14
        for i in 0..4 {
            ctlPitchL[i] = lag
        }
    }

    // silk_PLC: update on a good frame, conceal on a lost one.
    fn plc(_ lost: Bool) {
        if fsKHz != plcFsKHz {
            plcReset()
            plcFsKHz = fsKHz
        }
        if lost {
            plcConceal()
            lossCnt += 1
        } else {
            plcUpdate()
        }
    }

    // silk_PLC_glue_frames: fades from concealment into the next good frame.
    fn plcGlueFrames(_ length: Int) {
        if lossCnt != 0 {
            let (e, s) = silkSumSqrShift(xq, 0, length)
            plcConcEnergy = e
            plcConcEnergyShift = s
            plcLastFrameLost = true
            return
        }
        if plcLastFrameLost {
            var (energy, energyShift) = silkSumSqrShift(xq, 0, length)
            if energyShift > plcConcEnergyShift {
                plcConcEnergy = plcConcEnergy >> (energyShift - plcConcEnergyShift)
            } else if energyShift < plcConcEnergyShift {
                energy = energy >> (plcConcEnergyShift - energyShift)
            }
            if energy > plcConcEnergy {
                let lz = silkCLZ32(plcConcEnergy) - 1
                plcConcEnergy = silkI32(plcConcEnergy << lz)
                energy = energy >> max(24 - lz, 0)
                let fracQ24 = plcConcEnergy / max(energy, 1)
                var gainQ16 = silkSqrtApprox(fracQ24) << 4
                var slopeQ16 = ((1 << 16) - gainQ16) / length
                slopeQ16 = slopeQ16 << 2
                for i in 0..length {
                    xq[i] = (gainQ16 * xq[i]) >> 16
                    gainQ16 += slopeQ16
                    if gainQ16 > 65536 {
                        break
                    }
                }
            }
        }
        plcLastFrameLost = false
    }

    // silk_CNG_Reset.
    fn cngReset() {
        let step = 32767 / (lpcOrder + 1)
        var acc = 0
        for i in 0..lpcOrder {
            acc += step
            cngSmthNLSFQ15[i] = acc
        }
        cngSmthGainQ16 = 0
        cngRandSeed = 3176576
    }

    // silk_CNG: tracks the background noise on inactive frames and adds
    // comfort noise to concealed ones.
    fn cng(_ length: Int) {
        if fsKHz != cngFsKHz {
            cngReset()
            cngFsKHz = fsKHz
        }
        if lossCnt == 0 && prevSignalType == 0 {
            for i in 0..lpcOrder {
                cngSmthNLSFQ15[i] += ((prevNLSFQ15[i] - cngSmthNLSFQ15[i]) * 16348) >> 16
            }
            var maxGain = 0
            var subfr = 0
            for i in 0..nbSubfr {
                if ctlGainsQ16[i] > maxGain {
                    maxGain = ctlGainsQ16[i]
                    subfr = i
                }
            }
            var i = (nbSubfr - 1) * subfrLength - 1
            while i >= 0 {
                cngExcBufQ14[subfrLength + i] = cngExcBufQ14[i]
                i -= 1
            }
            for k in 0..subfrLength {
                cngExcBufQ14[k] = excQ14[subfr * subfrLength + k]
            }
            for k in 0..nbSubfr {
                cngSmthGainQ16 += silkSMULWB(ctlGainsQ16[k] - cngSmthGainQ16, 4634)
                if silkSMULWW(cngSmthGainQ16, 46396) > ctlGainsQ16[k] {
                    cngSmthGainQ16 = ctlGainsQ16[k]
                }
            }
        }
        if lossCnt != 0 {
            var gainQ16 = silkSMULWW(plcRandScaleQ14, plcPrevGainQ16[1])
            if gainQ16 >= (1 << 21) || cngSmthGainQ16 > (1 << 23) {
                gainQ16 = (gainQ16 >> 16) * (gainQ16 >> 16)
                gainQ16 = silkI32((cngSmthGainQ16 >> 16) * (cngSmthGainQ16 >> 16) - silkI32(gainQ16 << 5))
                gainQ16 = silkI32(silkSqrtApprox(gainQ16) << 16)
            } else {
                gainQ16 = silkSMULWW(gainQ16, gainQ16)
                gainQ16 = silkI32(silkSMULWW(cngSmthGainQ16, cngSmthGainQ16) - silkI32(gainQ16 << 5))
                gainQ16 = silkI32(silkSqrtApprox(gainQ16) << 8)
            }
            let gainQ10 = gainQ16 >> 6
            var sig = silkZeros(length + 16)
            var mask = 255
            while mask > length {
                mask = mask >> 1
            }
            var s = cngRandSeed
            for i in 0..length {
                s = silkI32(907633515 + s * 196314165)
                sig[16 + i] = cngExcBufQ14[(s >> 24) & mask]
            }
            cngRandSeed = s
            var a = silkZeros(16)
            silkNLSF2A(a, 0, cngSmthNLSFQ15, lpcOrder)
            for i in 0..16 {
                sig[i] = cngSynthState[i]
            }
            for i in 0..length {
                var pred = lpcOrder >> 1
                for j in 0..lpcOrder {
                    pred += (sig[16 + i - 1 - j] * a[j]) >> 16
                }
                pred = silkI32(pred)
                sig[16 + i] = silkAddSat32(sig[16 + i], silkLshiftSat32(pred, 4))
                xq[i] = silkSat16(xq[i] + silkSat16(silkRshiftRound(silkSMULWW(sig[16 + i], gainQ10), 8)))
            }
            for i in 0..16 {
                cngSynthState[i] = sig[length + i]
            }
        } else {
            for i in 0..lpcOrder {
                cngSynthState[i] = 0
            }
        }
    }

    // silk_decode_frame: one 10 or 20 ms frame into xq[0..<frameLength].
    fn decodeFrame(_ rc: bind OpusRange, _ lost: Bool, _ condCoding: Int) {
        ctlLTPScaleQ14 = 0
        let l = frameLength
        if !lost {
            decodeIndices(rc, nFramesDecoded, false, condCoding)
            decodePulses(rc, signalType, quantOffsetType, frameLength)
            decodeParameters(condCoding)
            decodeCore()
            plc(false)
            lossCnt = 0
            prevSignalType = signalType
            firstFrameAfterReset = false
        } else {
            plc(true)
        }
        // Update the output buffer.
        let mvLen = ltpMemLength - frameLength
        for i in 0..mvLen {
            outBuf[i] = outBuf[frameLength + i]
        }
        for i in 0..frameLength {
            outBuf[mvLen + i] = xq[i]
        }
        cng(l)
        plcGlueFrames(l)
        lagPrev = ctlPitchL[nbSubfr - 1]
    }
}

// decode_split (section 4.2.7.8.3): how many of p pulses go to the first half.
fn silkShellSplit(_ rc: bind OpusRange, _ p: Int, _ table: [Int]) -> Int {
    if p > 0 {
        return rc.icdfAt(table, silkShellCodeTableOffsets[p], 8)
    }
    0
}
