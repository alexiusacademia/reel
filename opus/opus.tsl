// The Opus decoder Reel's player uses: reads the OpusHead setup (RFC 7845
// section 5.1) from the track, decodes each packet of one or more Opus
// streams (RFC 6716; several streams for surround, RFC 7845 section 5.1.1
// channel mapping families 0, 1 and 255) and hands on 48 kHz samples in WAV
// channel order with the header's output gain applied.
//
// Author: Alexius Academia
// Date: 2026-10-25

import "../core"

public struct Decoder {
    rate: Int = 48000
    channels: Int = 2
    layout: [String] = ["FL", "FR"]
    // Pre-skip: samples at the start the player should drop.
    delay: Int = 0
    warnings: [String] = []
    // The header's output gain as a factor.
    gain: Float = 1.0
    family: Int = 0
    // The streams; the first `coupled` ones are stereo.
    streams: [OpusStream] = []
    coupled: Int = 0
    // Per output channel (in WAV order): which decoded channel it is
    // (counting the streams' channels in order), or -1 for silence.
    source: [Int] = []
    // The final range of the last packet's last stream (for tests).
    rangeFinal: Int = 0
    lastFrames: Int = 960
    reportedErrors: Int = 0

    // Decodes one packet (with every stream's part of it). An empty
    // packet conceals one packet's worth of lost audio.
    fn decode(_ packet: Data, pts: Int) -> core.Samples {
        var decoded: [[Float]] = []
        var at = 0
        var frames = -1
        let n = streams.count
        for s in 0..n {
            let last = s == n - 1
            var part: [Float] = []
            if packet.isEmpty {
                let (pcm, _) = streams[s].decodePacket(packet, from: 0, to: 0, lostFrames: lastFrames)
                part = pcm
            } else {
                let (pcm, next) = streams[s].decodePacket(packet, from: at, to: packet.count, selfDelimited: !last)
                part = pcm
                at = next
            }
            let ch = streams[s].channels
            let f = part.count / ch
            if frames < 0 || f < frames {
                frames = f
            }
            decoded.append(part)
        }
        if n > 0 {
            rangeFinal = streams[n - 1].rangeFinal
        }
        var errs = 0
        for s in streams {
            errs += s.errors
        }
        if errs > reportedErrors {
            warnings.append("opus: damaged packet at pts {pts}")
            reportedErrors = errs
        }
        if frames <= 0 {
            return core.Samples(rate: rate, channels: channels, layout: layout, pts: pts)
        }
        lastFrames = frames
        // Map the streams' channels to the output channels.
        var streamOf: [Int] = []
        var chanOf: [Int] = []
        for s in 0..n {
            for c in 0..streams[s].channels {
                streamOf.append(s)
                chanOf.append(c)
            }
        }
        var out: [Float] = []
        let cc = channels
        for _ in 0..(frames * cc) {
            out.append(0.0)
        }
        for oc in 0..cc {
            let src = source[oc]
            if src < 0 || src >= streamOf.count {
                continue
            }
            let s = streamOf[src]
            let c = chanOf[src]
            let sc = streams[s].channels
            let pcm = decoded[s]
            for i in 0..frames {
                out[i * cc + oc] = pcm[i * sc + c] * gain
            }
        }
        core.Samples(rate: rate, channels: cc, data: out, layout: layout, pts: pts)
    }

    // Nothing is held back: Opus output is ready packet by packet.
    fn flush() -> core.Samples {
        core.Samples(rate: rate, channels: channels, layout: layout)
    }

    // After a seek: forget the history (the player drops the first 80 ms
    // or so of output itself if it wants a clean start).
    fn reset() {
        for i in 0..streams.count {
            streams[i].reset()
        }
        lastFrames = 960
    }
}

// Vorbis channel order (RFC 7845 section 5.1.1.2) to WAV order: for each
// WAV-order output channel, its position in the Vorbis order.
fn opusVorbisToWav(_ channels: Int) -> [Int] {
    match channels {
        3 -> [0, 2, 1]
        5 -> [0, 2, 1, 3, 4]
        6 -> [0, 2, 1, 5, 3, 4]
        7 -> [0, 2, 1, 6, 5, 3, 4]
        8 -> [0, 2, 1, 7, 5, 6, 3, 4]
        _ -> {
            var out: [Int] = []
            for i in 0..channels {
                out.append(i)
            }
            out
        }
    }
}

// The WAV-order names of family 1's layouts.
fn opusFamily1Layout(_ channels: Int) -> [String] {
    match channels {
        1 -> ["FC"]
        2 -> ["FL", "FR"]
        3 -> ["FL", "FR", "FC"]
        4 -> ["FL", "FR", "BL", "BR"]
        5 -> ["FL", "FR", "FC", "BL", "BR"]
        6 -> ["FL", "FR", "FC", "LFE", "BL", "BR"]
        7 -> ["FL", "FR", "FC", "LFE", "BC", "SL", "SR"]
        _ -> ["FL", "FR", "FC", "LFE", "BL", "BR", "SL", "SR"]
    }
}

// The setup from an OpusHead packet (RFC 7845 section 5.1). Without one
// (an empty extra), a stereo single stream is assumed, or mono when the
// track says one channel.
public fn newDecoder(_ track: core.Track) -> Result<Decoder> {
    let h = track.extra
    var channels = if track.channels == 1 { 1 } else { 2 }
    var preSkip = 0
    var gainQ8 = 0
    var family = 0
    var nStreams = 1
    var coupled = if channels == 2 { 1 } else { 0 }
    var mapping: [Int] = []
    if h.count >= 19 {
        if h.slice(from: 0, to: 8).latin1 != "OpusHead" {
            return .failure(error: Error("opus: the setup isn't an OpusHead packet"))
        }
        if h[8] >> 4 != 0 {
            return .failure(error: Error("opus: OpusHead version {h[8]} isn't supported"))
        }
        channels = h[9]
        preSkip = h.uint16(at: 10)
        gainQ8 = h.int16(at: 16)
        family = h[18]
        if channels < 1 {
            return .failure(error: Error("opus: OpusHead says 0 channels"))
        }
        if family == 0 {
            if channels > 2 {
                return .failure(error: Error("opus: mapping family 0 with {channels} channels"))
            }
            nStreams = 1
            coupled = if channels == 2 { 1 } else { 0 }
        } else {
            if h.count < 21 + channels {
                return .failure(error: Error("opus: OpusHead channel mapping is cut short"))
            }
            nStreams = h[19]
            coupled = h[20]
            if nStreams < 1 || coupled > nStreams || nStreams + coupled > 255 {
                return .failure(error: Error("opus: bad stream counts {nStreams}/{coupled}"))
            }
            for i in 0..channels {
                mapping.append(h[21 + i])
            }
        }
    } else if !h.isEmpty {
        return .failure(error: Error("opus: OpusHead is too short ({h.count} bytes)"))
    }
    if mapping.isEmpty {
        for i in 0..channels {
            mapping.append(i)
        }
    }
    var d = Decoder(channels: channels)
    d.delay = preSkip
    d.family = family
    d.coupled = coupled
    // 10^(gain / (20 * 256)), as libopus's OPUS_SET_GAIN applies it.
    d.gain = celtExp2(6.48814081e-4 * Float(gainQ8))
    for s in 0..nStreams {
        d.streams.append(newOpusStream(channels: if s < coupled { 2 } else { 1 }))
    }
    let total = nStreams + coupled
    var order: [Int] = []
    if family == 1 && channels <= 8 {
        order = opusVorbisToWav(channels)
        d.layout = opusFamily1Layout(channels)
    } else {
        for i in 0..channels {
            order.append(i)
        }
        d.layout = core.defaultLayout(channels)
        if family > 1 {
            d.warnings.append("opus: channel mapping family {family}: channels have no defined positions")
        }
    }
    for oc in 0..channels {
        let m = mapping[order[oc]]
        d.source.append(if m == 255 || m >= total { -1 } else { m })
    }
    .ok(value: d)
}
