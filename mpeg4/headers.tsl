// Header parsing for MPEG-4 Part 2 Visual (ISO/IEC 14496-2 6.2 and 6.3):
// the Visual Object Sequence and Visual Object (colour facts), the Video
// Object Layer (picture size, interlacing, sprites/GMC, quantiser type and
// matrices, quarter-pel, error resilience tools), user data (which encoder
// made the stream: DivX, Xvid or libavcodec, for bug workarounds), and the
// VOP header of each picture.
//
// Start codes are 00 00 01 xx: 00–1F video_object, 20–2F
// video_object_layer, B0 visual_object_sequence, B2 user_data, B3
// group_of_vop, B5 visual_object, B6 vop.
//
// Author: Alexius Academia
// Date: 2026-10-25

import "../core"

// Reads one VLC symbol from a lookup list made by m4BuildVlc; -1 when the
// bits match no code.
fn m4Vlc(_ br: bind core.BitReader, _ lut: [Int], _ bits: Int) -> Int {
    let e = lut[br.peek(bits)]
    if e == 0 {
        return -1
    }
    br.skip(e & 31)
    e >> 5
}

// n bits as a DCT-style signed number: when the first bit is 0 the value is
// negative, code - (2^n - 1) (7.4.3, dct_dc_differential; also dmv_code).
fn m4XBits(_ br: bind core.BitReader, _ n: Int) -> Int {
    if n == 0 {
        return 0
    }
    let v = br.bits(n)
    if (v >> (n - 1)) == 0 {
        return v - (1 << n) + 1
    }
    v
}

// The Video Object Layer and everything around it that stays the same from
// picture to picture.
struct M4Vol {
    seen: Bool = false
    verid: Int = 1
    voType: Int = 0
    sarNum: Int = 1
    sarDen: Int = 1
    hasSar: Bool = false
    lowDelay: Bool = false
    shape: Int = 0
    timeRes: Int = 25
    timeBits: Int = 5
    fixedRate: Bool = false
    fixedIncrement: Int = 0
    width: Int = 0
    height: Int = 0
    interlaced: Bool = false
    // 0 none, 1 static sprite, 2 GMC (6.3.3 sprite_enable).
    spriteEnable: Int = 0
    spritePoints: Int = 0
    spriteAccuracy: Int = 0
    spriteBrightness: Bool = false
    quantPrecision: Int = 5
    bitsPerPixel: Int = 8
    mpegQuant: Bool = false
    // Raster order.
    intraMatrix: [Int] = []
    interMatrix: [Int] = []
    quarterSample: Bool = false
    complexityDisable: Bool = true
    trashI: Int = 0
    trashP: Int = 0
    trashB: Int = 0
    resyncDisable: Bool = true
    dataPartitioned: Bool = false
    reversibleVlc: Bool = false
    newpred: Bool = false
    reducedRes: Bool = false
    scalability: Bool = false
    // From the visual object's video_signal_type.
    matrixCoefficients: Int = 0
    fullRange: Bool = false
    // Encoder versions from user data (-1 when not seen).
    divxVersion: Int = -1
    divxBuild: Int = -1
    divxPacked: Bool = false
    xvidBuild: Int = -1
    lavcBuild: Int = -1
    // Why the layer can't be decoded ("" when it can).
    unsupported: String = ""

    // visual_object (6.2.2): only the colour description matters here.
    fn parseVisualObject(_ br: bind core.BitReader) {
        if br.flag() {
            let v = br.bits(4)
            br.skip(3)
            if v > 0 {
                verid = v
            }
        }
        let type = br.bits(4)
        if type == 1 || type == 2 {
            if br.flag() {
                br.skip(3)
                fullRange = br.flag()
                if br.flag() {
                    br.skip(8)
                    br.skip(8)
                    matrixCoefficients = br.bits(8)
                }
            }
        }
    }

    // video_object_layer (6.2.3); sets `unsupported` when it can't be
    // decoded.
    fn parseLayer(_ br: bind core.BitReader) {
        unsupported = ""
        br.skip(1)
        voType = br.bits(8)
        if br.flag() {
            let v = br.bits(4)
            br.skip(3)
            if v > 0 {
                verid = v
            }
        }
        let aspect = br.bits(4)
        hasSar = true
        if aspect == 1 {
            sarNum = 1
            sarDen = 1
        } else if aspect == 2 {
            sarNum = 12
            sarDen = 11
        } else if aspect == 3 {
            sarNum = 10
            sarDen = 11
        } else if aspect == 4 {
            sarNum = 16
            sarDen = 11
        } else if aspect == 5 {
            sarNum = 40
            sarDen = 33
        } else if aspect == 15 {
            sarNum = br.bits(8)
            sarDen = br.bits(8)
            if sarNum == 0 || sarDen == 0 {
                sarNum = 1
                sarDen = 1
            }
        } else {
            hasSar = false
        }
        if br.flag() {
            let chroma = br.bits(2)
            if chroma != 1 {
                unsupported = "chroma format {chroma} (only 4:2:0)"
            }
            lowDelay = br.flag()
            if br.flag() {
                // vbv_parameters: 15+1+15+1+15+1+3+11+1+15+1 bits.
                br.skip(79)
            }
        } else {
            // Simple profiles have no B-VOPs.
            lowDelay = voType == 1
        }
        shape = br.bits(2)
        if shape == 3 && verid != 1 {
            br.skip(4)
        }
        br.skip(1)
        timeRes = br.bits(16)
        if timeRes == 0 {
            timeRes = 1
        }
        var b = 0
        while (1 << b) < timeRes {
            b += 1
        }
        timeBits = max(b, 1)
        br.skip(1)
        fixedRate = br.flag()
        if fixedRate {
            fixedIncrement = br.bits(timeBits)
        }
        if shape != 0 {
            unsupported = "non-rectangular video object shape {shape}"
            return
        }
        br.skip(1)
        width = br.bits(13)
        br.skip(1)
        height = br.bits(13)
        br.skip(1)
        interlaced = br.flag()
        br.skip(1)
        spriteEnable = if verid == 1 { br.bits(1) } else { br.bits(2) }
        if spriteEnable == 1 || spriteEnable == 2 {
            if spriteEnable != 2 {
                // sprite_width, height, left, top with markers.
                br.skip(56)
            }
            spritePoints = br.bits(6)
            spriteAccuracy = br.bits(2)
            spriteBrightness = br.flag()
            if spriteEnable != 2 {
                br.skip(1)
            }
            if spriteEnable == 1 {
                unsupported = "static sprites"
            }
        }
        if br.flag() {
            quantPrecision = br.bits(4)
            bitsPerPixel = br.bits(4)
            if bitsPerPixel != 8 {
                unsupported = "{bitsPerPixel}-bit video"
            }
        } else {
            quantPrecision = 5
            bitsPerPixel = 8
        }
        mpegQuant = br.flag()
        intraMatrix = m4DefaultIntraMatrix
        interMatrix = m4DefaultInterMatrix
        if mpegQuant {
            if br.flag() {
                intraMatrix = m4ReadMatrix(br)
            }
            if br.flag() {
                interMatrix = m4ReadMatrix(br)
            }
        }
        quarterSample = if verid != 1 { br.flag() } else { false }
        complexityDisable = br.flag()
        trashI = 0
        trashP = 0
        trashB = 0
        if !complexityDisable {
            parseComplexity(br)
        }
        resyncDisable = br.flag()
        dataPartitioned = br.flag()
        reversibleVlc = false
        if dataPartitioned {
            reversibleVlc = br.flag()
        }
        newpred = false
        reducedRes = false
        if verid != 1 {
            newpred = br.flag()
            if newpred {
                br.skip(3)
                unsupported = "NEWPRED"
            }
            reducedRes = br.flag()
        }
        scalability = br.flag()
        if scalability {
            unsupported = "scalable layers"
        }
        if width <= 0 || height <= 0 || width > 4096 || height > 4096 {
            unsupported = "picture size {width}x{height}"
        }
        seen = unsupported.isEmpty
    }

    // define_vop_complexity_estimation_header (6.2.3.1): only how many
    // bits each kind of VOP header then carries matters (they're skipped).
    fn parseComplexity(_ br: bind core.BitReader) {
        let method = br.bits(2)
        if method >= 2 {
            return
        }
        if !br.flag() {
            for _ in 0..6 {
                trashI += 8 * br.bits(1)
            }
        }
        if !br.flag() {
            trashI += 8 * br.bits(1)
            trashP += 8 * br.bits(1)
            trashP += 8 * br.bits(1)
            trashI += 8 * br.bits(1)
        }
        br.skip(1)
        if !br.flag() {
            trashI += 8 * br.bits(1)
            trashI += 8 * br.bits(1)
            trashI += 8 * br.bits(1)
            trashI += 4 * br.bits(1)
        }
        if !br.flag() {
            trashP += 8 * br.bits(1)
            trashP += 8 * br.bits(1)
            trashB += 8 * br.bits(1)
            trashP += 8 * br.bits(1)
            trashP += 8 * br.bits(1)
            trashP += 8 * br.bits(1)
        }
        br.skip(1)
        if method == 1 {
            trashI += 8 * br.bits(1)
            trashP += 8 * br.bits(1)
        }
    }

    // user_data: "DivX503b1393p", "XviD0050", "Lavc62.28.102".
    fn parseUserData(_ data: Data, from: Int, to: Int) {
        let text = data.slice(from: from, to: min(to, from + 64)).latin1
        let chars = text.characters
        if text.hasPrefix("DivX") {
            var i = 4
            var digits = ""
            while i < chars.count && "0123456789".contains(chars[i]) {
                digits += chars[i]
                i += 1
            }
            if let v = Int(digits) {
                divxVersion = v
            }
            if i < chars.count && (chars[i] == "b" || chars[i] == "B") {
                i += 1
                var bd = ""
                while i < chars.count && "0123456789".contains(chars[i]) {
                    bd += chars[i]
                    i += 1
                }
                divxBuild = Int(bd) ?? -1
            }
            if i < chars.count && chars[i] == "p" {
                divxPacked = true
            }
        } else if text.hasPrefix("XviD") {
            xvidBuild = Int(text.substring(from: 4, to: min(text.count, 8))) ?? -1
        } else if text.hasPrefix("Lavc") {
            let parts = text.substring(from: 4, to: text.count).split(".")
            if parts.count >= 3 {
                var last = ""
                for c in parts[2].characters {
                    if "0123456789".contains(c) {
                        last += c
                    } else {
                        break
                    }
                }
                let a = Int(parts[0]) ?? 0
                let b = Int(parts[1]) ?? 0
                let c = Int(last) ?? 0
                lavcBuild = (a << 16) + (b << 8) + c
            }
        }
    }
}

// A quantiser matrix: up to 64 values in zigzag order, ended early by a 0
// (the last value then fills the rest) (6.3.3).
fn m4ReadMatrix(_ br: bind core.BitReader) -> [Int] {
    var m = m4Zeros(64)
    var last = 0
    var i = 0
    while i < 64 {
        let v = br.bits(8)
        if v == 0 {
            break
        }
        last = v
        m[m4Zigzag[i]] = v
        i += 1
    }
    while i < 64 {
        m[m4Zigzag[i]] = last
        i += 1
    }
    m
}

// The VOP header (6.2.5) of one picture.
struct M4Vop {
    // 0 I, 1 P, 2 B, 3 S.
    type: Int = 0
    moduloTime: Int = 0
    timeIncrement: Int = 0
    coded: Bool = true
    rounding: Int = 0
    intraDcThr: Int = 0
    topFieldFirst: Bool = false
    altScan: Bool = false
    quant: Int = 1
    fcodeF: Int = 1
    fcodeB: Int = 1
    // Sprite trajectory: dx, dy of up to four warping points (in
    // 1/(2^(accuracy+1)) samples).
    traj: [Int] = [0, 0, 0, 0, 0, 0, 0, 0]
    problem: String = ""

    fn parse(_ br: bind core.BitReader, _ vol: M4Vol) {
        problem = ""
        type = br.bits(2)
        moduloTime = 0
        while br.bits(1) == 1 {
            moduloTime += 1
            if br.overrun || moduloTime > 1000 {
                problem = "damaged VOP header"
                return
            }
        }
        br.skip(1)
        timeIncrement = br.bits(vol.timeBits)
        br.skip(1)
        coded = br.flag()
        if !coded {
            return
        }
        rounding = 0
        if type == 1 || (type == 3 && vol.spriteEnable == 2) {
            rounding = br.bits(1)
        }
        if vol.reducedRes && (type == 0 || type == 1) {
            if br.flag() {
                problem = "reduced resolution VOP"
                return
            }
        }
        if !vol.complexityDisable {
            br.skip(vol.trashI)
            if type != 0 {
                br.skip(vol.trashP)
            }
            if type == 2 {
                br.skip(vol.trashB)
            }
        }
        intraDcThr = br.bits(3)
        topFieldFirst = false
        altScan = false
        if vol.interlaced {
            topFieldFirst = br.flag()
            altScan = br.flag()
        }
        if type == 3 && (vol.spriteEnable == 1 || vol.spriteEnable == 2) {
            if vol.spritePoints > 0 {
                parseTrajectory(br, vol)
            }
            if vol.spriteBrightness {
                problem = "sprite brightness change"
                return
            }
            if vol.spriteEnable == 1 {
                problem = "static sprite"
                return
            }
        }
        quant = br.bits(vol.quantPrecision)
        if quant == 0 {
            problem = "quantiser 0"
            return
        }
        fcodeF = 1
        fcodeB = 1
        if type != 0 {
            fcodeF = br.bits(3)
            if fcodeF == 0 {
                problem = "fcode 0"
                return
            }
        }
        if type == 2 {
            fcodeB = br.bits(3)
            if fcodeB == 0 {
                problem = "fcode 0"
                return
            }
        }
        if br.overrun {
            problem = "VOP header cut short"
        }
    }

    // sprite_trajectory (6.2.5.4): each point's dmv as a length code then
    // that many bits, with marker bits.
    fn parseTrajectory(_ br: bind core.BitReader, _ vol: M4Vol) {
        traj = [0, 0, 0, 0, 0, 0, 0, 0]
        for i in 0..min(vol.spritePoints, 4) {
            var len = m4Vlc(br, m4Sprite, m4SpriteBits)
            if len < 0 {
                problem = "damaged sprite trajectory"
                return
            }
            traj[2 * i] = m4XBits(br, len)
            if !(vol.divxVersion == 500 && vol.divxBuild == 413) {
                br.skip(1)
            }
            len = m4Vlc(br, m4Sprite, m4SpriteBits)
            if len < 0 {
                problem = "damaged sprite trajectory"
                return
            }
            traj[2 * i + 1] = m4XBits(br, len)
            br.skip(1)
        }
    }
}
