let m4IntraLastFrom = 67

// Coefficient lookup entries: length (5 bits), then level (5 bits), run
// (6 bits) and last (1 bit). The escape code has level 0.
let m4CoefBits = 12

fn m4BuildCoef(_ codes: [Int], _ lens: [Int], _ runs: [Int], _ levels: [Int], lastFrom: Int) -> [Int] {
    var values: [Int] = []
    for i in 0..codes.count {
        if i < runs.count {
            let last = if i >= lastFrom { 1 } else { 0 }
            values.append(levels[i] | (runs[i] << 5) | (last << 11))
        } else {
            values.append(0)
        }
    }
    m4BuildVlc(codes, lens, values, bits: 12)
}

let m4IntraCoef = m4BuildCoef(m4IntraCodes, m4IntraLens, m4IntraRun, m4IntraLevel, lastFrom: m4IntraLastFrom)
let m4InterCoef = m4BuildCoef(m4InterCodes, m4InterLens, m4InterRun, m4InterLevel, lastFrom: m4InterLastFrom)

// LMAX(last, run) and RMAX(last, level) for the escape codes (7.4.1.3):
// index last * 64 + run, and last * 64 + level.
fn m4MaxLevel(_ runs: [Int], _ levels: [Int], lastFrom: Int) -> [Int] {
    var out = m4Zeros(128)
    for i in 0..runs.count {
        let last = if i >= lastFrom { 1 } else { 0 }
        let k = last * 64 + runs[i]
        out[k] = max(out[k], levels[i])
    }
    out
}

fn m4MaxRun(_ runs: [Int], _ levels: [Int], lastFrom: Int) -> [Int] {
    var out = m4Zeros(128)
    for i in 0..runs.count {
        let last = if i >= lastFrom { 1 } else { 0 }
        let k = last * 64 + levels[i]
        out[k] = max(out[k], runs[i])
    }
    out
}

let m4IntraLmax = m4MaxLevel(m4IntraRun, m4IntraLevel, lastFrom: m4IntraLastFrom)
let m4IntraRmax = m4MaxRun(m4IntraRun, m4IntraLevel, lastFrom: m4IntraLastFrom)
let m4InterLmax = m4MaxLevel(m4InterRun, m4InterLevel, lastFrom: m4InterLastFrom)
let m4InterRmax = m4MaxRun(m4InterRun, m4InterLevel, lastFrom: m4InterLastFrom)

fn m4Zeros(_ n: Int) -> [Int] {
    var out: [Int] = []
    for _ in 0..n {
        out.append(0)
    }
    out
}

