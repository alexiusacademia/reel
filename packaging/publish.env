# Where Reel's releases go. Read by tools/gcs-setup.sh and the publish
# scripts. Nothing here is secret.
#
# The bucket is public to read: the website's download buttons fetch from it.
# It lives in Tally's project, like the other apps' release buckets, which has
# billing and the exception that lets a bucket be public.
#
# Author: Alexius Academia
# Date: 2026-10-27
REEL_GCS_PROJECT=syncster-tally
REEL_GCS_BUCKET=reel-releases
REEL_GCS_REGION=asia-southeast1
REEL_PUBLIC_BASE=https://storage.googleapis.com/reel-releases
# The website deploys itself from git: Netlify project "reel-syncster" builds website/
# on every push to main.
REEL_SITE_URL=https://reel.syncster.dev
