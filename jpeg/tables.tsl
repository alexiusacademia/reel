// The canonical codes of a DHT table (Annex C): (code, length, symbol)
// triples. Empty when the counts don't make a valid code.
fn jpgCodes(_ bits: [Int], _ vals: [Int]) -> [Int] {
    var out: [Int] = []
    var code = 0
    var k = 0
    for len in 1..17 {
        let n = bits[len - 1]
        for _ in 0..n {
            if k >= vals.count || code >= (1 << len) {
                return []
            }
            out.append(code)
            out.append(len)
            out.append(vals[k])
            code += 1
            k += 1
        }
        code = code << 1
    }
    out
}

// A two-level lookup table from (code, length, value) triples: [0] =
// root bits R, [1] = longest code L, then 2^R root entries and the
// sub-tables. An entry is value * 32 + length (0 = no such code) or
// -(index * 32 + extra bits) for a sub-table.
fn jpgBuild(_ codes: [Int], rootBits: Int) -> [Int] {
    var maxLen = 1
    var i = 0
    while i < codes.count {
        maxLen = max(maxLen, codes[i + 1])
        i += 3
    }
    let r = min(rootBits, maxLen)
    var t = [r, maxLen]
    for _ in 0..(1 << r) {
        t.append(0)
    }
    var extra = core.zeros(1 << r)
    i = 0
    while i < codes.count {
        let len = codes[i + 1]
        if len > r {
            let prefix = codes[i] >> (len - r)
            extra[prefix] = max(extra[prefix], len - r)
        }
        i += 3
    }
    for p in 0..(1 << r) {
        if extra[p] > 0 {
            let at = t.count
            t[2 + p] = -(at * 32 + extra[p])
            for _ in 0..(1 << extra[p]) {
                t.append(0)
            }
        }
    }
    i = 0
    while i < codes.count {
        let code = codes[i]
        let len = codes[i + 1]
        let entry = codes[i + 2] * 32 + len
        if len <= r {
            let first = code << (r - len)
            for k in 0..(1 << (r - len)) {
                t[2 + first + k] = entry
            }
        } else {
            let prefix = code >> (len - r)
            let e = -t[2 + prefix]
            let at = e >> 5
            let k = e & 31
            let rest = code & ((1 << (len - r)) - 1)
            let first = rest << (k - (len - r))
            for j in 0..(1 << (k - (len - r))) {
                t[at + first + j] = entry
            }
        }
        i += 3
    }
    t
}

let jpgDefaultDcLuma = jpgBuild(jpgCodes(jpgDcLumaBits, jpgDcLumaVals), rootBits: 9)
let jpgDefaultDcChroma = jpgBuild(jpgCodes(jpgDcChromaBits, jpgDcChromaVals), rootBits: 9)
let jpgDefaultAcLuma = jpgBuild(jpgCodes(jpgAcLumaBits, jpgAcLumaVals), rootBits: 9)
let jpgDefaultAcChroma = jpgBuild(jpgCodes(jpgAcChromaBits, jpgAcChromaVals), rootBits: 9)

// ---- Inverse DCT (Annex A.3.3) ----

let jpgW1 = 22725
let jpgW2 = 21407
let jpgW3 = 19266
let jpgW4 = 16383
let jpgW5 = 12873
let jpgW6 = 8867
let jpgW7 = 4520

fn jpgIdctRows(_ b: bind [Int]) {
    var r = 0
    while r < 64 {
        let x0 = b[r]
        let x1 = b[r + 1]
        let x2 = b[r + 2]
        let x3 = b[r + 3]
        let x4 = b[r + 4]
        let x5 = b[r + 5]
        let x6 = b[r + 6]
        let x7 = b[r + 7]
        if (x0 | x1 | x2 | x3 | x4 | x5 | x6 | x7) != 0 {
            var a0 = jpgW4 * x0 + 1024
            var a1 = a0
            var a2 = a0
            var a3 = a0
            a0 += jpgW2 * x2
            a1 += jpgW6 * x2
            a2 -= jpgW6 * x2
            a3 -= jpgW2 * x2
            var b0 = jpgW1 * x1 + jpgW3 * x3
            var b1 = jpgW3 * x1 - jpgW7 * x3
            var b2 = jpgW5 * x1 - jpgW1 * x3
            var b3 = jpgW7 * x1 - jpgW5 * x3
            if (x4 | x5 | x6 | x7) != 0 {
                a0 += jpgW4 * x4 + jpgW6 * x6
                a1 += -jpgW4 * x4 - jpgW2 * x6
                a2 += -jpgW4 * x4 + jpgW2 * x6
                a3 += jpgW4 * x4 - jpgW6 * x6
                b0 += jpgW5 * x5 + jpgW7 * x7
                b1 += -jpgW1 * x5 - jpgW5 * x7
                b2 += jpgW7 * x5 + jpgW3 * x7
                b3 += jpgW3 * x5 - jpgW1 * x7
            }
            b[r] = (a0 + b0) >> 11
            b[r + 7] = (a0 - b0) >> 11
            b[r + 1] = (a1 + b1) >> 11
            b[r + 6] = (a1 - b1) >> 11
            b[r + 2] = (a2 + b2) >> 11
            b[r + 5] = (a2 - b2) >> 11
            b[r + 3] = (a3 + b3) >> 11
            b[r + 4] = (a3 - b3) >> 11
        }
        r += 8
    }
}

fn jpgClip(_ v: Int) -> Int {
    if v < 0 {
        return 0
    }
    if v > 255 {
        return 255
    }
    v
}

// Transforms block b (raster order, dequantized, DC including the +1024
// level shift) and writes it to dst[off …], rows `stride` apart. The
// block is left zeroed.
fn jpgIdctPut(_ b: bind [Int], _ dst: bind [Int], _ off: Int, _ stride: Int) {
    jpgIdctRows(b)
    for c in 0..8 {
        let x0 = b[c]
        let x1 = b[c + 8]
        let x2 = b[c + 16]
        let x3 = b[c + 24]
        let x4 = b[c + 32]
        let x5 = b[c + 40]
        let x6 = b[c + 48]
        let x7 = b[c + 56]
        var a0 = jpgW4 * (x0 + 32)
        var a1 = a0
        var a2 = a0
        var a3 = a0
        a0 += jpgW2 * x2
        a1 += jpgW6 * x2
        a2 -= jpgW6 * x2
        a3 -= jpgW2 * x2
        var b0 = jpgW1 * x1 + jpgW3 * x3
        var b1 = jpgW3 * x1 - jpgW7 * x3
        var b2 = jpgW5 * x1 - jpgW1 * x3
        var b3 = jpgW7 * x1 - jpgW5 * x3
        if (x4 | x5 | x6 | x7) != 0 {
            a0 += jpgW4 * x4 + jpgW6 * x6
            a1 += -jpgW4 * x4 - jpgW2 * x6
            a2 += -jpgW4 * x4 + jpgW2 * x6
            a3 += jpgW4 * x4 - jpgW6 * x6
            b0 += jpgW5 * x5 + jpgW7 * x7
            b1 += -jpgW1 * x5 - jpgW5 * x7
            b2 += jpgW7 * x5 + jpgW3 * x7
            b3 += jpgW3 * x5 - jpgW1 * x7
        }
        let s = stride
        dst[off + c] = jpgClip((a0 + b0) >> 20)
        dst[off + s + c] = jpgClip((a1 + b1) >> 20)
        dst[off + 2 * s + c] = jpgClip((a2 + b2) >> 20)
        dst[off + 3 * s + c] = jpgClip((a3 + b3) >> 20)
        dst[off + 4 * s + c] = jpgClip((a3 - b3) >> 20)
        dst[off + 5 * s + c] = jpgClip((a2 - b2) >> 20)
        dst[off + 6 * s + c] = jpgClip((a1 - b1) >> 20)
        dst[off + 7 * s + c] = jpgClip((a0 - b0) >> 20)
    }
    for i in 0..64 {
        b[i] = 0
    }
}
