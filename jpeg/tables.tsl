// JPEG (ITU-T T.81): the zig-zag order, the example Huffman tables of
// Annex K.3 (which Motion-JPEG frames without a DHT segment use, as
// AVI1 MJPEG files expect), the Huffman lookup tables built from DHT
// segments, and the inverse DCT.
//
// The IDCT is the integer "simple IDCT" also used by the mpeg12 module
// (constants cos(k·π/16)·√2·2^14, rows rounded to 11 fractional bits,
// columns to 20), in the form ffmpeg's ARM NEON code computes it, so
// pictures can match ffmpeg's bit for bit.
//
// Author: Alexius Academia
// Date: 2026-10-25

import "../core"

// Zig-zag order (Figure A.6): position in the coded order → raster index.
let jpgZigZag = [
    0, 1, 8, 16, 9, 2, 3, 10, 17, 24, 32, 25, 18, 11, 4, 5,
    12, 19, 26, 33, 40, 48, 41, 34, 27, 20, 13, 6, 7, 14, 21, 28,
    35, 42, 49, 56, 57, 50, 43, 36, 29, 22, 15, 23, 30, 37, 44, 51,
    58, 59, 52, 45, 38, 31, 39, 46, 53, 60, 61, 54, 47, 55, 62, 63,
]

// Annex K.3, Tables K.3 to K.6: code counts per length (BITS) and the
