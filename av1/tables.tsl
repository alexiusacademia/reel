// Every constant table of the AV1 specification (scan orders, default
// CDFs, interpolation, warp, CDEF, loop restoration and upscaling
// filters, quantizer lookups and matrices, the film grain Gaussian
// sequence ...), generated from the spec sources by
// build/scratch/av1/gen/gentables.py. The tables are packed in one base64
// blob (long list literals compile slowly) and unpacked once at start.
// Each table keeps its spec name in camel case with an "av1" prefix and
// is flattened row by row; its dimensions are in the comment beside it.
//
// The CDF context: all Tile...Cdf arrays of the spec live in one flat
// [Int] of av1CdfSize entries; cfX is the offset of array X. Each CDF
// of N symbols takes N + 1 entries (the last counts uses, 9.2).
// av1CdfDefault holds the non-coefficient defaults (offsets 0 ..<
// av1CoeffStart) and av1CoeffCdfDefault0..3 the coefficient ones for
// each quantizer context (from av1CoeffStart on).
//
// Author: Alexius Academia
// Date: 2026-10-25

let av1Blob = ""

let av1BlobFmt: [Int] = [1, 8, 1, 8, 1, 8, 1, 4, 2, 3, 2, 2, 1, 22, 1, 88, 1, 48, 1, 64, 1, 7, 1, 5, 1, 16, 1, 12, 1, 2, 2, 3, 1, 3, 1, 3, 2, 2, 1, 2, 1, 5, 3, 32, 1, 15, 4, 768, 2, 1544, 3, 257, 1, 2, 1, 4, 1, 8, 1, 16, 1, 32, 1, 64, 1, 64, 1, 64, 1, 144, 1, 128, 1, 8, 1, 8, 3, 768, 3, 768, 3, 65, 1, 19, 1, 32, 3, 9, 1, 4, 1, 4, 2, 32, 4, 512, 1, 64, 1, 13, 1, 15, 1, 475, 1, 3, 1, 18, 1, 5, 1, 16, 1, 16, 1, 16, 1, 32, 1, 32, 1, 32, 1, 32, 1, 32, 1, 32, 1, 64, 1, 64, 1, 64, 1, 128, 1, 128, 1, 128, 1, 128, 1, 128, 1, 128, 1, 256, 1, 256, 1, 256, 3, 512, 3, 512, 3, 1024, 1, 64, 1, 64, 1, 64, 1, 64, 1, 64, 1, 64, 1, 256, 1, 256, 1, 22, 1, 22, 1, 22, 1, 22, 1, 22, 1, 22, 1, 220, 1, 19, 1, 14, 2, 9, 1, 3, 1, 4, 1, 8, 1, 16, 1, 32, 1, 64, 1, 13, 3, 90, 2, 280, 1, 19, 1, 19, 1, 19, 1, 19, 1, 19, 1, 19, 1, 22, 1, 30, 1, 19, 4, 2048, 3, 350, 3, 19, 1, 100320, 3, 3536, 3, 3999, 3, 3999, 3, 3999, 3, 3999, 3, 1476]

let av1All: [Int] = av1Unpack()

// Decodes the blob into one list of all tables, back to back.
fn av1Unpack() -> [Int] {
    let d = decodeBase64(av1Blob) ?? Data()
    var out: [Int] = []
    var at = 0
    var i = 0
    let f = av1BlobFmt
    while i + 1 < f.count {
        let kind = f[i]
        let n = f[i + 1]
        for _ in 0..n {
            if kind == 1 {
                out.append(d[at])
                at += 1
            } else if kind == 2 {
                out.append(d.int8(at: at))
                at += 1
            } else if kind == 3 {
                out.append(d.uint16(at: at))
                at += 2
            } else if kind == 4 {
                out.append(d.int16(at: at))
                at += 2
            } else {
                out.append(d.int32(at: at))
                at += 4
            }
        }
        i += 2
    }
    out
}

// Items start ..< start + n of the unpacked tables.
fn av1Seg(_ start: Int, _ n: Int) -> [Int] {
    let a = av1All
    var out: [Int] = []
    for k in start..(start + n) {
        out.append(a[k])
    }
    out
}

