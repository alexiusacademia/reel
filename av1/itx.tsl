    fn itxDct16k4(_ lo: Int, _ hi: Int) {
        let i0 = t[0]
        let i1 = t[1]
        let i2 = t[2]
        let i3 = t[3]
        let v1 = (i1 * 401 + 2048) >> 12
        let v2 = (i1 * 4076 + 2048) >> 12
        let v3 = (i3 * -1189 + 2048) >> 12
        let v4 = (i3 * 3920 + 2048) >> 12
        let v5 = (i2 * 799 + 2048) >> 12
        let v6 = (i2 * 4017 + 2048) >> 12
        let v7 = (i0 * 2896 + 2048) >> 12
        let v8 = (i0 * 2896 + 2048) >> 12
        let v9 = (v2 * 1567 + v1 * -3784 + 2048) >> 12
        let v10 = (v2 * 3784 + v1 * 1567 + 2048) >> 12
        let v11 = (v4 * -3784 + v3 * -1567 + 2048) >> 12
        let v12 = (v4 * 1567 + v3 * -3784 + 2048) >> 12
        let v13 = (v6 * 2896 + v5 * -2896 + 2048) >> 12
        let v14 = (v6 * 2896 + v5 * 2896 + 2048) >> 12
        let v15 = v1 + v3
        let v16 = if v15 < lo { lo } else if v15 > hi { hi } else { v15 }
        let v17 = v1 - v3
        let v18 = if v17 < lo { lo } else if v17 > hi { hi } else { v17 }
        let v19 = v9 + v11
        let v20 = if v19 < lo { lo } else if v19 > hi { hi } else { v19 }
        let v21 = v9 - v11
        let v22 = if v21 < lo { lo } else if v21 > hi { hi } else { v21 }
        let v23 = v2 + v4
        let v24 = if v23 < lo { lo } else if v23 > hi { hi } else { v23 }
        let v25 = v2 - v4
        let v26 = if v25 < lo { lo } else if v25 > hi { hi } else { v25 }
        let v27 = v10 + v12
        let v28 = if v27 < lo { lo } else if v27 > hi { hi } else { v27 }
        let v29 = v10 - v12
        let v30 = if v29 < lo { lo } else if v29 > hi { hi } else { v29 }
        let v31 = v8 + v6
        let v32 = if v31 < lo { lo } else if v31 > hi { hi } else { v31 }
        let v33 = v8 - v6
        let v34 = if v33 < lo { lo } else if v33 > hi { hi } else { v33 }
        let v35 = v7 + v14
        let v36 = if v35 < lo { lo } else if v35 > hi { hi } else { v35 }
        let v37 = v7 - v14
        let v38 = if v37 < lo { lo } else if v37 > hi { hi } else { v37 }
        let v39 = v7 + v13
        let v40 = if v39 < lo { lo } else if v39 > hi { hi } else { v39 }
        let v41 = v7 - v13
        let v42 = if v41 < lo { lo } else if v41 > hi { hi } else { v41 }
