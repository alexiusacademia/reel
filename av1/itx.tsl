        t[0] = v2
        t[1] = v1
        t[2] = v1
        t[3] = v2
        t[4] = v2
        t[5] = v1
        t[6] = v1
        t[7] = v2
        t[8] = v2
        t[9] = v1
        t[10] = v1
        t[11] = v2
        t[12] = v2
        t[13] = v1
        t[14] = v1
        t[15] = v2
