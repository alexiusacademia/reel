// The AV1 inverse transforms (spec 7.13): the 1D inverse DCT (4 to 64
// points, 7.13.2.3 with the permutation of 7.13.2.2), inverse ADST (4,
// 8 and 16 points, 7.13.2.4-7.13.2.9), inverse identity transforms
// (7.13.2.11-15), the Walsh-Hadamard transform of lossless blocks
// (7.13.2.10), and the 2D inverse transform process (7.13.3) with the
// adding of the residual to the frame (7.12.3 steps 2 and 3, including
// the flips of the FLIPADST types).
//
// The DCT and ADST kernels below the hand-written part are straight-line
// code generated by build/scratch/av1/itx/genitx.py, which runs the spec's
// butterfly steps (B and H of 7.13.2.1) symbolically. Each kernel
// variant "kN" assumes only its first N inputs can be non-zero, so zero
// inputs cost nothing; the 2D process only transforms rows that hold
// coefficients and gives each column transform the number of non-zero
// rows. A block whose only coefficient is the DC of a DCT_DCT transform
// takes a shortcut with the same result (every butterfly then just
// scales by cos128(32)).
//
// Author: Alexius Academia
// Date: 2026-10-25

struct Av1Itx {
    // The plane the residual is added to (the reconstructor swaps it in).
    pl: [Int] = []
    // ParsedFrame.coefs: per transform block a count n, then n entries
    // value * 1024 + position (frame.tsl).
    coefs: [Int] = []
    // The 1D transform array T of 7.13.2.
    t: [Int] = []
    // Dequant (32x32 at most, row stride Min(32, w)); kept all zero
    // between blocks (entries are cleared as they are read).
    dq: [Int] = []
    // Residual after the row transforms, row stride w.
    res: [Int] = []
    rowShift: [Int] = []
    wLog: [Int] = []
    hLog: [Int] = []
    ready: Bool = false

    fn setup() {
        if ready {
            return
        }
        ready = true
        t = itxZeros(64)
        dq = itxZeros(1024)
        res = itxZeros(4096)
        rowShift = av1TransformRowShift
        wLog = av1TxWidthLog2
        hLog = av1TxHeightLog2
    }

    // Inverse transform of one transform block (7.12.3 steps 2-3): the
    // dequantised coefficients at coefs[coefAt], transform size txSz and
    // type txType (PlaneTxType), added to pl at (x, y).
    fn reconstruct(_ x: Int, _ y: Int, _ stride: Int, _ txSz: Int, _ txType: Int,
                   _ coefAt: Int, _ eob: Int, _ lossless: Bool, _ bitDepth: Int) {
        setup()
        let log2W = wLog[txSz]
        let log2H = hLog[txSz]
        let w = 1 << log2W
        let h = 1 << log2H
        let twLog = min(log2W, 5)
        let twMask = (1 << twLog) - 1
        let n = coefs[coefAt]
        if n <= 0 {
            return
        }
        var maxR = 0
        var maxC = 0
        var k = 0
        while k < n {
            let e = coefs[coefAt + 1 + k]
            let pos = e & 1023
            dq[pos] = e >> 10
            let r = pos >> twLog
            let c = pos & twMask
            if r > maxR {
                maxR = r
            }
            if c > maxC {
                maxC = c
            }
            k += 1
        }
        let maxV = (1 << bitDepth) - 1
        let rect = log2W - log2H == 1 || log2H - log2W == 1
        let colR = max(bitDepth + 6, 16)
        let colLo = 0 - (1 << (colR - 1))
        let colHi = (1 << (colR - 1)) - 1
        if !lossless && txType == 0 && maxR == 0 && maxC == 0 {
            // DCT_DCT with only a DC coefficient: every output is the same.
            var v = dq[0]
            dq[0] = 0
            if rect {
                v = (v * 2896 + 2048) >> 12
            }
            v = (v * 2896 + 2048) >> 12
            let rs = rowShift[txSz]
            if rs > 0 {
                v = (v + (1 << (rs - 1))) >> rs
            }
            v = min(max(v, colLo), colHi)
            v = (v * 2896 + 2048) >> 12
            v = (v + 8) >> 4
            if v == 0 {
                return
            }
            var i = 0
            while i < h {
                var p = (y + i) * stride + x
                let end = p + w
                while p < end {
                    let s = pl[p] + v
                    pl[p] = if s < 0 { 0 } else if s > maxV { maxV } else { s }
                    p += 1
                }
                i += 1
            }
            return
        }
        // Row and column kinds: 0 DCT, 1 ADST, 2 identity (7.13.3).
        var rowKind = 2
        if txType == 0 || txType == 1 || txType == 4 || txType == 11 {
            rowKind = 0
        } else if txType == 2 || txType == 3 || txType == 5 || txType == 6 || txType == 7 || txType == 8 || txType == 13 || txType == 15 {
            rowKind = 1
        }
        var colKind = 2
        if txType == 0 || txType == 2 || txType == 5 || txType == 10 {
            colKind = 0
        } else if txType == 1 || txType == 3 || txType == 4 || txType == 6 || txType == 7 || txType == 8 || txType == 12 || txType == 14 {
            colKind = 1
        }
        let flipUD = txType == 4 || txType == 8 || txType == 14 || txType == 6
        let flipLR = txType == 5 || txType == 7 || txType == 15 || txType == 6
        let rs = if lossless { 0 } else { rowShift[txSz] }
        let cs = if lossless { 0 } else { 4 }
        let rowLo = 0 - (1 << (bitDepth + 7))
        let rowHi = (1 << (bitDepth + 7)) - 1
        let nzRows = maxR + 1
        let nzCols = maxC + 1
        let tw = twMask + 1
        // The kernels read only the inputs their variant may see (the
        // smallest of 1, 4, 8, 16, 32 at or above the non-zero count);
        // identity and WHT kernels read all of them.
        let rowZeroTo = if rowKind != 0 || lossless { w } else { min(w, itxVariantSize(nzCols)) }
        let colZeroTo = if colKind != 0 || lossless { h } else { min(h, itxVariantSize(nzRows)) }
        // Row transforms (only rows holding coefficients; the others are
        // zero after the transform too).
        var i = 0
        while i < nzRows {
            var j = 0
            let base = i * tw
            while j < nzCols {
                t[j] = dq[base + j]
                dq[base + j] = 0
                j += 1
            }
            while j < rowZeroTo {
                t[j] = 0
                j += 1
            }
            if rect {
                j = 0
                while j < nzCols {
                    t[j] = (t[j] * 2896 + 2048) >> 12
                    j += 1
                }
            }
            if lossless {
                wht(2)
            } else if rowKind == 2 {
                identity(log2W)
            } else {
                kernel(rowKind, log2W, nzCols, rowLo, rowHi)
            }
            let rb = i * w
            j = 0
            if rs == 0 {
                while j < w {
                    res[rb + j] = min(max(t[j], colLo), colHi)
                    j += 1
                }
            } else {
                let add = 1 << (rs - 1)
                while j < w {
                    res[rb + j] = min(max((t[j] + add) >> rs, colLo), colHi)
                    j += 1
                }
            }
            i += 1
        }
        // Column transforms, adding the residual to the plane.
        var j = 0
        let add = if cs == 0 { 0 } else { 1 << (cs - 1) }
        while j < w {
            i = 0
            while i < nzRows {
                t[i] = res[i * w + j]
                i += 1
            }
            while i < colZeroTo {
                t[i] = 0
                i += 1
            }
            if lossless {
                wht(0)
            } else if colKind == 2 {
                identity(log2H)
            } else {
                kernel(colKind, log2H, nzRows, colLo, colHi)
            }
            let xx = if flipLR { w - 1 - j } else { j }
            var p = y * stride + x + xx
            var step = stride
            if flipUD {
                p = (y + h - 1) * stride + x + xx
                step = 0 - stride
            }
            i = 0
            while i < h {
                let s = pl[p] + ((t[i] + add) >> cs)
                pl[p] = if s < 0 { 0 } else if s > maxV { maxV } else { s }
                p += step
                i += 1
            }
            j += 1
        }
    }

    // Inverse identity transforms (7.13.2.11-14) on t[0 ..< 2^lg].
    fn identity(_ lg: Int) {
        let n = 1 << lg
        var i = 0
        if lg == 2 {
            while i < n {
                t[i] = (t[i] * 5793 + 2048) >> 12
                i += 1
            }
        } else if lg == 3 {
            while i < n {
                t[i] = t[i] * 2
                i += 1
            }
        } else if lg == 4 {
            while i < n {
                t[i] = (t[i] * 11586 + 2048) >> 12
                i += 1
            }
        } else {
            while i < n {
                t[i] = t[i] * 4
                i += 1
            }
        }
    }

    // The inverse Walsh-Hadamard transform (7.13.2.10) on t[0 ..< 4].
    fn wht(_ shift: Int) {
        var a = t[0] >> shift
        var c = t[1] >> shift
        var d = t[2] >> shift
        var b = t[3] >> shift
        a += c
        d -= b
        let e = (a - d) >> 1
        b = e - b
        c = e - c
        a -= b
        d += c
        t[0] = a
        t[1] = b
        t[2] = c
        t[3] = d
    }

    // The inverse ADST4 (7.13.2.6) on t[0 ..< 4].
    fn adst4() {
        let t0 = t[0]
        let t1 = t[1]
        let t2 = t[2]
        let t3 = t[3]
        var s0 = 1321 * t0
        var s1 = 2482 * t0
        var s2 = 3344 * t1
        var s3 = 3803 * t2
        let s4 = 1321 * t2
        let s5 = 2482 * t3
        let s6 = 3803 * t3
        let a7 = t0 - t2
        let b7 = a7 + t3
        s0 = s0 + s3
        s1 = s1 - s4
        s3 = s2
        s2 = 3344 * b7
        s0 = s0 + s5
        s1 = s1 - s6
        let x0 = s0 + s3
        let x1 = s1 + s3
        let x2 = s2
        var x3 = s0 + s1
        x3 = x3 - s3
        t[0] = (x0 + 2048) >> 12
        t[1] = (x1 + 2048) >> 12
        t[2] = (x2 + 2048) >> 12
        t[3] = (x3 + 2048) >> 12
    }

    // ---- generated kernels -------------------------------------------

    fn itxDct4k1(_ lo: Int, _ hi: Int) {
        let i0 = t[0]
        let v1 = (i0 * 2896 + 2048) >> 12
        let v2 = (i0 * 2896 + 2048) >> 12
        t[0] = v2
        t[1] = v1
        t[2] = v1
        t[3] = v2
    }

    fn itxDct4k4(_ lo: Int, _ hi: Int) {
        let i0 = t[0]
        let i1 = t[1]
        let i2 = t[2]
        let i3 = t[3]
        let v1 = (i0 * 2896 + i2 * -2896 + 2048) >> 12
        let v2 = (i0 * 2896 + i2 * 2896 + 2048) >> 12
        let v3 = (i1 * 1567 + i3 * -3784 + 2048) >> 12
        let v4 = (i1 * 3784 + i3 * 1567 + 2048) >> 12
        let v5 = v2 + v4
        let v6 = if v5 < lo { lo } else if v5 > hi { hi } else { v5 }
        let v7 = v2 - v4
        let v8 = if v7 < lo { lo } else if v7 > hi { hi } else { v7 }
        let v9 = v1 + v3
        let v10 = if v9 < lo { lo } else if v9 > hi { hi } else { v9 }
        let v11 = v1 - v3
        let v12 = if v11 < lo { lo } else if v11 > hi { hi } else { v11 }
        t[0] = v6
        t[1] = v10
        t[2] = v12
        t[3] = v8
    }

    fn itxDct8k1(_ lo: Int, _ hi: Int) {
        let i0 = t[0]
        let v1 = (i0 * 2896 + 2048) >> 12
        let v2 = (i0 * 2896 + 2048) >> 12
        t[0] = v2
        t[1] = v1
        t[2] = v1
        t[3] = v2
        t[4] = v2
        t[5] = v1
        t[6] = v1
        t[7] = v2
    }

    fn itxDct8k4(_ lo: Int, _ hi: Int) {
        let i0 = t[0]
        let i1 = t[1]
        let i2 = t[2]
        let i3 = t[3]
        let v1 = (i1 * 799 + 2048) >> 12
        let v2 = (i1 * 4017 + 2048) >> 12
        let v3 = (i3 * -2276 + 2048) >> 12
        let v4 = (i3 * 3406 + 2048) >> 12
        let v5 = (i0 * 2896 + 2048) >> 12
        let v6 = (i0 * 2896 + 2048) >> 12
        let v7 = (i2 * 1567 + 2048) >> 12
        let v8 = (i2 * 3784 + 2048) >> 12
        let v9 = v1 + v3
        let v10 = if v9 < lo { lo } else if v9 > hi { hi } else { v9 }
        let v11 = v1 - v3
        let v12 = if v11 < lo { lo } else if v11 > hi { hi } else { v11 }
        let v13 = v2 + v4
        let v14 = if v13 < lo { lo } else if v13 > hi { hi } else { v13 }
        let v15 = v2 - v4
        let v16 = if v15 < lo { lo } else if v15 > hi { hi } else { v15 }
        let v17 = v6 + v8
        let v18 = if v17 < lo { lo } else if v17 > hi { hi } else { v17 }
        let v19 = v6 - v8
        let v20 = if v19 < lo { lo } else if v19 > hi { hi } else { v19 }
        let v21 = v5 + v7
        let v22 = if v21 < lo { lo } else if v21 > hi { hi } else { v21 }
        let v23 = v5 - v7
        let v24 = if v23 < lo { lo } else if v23 > hi { hi } else { v23 }
        let v25 = (v16 * 2896 + v12 * -2896 + 2048) >> 12
        let v26 = (v16 * 2896 + v12 * 2896 + 2048) >> 12
        let v27 = v18 + v14
        let v28 = if v27 < lo { lo } else if v27 > hi { hi } else { v27 }
        let v29 = v18 - v14
        let v30 = if v29 < lo { lo } else if v29 > hi { hi } else { v29 }
        let v31 = v22 + v26
        let v32 = if v31 < lo { lo } else if v31 > hi { hi } else { v31 }
        let v33 = v22 - v26
        let v34 = if v33 < lo { lo } else if v33 > hi { hi } else { v33 }
        let v35 = v24 + v25
        let v36 = if v35 < lo { lo } else if v35 > hi { hi } else { v35 }
        let v37 = v24 - v25
        let v38 = if v37 < lo { lo } else if v37 > hi { hi } else { v37 }
        let v39 = v20 + v10
        let v40 = if v39 < lo { lo } else if v39 > hi { hi } else { v39 }
        let v41 = v20 - v10
        let v42 = if v41 < lo { lo } else if v41 > hi { hi } else { v41 }
        t[0] = v28
        t[1] = v32
        t[2] = v36
        t[3] = v40
        t[4] = v42
        t[5] = v38
        t[6] = v34
        t[7] = v30
    }

    fn itxDct8k8(_ lo: Int, _ hi: Int) {
        let i0 = t[0]
        let i1 = t[1]
        let i2 = t[2]
        let i3 = t[3]
        let i4 = t[4]
        let i5 = t[5]
        let i6 = t[6]
        let i7 = t[7]
        let v1 = (i1 * 799 + i7 * -4017 + 2048) >> 12
        let v2 = (i1 * 4017 + i7 * 799 + 2048) >> 12
        let v3 = (i5 * 3406 + i3 * -2276 + 2048) >> 12
        let v4 = (i5 * 2276 + i3 * 3406 + 2048) >> 12
        let v5 = (i0 * 2896 + i4 * -2896 + 2048) >> 12
        let v6 = (i0 * 2896 + i4 * 2896 + 2048) >> 12
        let v7 = (i2 * 1567 + i6 * -3784 + 2048) >> 12
