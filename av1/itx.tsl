        let v49 = (v26 * 2896 + v18 * -2896 + 2048) >> 12
        let v50 = (v26 * 2896 + v18 * 2896 + 2048) >> 12
        let v51 = v32 + v24
        let v52 = if v51 < lo { lo } else if v51 > hi { hi } else { v51 }
        let v53 = v32 - v24
        let v54 = if v53 < lo { lo } else if v53 > hi { hi } else { v53 }
        let v55 = v36 + v28
        let v56 = if v55 < lo { lo } else if v55 > hi { hi } else { v55 }
        let v57 = v36 - v28
        let v58 = if v57 < lo { lo } else if v57 > hi { hi } else { v57 }
        let v59 = v40 + v48
        let v60 = if v59 < lo { lo } else if v59 > hi { hi } else { v59 }
        let v61 = v40 - v48
        let v62 = if v61 < lo { lo } else if v61 > hi { hi } else { v61 }
        let v63 = v44 + v50
        let v64 = if v63 < lo { lo } else if v63 > hi { hi } else { v63 }
        let v65 = v44 - v50
        let v66 = if v65 < lo { lo } else if v65 > hi { hi } else { v65 }
        let v67 = v46 + v49
        let v68 = if v67 < lo { lo } else if v67 > hi { hi } else { v67 }
        let v69 = v46 - v49
        let v70 = if v69 < lo { lo } else if v69 > hi { hi } else { v69 }
        let v71 = v42 + v47
