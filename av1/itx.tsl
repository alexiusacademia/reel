fn itxVariantSize(_ nz: Int) -> Int {
    if nz <= 1 {
        return 1
    }
    if nz <= 4 {
        return 4
    }
    if nz <= 8 {
        return 8
    }
    if nz <= 16 {
        return 16
    }
    32
}

fn itxZeros(_ n: Int) -> [Int] {
    var out: [Int] = []
    for _ in 0..n {
        out.append(0)
    }
    out
}
