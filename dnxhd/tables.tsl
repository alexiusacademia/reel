// One compression ID: geometry (0 = given by the frame header), flags
// (1 interlaced, 2 adaptive MB interlacing, 4 4:4:4), bit depth (0 =
// variable) and the tables it uses (names into dxTable).
struct DxCid {
    cid: Int = 0
    width: Int = 0
    height: Int = 0
    frameSize: Int = 0
    codingUnit: Int = 0
    flags: Int = 0
    indexBits: Int = 0
    bitDepth: Int = 0
    eobIndex: Int = 0
    lumaWeight: String = ""
    chromaWeight: String = ""
    dcCodes: String = ""
    dcBits: String = ""
    acCodes: String = ""
    acBits: String = ""
    acInfo: String = ""
    runCodes: String = ""
    runBits: String = ""
    run: String = ""
}

