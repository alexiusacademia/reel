// A table by its name.
fn dxTable(_ name: String) -> [Int] {
    match name {
        "dx1235LumaWeight" -> dx1235LumaWeight
        "dx1235ChromaWeight" -> dx1235ChromaWeight
        "dx1235DcCodes" -> dx1235DcCodes
        "dx1235DcBits" -> dx1235DcBits
        "dx1235AcCodes" -> dx1235AcCodes
        "dx1235AcBits" -> dx1235AcBits
        "dx1235AcInfo" -> dx1235AcInfo
        "dx1235RunCodes" -> dx1235RunCodes
        "dx1235RunBits" -> dx1235RunBits
        "dx1235Run" -> dx1235Run
        "dx1237LumaWeight" -> dx1237LumaWeight
        "dx1237ChromaWeight" -> dx1237ChromaWeight
        "dx1237DcCodes" -> dx1237DcCodes
