// The polyphase synthesis filterbank of MPEG audio (ISO/IEC 11172-3
// section 2.4.3.2 and Annex A Figure A.2): each slot of 32 subband
// samples becomes 32 output samples through a 32-point DCT (matrixing)
// into a 512-sample FIFO, then the 512-tap window D[i].
//
// Two exact flavours, because Reel is compared with ffmpeg bit for bit
// where it can be: fixed point (ffmpeg's default decoders for layers I and
// II, 23 fractional bits, 16-bit output with the rounding error carried
// into the next sample), and floating point (its default for layer III).
// The DCT is the fast factorization ffmpeg uses (Byeong Gi Lee's
// algorithm), written as a list of butterflies both flavours run.
//
// Author: Alexius Academia
// Date: 2026-10-25

// 1 / (2 cos((2k+1) pi / 2^m)) for the DCT's butterflies, each already
// divided by the power of two its butterfly shifts back by:
// COS0_0…15 (0–15), COS1_0…7 (16–23), COS2_0…3 (24–27), COS3_0…1 (28, 29),
// COS4_0 (30).
let mpaDctCos = [
    0.50060299823519630134 / 2.0, 0.50547095989754365998 / 2.0, 0.51544730992262454697 / 2.0,
    0.53104259108978417447 / 2.0, 0.55310389603444452782 / 2.0, 0.58293496820613387367 / 2.0,
    0.62250412303566481615 / 2.0, 0.67480834145500574602 / 2.0, 0.74453627100229844977 / 2.0,
    0.83934964541552703873 / 2.0, 0.97256823786196069369 / 2.0, 1.16943993343288495515 / 4.0,
    1.48416461631416627724 / 4.0, 2.05778100995341155085 / 8.0, 3.40760841846871878570 / 8.0,
    10.19000812354805681150 / 32.0,
    0.50241928618815570551 / 2.0, 0.52249861493968888062 / 2.0, 0.56694403481635770368 / 2.0,
    0.64682178335999012954 / 2.0, 0.78815462345125022473 / 2.0, 1.06067768599034747134 / 4.0,
    1.72244709823833392782 / 4.0, 5.10114861868916385802 / 16.0,
    0.50979557910415916894 / 2.0, 0.60134488693504528054 / 2.0, 0.89997622313641570463 / 2.0,
    2.56291544774150617881 / 8.0,
    0.54119610014619698439 / 2.0, 1.30656296487637652785 / 4.0,
    0.70710678118654752440 / 2.0,
]

// The DCT as butterflies, 5 numbers each: kind, a, b, cosine, shift.
// kind 0: from the input (a, b are input indexes, result in val[a], val[b]);
// 1: on val; 2: BF1 (a, b, c=cos, d=shift: four indexes, see dct below);
// 3: BF2; 4: val[a] += val[b]. A negative cosine index -(k+1) means -COS[k].
let mpaDctOps = [
    0, 0, 31, 0, 1, 0, 15, 16, 15, 5, 1, 0, 15, 16, 1, 1, 16, 31, -17, 1,
    0, 7, 24, 7, 1, 0, 8, 23, 8, 1, 1, 7, 8, 23, 4, 1, 23, 24, -24, 4,
    1, 0, 7, 24, 1, 1, 8, 15, -25, 1, 1, 16, 23, 24, 1, 1, 24, 31, -25, 1,
    0, 3, 28, 3, 1, 0, 12, 19, 12, 2, 1, 3, 12, 19, 1, 1, 19, 28, -20, 1,
    0, 4, 27, 4, 1, 0, 11, 20, 11, 2, 1, 4, 11, 20, 1, 1, 20, 27, -21, 1,
    1, 3, 4, 27, 3, 1, 11, 12, -28, 3, 1, 19, 20, 27, 3, 1, 27, 28, -28, 3,
    1, 0, 3, 28, 1, 1, 4, 7, -29, 1, 1, 8, 11, 28, 1, 1, 12, 15, -29, 1,
    1, 16, 19, 28, 1, 1, 20, 23, -29, 1, 1, 24, 27, 28, 1, 1, 28, 31, -29, 1,
    0, 1, 30, 1, 1, 0, 14, 17, 14, 3, 1, 1, 14, 17, 1, 1, 17, 30, -18, 1,
    0, 6, 25, 6, 1, 0, 9, 22, 9, 1, 1, 6, 9, 22, 2, 1, 22, 25, -23, 2,
    1, 1, 6, 25, 1, 1, 9, 14, -26, 1, 1, 17, 22, 25, 1, 1, 25, 30, -26, 1,
    0, 2, 29, 2, 1, 0, 13, 18, 13, 3, 1, 2, 13, 18, 1, 1, 18, 29, -19, 1,
    0, 5, 26, 5, 1, 0, 10, 21, 10, 1, 1, 5, 10, 21, 2, 1, 21, 26, -22, 2,
    1, 2, 5, 26, 1, 1, 10, 13, -27, 1, 1, 18, 21, 26, 1, 1, 26, 29, -27, 1,
    1, 1, 2, 29, 2, 1, 5, 6, -30, 2, 1, 9, 10, 29, 2, 1, 13, 14, -30, 2,
    1, 17, 18, 29, 2, 1, 21, 22, -30, 2, 1, 25, 26, 29, 2, 1, 29, 30, -30, 2,
    2, 0, 1, 2, 3, 3, 4, 5, 6, 7, 2, 8, 9, 10, 11, 3, 12, 13, 14, 15,
    2, 16, 17, 18, 19, 3, 20, 21, 22, 23, 2, 24, 25, 26, 27, 3, 28, 29, 30, 31,
    4, 8, 12, 0, 0, 4, 12, 10, 0, 0, 4, 10, 14, 0, 0, 4, 14, 9, 0, 0,
    4, 9, 13, 0, 0, 4, 13, 11, 0, 0, 4, 11, 15, 0, 0,
    4, 24, 28, 0, 0, 4, 28, 26, 0, 0, 4, 26, 30, 0, 0, 4, 30, 25, 0, 0,
    4, 25, 29, 0, 0, 4, 29, 27, 0, 0, 4, 27, 31, 0, 0,
]

// Where each output comes from: out[k] = val[a] + val[b] (b = -1: val[a]).
let mpaDctOut = [
    0, 0, 16, 1, 8, 2, 24, 3, 4, 4, 20, 5, 12, 6, 28, 7,
    2, 8, 18, 9, 10, 10, 26, 11, 6, 12, 22, 13, 14, 14, 30, 15,
]
let mpaDctOut2 = [
    1, 16, 24, 17, 17, 25, 9, 18, 26, 25, 19, 27, 5, 20, 28, 21, 21, 29,
    13, 22, 30, 29, 23, 31, 3, 24, 20, 19, 25, 21, 11, 26, 22, 27, 27, 23,
    7, 28, 18, 23, 29, 19, 15, 30, 17, 31, 31, -1,
]

fn mpaFixedCos() -> [Int] {
    var out: [Int] = []
    for c in mpaDctCos {
        out.append(Int(c * 4294967296.0 + 0.5))
    }
    out
}

let mpaDctCosFixed = mpaFixedCos()

// The window in both forms, mirrored to 512 taps (the second half is the
// first reversed, negated except at multiples of 64).
fn mpaWindowFixed() -> [Int] {
    var w: [Int] = []
    for _ in 0..512 {
        w.append(0)
    }
    for i in 0..257 {
        var v = mpaEnwindow[i]
        w[i] = v
        if i & 63 != 0 {
            v = -v
        }
        if i != 0 {
            w[512 - i] = v
        }
    }
    w
}

fn mpaWindowFloat() -> [Float] {
    var out: [Float] = []
    for v in mpaWindowFixed() {
        out.append(Float(v) / 549755813888.0)
    }
    out
}

let mpaWinFixed = mpaWindowFixed()
let mpaWinFloat = mpaWindowFloat()

// Signed 32-bit wraparound, as C's int.
fn mpaI32(_ v: Int) -> Int {
    (v << 32) >> 32
}

// The synthesis state of up to two channels.
public struct MpaSynth {
    // FIFOs (V in the standard), 1024 per channel; the matrixing writes 32
    // values at `offset`, which steps back by 32 each slot.
    bufFixed: [Int] = []
    bufFloat: [Float] = []
    offset: [Int] = [0, 0]
    // Rounding carry of the fixed-point window (shared by the channels,
    // as in ffmpeg).
    dither: Int = 0
    valI: [Int] = []
    valF: [Float] = []
    // Interleaved output samples of the frame being decoded.
    out: [Float] = []

    fn setup() {
        bufFixed = []
        bufFloat = []
        for _ in 0..2048 {
            bufFixed.append(0)
            bufFloat.append(0.0)
        }
        valI = []
        valF = []
        for _ in 0..32 {
            valI.append(0)
            valF.append(0.0)
        }
        offset = [0, 0]
        dither = 0
    }

    fn clear() {
        for i in 0..bufFixed.count {
            bufFixed[i] = 0
            bufFloat[i] = 0.0
        }
        offset = [0, 0]
        dither = 0
    }

    // Makes room for `n` interleaved samples.
    fn prepare(_ n: Int) {
        if out.count != n {
            out = []
            for _ in 0..n {
                out.append(0.0)
            }
        }
    }

    // One slot of fixed-point subband samples sb[at ..< at + 32] of
    // channel ch → 32 samples at out[pos], out[pos + stride], ….
    fn slotFixed(_ ch: Int, _ sb: [Int], _ at: Int, _ pos: Int, _ stride: Int) {
        let base = ch * 1024 + offset[ch]
        // Matrixing (the DCT).
        var k = 0
        while k < mpaDctOps.count {
            let kind = mpaDctOps[k]
            let a = mpaDctOps[k + 1]
            let b = mpaDctOps[k + 2]
            let c = mpaDctOps[k + 3]
            let s = mpaDctOps[k + 4]
            if kind == 0 {
                let x = sb[at + a]
                let y = sb[at + b]
                valI[a] = x + y
                valI[b] = mpaMulh(mpaI32((x - y) << s), mpaCosFixed(c))
            } else if kind == 1 {
                let x = valI[a]
                let y = valI[b]
                valI[a] = x + y
                valI[b] = mpaMulh(mpaI32((x - y) << s), mpaCosFixed(c))
            } else if kind == 2 || kind == 3 {
                // BF1 / BF2 on (a, b, c, d) = (a, b, c, s).
                let cp = mpaDctCosFixed[30]
                let x = valI[a]
                let y = valI[b]
                valI[a] = x + y
                valI[b] = mpaMulh(mpaI32((x - y) << 1), cp)
                let z = valI[c]
                let w = valI[s]
                valI[c] = z + w
                valI[s] = mpaMulh(mpaI32((z - w) << 1), -cp)
                valI[c] += valI[s]
                if kind == 3 {
                    valI[a] += valI[c]
                    valI[c] += valI[b]
                    valI[b] += valI[s]
                }
            } else {
                valI[a] += valI[b]
            }
            k += 5
        }
        var j = 0
        while j < 32 {
            let o = mpaDctOut[j]
            let v = mpaDctOut[j + 1]
            bufFixed[base + o] = valI[v]
            j += 2
        }
        j = 0
        while j < mpaDctOut2.count {
            let o = mpaDctOut2[j]
            let v1 = mpaDctOut2[j + 1]
            let v2 = mpaDctOut2[j + 2]
            bufFixed[base + o] = if v2 < 0 { valI[v1] } else { valI[v1] + valI[v2] }
            j += 3
        }
        // Windowing (ffmpeg's apply_window, fixed point).
        for i in 0..32 {
            bufFixed[base + 512 + i] = bufFixed[base + i]
        }
        let w = mpaWinFixed
        var sum = dither
        var q = 0
        while q < 8 {
            sum += w[q * 64] * bufFixed[base + 16 + q * 64]
            q += 1
        }
        q = 0
        while q < 8 {
            sum -= w[32 + q * 64] * bufFixed[base + 48 + q * 64]
            q += 1
        }
        out[pos] = Float(mpaRoundFixed(sum)) / 32768.0
        sum = sum & 0xffffff
        var w1 = 1
        var w2 = 31
        for jj in 1..16 {
            var sum2 = 0
            var p = base + 16 + jj
            q = 0
            while q < 8 {
                let t = bufFixed[p + q * 64]
                sum += w[w1 + q * 64] * t
                sum2 -= w[w2 + q * 64] * t
                q += 1
            }
            p = base + 48 - jj
            q = 0
            while q < 8 {
                let t = bufFixed[p + q * 64]
                sum -= w[w1 + 32 + q * 64] * t
                sum2 -= w[w2 + 32 + q * 64] * t
                q += 1
            }
            out[pos + jj * stride] = Float(mpaRoundFixed(sum)) / 32768.0
            sum = sum & 0xffffff
            sum += sum2
            out[pos + (32 - jj) * stride] = Float(mpaRoundFixed(sum)) / 32768.0
            sum = sum & 0xffffff
            w1 += 1
            w2 -= 1
        }
        q = 0
        while q < 8 {
            sum -= w[w1 + 32 + q * 64] * bufFixed[base + 32 + q * 64]
            q += 1
        }
        out[pos + 16 * stride] = Float(mpaRoundFixed(sum)) / 32768.0
        dither = sum & 0xffffff
        offset[ch] = (offset[ch] - 32) & 511
    }

    // The same in floating point, for layer III.
    fn slotFloat(_ ch: Int, _ sb: [Float], _ at: Int, _ pos: Int, _ stride: Int) {
        let base = ch * 1024 + offset[ch]
        var k = 0
        while k < mpaDctOps.count {
            let kind = mpaDctOps[k]
            let a = mpaDctOps[k + 1]
            let b = mpaDctOps[k + 2]
            let c = mpaDctOps[k + 3]
            let s = mpaDctOps[k + 4]
            if kind == 0 {
                let x = sb[at + a]
                let y = sb[at + b]
                valF[a] = x + y
                valF[b] = Float(1 << s) * mpaCosFloat(c) * (x - y)
            } else if kind == 1 {
                let x = valF[a]
                let y = valF[b]
                valF[a] = x + y
                valF[b] = Float(1 << s) * mpaCosFloat(c) * (x - y)
            } else if kind == 2 || kind == 3 {
                let cp = mpaDctCos[30]
                let x = valF[a]
                let y = valF[b]
                valF[a] = x + y
                valF[b] = 2.0 * cp * (x - y)
                let z = valF[c]
                let w = valF[s]
                valF[c] = z + w
                valF[s] = 2.0 * (-cp) * (z - w)
                valF[c] += valF[s]
                if kind == 3 {
                    valF[a] += valF[c]
                    valF[c] += valF[b]
                    valF[b] += valF[s]
                }
            } else {
                valF[a] += valF[b]
            }
            k += 5
        }
        var j = 0
        while j < 32 {
            bufFloat[base + mpaDctOut[j]] = valF[mpaDctOut[j + 1]]
            j += 2
        }
        j = 0
        while j < mpaDctOut2.count {
            let o = mpaDctOut2[j]
            let v1 = mpaDctOut2[j + 1]
            let v2 = mpaDctOut2[j + 2]
            bufFloat[base + o] = if v2 < 0 { valF[v1] } else { valF[v1] + valF[v2] }
            j += 3
        }
        for i in 0..32 {
            bufFloat[base + 512 + i] = bufFloat[base + i]
        }
        let w = mpaWinFloat
        var sum = 0.0
        var q = 0
        while q < 8 {
            sum += w[q * 64] * bufFloat[base + 16 + q * 64]
            q += 1
        }
        q = 0
        while q < 8 {
            sum -= w[32 + q * 64] * bufFloat[base + 48 + q * 64]
            q += 1
        }
        out[pos] = sum
        sum = 0.0
        var w1 = 1
        var w2 = 31
        for jj in 1..16 {
            var sum2 = 0.0
            var p = base + 16 + jj
            q = 0
            while q < 8 {
                let t = bufFloat[p + q * 64]
                sum += w[w1 + q * 64] * t
                sum2 -= w[w2 + q * 64] * t
                q += 1
            }
            p = base + 48 - jj
            q = 0
            while q < 8 {
                let t = bufFloat[p + q * 64]
                sum -= w[w1 + 32 + q * 64] * t
                sum2 -= w[w2 + 32 + q * 64] * t
                q += 1
            }
            out[pos + jj * stride] = sum
            out[pos + (32 - jj) * stride] = sum2
            sum = 0.0
            w1 += 1
            w2 -= 1
        }
        q = 0
        while q < 8 {
            sum -= w[w1 + 32 + q * 64] * bufFloat[base + 32 + q * 64]
            q += 1
        }
        out[pos + 16 * stride] = sum
        offset[ch] = (offset[ch] - 32) & 511
    }
}

// (a * b) >> 32 of two 32-bit numbers (ffmpeg's MULH).
fn mpaMulh(_ a: Int, _ b: Int) -> Int {
    (a * b) >> 32
}

fn mpaCosFixed(_ c: Int) -> Int {
    if c >= 0 { mpaDctCosFixed[c] } else { -mpaDctCosFixed[-c - 1] }
}

fn mpaCosFloat(_ c: Int) -> Float {
    if c >= 0 { mpaDctCos[c] } else { -mpaDctCos[-c - 1] }
}

// The fixed-point output sample: the top bits of the 64-bit sum (24
// fraction bits), clipped to 16 bits. The caller keeps the low 24 bits.
fn mpaRoundFixed(_ sum: Int) -> Int {
    let v = mpaI32(sum >> 24)
    if v > 32767 { 32767 } else if v < -32768 { -32768 } else { v }
}
