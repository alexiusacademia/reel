// The usage ping: small messages to the Syncster statistics service
// that count how many copies of Reel are installed, updated and in
// use. A copy of C-Tessel's ping/install.tsl (from Keystone's, Tally's and
// Forebay's), unchanged but for these comments.
//
// What is sent, and when (the website's privacy page says the same):
//
//   install  the first time the app runs on a computer (sent again on
//            later runs until the service has answered);
//   update   the first time it runs as another version than it last told;
//   active   at most once a UTC day, on a day the app runs.
//
// Each is one GET with no body, answered 204 when it's counted:
//
//   https://stats.syncster.dev/v1/ping?app=reel&type=install&id=…&v=0.1.0
//       &os=macos&arch=arm64&osv=15.4.1&lang=en-PH&screen=1512x982
//
// with `&prev=<old version>` for an update. `id` is random digits made
// here on the first run: it names this copy of the app, not a person or
// a computer. `osv`, `lang` and `screen` (the operating system's
// version, the locale and the main screen's size in points) are asked of
// the system with its own commands (see `gatherSystem`); one that can't
// be found out is left out. The service works out the country from the
// address a message comes from and keeps only the country.
//
// Nothing is sent when the user turned it off (`off` in the file below,
// the Help menu's "Send Anonymous Usage Statistics"), when
// REEL_NO_STATS=1 or DO_NOT_TRACK=1 is set, or in a run driven by a
// test script that doesn't name a place of its own (REEL_STATS_URL).
//
// What's kept is `stats.json` in the app's data folder: the id, the
// version last told, the last UTC day an active ping was taken, and the
// switch. A version or a day is written only once the service has
// answered, so a ping that didn't arrive is sent again later.
//
// The module knows nothing of the app around it (its name comes in).
//
// Author: Alexius Academia
// Date: 2026-10-27

// What's remembered between runs: this copy's id, the version last told
// to the service ("" until an install ping has been answered), the last
// UTC day ("2026-10-25") an active ping was answered ("" never), and
// whether the user turned the pings off.
public struct Installation {
    id: String = ""
    reported: String = ""
    active: String = ""
    off: Bool = false
}

// What the system says about itself, as the service takes it: the
// system ("macos", "windows"), the processor ("arm64", "x64"), the
// system's version ("15.4.1", "10.0.26100"), the locale ("en-PH") and
// the main screen's size in points ("1512x982"). "" where it couldn't be
// found out (the field is then left out of the ping).
public struct SystemInfo {
    os: String = ""
    arch: String = ""
    osv: String = ""
    lang: String = ""
    screen: String = ""
}

// How one report went: `result` is "" when there was nothing to send
// (or pings aren't allowed), else the kinds that were sent and taken in
// order ("install, active"), or "failed" when one wasn't taken.
// `queries` are the query parts of the pings sent (without the address),
// for a test to look at.
public struct Sent {
    result: String = ""
    queries: [String] = []
}

// The variable that names another place for the pings (REEL_STATS_URL
// for "reel").
fn urlVariable(_ name: String) -> String {
    "{name.uppercase()}_STATS_URL"
}

// Where pings go. The variable REEL_STATS_URL (the app's name in
// capitals) names another place, for trying it without counting
// anything. A file:// address works: a file can't take a query, so none
// is added, and a file that's there answers like the service does, one
// that isn't like a service out of reach.
public fn statsURL(name: String) -> String {
    if let other = environment(urlVariable(name)) {
        if !other.isEmpty {
            return other
        }
    }
    "https://stats.syncster.dev/v1/ping"
}

// Whether the environment turns the pings off: REEL_NO_STATS=1 (the
// app's name in capitals), or DO_NOT_TRACK=1, which Tessel itself
// honours too.
public fn turnedOffByEnvironment(name: String) -> Bool {
    (environment("{name.uppercase()}_NO_STATS") ?? "") == "1" || (environment("DO_NOT_TRACK") ?? "") == "1"
}

// Whether a ping may be sent at all, whatever the user's switch says:
// not when the environment turns them off, and not in a run driven by a
// test script, unless it names a place of its own (so tests never reach
// the real service).
public fn statsAllowed(name: String) -> Bool {
    if turnedOffByEnvironment(name: name) {
        return false
    }
    environment("TESSEL_SCRIPT") == nil || (environment(urlVariable(name)) ?? "") != ""
}

// A new random id, written like a UUID (32 hexadecimal digits in groups
// of 8, 4, 4, 4 and 12). Nothing of the computer or the user goes into
// it.
public fn newId() -> String {
    let digits = "0123456789abcdef"
    var id = ""
    for i in 0..32 {
        if i == 8 || i == 12 || i == 16 || i == 20 {
            id += "-"
        }
        let k = random(0..16)
        id += digits.substring(from: k, to: k + 1)
    }
    id
}

// Whether an id is one the service takes: 16 to 64 hexadecimal digits
// and dashes.
public fn validId(_ id: String) -> Bool {
    if id.count < 16 || id.count > 64 {
        return false
    }
    for c in id.characters {
        if !"0123456789abcdefABCDEF-".contains(c) {
            return false
        }
    }
    true
}

// Text cut down to the characters in `allowed` (anything else becomes
// -), 32 characters at most, with dashes trimmed from both ends.
fn keepOnly(_ text: String, _ allowed: String) -> String {
    var out = ""
    for c in text.trim().characters {
        if out.count == 32 {
            break
        }
        out += if allowed.contains(c) { c } else { "-" }
    }
    while out.hasPrefix("-") {
        out = out.substring(from: 1, to: out.count)
    }
    while out.hasSuffix("-") {
        out = out.substring(from: 0, to: out.count - 1)
    }
    out
}

let letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

// A version, system or processor name as the service takes it: letters,
// digits and . _ - only (anything else becomes -), 32 characters at
// most, and never empty.
public fn tidy(_ text: String) -> String {
    let out = keepOnly(text, letters + "._-")
    if out.isEmpty { "unknown" } else { out }
}

// The processor's kind as the service names it ("arm64" or "x64"), from
// what the system calls it (`uname -m`, or Windows's
// PROCESSOR_ARCHITECTURE).
public fn archName(_ machine: String) -> String {
    let name = machine.trim().lowercase()
    if name == "arm64" || name == "aarch64" {
        return "arm64"
    }
    if name == "x86_64" || name == "amd64" || name == "x64" {
        return "x64"
    }
    tidy(name)
}

// The system as the service names it.
public fn osName() -> String {
    tidy(platform())
}

// The system's version from what it says: macOS's `sw_vers
// -productVersion` ("15.4.1") as it is; Windows's `ver` ("Microsoft
// Windows [Version 10.0.26100.4061]") as its first three numbers
// ("10.0.26100"). "" when the text holds no version.
public fn osVersionFrom(_ text: String) -> String {
    var line = text.trim()
    if let at = line.find("Version ") {
        line = line.substring(from: at + 8, to: line.count)
        if let end = line.find("]") {
            line = line.substring(from: 0, to: end)
        }
        let parts = line.trim().split(".")
        if parts.count > 3 {
            line = "{parts[0]}.{parts[1]}.{parts[2]}"
        }
    }
    let out = keepOnly(line, "0123456789.")
    if out.isEmpty || !"0123456789".contains(out.substring(from: 0, to: 1)) {
        return ""
    }
    out
}

// The locale from what the system says: macOS's AppleLocale ("en_PH",
// maybe with "@rg=…" after it) or the LocaleName line of Windows's
// registry ("    LocaleName    REG_SZ    en-PH"), written with dashes
// ("en-PH"): letters, digits and dashes only. "" when there's none.
public fn localeFrom(_ text: String) -> String {
    var word = text.trim()
    if word.contains("REG_SZ") {
        word = (word.split(" ").filter { w in !w.isEmpty }.last ?? "")
    }
    if let at = word.find("@") {
        word = word.substring(from: 0, to: at)
    }
    let out = keepOnly(word.replace("_", with: "-"), letters + "-")
    if out.count < 2 { "" } else { out }
}

// A screen size as the service takes it: "<width>x<height>" in whole
// points, from text such as "1512 x 982 @ 120.00Hz" or "1920x1080". ""
// when it isn't one.
public fn screenFrom(_ text: String) -> String {
    var t = text.trim()
    if let at = t.find("@") {
        t = t.substring(from: 0, to: at)
    }
    let parts = t.replace(" ", with: "").lowercase().split("x")
    if parts.count != 2 {
        return ""
    }
    let w = Int(parts[0]) ?? 0
    let h = Int(parts[1]) ?? 0
    if w < 100 || h < 100 || w > 100000 || h > 100000 {
        return ""
    }
    "{w}x{h}"
}

// The main screen's size in points from the lines of macOS's
// `system_profiler SPDisplaysDataType -json`: each display's
// "_spdisplays_resolution" ("1512 x 982 @ 120.00Hz", the size the screen
// looks like, in points) and whether it's the main one
// ("spdisplays_main"). The first display's when none says it's the main
// one; "" when there's none.
public fn macScreenFrom(_ lines: [String]) -> String {
    var first = ""
    var current = ""
    var main = ""
    for line in lines {
        if line.contains("\"_name\"") {
            current = ""
        } else if line.contains("\"_spdisplays_resolution\"") {
            let value = line.split(":").last ?? ""
            current = screenFrom(value.replace("\"", with: "").replace(",", with: ""))
            if first.isEmpty {
                first = current
            }
        } else if line.contains("\"spdisplays_main\"") && line.contains("spdisplays_yes") {
            if main.isEmpty {
                main = current
            }
        }
    }
    if main.isEmpty { first } else { main }
}

// The UTC day of a moment (seconds since 1970) as the file keeps it:
// "2026-10-25".
public fn utcDay(_ t: Float) -> String {
    formatDate(t, format: "yyyy-MM-dd", timeZone: "UTC")
}

// Where the id and the rest are kept ("" when the app has no data
// folder, as in a test that names none).
public fn stateFile(folder: String) -> String {
    if folder.isEmpty { "" } else { joinPath(folder, "stats.json") }
}

// What's kept there. A file that's missing or unreadable reads as a copy
// that was never counted; one with an id the service wouldn't take
// keeps only the switch.
public fn loadInstallation(folder: String) -> Installation {
    let file = stateFile(folder: folder)
    if !file.isEmpty {
        if let text = readFile(file) {
            if let saved: Installation = fromJson(text) {
                if validId(saved.id) {
                    return saved
                }
                return Installation(off: saved.off)
            }
        }
    }
    Installation()
}

public fn saveInstallation(folder: String, _ inst: Installation) -> Bool {
    let file = stateFile(folder: folder)
    if file.isEmpty {
        return false
    }
    writeFile(path: file, text: toJson(inst))
}

// Turns the pings off or on (the Help menu's switch), keeping the rest.
// False when it couldn't be written.
public fn setOff(folder: String, _ off: Bool) -> Bool {
    var inst = loadInstallation(folder: folder)
    inst.off = off
    saveInstallation(folder: folder, inst)
}

// Whether the user has turned the pings off.
public fn isOff(folder: String) -> Bool {
    loadInstallation(folder: folder).off
}

// What there is to tell about the version when the app starts as
// `version`: "install" when no install ping was ever answered (there's
// no id yet, or there is one and no version beside it), "update" when
// the version told last isn't this one, and "" when the service knows
// already.
public fn whatToSend(_ inst: Installation, version: String) -> String {
    if !validId(inst.id) || inst.reported.isEmpty {
        return "install"
    }
    if inst.reported != version { "update" } else { "" }
}

// Whether today's active ping is still to be sent (`day` is today's UTC
// day, as `utcDay` writes it).
public fn activeDue(_ inst: Installation, day: String) -> Bool {
    inst.active != day
}

// The query of one ping: everything after the service's address. The
// system details that are "" are left out.
public fn pingQuery(name: String, kind: String, _ inst: Installation, version: String, _ sys: SystemInfo) -> String {
    var q = "?app={name}&type={kind}&id={inst.id}&v={tidy(version)}&os={tidy(sys.os)}&arch={tidy(sys.arch)}"
    if kind == "update" {
        q += "&prev={tidy(inst.reported)}"
    }
    let osv = keepOnly(sys.osv, letters + "._-")
    if !osv.isEmpty {
        q += "&osv={osv}"
    }
    let lang = keepOnly(sys.lang, letters + "-")
    if !lang.isEmpty {
        q += "&lang={lang}"
    }
    let screen = screenFrom(sys.screen)
    if !screen.isEmpty {
        q += "&screen={screen}"
    }
    q
}

// The address a ping goes to: the service's with the query, or a
// file:// address as it is (a file can't take a query).
public fn pingURL(base: String, query: String) -> String {
    if base.hasPrefix("file://") { base } else { base + query }
}

// For a test's printout: where the count of this copy stands, with the
// app running as `version` on the UTC day `day`. (The id isn't shown:
// it's never the same twice.)
public fn standing(folder: String, version: String, day: String) -> String {
    let inst = loadInstallation(folder: folder)
    var parts: [String] = []
    if !validId(inst.id) {
        parts.append("no id")
    } else if inst.reported.isEmpty {
        parts.append("an id, nothing reported")
    } else if inst.reported == version {
        parts.append("an id, this version reported")
    } else {
        parts.append("an id, version {inst.reported} reported")
    }
    if inst.active == day {
        parts.append("active today")
    } else if !inst.active.isEmpty {
        parts.append("last active another day")
    }
    if inst.off {
        parts.append("turned off")
    }
    parts.joined(separator: ", ")
}

// Finds out what the system says about itself, in the background, and
// hands it to `done`: the processor (`uname -m`, or Windows's
// PROCESSOR_ARCHITECTURE), the system's version (`sw_vers
// -productVersion`; `cmd /c ver`), the locale (`defaults read -g
// AppleLocale`; the registry's LocaleName) and the main screen's size in
// points (`system_profiler SPDisplaysDataType -json`; Windows Forms'
// PrimaryScreen through PowerShell). One command after another; what a
// command can't tell stays "".
public fn gatherSystem(done: fn(SystemInfo)) {
    var info = SystemInfo(os: osName())
    if platform() == "windows" {
        info.arch = archName(environment("PROCESSOR_ARCHITEW6432") ?? environment("PROCESSOR_ARCHITECTURE") ?? "")
        var ver = ""
        let a = runCommand(path: "cmd.exe", args: ["/c", "ver"], onOutput: { line in
            if ver.isEmpty && line.contains("Version") {
                ver = line
            }
        }) { code in
            info.osv = osVersionFrom(ver)
            var loc = ""
            let b = runCommand(path: "reg.exe", args: ["query", "HKCU\\Control Panel\\International", "/v", "LocaleName"], onOutput: { line in
                if line.contains("LocaleName") {
                    loc = line
                }
            }) { code2 in
                info.lang = localeFrom(loc)
                var size = ""
                let c = runCommand(path: "powershell.exe", args: ["-NoProfile", "-NonInteractive", "-Command",
                    "Add-Type -AssemblyName System.Windows.Forms; $b = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds; '{0}x{1}' -f $b.Width, $b.Height"], onOutput: { line in
                    if size.isEmpty && !line.hasPrefix("error:") {
                        size = line
                    }
                }) { code3 in
                    info.screen = screenFrom(size)
                    done(info)
                }
            }
        }
        return
    }
    var machine = ""
    let a = runCommand(path: "/usr/bin/uname", args: ["-m"], onOutput: { line in
        if machine.isEmpty && !line.hasPrefix("error:") {
            machine = line
        }
    }) { code in
        info.arch = archName(machine)
        var ver = ""
        let b = runCommand(path: "/usr/bin/sw_vers", args: ["-productVersion"], onOutput: { line in
            if ver.isEmpty && !line.hasPrefix("error:") {
                ver = line
            }
        }) { code2 in
            info.osv = osVersionFrom(ver)
            var loc = ""
            let c = runCommand(path: "/usr/bin/defaults", args: ["read", "-g", "AppleLocale"], onOutput: { line in
                if loc.isEmpty && !line.hasPrefix("error:") && code2 == 0 {
                    loc = line
                }
            }) { code3 in
                info.lang = if code3 == 0 { localeFrom(loc) } else { "" }
                var lines: [String] = []
                let e = runCommand(path: "/usr/sbin/system_profiler", args: ["SPDisplaysDataType", "-json"], onOutput: { line in
                    lines.append(line)
                }) { code4 in
                    info.screen = macScreenFrom(lines)
                    done(info)
                }
            }
        }
    }
}

// Sends what there is to tell about this copy of the app called `name`
// ("reel"), running as `version` and keeping its files in `folder`,
// on the UTC day `day`: the install or update ping when one is due, then
// the active ping when today's isn't in yet, to the address `base`, with
// the system details `sys`. What the service takes is written down as
// it's taken. `done` hears how it went (see `Sent`). It all happens in
// the background; nothing is shown either way. It doesn't look at
// whether pings are allowed or turned off: the caller does.
public fn report(name: String, version: String, folder: String, base: String, sys: SystemInfo, day: String, done: fn(Sent)) {
    if version.isEmpty || stateFile(folder: folder).isEmpty {
        done(Sent())
        return
    }
    var inst = loadInstallation(folder: folder)
    if !validId(inst.id) {
        // The first run here. The id is kept before anything is sent: an
        // id that couldn't be kept would count this copy again each run.
        inst = Installation(id: newId(), off: inst.off)
        if !saveInstallation(folder: folder, inst) {
            done(Sent(result: "failed"))
            return
        }
    }
    let kind = whatToSend(inst, version: version)
    var kinds: [String] = []
    if !kind.isEmpty {
        kinds.append(kind)
    }
    if activeDue(inst, day: day) {
        kinds.append("active")
    }
    if kinds.isEmpty {
        done(Sent())
        return
    }
    var sent = Sent()
    // Sends kinds[i] and then the rest, one after another.
    fn next(_ i: Int) {
        if i >= kinds.count {
            done(sent)
            return
        }
        let k = kinds[i]
        let now = loadInstallation(folder: folder)
        let query = pingQuery(name: name, kind: k, Installation(id: inst.id, reported: now.reported, active: now.active), version: version, sys)
        sent.queries.append(query)
        let asked = request(url: pingURL(base: base, query: query)) { response in
            if response.ok {
                // Read again: the switch may have changed meanwhile.
                var kept = loadInstallation(folder: folder)
                kept.id = inst.id
                if k == "active" {
                    kept.active = day
                } else {
                    kept.reported = version
                }
                let ok = saveInstallation(folder: folder, kept)
                sent.result = if sent.result.isEmpty { k } else { sent.result + ", " + k }
                next(i + 1)
            } else {
                sent.result = "failed"
                done(sent)
            }
        }
    }
    next(0)
}
