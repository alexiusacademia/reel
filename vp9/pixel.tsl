    fn add8(_ d: Int, _ o: (Int, Int, Int, Int, Int, Int, Int, Int), _ stride: Int) {
        let mv = maxV
        let v0 = pl[d + 0 * stride] + ((o.0 + 16) >> 5)
        pl[d + 0 * stride] = if v0 < 0 { 0 } else if v0 > mv { mv } else { v0 }
        let v1 = pl[d + 1 * stride] + ((o.1 + 16) >> 5)
        pl[d + 1 * stride] = if v1 < 0 { 0 } else if v1 > mv { mv } else { v1 }
        let v2 = pl[d + 2 * stride] + ((o.2 + 16) >> 5)
        pl[d + 2 * stride] = if v2 < 0 { 0 } else if v2 > mv { mv } else { v2 }
        let v3 = pl[d + 3 * stride] + ((o.3 + 16) >> 5)
        pl[d + 3 * stride] = if v3 < 0 { 0 } else if v3 > mv { mv } else { v3 }
        let v4 = pl[d + 4 * stride] + ((o.4 + 16) >> 5)
        pl[d + 4 * stride] = if v4 < 0 { 0 } else if v4 > mv { mv } else { v4 }
        let v5 = pl[d + 5 * stride] + ((o.5 + 16) >> 5)
        pl[d + 5 * stride] = if v5 < 0 { 0 } else if v5 > mv { mv } else { v5 }
        let v6 = pl[d + 6 * stride] + ((o.6 + 16) >> 5)
        pl[d + 6 * stride] = if v6 < 0 { 0 } else if v6 > mv { mv } else { v6 }
        let v7 = pl[d + 7 * stride] + ((o.7 + 16) >> 5)
        pl[d + 7 * stride] = if v7 < 0 { 0 } else if v7 > mv { mv } else { v7 }
    }

    fn add4(_ at: Int, _ i: Int, _ o: (Int, Int, Int, Int), _ rnd: Int, _ sh: Int, _ stride: Int) {
        let mv = maxV
        let d = at + i
        var v = pl[d] + ((o.0 + rnd) >> sh)
        pl[d] = if v < 0 { 0 } else if v > mv { mv } else { v }
        v = pl[d + stride] + ((o.1 + rnd) >> sh)
        pl[d + stride] = if v < 0 { 0 } else if v > mv { mv } else { v }
        v = pl[d + 2 * stride] + ((o.2 + rnd) >> sh)
        pl[d + 2 * stride] = if v < 0 { 0 } else if v > mv { mv } else { v }
        v = pl[d + 3 * stride] + ((o.3 + rnd) >> sh)
        pl[d + 3 * stride] = if v < 0 { 0 } else if v > mv { mv } else { v }
