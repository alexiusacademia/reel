// The sample-level work of the VP9 reconstructor, on one plane at a time:
// intra prediction (8.5.1, with FFmpeg's edge rules), the inverse DCT,
// ADST and Walsh-Hadamard transforms (8.7.1, 8.7.2), the 8-tap and
// bilinear motion compensation filters (8.5.2.3), and the loop filter
// (8.8.2). The plane being worked on is the field `pl` (the reconstructor
// moves each plane in and out), so writes are in place.
//
// The arithmetic is FFmpeg's vp9dsp_template.c, which matches libvpx.
//
// Author: Alexius Academia
// Date: 2026-10-25

struct Vp9Px {
    pl: [Int] = []
    // The frame's three planes; the one being worked on is in `pl` (its
    // own field then holds an empty list), so writes are in place.
    sY: [Int] = []
    sU: [Int] = []
    sV: [Int] = []
    active: Int = -1
    maxV: Int = 255
    bitDepth: Int = 8
    // Coefficient block (raster order) and transform scratch.
    blk: [Int] = []
    tmp: [Int] = []
    o: [Int] = []
    // Intra edges: et[0] the top-left sample, et[1 + k] above sample k
    // (extended to 2n); el the left samples bottom-up as FFmpeg keeps them,
    // eln the left samples top-down (extended).
    et: [Int] = []
    el: [Int] = []
    eln: [Int] = []
    vv: [Int] = []
    // Motion compensation scratch.
    mcTmp: [Int] = []
    emu: [Int] = []
    filters: [Int] = []
    // Loop filter limits by level.
    limLut: [Int] = []
    mblimLut: [Int] = []
    sharp: Int = -1

    fn setup() {
        if blk.isEmpty {
            blk = vp9Zeros(1024)
            tmp = vp9Zeros(1024)
            o = vp9Zeros(64)
            et = vp9Zeros(160)
            el = vp9Zeros(64)
            eln = vp9Zeros(160)
            vv = vp9Zeros(160)
            mcTmp = vp9Zeros(64 * 140)
            emu = vp9Zeros(288 * 144)
            filters = vp9SubpelFilters
            limLut = vp9Zeros(64)
            mblimLut = vp9Zeros(64)
        }
    }

    fn swapPlane(_ p: Int) {
        if p == 0 {
            let t = sY
            sY = pl
            pl = t
        } else if p == 1 {
            let t = sU
            sU = pl
            pl = t
        } else {
            let t = sV
            sV = pl
            pl = t
        }
    }

    fn use(_ p: Int) {
        if p == active {
            return
        }
        if active >= 0 {
            swapPlane(active)
        }
        swapPlane(p)
        active = p
    }

    // Puts the working plane back in its field.
    fn settle() {
        if active >= 0 {
            swapPlane(active)
            active = -1
        }
    }

    fn setDepth(_ bd: Int) {
        bitDepth = bd
        maxV = (1 << bd) - 1
    }

    fn clip(_ v: Int) -> Int {
        if v < 0 {
            return 0
        }
        if v > maxV {
            return maxV
        }
        v
    }

    // ---- intra prediction --------------------------------------------

    // Gathers the edges of a transform block at plane offset `at` (FFmpeg's
    // check_intra_mode) and returns the prediction mode to use.
    //   haveTop/haveLeft/haveRight  availability
    //   pxHaveT  samples available to the right on the row above
    //   pxHaveL  samples available below on the left column
    fn edges(_ mode0: Int, _ at: Int, _ stride: Int, _ tx: Int, _ haveTop: Bool, _ haveLeft: Bool,
             _ haveRight: Bool, _ pxHaveT: Int, _ pxHaveL: Int) -> Int {
        let mode = vp9ConvMode(mode0, haveLeft, haveTop)
        let flags = vp9EdgeFlags(mode)
        let needL = (flags & 1) != 0
        let needT = (flags & 2) != 0
        let needTl = (flags & 4) != 0
        let needTr = (flags & 8) != 0
        let invL = (flags & 16) != 0
        let n = 4 << tx
        let base = 1 << (bitDepth - 8)
        if needT {
            let needTrN = if tx == 0 && needTr && haveRight { 4 } else { 0 }
            let topAt = at - stride
            if haveTop && (!needTl || haveLeft) && (tx != 0 || !needTr || haveRight) && n + needTrN <= pxHaveT {
                // Read straight from the row above.
                var k = 0
                let cnt = n + needTrN
                while k < cnt {
                    et[1 + k] = pl[topAt + k]
                    k += 1
                }
                if needTl {
                    et[0] = pl[topAt - 1]
                }
            } else {
                if haveTop {
                    if n <= pxHaveT {
                        for k in 0..n {
                            et[1 + k] = pl[topAt + k]
                        }
                    } else {
                        for k in 0..pxHaveT {
                            et[1 + k] = pl[topAt + k]
                        }
                        let last = et[pxHaveT]
                        for k in pxHaveT..n {
                            et[1 + k] = last
                        }
                    }
                } else {
                    for k in 0..n {
                        et[1 + k] = 128 * base - 1
                    }
                }
                if needTl {
                    if haveLeft && haveTop {
                        et[0] = pl[topAt - 1]
                    } else {
                        et[0] = if haveTop { 128 * base + 1 } else { 128 * base - 1 }
                    }
                }
                if tx == 0 && needTr {
                    if haveTop && haveRight && n + needTrN <= pxHaveT {
                        for k in 4..8 {
                            et[1 + k] = pl[topAt + k]
                        }
                    } else {
                        let v = et[4]
                        for k in 4..8 {
                            et[1 + k] = v
                        }
                    }
                }
            }
            if tx > 0 {
                // Larger blocks never use the above-right: extend by the
                // last sample (as the predictors effectively do).
                let v = et[n]
                for k in n..(2 * n) {
                    et[1 + k] = v
                }
            }
        }
        if needL {
            if haveLeft {
                let la = at - 1
                let cnt = min(n, pxHaveL)
                if invL {
                    for i in 0..cnt {
                        eln[i] = pl[la + i * stride]
                    }
                    if cnt < n {
                        let v = eln[cnt - 1]
                        for i in cnt..n {
                            eln[i] = v
                        }
                    }
                } else {
                    for i in 0..cnt {
                        el[n - 1 - i] = pl[la + i * stride]
                    }
                    if cnt < n {
                        let v = el[n - cnt]
                        for i in 0..(n - cnt) {
                            el[i] = v
                        }
                    }
                }
            } else {
                for i in 0..n {
                    el[i] = 128 * base + 1
                    eln[i] = 128 * base + 1
                }
            }
            if invL {
                let v = eln[n - 1]
                for i in n..(2 * n + 2) {
                    eln[i] = v
                }
            }
        }
        mode
    }

    // Predicts an n x n block at plane offset `at` with the edges gathered
    // by edges() (8.5.1.1 … 8.5.1.4 as FFmpeg's intra_pred).
    fn predict(_ mode: Int, _ at: Int, _ stride: Int, _ tx: Int) {
        let n = 4 << tx
        let base = 1 << (bitDepth - 8)
        if mode == 0 {
            // V
            for y in 0..n {
                let d = at + y * stride
                for x in 0..n {
                    pl[d + x] = et[1 + x]
                }
            }
        } else if mode == 1 {
            // H
            for y in 0..n {
                let d = at + y * stride
                let v = el[n - 1 - y]
                for x in 0..n {
                    pl[d + x] = v
                }
            }
        } else if mode == 2 || mode == 10 || mode == 11 {
            var sum = 0
            var sh = tx + 2
            if mode != 11 {
                for i in 0..n {
                    sum += el[i]
                }
            }
            if mode != 10 {
                for i in 0..n {
                    sum += et[1 + i]
                }
            }
            if mode == 2 {
                sh += 1
            }
            let v = (sum + (1 << (sh - 1))) >> sh
            fillBlock(at, stride, n, v)
        } else if mode == 12 {
            fillBlock(at, stride, n, 128 * base)
        } else if mode == 13 {
            fillBlock(at, stride, n, 128 * base - 1)
        } else if mode == 14 {
            fillBlock(at, stride, n, 128 * base + 1)
        } else if mode == 9 {
            // TM
            let tl = et[0]
            for y in 0..n {
                let d = at + y * stride
                let lm = el[n - 1 - y] - tl
                for x in 0..n {
                    pl[d + x] = clip(et[1 + x] + lm)
                }
            }
        } else if mode == 3 {
            // D45 (diagonal down left): v[k] along the anti-diagonals.
            let last = et[2 * n]
            for k in 0..(2 * n - 2) {
                vv[k] = (et[1 + k] + 2 * et[2 + k] + et[3 + k] + 2) >> 2
            }
            vv[2 * n - 2] = last
            copyRows(at, stride, n, 0, 1, 0)
        } else if mode == 7 {
            // D63 (vertical left): even rows from ve, odd rows from vo.
            let m = n / 2 + n
            for k in 0..m {
                vv[k] = (et[1 + k] + et[2 + k] + 1) >> 1
                vv[80 + k] = (et[1 + k] + 2 * et[2 + k] + et[3 + k] + 2) >> 2
            }
            for y in 0..n {
                let d = at + y * stride
                let base = (y >> 1) + (if (y & 1) == 0 { 0 } else { 80 })
                for x in 0..n {
                    pl[d + x] = vv[base + x]
                }
            }
        } else if mode == 4 {
            // D135 (diagonal down right) over e = left (bottom-up),
            // top-left, top.
            for i in 0..(2 * n - 1) {
                vv[i] = (edgeE(i, n) + 2 * edgeE(i + 1, n) + edgeE(i + 2, n) + 2) >> 2
            }
            copyRows(at, stride, n, n - 1, -1, 0)
        } else if mode == 5 {
            // D117 (vertical right)
            let h = n / 2
            let m = h + n - 1
            for i in 0..m {
                vv[i] = d117e(i, n)
                vv[80 + i] = d117o(i, n)
            }
            for y in 0..n {
                let d = at + y * stride
                let base = h - 1 - (y >> 1) + (if (y & 1) == 0 { 0 } else { 80 })
                for x in 0..n {
                    pl[d + x] = vv[base + x]
                }
            }
        } else if mode == 6 {
            // D153 (horizontal down)
            for i in 0..(3 * n - 2) {
                vv[i] = d153v(i, n)
            }
            copyRows(at, stride, n, 2 * n - 2, -2, 0)
        } else if mode == 8 {
            // D207 (horizontal up) over the top-down left column.
            for idx in 0..(3 * n - 2) {
                let i = idx >> 1
                if (idx & 1) == 0 {
                    vv[idx] = (eln[i] + eln[i + 1] + 1) >> 1
                } else {
                    vv[idx] = (eln[i] + 2 * eln[i + 1] + eln[i + 2] + 2) >> 2
                }
            }
            copyRows(at, stride, n, 0, 2, 0)
        }
    }

    // Row y of the block is vv[start + y * step …].
    fn copyRows(_ at: Int, _ stride: Int, _ n: Int, _ start: Int, _ step: Int, _ unused: Int) {
        for y in 0..n {
            let d = at + y * stride
            let b = start + y * step
            for x in 0..n {
                pl[d + x] = vv[b + x]
            }
        }
    }

    fn fillBlock(_ at: Int, _ stride: Int, _ n: Int, _ v: Int) {
        for y in 0..n {
            let d = at + y * stride
            for x in 0..n {
                pl[d + x] = v
            }
        }
    }

    // The joined edge left (bottom-up) · top-left · top for D135.
    fn edgeE(_ i: Int, _ n: Int) -> Int {
        if i < n {
            return el[i]
        }
        et[i - n]
    }

    // FFmpeg's ve / vo arrays of vert_right.
    fn d117e(_ i: Int, _ n: Int) -> Int {
        let h = n / 2
        if i < h - 2 {
            return (el[i * 2 + 4] + el[i * 2 + 3] * 2 + el[i * 2 + 2] + 2) >> 2
        }
        if i == h - 2 {
            return (et[0] + el[n - 1] * 2 + el[n - 2] + 2) >> 2
        }
        if i == h - 1 {
            return (et[0] + et[1] + 1) >> 1
        }
        let k = i - h
        (et[1 + k] + et[2 + k] + 1) >> 1
    }

    fn d117o(_ i: Int, _ n: Int) -> Int {
        let h = n / 2
        if i < h - 2 {
            return (el[i * 2 + 3] + el[i * 2 + 2] * 2 + el[i * 2 + 1] + 2) >> 2
        }
        if i == h - 2 {
            return (el[n - 1] + el[n - 2] * 2 + el[n - 3] + 2) >> 2
        }
        if i == h - 1 {
            return (el[n - 1] + et[0] * 2 + et[1] + 2) >> 2
        }
        let k = i - h
        (et[k] + et[1 + k] * 2 + et[2 + k] + 2) >> 2
    }

    // FFmpeg's v array of hor_down.
    fn d153v(_ i: Int, _ n: Int) -> Int {
        if i >= 2 * n {
            let k = i - 2 * n
            return (et[k] + et[1 + k] * 2 + et[2 + k] + 2) >> 2
        }
        if i == 2 * n - 1 {
            return (et[1] + et[0] * 2 + el[n - 1] + 2) >> 2
        }
        if i == 2 * n - 2 {
            return (et[0] + el[n - 1] + 1) >> 1
        }
        if i == 2 * n - 3 {
            return (et[0] + el[n - 1] * 2 + el[n - 2] + 2) >> 2
        }
        if i == 2 * n - 4 {
            return (el[n - 1] + el[n - 2] + 1) >> 1
        }
        let k = i >> 1
        if (i & 1) == 0 {
            return (el[k + 1] + el[k] + 1) >> 1
        }
        (el[k + 2] + el[k + 1] * 2 + el[k] + 2) >> 2
    }

    // ---- inverse transforms --------------------------------------------

    // Adds the inverse transform of the coefficient entries
    // coefs[from + 1 … from + cnt] (value * 1024 + position) to the n x n
    // block at plane offset `at`. kind: 0…3 the FFmpeg transform type
    // (DCT_DCT, DCT_ADST, ADST_DCT, ADST_ADST), 4 the lossless WHT.
    fn itxAdd(_ coefs: [Int], _ from: Int, _ cnt: Int, _ at: Int, _ stride: Int, _ tx: Int, _ kind0: Int) {
        let n = 4 << tx
        // 32x32 blocks always use the DCT.
        let kind = if tx == 3 { 0 } else { kind0 }
        // DC only, DCT: one value for the whole block.
        if kind == 0 && cnt == 1 && (coefs[from + 1] & 1023) == 0 {
            let dc = coefs[from + 1] >> 10
            let t = (((dc * 11585 + 8192) >> 14) * 11585 + 8192) >> 14
            let bits = if tx == 0 { 4 } else if tx == 1 { 5 } else { 6 }
            let add = (t + (1 << (bits - 1))) >> bits
            for y in 0..n {
                let d = at + y * stride
                for x in 0..n {
                    pl[d + x] = clip(pl[d + x] + add)
                }
            }
            return
        }
        if tx == 0 {
            itx4(coefs, from, cnt, at, stride, kind)
            return
        }
        if tx == 1 {
            itx8(coefs, from, cnt, at, stride, kind)
            return
        }
        // Scatter the coefficients; note the columns that have any.
        var colMask = 0
        for k in 0..cnt {
            let e = coefs[from + 1 + k]
            let pos = e & 1023
            blk[pos] = e >> 10
            colMask = colMask | (1 << (pos & (n - 1)))
        }
        let k1 = if kind == 4 { 2 } else if kind == 1 || kind == 3 { 1 } else { 0 }
        let k2 = if kind == 4 { 2 } else if kind >= 2 { 1 } else { 0 }
        // Pass 1 over each column i of blk (stride n) into row i of tmp.
        for i in 0..n {
            if ((colMask >> i) & 1) == 0 {
                for j in 0..n {
                    tmp[i * n + j] = 0
                }
            } else {
                tx1d(k1, n, true, i, n, 0)
                for j in 0..n {
                    tmp[i * n + j] = o[j]
                }
            }
        }
        // Clear the coefficients for the next block.
        for k in 0..cnt {
            blk[coefs[from + 1 + k] & 1023] = 0
        }
        // Pass 2 over each column of tmp, added to the picture.
        let bits = if kind == 4 { 0 } else if tx == 0 { 4 } else if tx == 1 { 5 } else { 6 }
        let rnd = if bits > 0 { 1 << (bits - 1) } else { 0 }
        for i in 0..n {
            tx1d(k2, n, false, i, n, 1)
            for j in 0..n {
                let d = at + j * stride + i
                pl[d] = clip(pl[d] + ((o[j] + rnd) >> bits))
            }
        }
    }

    // The 4x4 transforms with everything in locals.
    fn itx4(_ coefs: [Int], _ from: Int, _ cnt: Int, _ at: Int, _ stride: Int, _ kind: Int) {
        for k in 0..cnt {
            let e = coefs[from + 1 + k]
            blk[e & 15] = e >> 10
        }
        let c0 = blk[0]
        let c1 = blk[1]
        let c2 = blk[2]
        let c3 = blk[3]
        let c4 = blk[4]
        let c5 = blk[5]
        let c6 = blk[6]
        let c7 = blk[7]
        let c8 = blk[8]
        let c9 = blk[9]
        let c10 = blk[10]
        let c11 = blk[11]
        let c12 = blk[12]
        let c13 = blk[13]
        let c14 = blk[14]
        let c15 = blk[15]
        for k in 0..cnt {
            blk[coefs[from + 1 + k] & 15] = 0
        }
        // Pass 1 over the columns (FFmpeg's first pass), row i of tmp.
        let a1 = kind == 1 || kind == 3
        let a2 = kind >= 2 && kind != 4
        let w = kind == 4
        var r0 = (0, 0, 0, 0)
        var r1 = (0, 0, 0, 0)
        var r2 = (0, 0, 0, 0)
        var r3 = (0, 0, 0, 0)
        if w {
            r0 = vp9Iwht4(c0 >> 2, c4 >> 2, c8 >> 2, c12 >> 2)
            r1 = vp9Iwht4(c1 >> 2, c5 >> 2, c9 >> 2, c13 >> 2)
            r2 = vp9Iwht4(c2 >> 2, c6 >> 2, c10 >> 2, c14 >> 2)
            r3 = vp9Iwht4(c3 >> 2, c7 >> 2, c11 >> 2, c15 >> 2)
        } else if a1 {
            r0 = vp9Iadst4(c0, c4, c8, c12)
            r1 = vp9Iadst4(c1, c5, c9, c13)
            r2 = vp9Iadst4(c2, c6, c10, c14)
            r3 = vp9Iadst4(c3, c7, c11, c15)
        } else {
            r0 = vp9Idct4(c0, c4, c8, c12)
            r1 = vp9Idct4(c1, c5, c9, c13)
            r2 = vp9Idct4(c2, c6, c10, c14)
            r3 = vp9Idct4(c3, c7, c11, c15)
        }
        // Pass 2 over the columns of tmp: column i is (r0.i, r1.i, r2.i, r3.i).
        var o0 = (0, 0, 0, 0)
        var o1 = (0, 0, 0, 0)
        var o2 = (0, 0, 0, 0)
        var o3 = (0, 0, 0, 0)
        if w {
            o0 = vp9Iwht4(r0.0, r1.0, r2.0, r3.0)
            o1 = vp9Iwht4(r0.1, r1.1, r2.1, r3.1)
            o2 = vp9Iwht4(r0.2, r1.2, r2.2, r3.2)
            o3 = vp9Iwht4(r0.3, r1.3, r2.3, r3.3)
        } else if a2 {
            o0 = vp9Iadst4(r0.0, r1.0, r2.0, r3.0)
            o1 = vp9Iadst4(r0.1, r1.1, r2.1, r3.1)
            o2 = vp9Iadst4(r0.2, r1.2, r2.2, r3.2)
            o3 = vp9Iadst4(r0.3, r1.3, r2.3, r3.3)
        } else {
            o0 = vp9Idct4(r0.0, r1.0, r2.0, r3.0)
            o1 = vp9Idct4(r0.1, r1.1, r2.1, r3.1)
            o2 = vp9Idct4(r0.2, r1.2, r2.2, r3.2)
            o3 = vp9Idct4(r0.3, r1.3, r2.3, r3.3)
        }
        let rnd = if w { 0 } else { 8 }
        let sh = if w { 0 } else { 4 }
        // Column i of the output is o_i; its sample j goes to row j.
        add4(at, 0, o0, rnd, sh, stride)
        add4(at, 1, o1, rnd, sh, stride)
        add4(at, 2, o2, rnd, sh, stride)
        add4(at, 3, o3, rnd, sh, stride)
    }

    // The 8x8 transforms with everything in locals.
    fn itx8(_ coefs: [Int], _ from: Int, _ cnt: Int, _ at: Int, _ stride: Int, _ kind: Int) {
        for k in 0..cnt {
            let e = coefs[from + 1 + k]
            blk[e & 63] = e >> 10
        }
        let c0 = blk[0]
        let c1 = blk[1]
        let c2 = blk[2]
        let c3 = blk[3]
        let c4 = blk[4]
        let c5 = blk[5]
        let c6 = blk[6]
        let c7 = blk[7]
        let c8 = blk[8]
        let c9 = blk[9]
        let c10 = blk[10]
        let c11 = blk[11]
        let c12 = blk[12]
        let c13 = blk[13]
        let c14 = blk[14]
        let c15 = blk[15]
        let c16 = blk[16]
        let c17 = blk[17]
        let c18 = blk[18]
        let c19 = blk[19]
        let c20 = blk[20]
        let c21 = blk[21]
        let c22 = blk[22]
        let c23 = blk[23]
        let c24 = blk[24]
        let c25 = blk[25]
        let c26 = blk[26]
        let c27 = blk[27]
        let c28 = blk[28]
        let c29 = blk[29]
        let c30 = blk[30]
        let c31 = blk[31]
        let c32 = blk[32]
        let c33 = blk[33]
        let c34 = blk[34]
        let c35 = blk[35]
        let c36 = blk[36]
        let c37 = blk[37]
        let c38 = blk[38]
        let c39 = blk[39]
        let c40 = blk[40]
        let c41 = blk[41]
        let c42 = blk[42]
        let c43 = blk[43]
        let c44 = blk[44]
        let c45 = blk[45]
        let c46 = blk[46]
        let c47 = blk[47]
        let c48 = blk[48]
        let c49 = blk[49]
        let c50 = blk[50]
        let c51 = blk[51]
        let c52 = blk[52]
        let c53 = blk[53]
        let c54 = blk[54]
        let c55 = blk[55]
        let c56 = blk[56]
        let c57 = blk[57]
        let c58 = blk[58]
        let c59 = blk[59]
        let c60 = blk[60]
        let c61 = blk[61]
        let c62 = blk[62]
        let c63 = blk[63]
        for k in 0..cnt {
            blk[coefs[from + 1 + k] & 63] = 0
        }
