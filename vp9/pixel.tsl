        var t14 = t15a - t14a
        var t15 = t15a + t14a
        var t16 = t16a + t17a
        var t17 = t16a - t17a
        var t18 = t19a - t18a
        var t19 = t19a + t18a
        var t20 = t20a + t21a
        var t21 = t20a - t21a
        var t22 = t23a - t22a
        var t23 = t23a + t22a
        var t24 = t24a + t25a
        var t25 = t24a - t25a
        var t26 = t27a - t26a
        var t27 = t27a + t26a
        var t28 = t28a + t29a
        var t29 = t28a - t29a
        var t30 = t31a - t30a
        var t31 = t31a + t30a

        t5a = ((t6 - t5) * 11585 + 8192) >> 14
        t6a = ((t6 + t5) * 11585 + 8192) >> 14
        t9a = (t14 * 6270 - t9 * 15137 + 8192) >> 14
        t14a = (t14 * 15137 + t9 * 6270 + 8192) >> 14
        t10a = (-(t13 * 15137 + t10 * 6270) + 8192) >> 14
        t13a = (t13 * 6270 - t10 * 15137 + 8192) >> 14
        t17a = (t30 * 3196 - t17 * 16069 + 8192) >> 14
        t30a = (t30 * 16069 + t17 * 3196 + 8192) >> 14
        t18a = (-(t29 * 16069 + t18 * 3196) + 8192) >> 14
        t29a = (t29 * 3196 - t18 * 16069 + 8192) >> 14
        t21a = (t26 * 13623 - t21 * 9102 + 8192) >> 14
        t26a = (t26 * 9102 + t21 * 13623 + 8192) >> 14
        t22a = (-(t25 * 9102 + t22 * 13623) + 8192) >> 14
        t25a = (t25 * 13623 - t22 * 9102 + 8192) >> 14

        t0a = t0 + t7
        t1a = t1 + t6a
        t2a = t2 + t5a
        t3a = t3 + t4
        t4a = t3 - t4
        t5 = t2 - t5a
        t6 = t1 - t6a
        t7a = t0 - t7
        t8a = t8 + t11
        t9 = t9a + t10a
        t10 = t9a - t10a
        t11a = t8 - t11
        t12a = t15 - t12
        t13 = t14a - t13a
        t14 = t14a + t13a
        t15a = t15 + t12
        t16a = t16 + t19
        t17 = t17a + t18a
        t18 = t17a - t18a
        t19a = t16 - t19
        t20a = t23 - t20
        t21 = t22a - t21a
        t22 = t22a + t21a
        t23a = t23 + t20
        t24a = t24 + t27
        t25 = t25a + t26a
        t26 = t25a - t26a
        t27a = t24 - t27
        t28a = t31 - t28
        t29 = t30a - t29a
        t30 = t30a + t29a
        t31a = t31 + t28

        t10a = ((t13 - t10) * 11585 + 8192) >> 14
        t13a = ((t13 + t10) * 11585 + 8192) >> 14
        t11 = ((t12a - t11a) * 11585 + 8192) >> 14
        t12 = ((t12a + t11a) * 11585 + 8192) >> 14
        t18a = (t29 * 6270 - t18 * 15137 + 8192) >> 14
        t29a = (t29 * 15137 + t18 * 6270 + 8192) >> 14
        t19 = (t28a * 6270 - t19a * 15137 + 8192) >> 14
        t28 = (t28a * 15137 + t19a * 6270 + 8192) >> 14
        t20 = (-(t27a * 15137 + t20a * 6270) + 8192) >> 14
        t27 = (t27a * 6270 - t20a * 15137 + 8192) >> 14
        t21a = (-(t26 * 15137 + t21 * 6270) + 8192) >> 14
        t26a = (t26 * 6270 - t21 * 15137 + 8192) >> 14

        t0 = t0a + t15a
        t1 = t1a + t14
        t2 = t2a + t13a
        t3 = t3a + t12
        t4 = t4a + t11
        t5a = t5 + t10a
        t6a = t6 + t9
        t7 = t7a + t8a
        t8 = t7a - t8a
        t9a = t6 - t9
        t10 = t5 - t10a
        t11a = t4a - t11
        t12a = t3a - t12
        t13 = t2a - t13a
        t14a = t1a - t14
        t15 = t0a - t15a
        t16 = t16a + t23a
        t17a = t17 + t22
        t18 = t18a + t21a
        t19a = t19 + t20
        t20a = t19 - t20
        t21 = t18a - t21a
        t22a = t17 - t22
        t23 = t16a - t23a
        t24 = t31a - t24a
        t25a = t30 - t25
        t26 = t29a - t26a
        t27a = t28 - t27
        t28a = t28 + t27
        t29 = t29a + t26a
        t30a = t30 + t25
        t31 = t31a + t24a

        t20 = ((t27a - t20a) * 11585 + 8192) >> 14
        t27 = ((t27a + t20a) * 11585 + 8192) >> 14
        t21a = ((t26 - t21) * 11585 + 8192) >> 14
        t26a = ((t26 + t21) * 11585 + 8192) >> 14
        t22 = ((t25a - t22a) * 11585 + 8192) >> 14
        t25 = ((t25a + t22a) * 11585 + 8192) >> 14
        t23a = ((t24 - t23) * 11585 + 8192) >> 14
        t24a = ((t24 + t23) * 11585 + 8192) >> 14

        o[0] = t0 + t31
        o[1] = t1 + t30a
        o[2] = t2 + t29
        o[3] = t3 + t28a
        o[4] = t4 + t27
        o[5] = t5a + t26a
        o[6] = t6a + t25
        o[7] = t7 + t24a
        o[8] = t8 + t23a
        o[9] = t9a + t22
        o[10] = t10 + t21a
        o[11] = t11a + t20
        o[12] = t12a + t19a
        o[13] = t13 + t18
        o[14] = t14a + t17a
        o[15] = t15 + t16
        o[16] = t15 - t16
        o[17] = t14a - t17a
        o[18] = t13 - t18
        o[19] = t12a - t19a
        o[20] = t11a - t20
        o[21] = t10 - t21a
        o[22] = t9a - t22
        o[23] = t8 - t23a
        o[24] = t7 - t24a
        o[25] = t6a - t25
        o[26] = t5a - t26a
        o[27] = t4 - t27
        o[28] = t3 - t28a
        o[29] = t2 - t29
        o[30] = t1 - t30a
        o[31] = t0 - t31
    }

    // ---- motion compensation ------------------------------------------------

    // Predicts a bw x bh block into pl[dOff] (rows dStride apart) from the
    // reference plane `ref` (rw x rh visible samples, rows rStride apart)
    // at integer position (x, y) plus phase (mx, my) in 1/16 sample.
    // Samples outside the visible reference repeat its edges. avg: average
    // with what is already there (the second prediction of a compound
    // block). filt: 0 smooth, 1 regular, 2 sharp, 3 bilinear.
    fn mc(_ ref: [Int], _ rStride: Int, _ rw: Int, _ rh: Int, _ x: Int, _ y: Int, _ mx: Int, _ my: Int,
          _ dOff: Int, _ dStride: Int, _ bw: Int, _ bh: Int, _ filt: Int, _ avg: Bool) {
        let hx = if mx != 0 { 1 } else { 0 }
        let hy = if my != 0 { 1 } else { 0 }
        if x - 3 * hx >= 0 && y - 3 * hy >= 0 && x + bw + 4 * hx <= rw && y + bh + 4 * hy <= rh {
            mcFilter(ref, y * rStride + x, rStride, mx, my, dOff, dStride, bw, bh, filt, avg)
            return
        }
        // Copy the area with edge clamping (emulated_edge_mc).
        let ew = bw + 7 * hx
        let eh = bh + 7 * hy
        let x0 = x - 3 * hx
        let y0 = y - 3 * hy
        for j in 0..eh {
            let sy = vp9Clip(y0 + j, 0, rh - 1) * rStride
            let e = j * 160
            for i in 0..ew {
                emu[e + i] = ref[sy + vp9Clip(x0 + i, 0, rw - 1)]
            }
        }
        let e = emu
        mcFilter(e, 3 * hy * 160 + 3 * hx, 160, mx, my, dOff, dStride, bw, bh, filt, avg)
    }

    fn mcFilter(_ src: [Int], _ sOff: Int, _ sStride: Int, _ mx: Int, _ my: Int,
                _ dOff: Int, _ dStride: Int, _ bw: Int, _ bh: Int, _ filt: Int, _ avg: Bool) {
        let mv = maxV
        if mx == 0 && my == 0 {
            for y in 0..bh {
                let s = sOff + y * sStride
                let d = dOff + y * dStride
                if avg {
                    for x in 0..bw {
                        pl[d + x] = (pl[d + x] + src[s + x] + 1) >> 1
                    }
                } else {
                    for x in 0..bw {
                        pl[d + x] = src[s + x]
                    }
                }
            }
            return
        }
        if filt == 3 {
            mcBilin(src, sOff, sStride, mx, my, dOff, dStride, bw, bh, avg)
            return
        }
        // The 8-tap filters work on two samples at once: sample x in the low
        // 32 bits of an Int and sample x + 1 in the high bits (every sum
        // stays far inside 32 bits, so the halves don't mix).
        let f = filters
        let rnd = 64 + (64 << 32)
        if my == 0 {
            let fb = filt * 128 + mx * 8
            let f0 = f[fb]
            let f1 = f[fb + 1]
            let f2 = f[fb + 2]
            let f3 = f[fb + 3]
            let f4 = f[fb + 4]
            let f5 = f[fb + 5]
            let f6 = f[fb + 6]
            let f7 = f[fb + 7]
            for y in 0..bh {
                let s = sOff + y * sStride - 3
                let d = dOff + y * dStride
                let c2 = src[s + 2]
                var p0 = src[s] + (src[s + 1] << 32)
                var p1 = src[s + 1] + (c2 << 32)
                var p2 = c2 + (src[s + 3] << 32)
                var p3 = src[s + 3] + (src[s + 4] << 32)
                var p4 = src[s + 4] + (src[s + 5] << 32)
                var c7 = src[s + 7]
                var p5 = src[s + 5] + (src[s + 6] << 32)
                var p6 = src[s + 6] + (c7 << 32)
                var x = 0
                var k = s + 8
                while x < bw {
                    let c8 = src[k]
                    let p7 = c7 + (c8 << 32)
                    let sum = f0 * p0 + f1 * p1 + f2 * p2 + f3 * p3 + f4 * p4 + f5 * p5 + f6 * p6 + f7 * p7 + rnd
                    let lo = ((sum & 0xffffffff) ^ 0x80000000) - 0x80000000
                    var v0 = lo >> 7
                    var v1 = (sum - lo) >> 39
                    if v0 < 0 { v0 = 0 } else if v0 > mv { v0 = mv }
                    if v1 < 0 { v1 = 0 } else if v1 > mv { v1 = mv }
                    if avg {
                        pl[d + x] = (pl[d + x] + v0 + 1) >> 1
                        pl[d + x + 1] = (pl[d + x + 1] + v1 + 1) >> 1
                    } else {
                        pl[d + x] = v0
                        pl[d + x + 1] = v1
                    }
                    p0 = p2
                    p1 = p3
                    p2 = p4
                    p3 = p5
                    p4 = p6
                    p5 = p7
                    x += 2
                    if x < bw {
                        let c9 = src[k + 1]
                        p6 = c8 + (c9 << 32)
                        c7 = c9
                    }
                    k += 2
                }
            }
            return
        }
        let gb = filt * 128 + my * 8
        let g0 = f[gb]
        let g1 = f[gb + 1]
        let g2 = f[gb + 2]
        let g3 = f[gb + 3]
        let g4 = f[gb + 4]
        let g5 = f[gb + 5]
        let g6 = f[gb + 6]
        let g7 = f[gb + 7]
        if mx == 0 {
            // Vertical only: down each pair of columns.
            var x = 0
            while x < bw {
                let b0 = sOff + x - 3 * sStride
                var q0 = src[b0] + (src[b0 + 1] << 32)
                var q1 = src[b0 + sStride] + (src[b0 + sStride + 1] << 32)
                var q2 = src[b0 + 2 * sStride] + (src[b0 + 2 * sStride + 1] << 32)
                var q3 = src[b0 + 3 * sStride] + (src[b0 + 3 * sStride + 1] << 32)
                var q4 = src[b0 + 4 * sStride] + (src[b0 + 4 * sStride + 1] << 32)
                var q5 = src[b0 + 5 * sStride] + (src[b0 + 5 * sStride + 1] << 32)
                var q6 = src[b0 + 6 * sStride] + (src[b0 + 6 * sStride + 1] << 32)
                var r = b0 + 7 * sStride
                var d = dOff + x
                var y = 0
                while y < bh {
                    let q7 = src[r] + (src[r + 1] << 32)
                    let sum = g0 * q0 + g1 * q1 + g2 * q2 + g3 * q3 + g4 * q4 + g5 * q5 + g6 * q6 + g7 * q7 + rnd
                    let lo = ((sum & 0xffffffff) ^ 0x80000000) - 0x80000000
                    var v0 = lo >> 7
                    var v1 = (sum - lo) >> 39
                    if v0 < 0 { v0 = 0 } else if v0 > mv { v0 = mv }
                    if v1 < 0 { v1 = 0 } else if v1 > mv { v1 = mv }
                    if avg {
                        pl[d] = (pl[d] + v0 + 1) >> 1
                        pl[d + 1] = (pl[d + 1] + v1 + 1) >> 1
                    } else {
                        pl[d] = v0
                        pl[d + 1] = v1
                    }
                    q0 = q1
                    q1 = q2
                    q2 = q3
                    q3 = q4
                    q4 = q5
                    q5 = q6
                    q6 = q7
                    r += sStride
                    d += dStride
                    y += 1
                }
                x += 2
            }
            return
        }
        // Two passes: horizontal into mcTmp (rows -3 … bh + 3, pairs packed,
        // 32 pairs a row), then vertical down each pair of columns.
        let fb = filt * 128 + mx * 8
        let f0 = f[fb]
        let f1 = f[fb + 1]
        let f2 = f[fb + 2]
        let f3 = f[fb + 3]
        let f4 = f[fb + 4]
        let f5 = f[fb + 5]
        let f6 = f[fb + 6]
        let f7 = f[fb + 7]
        let hw = bw >> 1
        for y in 0..(bh + 7) {
            let s = sOff + (y - 3) * sStride - 3
            let t = y * 32
            let c2 = src[s + 2]
            var p0 = src[s] + (src[s + 1] << 32)
            var p1 = src[s + 1] + (c2 << 32)
            var p2 = c2 + (src[s + 3] << 32)
            var p3 = src[s + 3] + (src[s + 4] << 32)
            var p4 = src[s + 4] + (src[s + 5] << 32)
            var c7 = src[s + 7]
            var p5 = src[s + 5] + (src[s + 6] << 32)
            var p6 = src[s + 6] + (c7 << 32)
            var x = 0
            var k = s + 8
            while x < hw {
                let c8 = src[k]
                let p7 = c7 + (c8 << 32)
                let sum = f0 * p0 + f1 * p1 + f2 * p2 + f3 * p3 + f4 * p4 + f5 * p5 + f6 * p6 + f7 * p7 + rnd
                let lo = ((sum & 0xffffffff) ^ 0x80000000) - 0x80000000
                var v0 = lo >> 7
                var v1 = (sum - lo) >> 39
                if v0 < 0 { v0 = 0 } else if v0 > mv { v0 = mv }
                if v1 < 0 { v1 = 0 } else if v1 > mv { v1 = mv }
                mcTmp[t + x] = v0 + (v1 << 32)
                p0 = p2
                p1 = p3
                p2 = p4
                p3 = p5
                p4 = p6
                p5 = p7
                x += 1
                if x < hw {
                    let c9 = src[k + 1]
                    p6 = c8 + (c9 << 32)
                    c7 = c9
                }
                k += 2
            }
        }
        for x in 0..hw {
            var a0 = mcTmp[x]
            var a1 = mcTmp[x + 32]
            var a2 = mcTmp[x + 64]
            var a3 = mcTmp[x + 96]
            var a4 = mcTmp[x + 128]
            var a5 = mcTmp[x + 160]
            var a6 = mcTmp[x + 192]
            var r = x + 224
            var d = dOff + 2 * x
            var y = 0
            while y < bh {
                let a7 = mcTmp[r]
                let sum = g0 * a0 + g1 * a1 + g2 * a2 + g3 * a3 + g4 * a4 + g5 * a5 + g6 * a6 + g7 * a7 + rnd
                let lo = ((sum & 0xffffffff) ^ 0x80000000) - 0x80000000
                var v0 = lo >> 7
                var v1 = (sum - lo) >> 39
                if v0 < 0 { v0 = 0 } else if v0 > mv { v0 = mv }
                if v1 < 0 { v1 = 0 } else if v1 > mv { v1 = mv }
                if avg {
                    pl[d] = (pl[d] + v0 + 1) >> 1
                    pl[d + 1] = (pl[d + 1] + v1 + 1) >> 1
                } else {
                    pl[d] = v0
                    pl[d + 1] = v1
                }
                a0 = a1
                a1 = a2
                a2 = a3
                a3 = a4
                a4 = a5
                a5 = a6
                a6 = a7
                r += 32
                d += dStride
                y += 1
            }
        }
    }

    fn mcBilin(_ src: [Int], _ sOff: Int, _ sStride: Int, _ mx: Int, _ my: Int,
               _ dOff: Int, _ dStride: Int, _ bw: Int, _ bh: Int, _ avg: Bool) {
        if my == 0 {
            for y in 0..bh {
                let s = sOff + y * sStride
                let d = dOff + y * dStride
                for x in 0..bw {
                    let a = src[s + x]
                    let v = a + ((mx * (src[s + x + 1] - a) + 8) >> 4)
                    pl[d + x] = if avg { (pl[d + x] + v + 1) >> 1 } else { v }
                }
            }
            return
        }
        if mx == 0 {
            for y in 0..bh {
                let s = sOff + y * sStride
                let d = dOff + y * dStride
                for x in 0..bw {
                    let a = src[s + x]
                    let v = a + ((my * (src[s + x + sStride] - a) + 8) >> 4)
                    pl[d + x] = if avg { (pl[d + x] + v + 1) >> 1 } else { v }
                }
            }
            return
        }
        for y in 0..(bh + 1) {
            let s = sOff + y * sStride
            let t = y * 64
            for x in 0..bw {
                let a = src[s + x]
                mcTmp[t + x] = a + ((mx * (src[s + x + 1] - a) + 8) >> 4)
            }
        }
        for y in 0..bh {
            let d = dOff + y * dStride
            let t = y * 64
            for x in 0..bw {
                let a = mcTmp[t + x]
                let v = a + ((my * (mcTmp[t + x + 64] - a) + 8) >> 4)
                pl[d + x] = if avg { (pl[d + x] + v + 1) >> 1 } else { v }
            }
        }
    }

    // Scaled prediction (8.5.2.3 with a reference of another size):
    // (x, y) the integer and (mx, my) the 1/16 phase of the first sample,
    // (dx, dy) the step per output sample in 1/16.
    fn mcScaled(_ ref: [Int], _ rStride: Int, _ rw: Int, _ rh: Int, _ x: Int, _ y: Int, _ mx: Int, _ my: Int,
                _ dx: Int, _ dy: Int, _ dOff: Int, _ dStride: Int, _ bw: Int, _ bh: Int, _ filt: Int, _ avg: Bool) {
        let refbw = ((bw - 1) * dx + mx) >> 4
        let refbh = ((bh - 1) * dy + my) >> 4
        var src = ref
        var sOff = y * rStride + x
        var sStride = rStride
        if x < 3 || y < 3 || x + 4 >= rw - refbw || y + 5 >= rh - refbh {
            let ew = refbw + 8
            let eh = refbh + 8
            let x0 = x - 3
            let y0 = y - 3
            for j in 0..eh {
                let sy = vp9Clip(y0 + j, 0, rh - 1) * rStride
                let e = j * 288
                for i in 0..ew {
                    emu[e + i] = ref[sy + vp9Clip(x0 + i, 0, rw - 1)]
                }
            }
            src = emu
            sOff = 3 * 288 + 3
            sStride = 288
        }
        let f = filters
        if filt == 3 {
            let th = (((bh - 1) * dy + my) >> 4) + 2
            for yy in 0..th {
                let s = sOff + yy * sStride
                let t = yy * 64
                var imx = mx
                var ioff = 0
                for xx in 0..bw {
                    let a = src[s + ioff]
                    mcTmp[t + xx] = a + ((imx * (src[s + ioff + 1] - a) + 8) >> 4)
                    imx += dx
                    ioff += imx >> 4
                    imx = imx & 15
                }
            }
            var t = 0
            var m = my
            for yy in 0..bh {
                let d = dOff + yy * dStride
                for xx in 0..bw {
                    let a = mcTmp[t + xx]
                    let v = a + ((m * (mcTmp[t + xx + 64] - a) + 8) >> 4)
                    pl[d + xx] = if avg { (pl[d + xx] + v + 1) >> 1 } else { v }
                }
                m += dy
                t += (m >> 4) * 64
                m = m & 15
            }
            return
        }
        let th = (((bh - 1) * dy + my) >> 4) + 8
        for yy in 0..th {
            let s = sOff + (yy - 3) * sStride - 3
            let t = yy * 64
            var imx = mx
            var ioff = 0
            for xx in 0..bw {
                let fb = filt * 128 + imx * 8
                let a = s + ioff
                mcTmp[t + xx] = clip((f[fb] * src[a] + f[fb + 1] * src[a + 1] + f[fb + 2] * src[a + 2] + f[fb + 3] * src[a + 3] + f[fb + 4] * src[a + 4] + f[fb + 5] * src[a + 5] + f[fb + 6] * src[a + 6] + f[fb + 7] * src[a + 7] + 64) >> 7)
                imx += dx
                ioff += imx >> 4
                imx = imx & 15
            }
        }
        var t = 3 * 64
        var m = my
        for yy in 0..bh {
            let d = dOff + yy * dStride
            let gb = filt * 128 + m * 8
            for xx in 0..bw {
                let a = t + xx
                let v = clip((f[gb] * mcTmp[a - 192] + f[gb + 1] * mcTmp[a - 128] + f[gb + 2] * mcTmp[a - 64] + f[gb + 3] * mcTmp[a] + f[gb + 4] * mcTmp[a + 64] + f[gb + 5] * mcTmp[a + 128] + f[gb + 6] * mcTmp[a + 192] + f[gb + 7] * mcTmp[a + 256] + 64) >> 7)
                pl[d + xx] = if avg { (pl[d + xx] + v + 1) >> 1 } else { v }
            }
            m += dy
            t += (m >> 4) * 64
            m = m & 15
        }
    }

    // ---- loop filter (8.8) -------------------------------------------------

    fn setSharpness(_ s: Int) {
        if s == sharp {
            return
        }
        sharp = s
        for i in 1..64 {
            var limit = i
            if s > 0 {
                limit = limit >> ((s + 3) >> 2)
                limit = min(limit, 9 - s)
            }
            limit = max(limit, 1)
            limLut[i] = limit
            mblimLut[i] = 2 * (i + 2) + limit
        }
    }

    // One 8-sample edge segment at plane offset `at`: sa steps along the
    // edge, sb across it. wd 4, 8 or 16 (FFmpeg's loop_filter).
    fn lf(_ at: Int, _ level: Int, _ sa: Int, _ sb: Int, _ wd: Int) {
        let sh = bitDepth - 8
        let e = mblimLut[level] << sh
        let ii = limLut[level] << sh
        let hh = (level >> 4) << sh
        let fl = 1 << sh
        let lo = -(1 << (bitDepth - 1))
        let hi = (1 << (bitDepth - 1)) - 1
        var d = at
        for _ in 0..8 {
            let p3 = pl[d - 4 * sb]
            let p2 = pl[d - 3 * sb]
            let p1 = pl[d - 2 * sb]
            let p0 = pl[d - sb]
            let q0 = pl[d]
            let q1 = pl[d + sb]
            let q2 = pl[d + 2 * sb]
            let q3 = pl[d + 3 * sb]
            let m1 = max(max(abs(p3 - p2), abs(p2 - p1)), max(abs(p1 - p0), abs(q1 - q0)))
            let m2 = max(abs(q2 - q1), abs(q3 - q2))
            let fm = max(m1, m2) <= ii && abs(p0 - q0) * 2 + (abs(p1 - q1) >> 1) <= e
            if fm {
                var flat8in = false
                if wd >= 8 {
                    flat8in = max(max(max(abs(p3 - p0), abs(p2 - p0)), max(abs(p1 - p0), abs(q1 - q0))), max(abs(q2 - q0), abs(q3 - q0))) <= fl
                }
                var flat8out = false
                if wd >= 16 && flat8in {
                    let p7 = pl[d - 8 * sb]
                    let p6 = pl[d - 7 * sb]
                    let p5 = pl[d - 6 * sb]
                    let p4 = pl[d - 5 * sb]
                    let q4 = pl[d + 4 * sb]
                    let q5 = pl[d + 5 * sb]
                    let q6 = pl[d + 6 * sb]
                    let q7 = pl[d + 7 * sb]
                    flat8out = abs(p7 - p0) <= fl && abs(p6 - p0) <= fl && abs(p5 - p0) <= fl && abs(p4 - p0) <= fl &&
                        abs(q4 - q0) <= fl && abs(q5 - q0) <= fl && abs(q6 - q0) <= fl && abs(q7 - q0) <= fl
                    if flat8out {
                        // The 15-tap filter as a running sum.
                        var t = p7 * 7 + p6 * 2 + p5 + p4 + p3 + p2 + p1 + p0 + q0 + 8
                        pl[d - 7 * sb] = t >> 4
                        t += p5 + q1 - p7 - p6
                        pl[d - 6 * sb] = t >> 4
                        t += p4 + q2 - p7 - p5
                        pl[d - 5 * sb] = t >> 4
                        t += p3 + q3 - p7 - p4
                        pl[d - 4 * sb] = t >> 4
                        t += p2 + q4 - p7 - p3
                        pl[d - 3 * sb] = t >> 4
                        t += p1 + q5 - p7 - p2
                        pl[d - 2 * sb] = t >> 4
                        t += p0 + q6 - p7 - p1
                        pl[d - sb] = t >> 4
                        t += q0 + q7 - p7 - p0
                        pl[d] = t >> 4
                        t += q1 + q7 - p6 - q0
                        pl[d + sb] = t >> 4
                        t += q2 + q7 - p5 - q1
                        pl[d + 2 * sb] = t >> 4
                        t += q3 + q7 - p4 - q2
                        pl[d + 3 * sb] = t >> 4
                        t += q4 + q7 - p3 - q3
                        pl[d + 4 * sb] = t >> 4
                        t += q5 + q7 - p2 - q4
                        pl[d + 5 * sb] = t >> 4
                        t += q6 + q7 - p1 - q5
                        pl[d + 6 * sb] = t >> 4
                    }
                }
                if flat8out {
                    // done above
                } else if flat8in {
                    var t = p3 * 3 + 2 * p2 + p1 + p0 + q0 + 4
                    pl[d - 3 * sb] = t >> 3
                    t += p1 + q1 - p3 - p2
                    pl[d - 2 * sb] = t >> 3
                    t += p0 + q2 - p3 - p1
                    pl[d - sb] = t >> 3
                    t += q0 + q3 - p3 - p0
                    pl[d] = t >> 3
                    t += q1 + q3 - p2 - q0
                    pl[d + sb] = t >> 3
                    t += q2 + q3 - p1 - q1
                    pl[d + 2 * sb] = t >> 3
                } else {
                    let hev = abs(p1 - p0) > hh || abs(q1 - q0) > hh
                    if hev {
                        var f = vp9Clip(p1 - q1, lo, hi)
                        f = vp9Clip(3 * (q0 - p0) + f, lo, hi)
                        let f1 = min(f + 4, hi) >> 3
                        let f2 = min(f + 3, hi) >> 3
                        pl[d - sb] = clip(p0 + f2)
                        pl[d] = clip(q0 - f1)
                    } else {
                        let f = vp9Clip(3 * (q0 - p0), lo, hi)
                        let f1 = min(f + 4, hi) >> 3
                        let f2 = min(f + 3, hi) >> 3
                        pl[d - sb] = clip(p0 + f2)
                        pl[d] = clip(q0 - f1)
                        let f3 = (f1 + 1) >> 1
                        pl[d - 2 * sb] = clip(p1 + f3)
                        pl[d + sb] = clip(q1 - f3)
                    }
                }
            }
            d += sa
        }
    }

    // FFmpeg's filter_plane_cols for one superblock: the vertical edges.
    //   mask  the plane's masks (… [y][4] for this direction) at mBase
    //   lv    the superblock's 64 levels at lBase
    fn planeCols(_ mask: [Int], _ mBase: Int, _ lv: [Int], _ lBase: Int, _ col: Int, _ ssH: Int, _ ssV: Int, _ at0: Int, _ ls: Int) {
        var y = 0
        var dst = at0
        var lvl = lBase
        while y < 8 {
            var ptr = dst
            var l = lvl
            let m1 = mBase + y * 4
            let m2 = mBase + (y + 1 + ssV) * 4
            let hm1 = mask[m1] | mask[m1 + 1] | mask[m1 + 2]
            let hm13 = mask[m1 + 3]
            let hm2 = mask[m2 + 1] | mask[m2 + 2]
            let hm23 = mask[m2 + 3]
            let hm = hm1 | hm2 | hm13 | hm23
            var x = 1
            while (hm & ~(x - 1)) != 0 {
                if col != 0 || x > 1 {
                    if (hm1 & x) != 0 {
                        let lL = lv[l]
                        if (mask[m1] & x) != 0 {
                            if (mask[m2] & x) != 0 {
                                lf(ptr, lL, ls, 1, 16)
                                lf(ptr + 8 * ls, lL, ls, 1, 16)
                            } else {
                                lf(ptr, lL, ls, 1, 16)
                            }
                        } else if (hm2 & x) != 0 {
                            let l2 = lv[l + (8 << ssV)]
                            lf(ptr, lL, ls, 1, if (mask[m1 + 1] & x) != 0 { 8 } else { 4 })
                            lf(ptr + 8 * ls, l2, ls, 1, if (mask[m2 + 1] & x) != 0 { 8 } else { 4 })
                        } else {
                            lf(ptr, lL, ls, 1, if (mask[m1 + 1] & x) != 0 { 8 } else { 4 })
                        }
                    } else if (hm2 & x) != 0 {
                        let l2 = lv[l + (8 << ssV)]
                        lf(ptr + 8 * ls, l2, ls, 1, if (mask[m2 + 1] & x) != 0 { 8 } else { 4 })
                    }
                }
                if ssH == 1 {
                    if (x & 0xAA) != 0 {
                        l += 2
                    }
                } else {
                    if (hm13 & x) != 0 {
                        let lL = lv[l]
                        if (hm23 & x) != 0 {
                            let l2 = lv[l + (8 << ssV)]
                            lf(ptr + 4, lL, ls, 1, 4)
                            lf(ptr + 4 + 8 * ls, l2, ls, 1, 4)
                        } else {
                            lf(ptr + 4, lL, ls, 1, 4)
                        }
                    } else if (hm23 & x) != 0 {
                        let l2 = lv[l + (8 << ssV)]
                        lf(ptr + 8 * ls + 4, l2, ls, 1, 4)
                    }
                    l += 1
                }
                x = x << 1
                ptr += 8 >> ssH
            }
            y += 2 << ssV
            dst += 16 * ls
            lvl += 16 << ssV
        }
    }

    // FFmpeg's filter_plane_rows: the horizontal edges.
    fn planeRows(_ mask: [Int], _ mBase: Int, _ lv: [Int], _ lBase: Int, _ row: Int, _ ssH: Int, _ ssV: Int, _ at0: Int, _ ls: Int) {
        var y = 0
        var dst = at0
        var lvl = lBase
        while y < 8 {
            var ptr = dst
            var l = lvl
            let mb = mBase + y * 4
            let vm = mask[mb] | mask[mb + 1] | mask[mb + 2]
            let vm3 = mask[mb + 3]
            var x = 1
            while (vm & ~(x - 1)) != 0 {
                let x2 = x << (1 + ssH)
                if row != 0 || y != 0 {
                    if (vm & x) != 0 {
                        let lL = lv[l]
                        if (mask[mb] & x) != 0 {
                            if (mask[mb] & x2) != 0 {
                                lf(ptr, lL, 1, ls, 16)
                                lf(ptr + 8, lL, 1, ls, 16)
                            } else {
                                lf(ptr, lL, 1, ls, 16)
                            }
                        } else if (vm & x2) != 0 {
                            let l2 = lv[l + 1 + ssH]
                            lf(ptr, lL, 1, ls, if (mask[mb + 1] & x) != 0 { 8 } else { 4 })
                            lf(ptr + 8, l2, 1, ls, if (mask[mb + 1] & x2) != 0 { 8 } else { 4 })
                        } else {
                            lf(ptr, lL, 1, ls, if (mask[mb + 1] & x) != 0 { 8 } else { 4 })
                        }
                    } else if (vm & x2) != 0 {
                        let l2 = lv[l + 1 + ssH]
                        lf(ptr + 8, l2, 1, ls, if (mask[mb + 1] & x2) != 0 { 8 } else { 4 })
                    }
                }
                if ssV == 0 {
                    if (vm3 & x) != 0 {
                        let lL = lv[l]
                        if (vm3 & x2) != 0 {
                            let l2 = lv[l + 1 + ssH]
                            lf(ptr + ls * 4, lL, 1, ls, 4)
                            lf(ptr + ls * 4 + 8, l2, 1, ls, 4)
                        } else {
                            lf(ptr + ls * 4, lL, 1, ls, 4)
                        }
                    } else if (vm3 & x2) != 0 {
                        let l2 = lv[l + 1 + ssH]
                        lf(ptr + ls * 4 + 8, l2, 1, ls, 4)
                    }
                }
                x = x << (2 << ssH)
                ptr += 16
                l += 2 << ssH
            }
            if ssV == 1 {
                if (y & 1) == 1 {
                    lvl += 16
                }
            } else {
                lvl += 8
            }
            y += 1
            dst += (8 * ls) >> ssV
        }
    }
}

// The 4-point inverse transforms (8.7.1.x) on four values.
fn vp9Idct4(_ i0: Int, _ i1: Int, _ i2: Int, _ i3: Int) -> (Int, Int, Int, Int) {
    let t0 = ((i0 + i2) * 11585 + 8192) >> 14
    let t1 = ((i0 - i2) * 11585 + 8192) >> 14
    let t2 = (i1 * 6270 - i3 * 15137 + 8192) >> 14
    let t3 = (i1 * 15137 + i3 * 6270 + 8192) >> 14
    (t0 + t3, t1 + t2, t1 - t2, t0 - t3)
}

fn vp9Iadst4(_ i0: Int, _ i1: Int, _ i2: Int, _ i3: Int) -> (Int, Int, Int, Int) {
    let t0 = 5283 * i0 + 15212 * i2 + 9929 * i3
    let t1 = 9929 * i0 - 5283 * i2 - 15212 * i3
    let t2 = 13377 * (i0 - i2 + i3)
    let t3 = 13377 * i1
    ((t0 + t3 + 8192) >> 14, (t1 + t3 + 8192) >> 14, (t2 + 8192) >> 14, (t0 + t1 - t3 + 8192) >> 14)
}

// The 8-point inverse DCT and ADST on eight values (FFmpeg's idct8_1d,
// iadst8_1d).
fn vp9Idct8(_ i0: Int, _ i1: Int, _ i2: Int, _ i3: Int, _ i4: Int, _ i5: Int, _ i6: Int, _ i7: Int) -> (Int, Int, Int, Int, Int, Int, Int, Int) {
    let t0a = ((i0 + i4) * 11585 + 8192) >> 14
    let t1a = ((i0 - i4) * 11585 + 8192) >> 14
    let t2a = (i2 * 6270 - i6 * 15137 + 8192) >> 14
    let t3a = (i2 * 15137 + i6 * 6270 + 8192) >> 14
    let t4a = (i1 * 3196 - i7 * 16069 + 8192) >> 14
    let t5a = (i5 * 13623 - i3 * 9102 + 8192) >> 14
    let t6a = (i5 * 9102 + i3 * 13623 + 8192) >> 14
    let t7a = (i1 * 16069 + i7 * 3196 + 8192) >> 14
    let t0 = t0a + t3a
    let t1 = t1a + t2a
    let t2 = t1a - t2a
    let t3 = t0a - t3a
    let t4 = t4a + t5a
    let t5b = t4a - t5a
    let t7 = t7a + t6a
    let t6b = t7a - t6a
    let t5 = ((t6b - t5b) * 11585 + 8192) >> 14
    let t6 = ((t6b + t5b) * 11585 + 8192) >> 14
    (t0 + t7, t1 + t6, t2 + t5, t3 + t4, t3 - t4, t2 - t5, t1 - t6, t0 - t7)
}

fn vp9Iadst8(_ i0: Int, _ i1: Int, _ i2: Int, _ i3: Int, _ i4: Int, _ i5: Int, _ i6: Int, _ i7: Int) -> (Int, Int, Int, Int, Int, Int, Int, Int) {
    let t0a = 16305 * i7 + 1606 * i0
    let t1a = 1606 * i7 - 16305 * i0
    let t2a = 14449 * i5 + 7723 * i2
    let t3a = 7723 * i5 - 14449 * i2
    let t4a = 10394 * i3 + 12665 * i4
    let t5a = 12665 * i3 - 10394 * i4
    let t6a = 4756 * i1 + 15679 * i6
    let t7a = 15679 * i1 - 4756 * i6
    let t0 = (t0a + t4a + 8192) >> 14
    let t1 = (t1a + t5a + 8192) >> 14
    let t2 = (t2a + t6a + 8192) >> 14
    let t3 = (t3a + t7a + 8192) >> 14
    let t4 = (t0a - t4a + 8192) >> 14
    let t5 = (t1a - t5a + 8192) >> 14
    let t6 = (t2a - t6a + 8192) >> 14
    let t7 = (t3a - t7a + 8192) >> 14
    let u4 = 15137 * t4 + 6270 * t5
    let u5 = 6270 * t4 - 15137 * t5
    let u6 = 15137 * t7 - 6270 * t6
    let u7 = 6270 * t7 + 15137 * t6
    let v2 = t0 - t2
    let v3 = t1 - t3
    let v6 = (8192 + u4 - u6) >> 14
    let v7 = (8192 + u5 - u7) >> 14
    (t0 + t2, -((8192 + u4 + u6) >> 14), ((v6 + v7) * 11585 + 8192) >> 14, -(((v2 + v3) * 11585 + 8192) >> 14),
     ((v2 - v3) * 11585 + 8192) >> 14, -(((v6 - v7) * 11585 + 8192) >> 14), (8192 + u5 + u7) >> 14, -(t1 + t3))
}

// The Walsh-Hadamard transform (lossless); inputs already shifted in the
// first pass.
fn vp9Iwht4(_ a: Int, _ b: Int, _ c: Int, _ d: Int) -> (Int, Int, Int, Int) {
    var t0 = a
    var t1 = d
    var t2 = b
    var t3 = c
    t0 += t2
    t3 -= t1
    let t4 = (t0 - t3) >> 1
    t1 = t4 - t1
    t2 = t4 - t2
    t0 -= t1
    t3 += t2
    (t0, t1, t2, t3)
}

// mode_conv of check_intra_mode: the mode used when edges are missing.
fn vp9ConvMode(_ mode: Int, _ haveLeft: Bool, _ haveTop: Bool) -> Int {
    if mode == 0 || mode == 3 || mode == 7 {
        return if haveTop { mode } else { 13 }
    }
    if mode == 1 || mode == 8 {
        return if haveLeft { mode } else { 14 }
    }
    if mode == 2 {
        if haveLeft {
            return if haveTop { 2 } else { 10 }
        }
        return if haveTop { 11 } else { 12 }
    }
    if mode == 9 {
        if haveLeft {
            return if haveTop { 9 } else { 1 }
        }
        return if haveTop { 0 } else { 14 }
    }
    mode
}

// Edges a mode needs: 1 left, 2 top, 4 top-left, 8 top-right, 16 left
// read top-down (FFmpeg's invert_left).
fn vp9EdgeFlags(_ mode: Int) -> Int {
    if mode == 0 { return 2 }
    if mode == 1 { return 1 }
    if mode == 2 { return 3 }
    if mode == 3 { return 10 }
    if mode == 4 || mode == 5 || mode == 6 || mode == 9 { return 7 }
    if mode == 7 { return 10 }
    if mode == 8 { return 17 }
    if mode == 10 { return 1 }
    if mode == 11 { return 2 }
    0
}
