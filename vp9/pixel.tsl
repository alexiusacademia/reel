    fn tx1d(_ kind: Int, _ n: Int, _ fromBlk: Bool, _ off: Int, _ st: Int, _ pass: Int) {
        if n == 16 {
            if fromBlk {
                if kind == 0 { idct16(blk, off, st) } else { iadst16(blk, off, st) }
            } else {
                if kind == 0 { idct16(tmp, off, st) } else { iadst16(tmp, off, st) }
            }
            return
        }
        if fromBlk {
            idct32(blk, off, st)
        } else {
            idct32(tmp, off, st)
        }
    }

