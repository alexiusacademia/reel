// Byte building shared by the writers: a growable big-endian byte buffer
// (ExBuf), the output sink that writes big files in pieces (Sink), MP4
// boxes (ISO/IEC 14496-12 §4.2) and EBML elements (RFC 8794 §4–7).
//
// Author: Alexius Academia
// Date: 2026-10-26

// Bytes added at the end, numbers big-endian (both MP4 and EBML are).
public struct ExBuf {
    data: Data = Data()

    fn u8(_ v: Int) {
        data.append(byte: v & 255)
    }

    fn u16(_ v: Int) {
        data.append(byte: (v >> 8) & 255)
        data.append(byte: v & 255)
    }

    fn u24(_ v: Int) {
        data.append(byte: (v >> 16) & 255)
        data.append(byte: (v >> 8) & 255)
        data.append(byte: v & 255)
    }

    fn u32(_ v: Int) {
        data.append(byte: (v >> 24) & 255)
        data.append(byte: (v >> 16) & 255)
        data.append(byte: (v >> 8) & 255)
        data.append(byte: v & 255)
    }

    fn u64(_ v: Int) {
        u32((v >> 32) & 0xFFFFFFFF)
        u32(v & 0xFFFFFFFF)
    }

    fn bytes(_ d: Data) {
        data += d
    }

    fn fourcc(_ s: String) {
        data += exLatin1(s, 4)
    }

    // Zero bytes.
    fn zeros(_ n: Int) {
        for _ in 0..n {
            data.append(byte: 0)
        }
    }
}

// Text as single bytes (box types like "©nam" use Latin-1 for ©), padded or
// cut to `n` bytes when n > 0.
public fn exLatin1(_ s: String, _ n: Int) -> Data {
    var out = Data()
    let u = Data(text: s)
    var i = 0
    while i < u.count {
        let b = u[i]
        if (b == 0xC2 || b == 0xC3) && i + 1 < u.count {
            // Two-byte UTF-8 for U+0080…U+00FF.
            out.append(byte: ((b & 3) << 6) | (u[i + 1] & 0x3F))
            i += 2
        } else if b < 0x80 {
            out.append(byte: b)
            i += 1
        } else {
            out.append(byte: 63)
            i += 1
            while i < u.count && (u[i] & 0xC0) == 0x80 {
                i += 1
            }
        }
    }
    if n > 0 {
        while out.count < n {
            out.append(byte: 32)
        }
        if out.count > n {
            out = out.slice(from: 0, to: n)
        }
    }
    out
}

// Where a writer's output goes: a file written in pieces of a few MB with
// appendData (so a big clip never sits in memory whole), or memory when
// `path` is empty (for small outputs and tests: read `data` at the end).
public struct Sink {
    path: String = ""
    data: Data = Data()
    flushed: Int = 0
    failed: Bool = false
    pieceSize: Int = 4194304

    fn put(_ d: Data) {
        data += d
        if !path.isEmpty && data.count >= pieceSize {
            flush()
        }
    }

    fn flush() {
        if path.isEmpty || data.isEmpty {
            return
        }
        if !appendData(path: path, data: data) {
            failed = true
        }
        flushed += data.count
        data = Data()
    }

    // Bytes written so far.
    written: Int { flushed + data.count }
}

// A sink for `path` (emptied first), or a memory sink for "".
public fn newSink(_ path: String) -> Sink {
    var s = Sink(path: path)
    if !path.isEmpty {
        if !writeData(path: path, data: Data()) {
            s.failed = true
        }
    }
    s
}

// ---------------------------------------------------------------------------
// MP4 boxes (ISO/IEC 14496-12 §4.2): 32-bit size, type, body; a 64-bit
// "largesize" when the box is 4 GB or more.

public fn exBox(_ type: String, _ body: Data) -> Data {
    var b = ExBuf()
    let size = body.count + 8
    if size > 0xFFFFFFFF {
        b.u32(1)
        b.fourcc(type)
        b.u64(size + 8)
    } else {
        b.u32(size)
        b.fourcc(type)
    }
    b.bytes(body)
    b.data
}

// A FullBox: version, 24-bit flags, body.
public fn exFullBox(_ type: String, _ version: Int, _ flags: Int, _ body: Data) -> Data {
    var b = ExBuf()
    b.u8(version)
    b.u24(flags)
    b.bytes(body)
    exBox(type, b.data)
}

// ---------------------------------------------------------------------------
// EBML (RFC 8794): element ID (kept with its length marker), a variable
// size integer (VINT, §4), then the body.

// Bytes a VINT needs for n (the all-ones value of each length is reserved
// for "unknown", so n must be below 2^(7·len) − 1).
public fn exVintLen(_ n: Int) -> Int {
    var len = 1
    while len < 8 && n >= (1 << (7 * len)) - 1 {
        len += 1
    }
    len
}

public fn exVint(_ n: Int, _ len: Int) -> Data {
    var out = Data()
    let v = n | (1 << (7 * len))
    var i = len - 1
    while i >= 0 {
        out.append(byte: (v >> (8 * i)) & 255)
        i -= 1
    }
    out
}

public fn exIdLen(_ id: Int) -> Int {
    if id < 0x100 { 1 } else if id < 0x10000 { 2 } else if id < 0x1000000 { 3 } else { 4 }
}

public fn exId(_ id: Int) -> Data {
    var out = Data()
    var i = exIdLen(id) - 1
    while i >= 0 {
        out.append(byte: (id >> (8 * i)) & 255)
        i -= 1
    }
    out
}

// The whole size of an element with a body of n bytes.
public fn exElSize(_ id: Int, _ n: Int) -> Int {
    exIdLen(id) + exVintLen(n) + n
}

public fn exEl(_ id: Int, _ body: Data) -> Data {
    var out = exId(id)
    out += exVint(body.count, exVintLen(body.count))
    out += body
    out
}

// Just the ID and size of an element whose body follows separately.
public fn exElHead(_ id: Int, _ n: Int) -> Data {
    var out = exId(id)
    out += exVint(n, exVintLen(n))
    out
}

// An unsigned integer element in as few bytes as it needs (§7.2).
public fn exUint(_ id: Int, _ v: Int) -> Data {
    var len = 1
    while len < 8 && (v >> (8 * len)) != 0 {
        len += 1
    }
    exEl(id, exBE(v, len))
}

// An unsigned integer element always 8 bytes long, so its size doesn't
// depend on its value (positions worked out after the layout).
public fn exUint8(_ id: Int, _ v: Int) -> Data {
    exEl(id, exBE(v, 8))
}

public fn exSint(_ id: Int, _ v: Int) -> Data {
    var len = 1
    while len < 8 && (v >= (1 << (8 * len - 1)) || v < -(1 << (8 * len - 1))) {
        len += 1
    }
    exEl(id, exBE(v, len))
}

public fn exFloat(_ id: Int, _ v: Float) -> Data {
    exEl(id, Data(bytes: v.bytes(count: 8, bigEndian: true)))
}

public fn exString(_ id: Int, _ s: String) -> Data {
    exEl(id, Data(text: s))
}

// n bytes of v, big-endian.
public fn exBE(_ v: Int, _ n: Int) -> Data {
    var out = Data()
    var i = n - 1
    while i >= 0 {
        out.append(byte: (v >> (8 * i)) & 255)
        i -= 1
    }
    out
}

// Rounds t·to/from to the nearest tick, without overflow for long times.
public fn exRescale(_ t: Int, _ from: Int, _ to: Int) -> Int {
    if from == to || from <= 0 {
        return t
    }
    let whole = t / from
    let rest = t % from
    let r = rest * to
    var part = r / from
    let left = r % from
    if left * 2 >= from {
        part += 1
    } else if left * 2 <= -from {
        part -= 1
    }
    whole * to + part
}
