// The plain data the VP8 parser hands the reconstructor: the parts of a
// frame header (RFC 6386 section 9 / 19.2) reconstruction needs, and a
// ParsedFrame with one record per macroblock and the macroblocks'
// non-zero dequantised coefficients.
//
// Macroblock record (vp8MbSize Ints, in raster order):
//   0 luma mode: 0 DC_PRED, 1 V_PRED, 2 H_PRED, 3 TM_PRED, 4 B_PRED,
//     5 NEARESTMV, 6 NEARMV, 7 ZEROMV, 8 NEWMV, 9 SPLITMV
//   1 chroma mode (0…3 for intra macroblocks)
//   2 reference frame: 0 intra (the current frame), 1 last, 2 golden,
//     3 altref
//   3 loop filter level (15.1, after segment and delta adjustments)
//   4 1 when the inner (subblock) edges are filtered: the macroblock has
//     coefficients, or is B_PRED or SPLITMV (15.1)
//   5 index of the macroblock's first coefficient entry, -1 for none
//   6 the macroblock's motion vector, packed (see vp8Mv)
//   7 segment id
//   8…23 the sixteen subblocks' intra modes (B_PRED, and the implied
//     mode of other intra macroblocks: 0 B_DC … 9 B_HU, 11.2) or motion
//     vectors (SPLITMV and other inter macroblocks)
// Coefficients of a macroblock: the count n of entries, then n entries
// value * 512 + block * 16 + raster position, block 0…15 Y, 16…19 U,
// 20…23 V, 24 Y2. Values are what the decoder's 16-bit coefficient store
// holds after dequantisation (14.1).
//
// Motion vectors are in eighth samples of luma (always even: VP8's
// quarter-sample precision, the RFC's units).
//
// Author: Alexius Academia
// Date: 2026-10-25

let vp8MbSize = 24

public struct FrameHeader {
    keyframe: Bool = false
    // Bitstream version 0…3 (9.1): 0 six-tap filters, 1…3 bilinear,
    // 3 full-sample chroma motion.
    version: Int = 0
    show: Bool = true
    width: Int = 0
    height: Int = 0
    // Scaling bits of a keyframe (shown as decoded, as libvpx and ffmpeg
    // do).
    hScale: Int = 0
    vScale: Int = 0
    colorSpace: Int = 0
    clampType: Int = 0
    mbCols: Int = 0
    mbRows: Int = 0
    // Loop filter (9.4): simple or normal, frame level and sharpness.
    simpleFilter: Bool = false
    filterLevel: Int = 0
    sharpness: Int = 0
    // Reference updates (9.7, 9.8). copyGolden / copyAltref: 0 none,
    // 1 from last, 2 from altref / golden.
    refreshGolden: Bool = false
    refreshAltref: Bool = false
    refreshLast: Bool = true
    copyGolden: Int = 0
    copyAltref: Int = 0
    signBiasGolden: Int = 0
    signBiasAltref: Int = 0
    refreshEntropy: Bool = true
    qIndex: Int = 0
    partitions: Int = 1
    segmentation: Bool = false
    firstPartSize: Int = 0
}

// One frame as parsed.
//   kind 0  a coded frame to reconstruct (shown when hdr.show)
//        2  damaged: show the last picture again (no reference changes)
//        3  nothing to do (skipped, or before the first keyframe)
public struct ParsedFrame {
    kind: Int = 0
    hdr: FrameHeader = FrameHeader()
    pts: Int = -9223372036854775807
    key: Bool = false
    mbs: [Int] = []
    coefs: [Int] = []
    nCoefs: Int = 0
}

// The parts of a packed motion vector (y * 65536 + x as 16 bits).
fn vp8MvX(_ p: Int) -> Int {
    ((p & 0xffff) ^ 0x8000) - 0x8000
}

fn vp8MvY(_ p: Int) -> Int {
    p >> 16
}

fn vp8Mv(_ x: Int, _ y: Int) -> Int {
    (y << 16) + (x & 0xffff)
}

// A list of n zeros.
fn vp8Zeros(_ n: Int) -> [Int] {
    var out: [Int] = []
    var i = 0
    while i < n {
        out.append(0)
        i += 1
    }
    out
}
