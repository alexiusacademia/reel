// ASF files (.wmv, .wma, .asf): Windows Media, after Microsoft's
// "Advanced Systems Format (ASF) Specification", revision 01.20.03.
//
// An ASF file is a list of top-level objects, each a 16-byte GUID, a
// 64-bit little-endian size (including those 24 bytes) and a body:
//
//   Header object (3.1)              holds the other header objects:
//     File Properties (3.2)          preroll, play duration, packet size
//     Stream Properties (3.3)        one per stream: type, number, codec
//                                    setup (WAVEFORMATEX or
//                                    BITMAPINFOHEADER), audio spreading
//     Header Extension (3.4)         holds Extended Stream Properties
//                                    (4.1; may embed a Stream Properties
//                                    object), Language List (4.6),
//                                    Metadata (4.7), Metadata Library (4.8)
//     Content Description (3.10)     title, author, copyright, description
//     Extended Content Description   name/value tags (WM/AlbumTitle …,
//                        (3.11)      WM/Picture = cover art)
//     Stream Bitrate Properties (3.12), Codec List (3.13), Marker (3.7,
//                                    chapters), Content Encryption (3.14,
//                                    3.15: DRM — refused)
//   Data object (5.1)                fixed-size data packets
//   Simple Index (6.1)               a keyframe's packet per time interval
//
// A data packet (5.2) starts with optional error correction data and the
// payload parsing information (flags, packet length, padding, send time),
// then one payload or several. Each payload is a fragment of a "media
// object" (a frame of video, a block of audio): stream number and key
// flag, media object number, the fragment's offset in its object, and
// replicated data (the object's size and presentation time in ms). A
// payload whose replicated data length is 1 is "compressed": it holds
// several whole small objects (sub-payloads), each one byte of length and
// its bytes, a time delta apart.
//
// Packets here are whole media objects; one split over several data
// packets becomes one PacketRef with `parts`. Times are milliseconds
// (timescale 1000) from the presentation time minus the preroll, as
// ffmpeg's asf demuxer gives them. ASF stores frames in decode order and
// its times are decode times (ffmpeg calls them dts; for video with
// B-frames it gives no pts at all): pts = dts here, the video decoder
// reorders. Audio packets are always keyframes.
//
// Author: Alexius Academia
// Date: 2026-10-25

import "../core"

// GUIDs as the hex of their 16 bytes in file order.
let asfGuidHeader = "3026b2758e66cf11a6d900aa0062ce6c"
let asfGuidData = "3626b2758e66cf11a6d900aa0062ce6c"
let asfGuidFileProps = "a1dcab8c47a9cf118ee400c00c205365"
let asfGuidStreamProps = "9107dcb7b7a9cf118ee600c00c205365"
let asfGuidHeaderExt = "b503bf5f2ea9cf118ee300c00c205365"
let asfGuidExtStreamProps = "cba5e61472c632438399a96952065b5a"
let asfGuidContentDesc = "3326b2758e66cf11a6d900aa0062ce6c"
let asfGuidExtContentDesc = "40a4d0d207e3d21197f000a0c95ea850"
let asfGuidLanguageList = "a946437ce0effc4bb229393ede415c85"
let asfGuidMetadata = "eacbf8c5af5b77488467aa8c44fa4cca"
let asfGuidMetadataLibrary = "941c23449894d149a1411d134e457054"
let asfGuidMarker = "01cd87f451a9cf118ee600c00c205365"
let asfGuidBitrateProps = "ce75f87b8d46d1118d82006097c9a2b2"
let asfGuidCodecList = "4052d1861d31d011a3a400a0c90348f6"
let asfGuidEncryption = "fbb3112223bdd211b4b700a0c955fc6e"
let asfGuidExtEncryption = "14e68a292226174cb935dae07ee9289c"
let asfGuidSimpleIndex = "90080033b1e5cf1189f400a0c90349cb"
// Stream types (3.3).
let asfGuidAudio = "409e69f84d5bcf11a8fd00805f5c442b"
let asfGuidVideo = "c0ef19bc4d5bcf11a8fd00805f5c442b"
let asfGuidCommand = "c0cfda59e659d011a3ac00a0c90348f6"
let asfGuidJfif = "00e11bb64e5bcf11a8fd00805f5c442b"
let asfGuidDegradableJpeg = "e07d903515e4cf11a91700805f5c442b"
let asfGuidFileTransfer = "2c22bd911cf27a498b6d5aa86bfc0185"
let asfGuidBinary = "e265fb3aef47f240ac2c70a90d71d343"
// Audio spread error correction (3.3, 9.1).
let asfGuidAudioSpread = "50cdc3bf8f61cf118bb200aa00b4e220"
// Embedded audio in a binary stream (DVR-MS).
let asfGuidExtAudio = "9d8c1731e1032845b5823df9db22f503"

// One stream from its Stream Properties object.
struct AsfStream {
    number: Int = 0
    track: core.Track = core.Track(index: 0, kind: core.TrackKind.other, codec: "unknown:asf")
    // Audio spreading (descrambling): span, virtual packet and chunk
    // lengths (ASF 9.1); span <= 1 means none.
    span: Int = 0
    spreadPacket: Int = 0
    spreadChunk: Int = 0
    // Payload extension systems from the Extended Stream Properties: the
    // first byte of each one's GUID and its data size (0xFFFF: variable,
    // a 16-bit length comes first).
    extKinds: [Int] = []
    extSizes: [Int] = []
    languageIndex: Int = -1
    leakRate: Int = 0
    bitratePropsRate: Int = 0
    avgFrameTime: Int = 0
    aspectX: Int = 0
    aspectY: Int = 0
    encrypted: Bool = false
    // Which Stream Properties object this was (-1: none seen).
    order: Int = -1
}

// A media object being put together from its fragments.
struct AsfPartial {
    active: Bool = false
    size: Int = 0
    got: Int = 0
    pts: Int = 0
    key: Bool = false
    // offset, size pairs in the file.
    parts: [Int] = []
}

struct AsfReader {
    file: Data
    streams: [AsfStream] = []
    // Stream number (0–127) → index in `streams`, -1 when none.
    byNumber: [Int] = []
    languages: [String] = []
    tags: [String: String] = [:]
    cover: Data = Data()
    warnings: [String] = []
    chapters: [core.Chapter] = []
    codecNames: [String] = []
    preroll: Int = 0
    playDuration: Int = 0
    headerFileSize: Int = 0
    broadcast: Bool = false
    minPacket: Int = 0
    maxPacket: Int = 0
    drm: Bool = false
    // AspectRatioX/Y by stream number (0: the whole file's, from the
    // extended content description), which may come before the stream.
    aspectXs: [Int] = []
    aspectYs: [Int] = []
    // Stream Properties objects seen, to number tracks in their order.
    propsSeen: Int = 0
    dataStart: Int = -1
    dataEnd: Int = 0
    // Packet numbers the simple index points at (keyframes).
    indexPackets: [Int] = []
    // A track number per WM/TrackNumber, or WM/Track (zero-based).
    track0: String = ""

    fn has(_ at: Int, _ n: Int) -> Bool {
        at >= 0 && at + n <= file.count
    }

    fn u8(_ at: Int) -> Int {
        if at < 0 || at >= file.count { 0 } else { file[at] }
    }

    fn u16(_ at: Int) -> Int {
        if has(at, 2) { file.uint16(at: at) } else { 0 }
    }

    fn u32(_ at: Int) -> Int {
        if has(at, 4) { file.uint32(at: at) } else { 0 }
    }

    // 64-bit sizes and times; values of 2^63 and over stop at 2^63 - 1.
    fn u64(_ at: Int) -> Int {
        if !has(at, 8) {
            return 0
        }
        let lo = file.uint32(at: at)
        let hi = file.uint32(at: at + 4)
        if hi >= 0x80000000 {
            return 9223372036854775807
        }
        (hi << 32) | lo
    }

    fn guid(_ at: Int) -> String {
        if !has(at, 16) {
            return ""
        }
        file.slice(from: at, to: at + 16).hex
    }

    // The top-level objects: the header (which must come first), the data
    // object, and the index objects after it.
    fn readTop() -> String {
        if guid(0) != asfGuidHeader {
            return "not an ASF file"
        }
        let headerSize = u64(16)
        let headerEnd = min(file.count, headerSize)
        readObjects(30, headerEnd, inExtension: false)
        var at = headerSize
        while has(at, 24) {
            let g = guid(at)
            let size = u64(at + 16)
            if g == asfGuidData {
                // Data object: GUID, size, file id (16), total packets (8),
                // reserved (2), then the packets (5.1).
                dataStart = at + 50
                var end = at + size
                if broadcast || size < 50 || end > file.count {
                    if end > file.count && !broadcast {
                        warnings.append("ASF: the file is cut short (the data object says {size} bytes)")
                    }
                    end = file.count
                }
                dataEnd = end
            } else if g == asfGuidSimpleIndex {
                readSimpleIndex(at, min(file.count, at + size))
            }
            if size < 24 {
                break
            }
            at += size
        }
        if dataStart < 0 {
            return "ASF: no data object"
        }
        ""
    }

    // Header objects in [from, to). The header extension's objects are
    // read the same way (4.0).
    fn readObjects(_ from: Int, _ to: Int, inExtension: Bool) {
        var at = from
        while at + 24 <= to {
            let g = guid(at)
            let size = u64(at + 16)
            if size < 24 {
                warnings.append("ASF: a header object has a bad size")
                break
            }
            let end = min(to, at + size)
            let body = at + 24
            if g == asfGuidFileProps {
                readFileProps(body)
            } else if g == asfGuidStreamProps {
                readStreamProps(body, end, ext: -1)
            } else if g == asfGuidHeaderExt {
                // Reserved GUID (16), reserved (2), data size (4), objects.
                let dataSize = u32(body + 18)
                readObjects(body + 22, min(end, body + 22 + dataSize), inExtension: true)
            } else if g == asfGuidExtStreamProps {
                readExtStreamProps(body, end)
            } else if g == asfGuidContentDesc {
                readContentDesc(body, end)
            } else if g == asfGuidExtContentDesc {
                readExtContentDesc(body, end)
            } else if g == asfGuidLanguageList {
                readLanguageList(body, end)
            } else if g == asfGuidMetadata || g == asfGuidMetadataLibrary {
                readMetadata(body, end)
            } else if g == asfGuidMarker {
                readMarker(body, end)
            } else if g == asfGuidBitrateProps {
                readBitrateProps(body, end)
            } else if g == asfGuidCodecList {
                readCodecList(body, end)
            } else if g == asfGuidEncryption || g == asfGuidExtEncryption {
                drm = true
            }
            at += size
        }
    }

    // File Properties (3.2): file id (16), file size (8), creation date
    // (8), data packets count (8), play duration (8, 100 ns), send
    // duration (8), preroll (8, ms), flags (4: broadcast 1, seekable 2),
    // minimum and maximum data packet size (4 + 4), maximum bitrate (4).
    fn readFileProps(_ at: Int) {
        headerFileSize = u64(at + 16)
        playDuration = u64(at + 40)
        preroll = u64(at + 56)
        let flags = u32(at + 64)
        broadcast = (flags & 1) != 0
        minPacket = u32(at + 68)
        maxPacket = u32(at + 72)
    }

    // Stream Properties (3.3): stream type, error correction type (16 +
    // 16), time offset (8), type-specific data length (4), error
    // correction data length (4), flags (2: stream number in the low 7
    // bits, encrypted 0x8000), reserved (4), the type-specific data, the
    // error correction data. `ext` is the index of the stream an Extended
    // Stream Properties object already made, when this one is embedded in
    // it.
    fn readStreamProps(_ at: Int, _ end: Int, ext: Int) {
        var type = guid(at)
        let ecType = guid(at + 16)
        let typeLen = u32(at + 40)
        let ecLen = u32(at + 44)
        let flags = u16(at + 48)
        let number = flags & 0x7f
        var ts = at + 54
        let ecAt = ts + typeLen
        if number == 0 {
            warnings.append("ASF: a stream has number 0")
        }
        var i = byNumber[number]
        if i < 0 {
            i = streams.count
            streams.append(AsfStream(number: number))
            byNumber[number] = i
        }
        streams[i].encrypted = (flags & 0x8000) != 0
        streams[i].order = propsSeen
        propsSeen += 1
        var t = core.Track(index: i, id: number, kind: core.TrackKind.other, codec: "unknown:asf")
        t.timescale = 1000
        if type == asfGuidBinary && guid(ts) == asfGuidExtAudio {
            // DVR-MS: a WAVEFORMATEX after a 60-byte media type header.
            type = asfGuidAudio
            ts += 60
        }
        if type == asfGuidAudio {
            t.kind = core.TrackKind.audio
            asfWaveFormat(t, file, ts, ecAt)
            if ecType == asfGuidAudioSpread && ecLen >= 5 {
                // Span (1), virtual packet length (2), virtual chunk length
                // (2), silence data length (2), silence data.
                let span = u8(ecAt)
                let vpl = u16(ecAt + 1)
                let vcl = u16(ecAt + 3)
                if span > 1 && vcl > 0 && vpl / vcl > 1 && vpl % vcl == 0 {
                    streams[i].span = span
                    streams[i].spreadPacket = vpl
                    streams[i].spreadChunk = vcl
                }
            }
        } else if type == asfGuidVideo {
            // Encoded image width (4), height (4), reserved (1), format data
            // size (2), then the BITMAPINFOHEADER (biSize, biWidth,
            // biHeight, biPlanes, biBitCount, biCompression, biSizeImage,
            // biXPelsPerMeter, biYPelsPerMeter, biClrUsed, biClrImportant).
            t.kind = core.TrackKind.video
            let bih = ts + 11
            let formatSize = u16(ts + 9)
            let biSize = u32(bih)
            t.width = u32(bih + 4)
            t.height = abs(file.int32(at: min(bih + 8, file.count - 4)))
            t.bitsPerSample = u16(bih + 14)
            let fourcc = asfFourcc(file, bih + 16)
            t.tag = fourcc
            t.codec = asfVideoCodec(fourcc)
            let extraEnd = min(min(bih + max(biSize, formatSize), ecAt), file.count)
            if biSize > 40 && bih + 40 < extraEnd {
                t.extra = file.slice(from: bih + 40, to: extraEnd)
            }
            if fourcc == "DVR " {
                // DVR-MS MPEG-2: the stream's own sequence header is right.
                t.width = 0
                t.height = 0
                t.extra = Data()
            }
            if t.codec == "h264" && !t.extra.isEmpty && t.extra[0] != 1 {
                t.extra = Data()
            }
        } else if type == asfGuidJfif || type == asfGuidDegradableJpeg {
            // JFIF: image width (4), height (4), reserved (4).
            t.kind = core.TrackKind.video
            t.codec = "mjpeg"
            t.width = u32(ts)
            t.height = u32(ts + 4)
            t.matrix = core.ColorMatrix.bt601
            t.fullRange = true
        } else if type == asfGuidCommand {
            t.codec = "unknown:command"
        } else if type == asfGuidFileTransfer {
            t.codec = "unknown:filetransfer"
        } else {
            t.codec = "unknown:binary"
        }
        streams[i].track = t
    }

    // Extended Stream Properties (4.1): start and end time (8 + 8), data
    // bitrate (4), buffer size (4), initial buffer fullness (4), the same
    // three alternates (12), maximum object size (4), flags (4), stream
    // number (2), stream language index (2), average time per frame (8,
    // 100 ns), stream name count (2), payload extension system count (2),
    // the names (language index 2, length 2, name), the payload extension
    // systems (GUID 16, data size 2, info length 4, info), and maybe a
    // Stream Properties object.
    fn readExtStreamProps(_ at: Int, _ end: Int) {
        let leak = u32(at + 16)
        let number = u16(at + 48) & 0x7f
        let lang = u16(at + 50)
        let avg = u64(at + 52)
        let names = u16(at + 60)
        let systems = u16(at + 62)
        var i = byNumber[number]
        if i < 0 {
            i = streams.count
            var st = AsfStream(number: number)
            st.track = core.Track(index: i, id: number, kind: core.TrackKind.other, codec: "unknown:asf")
            streams.append(st)
            byNumber[number] = i
        }
        streams[i].leakRate = leak
        streams[i].languageIndex = lang
        streams[i].avgFrameTime = avg
        var p = at + 64
        for _ in 0..names {
            p += 4 + u16(p + 2)
        }
        streams[i].extKinds = []
        streams[i].extSizes = []
        for _ in 0..systems {
            if p + 22 > end {
                break
            }
            streams[i].extKinds.append(u8(p))
            streams[i].extSizes.append(u16(p + 16))
            p += 22 + u32(p + 18)
        }
        if p + 24 <= end && guid(p) == asfGuidStreamProps {
            let size = u64(p + 16)
            readStreamProps(p + 24, min(end, p + size), ext: i)
        }
    }

    // Content Description (3.10): five lengths (title, author, copyright,
    // description, rating), then the five UTF-16 strings.
    fn readContentDesc(_ at: Int, _ end: Int) {
        let keys = ["title", "artist", "copyright", "comment", "rating"]
        var p = at + 10
        for k in 0..5 {
            let len = u16(at + 2 * k)
            let s = asfUtf16(file, p, min(len, end - p))
            if !s.isEmpty {
                tags[keys[k]] = s
            }
            p += len
        }
    }

    // Extended Content Description (3.11): count (2), then name length
    // (2), name (UTF-16), value type (2), value length (2), value.
    fn readExtContentDesc(_ at: Int, _ end: Int) {
        let count = u16(at)
        var p = at + 2
        for _ in 0..count {
            if p + 2 > end {
                break
            }
            var nameLen = u16(p)
            if nameLen % 2 == 1 {
                // Some old muxers wrote the length one short.
                nameLen += 1
            }
            let name = asfUtf16(file, p + 2, nameLen)
            p += 2 + nameLen
            let type = u16(p)
            var valueLen = u16(p + 2)
            if type == 0 && valueLen % 2 == 1 {
                valueLen += 1
            }
            p += 4
            if p + valueLen > end {
                warnings.append("ASF: an extended content descriptor is cut short")
                break
            }
            setTag(name, type, p, valueLen, boolSize: 4, stream: 0)
            p += valueLen
        }
    }

    // Metadata and Metadata Library (4.7, 4.8): count (2), then language
    // list index (2), stream number (2), name length (2), value type (2),
    // value length (4), name, value.
    fn readMetadata(_ at: Int, _ end: Int) {
        let count = u16(at)
        var p = at + 2
        for _ in 0..count {
            if p + 12 > end {
                break
            }
            let stream = u16(p + 2)
            let nameLen = u16(p + 4)
            let type = u16(p + 6)
            let valueLen = u32(p + 8)
            let name = asfUtf16(file, p + 12, nameLen)
            let v = p + 12 + nameLen
            if v + valueLen > end {
                warnings.append("ASF: a metadata record is cut short")
                break
            }
            setTag(name, type, v, valueLen, boolSize: 2, stream: stream)
            p = v + valueLen
        }
    }

    // One name/value pair from a descriptor or metadata record.
    fn setTag(_ name: String, _ type: Int, _ at: Int, _ len: Int, boolSize: Int, stream: Int) {
        if name == "AspectRatioX" || name == "AspectRatioY" {
            let v = asfNumber(file, type, at, len, boolSize)
            if stream >= 0 && stream < 128 {
                if name == "AspectRatioX" { aspectXs[stream] = v } else { aspectYs[stream] = v }
            }
            return
        }
        if type == 1 {
            // Byte arrays: WM/Picture is cover art (an APIC-like record).
            if name == "WM/Picture" {
                readPicture(at, len)
            }
            return
        }
        var value = ""
        if type == 0 {
            value = asfUtf16(file, at, len)
        } else if type >= 2 && type <= 5 {
            value = "{asfNumber(file, type, at, len, boolSize)}"
        } else {
            return
        }
        if value.isEmpty || name.hasPrefix("xmp") {
            return
        }
        let key = asfTagKey(name)
        if name == "WM/Track" {
            // Zero-based; used only when WM/TrackNumber is missing.
            if let n = Int(value) {
                track0 = "{n + 1}"
            }
            return
        }
        if key == "encoder" && tags["encoder"] != nil {
            return
        }
        tags[key] = value
    }

    // WM/Picture: picture type (1), data size (4), MIME type and
    // description (UTF-16, zero-terminated), the picture's bytes. The
    // front cover (type 3) wins over other pictures.
    fn readPicture(_ at: Int, _ len: Int) {
        if len < 9 {
            return
        }
        let type = u8(at)
        let size = u32(at + 1)
        var p = at + 5
        let end = at + len
        // Skip two zero-terminated UTF-16 strings.
        for _ in 0..2 {
            while p + 1 < end && (u8(p) != 0 || u8(p + 1) != 0) {
                p += 2
            }
            p += 2
        }
        if p + size > end || size <= 0 {
            warnings.append("ASF: the cover art (WM/Picture) is damaged")
            return
        }
        if cover.isEmpty || type == 3 {
            cover = file.slice(from: p, to: p + size)
        }
    }

    // Language List (4.6): count (2), then length (1) and a UTF-16
    // RFC 1766 name ("en-us") each.
    fn readLanguageList(_ at: Int, _ end: Int) {
        let count = u16(at)
        var p = at + 2
        for _ in 0..count {
            if p >= end {
                break
            }
            let len = u8(p)
            languages.append(asfUtf16(file, p + 1, min(len, end - p - 1)))
            p += 1 + len
        }
    }

    // Marker (3.7): reserved GUID (16), count (4), reserved (2), name
    // length (2), name, then per marker: offset (8), presentation time (8,
    // 100 ns), entry length (2), send time (4), flags (4), description
    // length (4, in characters), description.
    fn readMarker(_ at: Int, _ end: Int) {
        let count = u32(at + 16)
        var p = at + 24 + u16(at + 22)
        for _ in 0..count {
            if p + 30 > end {
                break
            }
            let time = u64(p + 8) - preroll * 10000
            let chars = u32(p + 26)
            let title = asfUtf16(file, p + 30, min(chars * 2, end - p - 30))
            chapters.append(core.Chapter(start: Float(time) / 10000000.0, title: title))
            p += 30 + chars * 2
        }
    }

    // Stream Bitrate Properties (3.12): count (2), then flags (2, stream
    // number in the low 7 bits) and average bitrate (4).
    fn readBitrateProps(_ at: Int, _ end: Int) {
        let count = u16(at)
        for k in 0..count {
            let p = at + 2 + k * 6
            if p + 6 > end {
                break
            }
            let n = u16(p) & 0x7f
            let rate = u32(p + 2)
            if byNumber[n] >= 0 {
                streams[byNumber[n]].bitratePropsRate = rate
            } else {
                // Stream properties may come later: keep it on a stub.
                let i = streams.count
                var st = AsfStream(number: n, bitratePropsRate: rate)
                st.track = core.Track(index: i, id: n, kind: core.TrackKind.other, codec: "unknown:asf")
                streams.append(st)
                byNumber[n] = i
            }
        }
    }

    // Codec List (3.13): reserved GUID (16), count (4), then type (2),
    // name length (2, characters), name, description length (2),
    // description, information length (2), information.
    fn readCodecList(_ at: Int, _ end: Int) {
        let count = u32(at + 16)
        var p = at + 20
        for _ in 0..count {
            if p + 4 > end {
                break
            }
            let nameChars = u16(p + 2)
            let name = asfUtf16(file, p + 4, min(nameChars * 2, end - p - 4))
            p += 4 + nameChars * 2
            let descChars = u16(p)
            let desc = asfUtf16(file, p + 2, min(descChars * 2, end - p - 2))
            p += 2 + descChars * 2
            p += 2 + u16(p)
            var s = name.trim()
            if !desc.trim().isEmpty {
                s += " (" + desc.trim() + ")"
            }
            if !s.isEmpty {
                codecNames.append(s)
            }
        }
    }

    // Simple Index (6.1): file id (16), index entry time interval (8),
    // maximum packet count (4), entries count (4), then per entry the
    // packet number (4) and packet count (2).
    fn readSimpleIndex(_ at: Int, _ end: Int) {
        let count = u32(at + 52)
        var last = -1
        for k in 0..count {
            let p = at + 56 + k * 6
            if p + 6 > end {
                break
            }
            let n = u32(p)
            if n != last {
                indexPackets.append(n)
                last = n
            }
        }
    }
}

// What the data packets hold, as packets of media objects.
struct AsfPacketizer {
    file: Data
    streams: [AsfStream] = []
    byNumber: [Int] = []
    partials: [AsfPartial] = []
    packets: [core.PacketRef] = []
    warnings: [String] = []
    preroll: Int = 0
    // Where each ASF data packet started (for the simple index).
    packetStarts: [Int] = []
    damaged: Int = 0
    dropped: Int = 0
    compressedSeen: Int = 0
    resyncs: Int = 0

    fn u8(_ at: Int) -> Int {
        if at < 0 || at >= file.count { 0 } else { file[at] }
    }

    // A field whose size a 2-bit length type gives (0: none, 1: byte,
    // 2: word, 3: dword), little-endian. Returns (value, size).
    fn field(_ at: Int, _ type: Int, _ absent: Int) -> (Int, Int) {
        match type & 3 {
            1 -> (u8(at), 1)
            2 -> (if at + 2 <= file.count { file.uint16(at: at) } else { 0 }, 2)
            3 -> (if at + 4 <= file.count { file.uint32(at: at) } else { 0 }, 4)
            _ -> (absent, 0)
        }
    }

    // Reads the data packets in [start, end), each `packetSize` bytes when
    // the file properties give a fixed size.
    //
    // Packets normally start with the standard error correction bytes
    // 82 00 00. When the first one does, a packet that doesn't is looked
    // for further on (up to 32 KB), as ffmpeg does: some files have junk
    // between packets, or packets of another size than the header says.
    fn run(_ start: Int, _ end: Int, packetSize: Int) {
        var at = start
        let stdEcc = asfIsSync(file, start)
        while at < end {
            if stdEcc && !asfIsSync(file, at) {
                var q = at + 1
                let limit = min(end - 3, at + 32768)
                while q <= limit && !asfIsSync(file, q) {
                    q += 1
                }
                if q > limit {
                    if end - at > 64 {
                        warnings.append("ASF: no data packet found after byte {at}; the rest of the file is skipped")
                    }
                    break
                }
                resyncs += 1
                at = q
            }
            let next = readPacket(at, end, packetSize)
            if next <= at {
                break
            }
            at = next
        }
        // Objects still incomplete at the end: the one the file ends in is
        // kept, cut short (as ffmpeg gives it), the others are dropped.
        for s in 0..partials.count {
            if partials[s].active && partials[s].got > 0 {
                let c = partials[s].parts.count
                let last = partials[s].parts[c - 2] + partials[s].parts[c - 1]
                if last >= file.count {
                    partials[s].active = false
                    emit(s, partials[s].pts, partials[s].key, partials[s].parts, partials[s].got)
                } else {
                    dropped += 1
                    partials[s].active = false
                }
            }
        }
    }

    // One data packet at `at` (5.2); returns where the next one starts.
    fn readPacket(_ at: Int, _ end: Int, _ packetSize: Int) -> Int {
        packetStarts.append(at)
        let fixedNext = if packetSize > 0 { at + packetSize } else { -1 }
        var p = at
        var flags = u8(p)
        p += 1
        if (flags & 0x80) != 0 {
            // Error correction data (5.2.1): length in the low 4 bits when
            // the length type (bits 5–6) is 0; bit 4 is "opaque data".
            if (flags & 0x60) == 0 {
                p += flags & 0x0f
            }
            flags = u8(p)
            p += 1
        }
        let property = u8(p)
        p += 1
        // Payload parsing information (5.2.2): packet length, sequence,
        // padding length, by the 2-bit types in `flags`.
        let (packetLength, l1) = field(p, flags >> 5, packetSize)
        p += l1
        let (_, l2) = field(p, flags >> 1, 0)
        p += l2
        let (padding, l3) = field(p, flags >> 3, 0)
        p += l3
        let sendTime = if p + 4 <= file.count { file.uint32(at: p) } else { 0 }
        p += 6
        if packetLength <= 0 || padding >= packetLength || (flags & 0x80) != 0 {
            damaged += 1
            return fixedNext
        }
        let next = if packetSize > 0 { at + max(packetLength, packetSize) } else { at + packetLength }
        let payloadEnd = min(min(at + packetLength - padding, end), file.count)
        if p >= payloadEnd {
            damaged += 1
            return next
        }
        var multiple = (flags & 1) != 0
        var count = 1
        var lenType = 2
        if multiple {
            let pf = u8(p)
            p += 1
            count = pf & 0x3f
            lenType = pf >> 6
        }
        // Payloads (5.2.3): stream number with key flag, media object
        // number, offset into the object, replicated data length, by the
        // 2-bit types in `property`.
        for _ in 0..count {
            if p >= payloadEnd {
                break
            }
            let sb = u8(p)
            p += 1
            let number = sb & 0x7f
            let key = (sb & 0x80) != 0
            let (_, m1) = field(p, property >> 4, 0)
            p += m1
            let (offset, m2) = field(p, property >> 2, 0)
            p += m2
            let (repLen, m3) = field(p, property, 0)
            p += m3
            let rep = p
            p += repLen
            var length = payloadEnd - p
            if multiple {
                let (len, m4) = field(p, lenType, 0)
                p += m4
                length = len
            }
            if p + length > payloadEnd && payloadEnd == file.count && p <= payloadEnd {
                // The file ends inside this payload.
                length = payloadEnd - p
            }
            if p + length > payloadEnd || length < 0 || p > payloadEnd {
                damaged += 1
                return next
            }
            let si = if number < 128 { byNumber[number] } else { -1 }
            if si >= 0 {
                if repLen == 1 {
                    // Compressed payload (5.2.3.3): `offset` is the
                    // presentation time, one byte of time delta, then
                    // sub-payloads of one length byte each.
                    compressedSeen += 1
                    let delta = u8(rep)
                    var t = offset
                    var q = p
                    let qEnd = p + length
                    while q < qEnd {
                        let n = u8(q)
                        q += 1
                        if q + n > qEnd {
                            damaged += 1
                            break
                        }
                        if n > 0 {
                            emit(si, t - preroll, key || streams[si].track.kind == core.TrackKind.audio, [q, n], n)
                        }
                        q += n
                        t += delta
                    }
                } else {
                    var objSize = length
                    var time = sendTime
                    if repLen >= 8 && rep + 8 <= file.count {
                        objSize = file.uint32(at: rep)
                        time = file.uint32(at: rep + 4)
                        time = extensionTime(si, rep + 8, rep + repLen, time)
                    }
                    fragment(si, offset, objSize, time - preroll, key, p, length)
                }
            }
            p += length
        }
        next
    }

    // Payload extension data after the replicated object size and time:
    // a system whose GUID starts 0x2A carries the presentation time in
    // 100 ns units at byte 8 (as in DVR-MS files), which wins.
    fn extensionTime(_ si: Int, _ from: Int, _ to: Int, _ time: Int) -> Int {
        let kinds = streams[si].extKinds
        if kinds.isEmpty {
            return time
        }
        let sizes = streams[si].extSizes
        var p = from
        for k in 0..kinds.count {
            var size = sizes[k]
            if size == 0xffff {
                size = if p + 2 <= file.count { file.uint16(at: p) } else { 0 }
                p += 2
            }
            if p + size > to {
                break
            }
            if kinds[k] == 0x2a && size >= 24 {
                let lo = file.uint32(at: p + 8)
                let hi = file.uint32(at: p + 12)
                if !(lo == 0xffffffff && hi == 0xffffffff) && hi < 0x80000000 {
                    return ((hi << 32) | lo) / 10000
                }
            }
            p += size
        }
        time
    }

    // A fragment of a media object: `offset` into an object of `objSize`
    // bytes, `length` bytes at `at` in the file.
    fn fragment(_ si: Int, _ offset: Int, _ objSize: Int, _ pts: Int, _ key: Bool, _ at: Int, _ length: Int) {
        if objSize <= 0 || objSize >= 0x1000000 {
            damaged += 1
            return
        }
        if offset == 0 {
            if partials[si].active && partials[si].got > 0 {
                dropped += 1
            }
            partials[si].active = true
            partials[si].size = objSize
            partials[si].got = 0
            partials[si].pts = pts
            partials[si].key = key || streams[si].track.kind == core.TrackKind.audio
            partials[si].parts = []
        } else if !partials[si].active {
            // The object started before what we have (a cut file, or a
            // fragment lost): skip to the next object.
            return
        } else if offset != partials[si].got || objSize != partials[si].size {
            dropped += 1
            partials[si].active = false
            return
        }
        let n = min(length, partials[si].size - partials[si].got)
        if n <= 0 {
            return
        }
        partials[si].parts.append(at)
        partials[si].parts.append(n)
        partials[si].got += n
        if partials[si].got == partials[si].size {
            let parts = partials[si].parts
            partials[si].active = false
            emit(si, partials[si].pts, partials[si].key, parts, partials[si].size)
        }
    }

    // A whole media object.
    fn emit(_ si: Int, _ pts: Int, _ key: Bool, _ pieces: [Int], _ size: Int) {
        var parts = pieces
        let st = streams[si]
        if st.span > 1 && size == st.spreadPacket * st.span {
            parts = asfDescramble(pieces, size, st.span, st.spreadPacket, st.spreadChunk)
        }
        var p = core.PacketRef(track: si, pts: pts, dts: pts, key: key, offset: parts[0], size: size)
        if parts.count > 2 {
            p.parts = parts
        }
        packets.append(p)
    }
}

public fn asfOpen(_ file: Data) -> Result<core.Media> {
    var r = AsfReader(file: file)
    for _ in 0..128 {
        r.byNumber.append(-1)
        r.aspectXs.append(0)
        r.aspectYs.append(0)
    }
    let problem = r.readTop()
    if !problem.isEmpty {
        return Result.failure(error: Error(problem))
    }
    var encrypted = r.drm
    for st in r.streams {
        if st.encrypted {
            encrypted = true
        }
    }
    if encrypted {
        return Result.failure(error: Error("this Windows Media file is protected by DRM (digital rights management), so it can't be played"))
    }
    // Streams known only from extended or bitrate properties carry no
    // media; drop them and number the rest in header order.
    var streams: [AsfStream] = []
    var byNumber: [Int] = []
    for _ in 0..128 {
        byNumber.append(-1)
    }
    for k in 0..r.propsSeen {
        for st in r.streams {
            if st.order != k {
                continue
            }
            var s = st
            s.track.index = streams.count
            byNumber[s.number] = streams.count
            streams.append(s)
        }
    }
    if streams.isEmpty {
        return Result.failure(error: Error("ASF: the file has no streams"))
    }
    var m = core.Media(format: "asf")
    m.warnings = r.warnings

    // Packets.
    var pk = AsfPacketizer(file: file, streams: streams, byNumber: byNumber, preroll: r.preroll)
    for _ in 0..streams.count {
        pk.partials.append(AsfPartial())
    }
    let fixed = if r.minPacket > 0 && r.minPacket == r.maxPacket { r.minPacket } else { 0 }
    pk.run(r.dataStart, r.dataEnd, packetSize: fixed)
    if pk.damaged > 0 {
        m.warnings.append("ASF: {pk.damaged} damaged data packets or payloads skipped")
    }
    m.warnings += pk.warnings
    if pk.resyncs > 0 {
        m.warnings.append("ASF: {pk.resyncs} times the next data packet wasn't where expected (found it further on)")
    }
    if pk.dropped > 0 {
        m.warnings.append("ASF: {pk.dropped} incomplete media objects dropped")
    }

    // Keyframes from the simple index, for video streams whose payloads
    // never say "key": the first object starting in each indexed packet.
    if !r.indexPackets.isEmpty && fixed > 0 {
        for (si, st) in streams.enumerated() {
            if st.track.kind != core.TrackKind.video {
                continue
            }
            var anyKey = false
            for p in pk.packets {
                if p.track == si && p.key {
                    anyKey = true
                    break
                }
            }
            if anyKey {
                continue
            }
            let want = Set(r.indexPackets)
            var marked = -1
            for i in 0..pk.packets.count {
                if pk.packets[i].track != si {
                    continue
                }
                let n = (pk.packets[i].offset - r.dataStart) / fixed
                if want.contains(n) && n != marked {
                    pk.packets[i].key = true
                    marked = n
                }
            }
        }
    }

    // Tracks.
    let headerOk = r.headerFileSize <= 0 || abs(file.count - r.headerFileSize) < min(file.count, r.headerFileSize) / 20
    // Packet durations: to the next packet of the same track (the last
    // one: as long as the one before it). Track ends from them.
    var lastOf: [Int] = []
    var ends: [Int] = []
    for _ in 0..streams.count {
        lastOf.append(-1)
        ends.append(0)
    }
    for i in 0..pk.packets.count {
        let tr = pk.packets[i].track
        let prev = lastOf[tr]
        if prev >= 0 {
            pk.packets[prev].duration = max(0, pk.packets[i].pts - pk.packets[prev].pts)
            pk.packets[i].duration = pk.packets[prev].duration
        }
        lastOf[tr] = i
        ends[tr] = max(ends[tr], pk.packets[i].pts + pk.packets[i].duration)
    }
    var lastEnd = 0
    for e in ends {
        lastEnd = max(lastEnd, e)
    }
    for (i, st) in streams.enumerated() {
        var t = st.track
        if !r.broadcast && headerOk && r.playDuration > 0 {
            t.duration = r.playDuration / 10000 - r.preroll
        } else if ends[i] > 0 {
            t.duration = ends[i]
        }
        if t.bitrate == 0 {
            t.bitrate = if st.leakRate > 0 { st.leakRate } else { st.bitratePropsRate }
        }
        if st.languageIndex >= 0 && st.languageIndex < r.languages.count {
            t.language = asfLanguage(r.languages[st.languageIndex])
        }
        let ax = r.aspectXs[st.number]
        let ay = r.aspectYs[st.number]
        if ax > 0 && ay > 0 {
            let g = asfGcd(ax, ay)
            t.sarNum = ax / g
            t.sarDen = ay / g
        } else if r.aspectXs[0] > 0 && r.aspectYs[0] > 0 && t.kind == core.TrackKind.video {
            let g = asfGcd(r.aspectXs[0], r.aspectYs[0])
            t.sarNum = r.aspectXs[0] / g
            t.sarDen = r.aspectYs[0] / g
        }
        if t.codec == "mjpeg" {
            for k in 0..pk.packets.count {
                if pk.packets[k].track == i {
                    pk.packets[k].key = true
                }
            }
        }
        if t.kind == core.TrackKind.video && st.avgFrameTime > 0 {
            let g = asfGcd(10000000, st.avgFrameTime)
            t.fpsNum = 10000000 / g
            t.fpsDen = st.avgFrameTime / g
        }
        t.index = i
        m.tracks.append(t)
    }
    m.packets = pk.packets

    if !r.broadcast && headerOk && r.playDuration > 0 {
        m.duration = Float(r.playDuration) / 10000000.0 - Float(r.preroll) / 1000.0
    } else if lastEnd > 0 {
        m.duration = Float(lastEnd) / 1000.0
    }
    m.tags = r.tags
    if m.tags["track"] == nil && !r.track0.isEmpty {
        m.tags["track"] = r.track0
    }
    if !r.codecNames.isEmpty {
        m.tags["codecs"] = r.codecNames.joined(separator: "; ")
    }
    m.cover = r.cover
    // Chapters end where the next one starts.
    var chapters = r.chapters
    for k in 0..chapters.count {
        if k + 1 < chapters.count {
            chapters[k].end = chapters[k + 1].start
        } else if m.duration > 0.0 {
            chapters[k].end = m.duration
        }
    }
    m.chapters = chapters
    Result.ok(value: m)
}

// WAVEFORMATEX (wFormatTag, nChannels, nSamplesPerSec, nAvgBytesPerSec,
// nBlockAlign, wBitsPerSample, cbSize, then cbSize bytes of codec setup)
// at [at, end) → the track's codec, as in demux/mkv.tsl's mkvWaveFormat.
fn asfWaveFormat(_ t: bind core.Track, _ d: Data, _ at: Int, _ end: Int) {
    if at + 16 > d.count || end - at < 14 {
        t.codec = "unknown:wav"
        return
    }
    var tag = d.uint16(at: at)
    t.channels = d.uint16(at: at + 2)
    t.sampleRate = d.uint32(at: at + 4)
    t.bitrate = d.uint32(at: at + 8) * 8
    t.blockAlign = d.uint16(at: at + 12)
    let bits = d.uint16(at: at + 14)
    t.bitsPerSample = bits
    t.extra = Data()
    if end - at >= 18 && at + 18 <= d.count {
        let cb = d.uint16(at: at + 16)
        let to = min(min(at + 18 + cb, end), d.count)
        if to > at + 18 {
            t.extra = d.slice(from: at + 18, to: to)
        }
    }
    if tag == 0xFFFE && t.extra.count >= 22 {
        // WAVE_FORMAT_EXTENSIBLE: valid bits (2), channel mask (4), and the
        // real tag at the start of the SubFormat GUID.
        let mask = t.extra.uint32(at: 2)
        tag = t.extra.uint16(at: 6)
        t.layout = asfMaskLayout(mask, t.channels)
        t.extra = Data()
    }
    t.tag = "0x" + asfHex4(tag)
    t.codec = match tag {
        0x0160 -> "wmav1"
        0x0161 -> "wmav2"
        0x0162 -> "wmapro"
        0x0163 -> "wmalossless"
        0x0055 -> "mp3"
        0x0050 -> "mp2"
        0x2000 -> "ac3"
        0x2001 -> "dts"
        0x00FF -> "aac"
        0x1610 -> "aac"
        0x706D -> "aac"
        0xF1AC -> "flac"
        0x0001 -> "pcm"
        0x0003 -> "pcm"
        0x0006 -> "alaw"
        0x0007 -> "ulaw"
        _ -> "unknown:acm" + asfHex4(tag)
    }
    if tag == 1 || tag == 3 {
        let b = if bits > 0 { bits } else { 16 }
        t.pcm = core.PcmFormat(bits: b, float: tag == 3, bigEndian: false, signed: b > 8)
        t.bitsPerSample = b
        t.extra = Data()
    }
    if t.codec == "alaw" || t.codec == "ulaw" {
        t.extra = Data()
    }
    if t.codec == "aac" && (tag == 0x1610 || t.extra.isEmpty) {
        t.adts = true
        t.extra = Data()
    }
}

// WAVE_FORMAT_EXTENSIBLE channel mask bits → WAV channel names.
fn asfMaskLayout(_ mask: Int, _ channels: Int) -> [String] {
    let names = ["FL", "FR", "FC", "LFE", "BL", "BR", "FLC", "FRC", "BC", "SL", "SR", "TC", "TFL", "TFC", "TFR", "TBL", "TBC", "TBR"]
    var out: [String] = []
    for b in 0..18 {
        if (mask >> b) & 1 == 1 {
            out.append(names[b])
        }
    }
    if out.count != channels {
        return []
    }
    out
}

// Video codec from BITMAPINFOHEADER.biCompression.
fn asfVideoCodec(_ fourcc: String) -> String {
    match fourcc.uppercase() {
        "WMV1" -> "wmv1"
        "WMV2" -> "wmv2"
        "WMV3" -> "wmv3"
        "WVC1" -> "vc1"
        "WMVA" -> "vc1"
        "MP43" -> "msmpeg4v3"
        "DIV3" -> "msmpeg4v3"
        "DIV4" -> "msmpeg4v3"
        "MP42" -> "msmpeg4v2"
        "DIV2" -> "msmpeg4v2"
        "MPG4" -> "msmpeg4v1"
        "MP4S" -> "mpeg4"
        "M4S2" -> "mpeg4"
        "XVID" -> "mpeg4"
        "DIVX" -> "mpeg4"
        "DX50" -> "mpeg4"
        "FMP4" -> "mpeg4"
        "MP4V" -> "mpeg4"
        "H264" -> "h264"
        "AVC1" -> "h264"
        "X264" -> "h264"
        "HEVC" -> "hevc"
        "H265" -> "hevc"
        "MJPG" -> "mjpeg"
        "DVR " -> "mpeg2"
        "MPG2" -> "mpeg2"
        _ -> "unknown:" + fourcc.trim()
    }
}

fn asfFourcc(_ d: Data, _ at: Int) -> String {
    if at + 4 > d.count {
        return ""
    }
    let codes = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz\{|}~"
    var s = ""
    for k in 0..4 {
        let b = d[at + k]
        if b >= 32 && b < 127 {
            s += codes.substring(from: b - 32, to: b - 31)
        } else {
            s += "?"
        }
    }
    s
}

fn asfHex4(_ v: Int) -> String {
    let digits = "0123456789ABCDEF"
    var s = ""
    var n = v
    for _ in 0..4 {
        s = digits.substring(from: n & 15, to: (n & 15) + 1) + s
        n = n >> 4
    }
    s
}

// A number value (types 2 BOOL, 3 DWORD, 4 QWORD, 5 WORD). BOOL is 4
// bytes in the extended content description, 2 in metadata objects.
fn asfNumber(_ d: Data, _ type: Int, _ at: Int, _ len: Int, _ boolSize: Int) -> Int {
    let need = match type {
        2 -> boolSize
        3 -> 4
        4 -> 8
        5 -> 2
        _ -> 0
    }
    if need == 0 || len < need || at + need > d.count {
        return 0
    }
    match need {
        2 -> d.uint16(at: at)
        4 -> d.uint32(at: at)
        _ -> {
            let hi = d.uint32(at: at + 4)
            if hi >= 0x80000000 { 0 } else { (hi << 32) | d.uint32(at: at) }
        }
    }
}

// UTF-16LE text of `len` bytes at `at`, up to the first zero character.
fn asfUtf16(_ d: Data, _ at: Int, _ len: Int) -> String {
    var out = Data()
    var p = at
    let end = min(at + len, d.count)
    while p + 1 < end {
        var c = d.uint16(at: p)
        p += 2
        if c == 0 {
            break
        }
        if c >= 0xd800 && c < 0xdc00 && p + 1 < end {
            let lo = d.uint16(at: p)
            if lo >= 0xdc00 && lo < 0xe000 {
                c = 0x10000 + ((c - 0xd800) << 10) + (lo - 0xdc00)
                p += 2
            }
        }
        if c < 0x80 {
            out.append(byte: c)
        } else if c < 0x800 {
            out.append(byte: 0xc0 | (c >> 6))
            out.append(byte: 0x80 | (c & 0x3f))
        } else if c < 0x10000 {
            if c >= 0xd800 && c < 0xe000 {
                // A lone surrogate: the replacement character.
                c = 0xfffd
            }
            out.append(byte: 0xe0 | (c >> 12))
            out.append(byte: 0x80 | ((c >> 6) & 0x3f))
            out.append(byte: 0x80 | (c & 0x3f))
        } else {
            out.append(byte: 0xf0 | (c >> 18))
            out.append(byte: 0x80 | ((c >> 12) & 0x3f))
            out.append(byte: 0x80 | ((c >> 6) & 0x3f))
            out.append(byte: 0x80 | (c & 0x3f))
        }
    }
    out.text ?? out.latin1
}

// ASF tag names → Reel's lower-case keys (as ffmpeg's ff_asf_metadata_conv,
// plus WM/Year → date); other names are kept, lower-cased.
fn asfTagKey(_ name: String) -> String {
    match name {
        "Title" -> "title"
        "Author" -> "artist"
        "Copyright" -> "copyright"
        "Description" -> "comment"
        "WM/AlbumTitle" -> "album"
        "WM/AlbumArtist" -> "albumartist"
        "WM/Composer" -> "composer"
        "WM/Genre" -> "genre"
        "WM/Year" -> "date"
        "WM/TrackNumber" -> "track"
        "WM/PartOfSet" -> "disc"
        "WM/EncodingSettings" -> "encoder"
        "WM/ToolName" -> "encoder"
        "WM/Tool" -> "encoder"
        "WM/Publisher" -> "publisher"
        "WM/EncodedBy" -> "encoded_by"
        "WM/Language" -> "language"
        _ -> name.lowercase()
    }
}

// An RFC 1766 language ("en-us") as ISO 639-2 (bibliographic, as ffmpeg).
fn asfLanguage(_ rfc: String) -> String {
    let primary = rfc.split("-")[0].lowercase()
    if primary.count == 3 {
        return primary
    }
    match primary {
        "en" -> "eng"
        "de" -> "ger"
        "fr" -> "fre"
        "es" -> "spa"
        "it" -> "ita"
        "nl" -> "dut"
        "da" -> "dan"
        "sv" -> "swe"
        "no" -> "nor"
        "nb" -> "nob"
        "nn" -> "nno"
        "fi" -> "fin"
        "pt" -> "por"
        "ru" -> "rus"
        "pl" -> "pol"
        "cs" -> "cze"
        "sk" -> "slo"
        "hu" -> "hun"
        "ro" -> "rum"
        "el" -> "gre"
        "tr" -> "tur"
        "ja" -> "jpn"
        "zh" -> "chi"
        "ko" -> "kor"
        "ar" -> "ara"
        "he" -> "heb"
        "hi" -> "hin"
        "th" -> "tha"
        "vi" -> "vie"
        "id" -> "ind"
        "ms" -> "may"
        "uk" -> "ukr"
        "bg" -> "bul"
        "hr" -> "hrv"
        "sr" -> "srp"
        "sl" -> "slv"
        "et" -> "est"
        "lv" -> "lav"
        "lt" -> "lit"
        "is" -> "ice"
        "ga" -> "gle"
        "ca" -> "cat"
        "eu" -> "baq"
        "gl" -> "glg"
        "fa" -> "per"
        "tl" -> "tgl"
        _ -> ""
    }
}

// Audio spreading (ASF 9.1) undone: the object is `span` rows of virtual
// packets of `vpl` bytes, written column by column in `vcl`-byte chunks.
// Returns the parts (offset, size pairs in the file) in playing order.
fn asfDescramble(_ pieces: [Int], _ size: Int, _ span: Int, _ vpl: Int, _ vcl: Int) -> [Int] {
    var out: [Int] = []
    let perPacket = vpl / vcl
    var offset = 0
    while offset + vcl <= size {
        let k = offset / vcl
        let row = k / span
        let col = k % span
        let idx = row + col * perPacket
        asfAddRange(pieces, idx * vcl, vcl, out)
        offset += vcl
    }
    out
}

// Adds the file ranges holding object bytes [from, from + n) to `out`,
// joining a range to the one before when they touch.
fn asfAddRange(_ pieces: [Int], _ from: Int, _ n: Int, _ out: bind [Int]) {
    var objAt = 0
    var left = n
    var want = from
    var i = 0
    while i + 1 < pieces.count && left > 0 {
        let pOff = pieces[i]
        let pLen = pieces[i + 1]
        if want < objAt + pLen {
            let inPiece = want - objAt
            let take = min(left, pLen - inPiece)
            let fileAt = pOff + inPiece
            let c = out.count
            if c >= 2 && out[c - 2] + out[c - 1] == fileAt {
                out[c - 1] += take
            } else {
                out.append(fileAt)
                out.append(take)
            }
            want += take
            left -= take
        }
        objAt += pLen
        i += 2
    }
}

// The standard error correction bytes that start a data packet.
fn asfIsSync(_ d: Data, _ at: Int) -> Bool {
    at + 3 <= d.count && d[at] == 0x82 && d[at + 1] == 0 && d[at + 2] == 0
}

fn asfGcd(_ a: Int, _ b: Int) -> Int {
    var x = a
    var y = b
    while y != 0 {
        let r = x % y
        x = y
        y = r
    }
    max(x, 1)
}
