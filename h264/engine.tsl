// The H.264 decoding engine: its state (decoded frames with the motion
// data later pictures need, the per-macroblock tables of the picture being
// decoded, the neighbour caches) and, as methods of Eng, every stage of
// decoding, in sections:
//
//   decoding flow     packets, NAL units, slices, picture start and end
//   references        POC, reference lists, marking, DPB output order
//   neighbours        macroblock neighbours and the caches (6.4.11/12)
//   macroblocks       shared parts, CAVLC and CABAC macroblock layers
//   motion            vector prediction, P_Skip, direct prediction
//   reconstruction    intra / inter prediction plus residual
//   deblocking        boundary strengths and edges (8.7)
//
// (They are methods because calls between methods of one struct are far
// cheaper in Tessel than passing a `bind` parameter on between free
// functions; see build/TESSEL_ISSUES.md.) Sample-level work lives in
// intra.tsl, mc.tsl and deblock.tsl, parsing of parameter sets and slice
// headers in params.tsl and slice.tsl, the CABAC engine in cabac.tsl.
//
// Neighbour caches: the 4x4 blocks of the current macroblock and the
// blocks around it are kept in an 8-wide grid. Luma block (x, y) of the
// macroblock (x, y from 0 to 3) is at 12 + x + 8 * y; the row above (the
// bottom blocks of the macroblock above) is at 4 + x, the column to the
// left at 11 + 8 * y, the block above-right at 8 and above-left at 3.
// Chroma blocks of Cb are at 52 + x + 8 * y (above: 44 + x, left: 51 +
// 8 * y), of Cr at 76 + x + 8 * y. Each derivation of 6.4.11 is then one
// index.
//
// Macroblock types are bit sets (mbIntra4x4 ... mbDct8x8) so a single Int
// says what a macroblock is.
//
// Author: Alexius Academia
// Date: 2026-10-25

import "../core"

let mbIntra4x4 = 1
let mbIntra16x16 = 2
let mbPcm = 4
let mb16x16 = 8
let mb16x8 = 16
let mb8x16 = 32
let mb8x8 = 64
let mbInterlaced = 128
let mbDirect = 256
let mbP0L0 = 4096
let mbP1L0 = 8192
let mbP0L1 = 16384
let mbP1L1 = 32768
let mbL0 = 12288
let mbL1 = 49152
let mbSkip = 131072
let mbRef0 = 8388608
let mbDct8x8 = 16777216
let mbIntraMask = 7

// Rows of the left macroblock(s) next to the current macroblock's 4x4
// rows, by the four neighbour layouts of MBAFF frames (frame or field
// current macroblock beside a pair of the other kind), and the chroma
// rows likewise (6.4.12.2, Table 6-4).
let h264LeftRows: [Int] = [0, 1, 2, 3, 2, 2, 3, 3, 0, 0, 1, 1, 0, 2, 0, 2]
let h264LeftChromaRows: [Int] = [0, 1, 1, 1, 0, 0, 0, 0]

let partNotAvailable = -2
let listNotUsed = -1

// Cache position of luma block n (in decoding order, 6.4.3), then Cb
// blocks 16..19, then Cr 20..23.
let scan8: [Int] = [12, 13, 20, 21, 14, 15, 22, 23, 28, 29, 36, 37, 30, 31, 38, 39, 52, 53, 60, 61, 76, 77, 84, 85]
// x and y (in 4x4 blocks) of luma block n inside its macroblock.
let blkX: [Int] = [0, 1, 0, 1, 2, 3, 2, 3, 0, 1, 0, 1, 2, 3, 2, 3]
let blkY: [Int] = [0, 0, 1, 1, 0, 0, 1, 1, 2, 2, 3, 3, 2, 2, 3, 3]

// A decoded frame (or field pair) and what other pictures need of it.
struct Frame {
    id: Int = -1
    y: [Int] = []
    u: [Int] = []
    v: [Int] = []
    poc: Int = 0
    topPoc: Int = 0
    botPoc: Int = 0
    frameNum: Int = 0
    frameNumWrap: Int = 0
    longTermFrameIdx: Int = 0
    // Reference marking per field: bit 1 top, bit 2 bottom (3 = frame).
    shortRef: Int = 0
    longRef: Int = 0
    outputNeeded: Bool = false
    // Fields decoded so far (bit 1 top, bit 2 bottom, 3 both).
    fields: Int = 0
    isIdr: Bool = false
    mmco5: Bool = false
    nonExisting: Bool = false
    pts: Int = -9223372036854775807
    key: Bool = false
    // Motion data for direct prediction in later pictures (8.4.1.2):
    // per macroblock its type, per 4x4 block the vectors of both lists,
    // per 8x8 block the reference index and the id of the picture used.
    mbType: [Int] = []
    mvx0: [Int] = []
    mvy0: [Int] = []
    mvx1: [Int] = []
    mvy1: [Int] = []
    ref0: [Int] = []
    ref1: [Int] = []
    pic0: [Int] = []
    pic1: [Int] = []
    // Picture order counts of the pictures referenced (by id), for
    // temporal direct: (id, poc) pairs aren't needed as ids are unique.
    fieldPicture: Bool = false
    mbaffFrame: Bool = false

    isRef: Bool { shortRef != 0 || longRef != 0 }
}

struct Eng {
    // Parameter sets by id, and the active ones.
    spsList: [Sps] = []
    ppsList: [Pps] = []
    sps: Sps = Sps()
    pps: Pps = Pps()
    haveSps: Bool = false
    // Geometry of the active sequence (frame sizes in samples and
    // macroblocks).
    mbW: Int = 0
    mbH: Int = 0
    numMbs: Int = 0
    lumaW: Int = 0
    lumaH: Int = 0
    chromaW: Int = 0
    chromaH: Int = 0
    hasChroma: Bool = true

    // The current slice: header, type (sliceP, sliceB or sliceI), its
    // number (counting on over the whole stream), quantiser state.
    sh: SliceHeader = SliceHeader()
    sliceType: Int = 2
    sliceNum: Int = 0
    // Slice group of each macroblock address of the current picture (FMO,
    // 8.2.2); empty with one slice group.
    sgMap: [Int] = []
    // The pipeline (see pipeline.tsl): 0 decodes fully, 1 only parses
    // (and records what reconstruction needs), 2 only reconstructs from
    // such records.
    mode: Int = 0
    // Reconstruct mode: which planes this reconstructor makes (the luma
    // and the chroma planes don't depend on each other once parsed, so two
    // reconstructors can share the work); hasChroma is false without
    // chroma work.
    doLuma: Bool = true
    doChroma: Bool = true
    // Parse mode: operations, slice headers with their parameter sets,
    // macroblock records and coefficients since the last finished picture,
    // the table snapshot of the picture being finished, finished records.
    pOps: [Int] = []
    pHeaders: [SliceHeader] = []
    pPps: [Pps] = []
    pSps: [Sps] = []
    pRec: [Int] = []
    pCoef: [Int] = []
    pCoefMb: Int = 0
    pMbs: Int = 0
    pSliceOp: Int = -1
    pSnap: ParsedPicture = ParsedPicture()
    pBs: [Int] = []
    pDone: [ParsedPicture] = []
    // Reconstruct mode: the record being replayed, read positions, the
    // macroblock count of the current slice, whether its tables are in.
    rp: ParsedPicture = ParsedPicture()
    rRec: Int = 0
    rCoef: Int = 0
    rSliceMbs: Int = 0
    rInstalled: Bool = false
    reconWarn: Bool = false
    // SP slice (Extended profile): QSY, and per slice whether it is SP.
    spSlice: Bool = false
    qsY: Int = 26
    sliceSp: [Int] = []
    // Whether a slice of the current picture started at macroblock 0.
    picHadMb0: Bool = false
    qp: Int = 26
    qpCb: Int = 26
    qpCr: Int = 26
    lastQpDelta: Int = 0
    listCount: Int = 0
    refCount0: Int = 0
    refCount1: Int = 0
    // Reference lists: DPB positions (-1 missing, -2 the frame being
    // decoded), structure (1 top, 2 bottom, 3 frame), picture id (frame id
    // * 4 + structure), PicOrderCnt and long-term flag of each entry.
    list0: [Int] = []
    list1: [Int] = []
    listPar0: [Int] = []
    listPar1: [Int] = []
    listId0: [Int] = []
    listId1: [Int] = []
    listPoc0: [Int] = []
    listPoc1: [Int] = []
    listLong0: [Bool] = []
    listLong1: [Bool] = []
    // Weighted prediction (8.4.2.3): 0 default, 1 explicit, 2 implicit;
    // explicit weights and offsets per list 0 / list 1 index; implicit
    // weights of list 1 by (ref0 * 32 + ref1), and per field parity for
    // MBAFF field macroblocks ((parity - 1) * 4096 + ref0 * 64 + ref1).
    weightMode: Int = 0
    lumaLog2: Int = 0
    chromaLog2: Int = 0
    lumaW0: [Int] = []
    lumaW1: [Int] = []
    lumaO0: [Int] = []
    lumaO1: [Int] = []
    chromaW0: [Int] = []
    chromaW1: [Int] = []
    chromaO0: [Int] = []
    chromaO1: [Int] = []
    implicitW: [Int] = []
    implicitWF: [Int] = []
    // Temporal direct: DistScaleFactor by list 0 index (and per field
    // parity for MBAFF field macroblocks), the colocated field of a frame
    // whose RefPicList1[0] was coded as fields.
    distScale: [Int] = []
    distScaleF: [Int] = []
    colParity: Int = 0
    // The colocated macroblock(s) of the current one (h264ColSetup).
    colK: Int = -1
    colKind: Int = 0
    colMbA: Int = 0
    colMbB: Int = 0
    colTypeA: Int = 0
    colTypeB: Int = 0
    colRowSel: Int = 0

    // Per macroblock tables of the frame being decoded (frame macroblock
    // rows; a field's macroblocks use the rows of its parity): type, slice,
    // QP, coded_block_pattern (with CABAC's DC flags), coefficient counts
    // (16 luma, 4 Cb, 4 Cr), intra 4x4 modes, chroma mode, absolute mvd of
    // both lists, direct 8x8 blocks.
    mbTypes: [Int] = []
    sliceTab: [Int] = []
    qpTab: [Int] = []
    cbpTab: [Int] = []
    nzTab: [Int] = []
    predTab: [Int] = []
    chromaPredTab: [Int] = []
    mvdx0: [Int] = []
    mvdy0: [Int] = []
    mvdx1: [Int] = []
    mvdy1: [Int] = []
    directTab: [Int] = []
    codedMask: [Int] = []
    // Deblocking settings of each slice of the picture, by slice number
    // minus picFirstSlice.
    sliceDisable: [Int] = []
    sliceAlpha: [Int] = []
    sliceBeta: [Int] = []
    picFirstSlice: Int = 0

    // The current macroblock: position, type, neighbours (A may be two
    // macroblocks in MBAFF frames: leftXY for the upper half, leftXY2 for
    // the lower), intra modes and availability masks (bit 15 - n for 4x4
    // block n; see h264FillIntraAvail).
    mbX: Int = 0
    mbY: Int = 0
    mbXY: Int = 0
    mbType: Int = 0
    cbp: Int = 0
    leftXY: Int = 0
    leftXY2: Int = 0
    topXY: Int = 0
    topLeftXY: Int = 0
    topRightXY: Int = 0
    leftType: Int = 0
    leftType2: Int = 0
    topType: Int = 0
    topLeftType: Int = 0
    topRightType: Int = 0
    leftBlock: Int = 0
    topLeftPart: Int = -1
    leftCbp: Int = 0
    topCbp: Int = 0
    i16Mode: Int = 0
    chromaMode: Int = 0
    neighborTransform: Int = 0
    subMbType: [Int] = []
    subPartCount: [Int] = []
    prevMbSkipped: Bool = false
    nextMbSkipped: Bool = false
    skipRun: Int = -1
    tlAvail: Int = 0
    tAvail: Int = 0
    lAvail: Int = 0
    trAvail: Int = 0
    availLeft: Bool = false
    availTop: Bool = false
    availTopLeft: Bool = false
    hasDcY: Bool = false
    hasDcC: Int = 0
    predMvx: Int = 0
    predMvy: Int = 0
    mvdX: Int = 0
    mvdY: Int = 0
    mvdAx: Int = 0
    mvdAy: Int = 0
    mvdAbs: Int = 0
    diagX: Int = 0
    diagY: Int = 0
    // Frame/field layout of the current macroblock: field macroblock (in
    // a field or an MBAFF field pair), MBAFF frame, the pair's
    // mb_field_decoding_flag, plane positions and strides, the luma row
    // and field parity motion compensation works in, reference counts
    // (doubled for MBAFF field macroblocks), the type bit to store.
    mbField: Bool = false
    mbaffFrame: Bool = false
    pairField: Bool = false
    fieldDecoding: Bool = false
    fieldFlag: Int = 0
    lumaAt: Int = 0
    chromaAt: Int = 0
    mcRow: Int = 0
    mcParity: Int = 3
    mbRefCount0: Int = 0
    mbRefCount1: Int = 0

    // Caches (see the top of this file).
    predCache: [Int] = []
    nzCache: [Int] = []
    refCache: [Int] = []
    mvxCache: [Int] = []
    mvyCache: [Int] = []
    mvdxCache: [Int] = []
    mvdyCache: [Int] = []
    directCache: [Int] = []

    // Coefficients of the macroblock after scaling (8.5.12.1): luma block
    // n at 16 * n (or 8x8 block k at 64 * k), Cb at 256 + 16 * i, Cr at
    // 320 + 16 * i; DC values before their transforms.
    coef: [Int] = []
    dcY: [Int] = []
    dcC: [Int] = []
    tmp: [Int] = []
    pcmBytes: [Int] = []

    // Entropy decoding.
    br: core.BitReader = core.bitReader(Data())
    cab: Cabac = Cabac()
    rbsp: Data = Data()

    // Pictures: the frame being decoded, its structure (1 top field, 2
    // bottom field, 3 frame) and plane layout, the DPB, planes to reuse.
    cur: Frame = Frame()
    picSh: SliceHeader = SliceHeader()
    havePic: Bool = false
    pendingField: Bool = false
    curStructure: Int = 3
    pStride: Int = 0
    pOff: Int = 0
    cStride: Int = 0
    cOff: Int = 0
    picH: Int = 0
    picMbH: Int = 0
    rowStep: Int = 1
    mbRowOff: Int = 0
    dpb: [Frame] = []
    pool: [Frame] = []
    nextId: Int = 1
    maxFrames: Int = 1
    reorder: Int = 0
    // POC state (8.2.1).
    pocMsb: Int = 0
    curFieldPoc: Int = 0
    prevPocMsb: Int = 0
    prevPocLsb: Int = 0
    prevFrameNumOffset: Int = 0
    prevFrameNum: Int = 0
    prevRefFrameNum: Int = 0
    frameNumOffset: Int = 0
    maxPicNum: Int = 0
    maxLongTermFrameIdx: Int = -1
    // Output and stream state.
    out: [core.Picture] = []
    curPts: Int = -9223372036854775807
    curKey: Bool = false
    waitKey: Bool = true
    recoveryPoint: Bool = false
    dropOutput: Bool = false
    warnings: [String] = []
    skipNonRef: Bool = false
    frames: Int = 0

    // Scratch: intra edge samples, prediction buffers, zeroed templates
    // for new frames.
    edgeTop: [Int] = []
    edgeLeft: [Int] = []
    edgeA: [Int] = []
    edgeF: [Int] = []
    mc: Mc = Mc()
    zeroY: [Int] = []
    zeroC: [Int] = []
    zeroMb16: [Int] = []
    zeroMb4: [Int] = []

    // Copies of the module's constant tables (read through self, which is
    // cheaper than a module constant inside these methods).
    s8: [Int] = []
    bx4: [Int] = []
    by4: [Int] = []
    cavlcChromaDcTab: [Int] = []
    cavlcZerosTab: [Int] = []
    cavlcChromaDcZerosTab: [Int] = []
    cavlcRunTab: [Int] = []
    cavlcTokenBits: [Int] = []
    cavlcTokenTabs: [[Int]] = []
    cabacSig8x8: [Int] = []
    cabacLast8x8: [Int] = []
    cabacAbsLevel1Ctx: [Int] = []
    cabacAbsLevelGt1Ctx: [Int] = []
    cabacAbsTrans1: [Int] = []
    cabacAbsTransGt1: [Int] = []
    cabacSigOffset: [Int] = []
    cabacLastOffset: [Int] = []
    cabacAbsOffset: [Int] = []
    cabacCbfOffset: [Int] = []
    h264Identity: [Int] = []
    zigzag8x8: [Int] = []
    zigzag4x4: [Int] = []
    fieldScan4x4: [Int] = []
    fieldScan8x8: [Int] = []
    iMbTypeInfo: [Int] = []
    iMbPredMode: [Int] = []
    iMbCbp: [Int] = []
    pMbTypeInfo: [Int] = []
    pMbPartCount: [Int] = []
    pSubMbTypeInfo: [Int] = []
    pSubPartCount: [Int] = []
    bMbTypeInfo: [Int] = []
    bMbPartCount: [Int] = []
    bSubMbTypeInfo: [Int] = []
    bSubPartCount: [Int] = []
    h264LeftRows: [Int] = []
    h264LeftChromaRows: [Int] = []
    golombToIntra4x4Cbp: [Int] = []
    golombToInterCbp: [Int] = []
    golombToIntra4x4CbpGray: [Int] = []
    golombToInterCbpGray: [Int] = []

    // Development switches (environment variables H264_NODEBLOCK,
    // H264_TRACE with H264_FRAME / H264_MB, H264_TIMING, H264_NORECON) and
    // timing totals in seconds.
    debugNoDeblock: Bool = false
    debugTrace: Bool = false
    traceFrame: Int = -1
    traceMb: Int = -1
    timing: Bool = false
    noRecon: Bool = false
    dbgEdges: Int = 0
    tMask: Float = 0.0
    tMc: Float = 0.0
    // Explicit weights that change nothing, per list 0 / list 1 index.
    wDef0: [Int] = []
    wDef1: [Int] = []
    tDeblock: Float = 0.0
    tSlice: Float = 0.0
    tA: Float = 0.0
    tB: Float = 0.0
    tC: Float = 0.0

    // ----------------------------------------------------------------------
    // Decoding flow: packets, NAL units, slices and pictures (7.3.1, 7.4.1.2.4, 7.3.4)
    // ----------------------------------------------------------------------

    // Decodes the NAL units of one packet.
    fn h264DecodePacket(_ d: Data, _ lengthSize: Int, _ pts: Int, _ key: Bool) {
        var ls = lengthSize
        if ls == 0 || (h264LooksAnnexB(d) && !h264LengthsFit(d, ls)) {
            ls = 0
        }
        let nals = h264SplitNals(d, ls)
        if self.debugTrace {
            var t = ""
            var k = 0
            while k + 1 < nals.count {
                t += " {d[nals[k]] & 31}:{nals[k + 1] - nals[k]}"
                k += 2
            }
            print("packet {d.count} bytes ls {ls} nals{t}")
        }
        self.curPts = pts
        self.curKey = key
        if self.mode == 1 {
            self.pOps.append(1)
            self.pOps.append(pts)
            self.pOps.append(if key { 1 } else { 0 })
        }
        var i = 0
        while i + 1 < nals.count {
            h264HandleNal(d, nals[i], nals[i + 1])
            i += 2
        }
        if self.havePic {
            h264FinishPicture()
        }
    }

    fn h264HandleNal(_ d: Data, _ start: Int, _ end: Int) {
        if end <= start {
            return
        }
        let hdr = d[start]
        let type = hdr & 31
        let refIdc = (hdr >> 5) & 3
        if type == 7 {
            let s = parseSps(core.unescapeRbsp(d, from: start + 1, to: end))
            if s.valid {
                self.spsList[s.id] = s
            } else {
                h264Warn("bad sequence parameter set")
            }
        } else if type == 8 {
            let p = parsePps(core.unescapeRbsp(d, from: start + 1, to: end), self.spsList)
            if p.valid {
                self.ppsList[p.id] = p
                if self.havePic && p.id == self.pps.id {
                    // The active PPS may only be replaced between pictures.
                    h264FinishPicture()
                }
            } else {
                h264Warn("bad picture parameter set")
            }
        } else if type == 1 || type == 5 {
            h264HandleSlice(core.unescapeRbsp(d, from: start + 1, to: end), type, refIdc)
        } else if type == 6 {
            // SEI: only the recovery point (D.1.8, payloadType 6) matters.
            let rb = core.unescapeRbsp(d, from: start + 1, to: end)
            var p = 0
            while p + 1 < rb.count {
                var t = 0
                while p < rb.count && rb[p] == 255 {
                    t += 255
                    p += 1
                }
                if p >= rb.count {
                    break
                }
                t += rb[p]
                p += 1
                var size = 0
                while p < rb.count && rb[p] == 255 {
                    size += 255
                    p += 1
                }
                if p >= rb.count {
                    break
                }
                size += rb[p]
                p += 1
                if t == 6 {
                    self.recoveryPoint = true
                }
                p += size
                if p < rb.count && rb[p] == 0x80 && p + 1 == rb.count {
                    break
                }
            }
        } else if type == 2 || type == 3 || type == 4 {
            h264Warn("data partitioning (Extended profile) is not supported")
        }
    }

    // Whether a slice starts a new picture compared with the current one
    // (7.4.1.2.4).
    fn h264IsNewPicture(_ h: SliceHeader) -> Bool {
        if !self.havePic {
            return true
        }
        let a = self.picSh
        // A second slice starting at macroblock 0 (slices may come in any
        // order, ASO, so only this one is a sign of a lost picture boundary).
        if h.firstMb == 0 && self.picHadMb0 {
            return true
        }
        if h.frameNum != a.frameNum || h.ppsId != a.ppsId || h.fieldPic != a.fieldPic || h.bottomField != a.bottomField {
            return true
        }
        if (h.nalRefIdc == 0) != (a.nalRefIdc == 0) {
            return true
        }
        if h.pocLsb != a.pocLsb || h.deltaPocBottom != a.deltaPocBottom || h.deltaPoc0 != a.deltaPoc0 || h.deltaPoc1 != a.deltaPoc1 {
            return true
        }
        if h.isIdr != a.isIdr || (h.isIdr && h.idrPicId != a.idrPicId) {
            return true
        }
        false
    }

    fn h264HandleSlice(_ rbsp: Data, _ type: Int, _ refIdc: Int) {
        var h = h264ParseSliceHeader(rbsp, nalType: type, nalRefIdc: refIdc, spsList: self.spsList, ppsList: self.ppsList)
        if !h.ok {
            h264Warn("damaged slice header")
            return
        }
        if self.debugTrace {
            print("slice fn {h.frameNum} type {h.sliceType} ref {refIdc} first {h.firstMb} ok {h.ok}")
        }
        if self.waitKey {
            let st = h.sliceType
            if !(h.isIdr || ((self.curKey || self.recoveryPoint) && (st == sliceI || st == sliceSI))) {
                return
            }
            self.waitKey = false
        }
        let newPic = h264IsNewPicture(h)
        if newPic && self.havePic {
            h264FinishPicture()
        }
        if self.skipNonRef && refIdc == 0 {
            return
        }
        let pps = self.ppsList[h.ppsId]
        let sps = self.spsList[pps.spsId]
        if self.mode == 1 {
            self.pOps.append(2)
            self.pOps.append(self.sliceNum)
            self.pOps.append(self.pHeaders.count)
            self.pOps.append(if newPic { 1 } else { 0 })
            self.pOps.append(0)
            self.pSliceOp = self.pOps.count - 1
            self.pHeaders.append(h)
            self.pPps.append(pps)
            self.pSps.append(sps)
            let before = self.pMbs
            h264StartSlice(h, pps, sps, newPic, rbsp)
            self.pOps[self.pSliceOp] = self.pMbs - before
            return
        }
        h264StartSlice(h, pps, sps, newPic, rbsp)
    }

    // The part of slice handling the reconstructor replays: a new
    // sequence size, a new picture, then the slice itself.
    fn h264StartSlice(_ h: SliceHeader, _ pps: Pps, _ sps: Sps, _ newPic: Bool, _ rbsp: Data) {
        if newPic {
            if !self.haveSps || sps.mbWidth != self.sps.mbWidth || sps.mbHeight != self.sps.mbHeight || sps.chromaFormatIdc != self.sps.chromaFormatIdc {
                // A new sequence size: output what is held, start afresh.
                h264FlushPending()
                while h264Bump() {
                }
                self.dpb = []
                self.pool = []
                self.sps = sps
                h264SetGeometry()
                self.haveSps = true
            }
            if sps.chromaFormatIdc > 1 || sps.bitDepthLuma != 8 || sps.bitDepthChroma != 8 {
                h264Warn("only 8-bit 4:2:0 and 4:0:0 are decoded")
                return
            }
            self.sps = sps
            self.pps = pps
            h264SetDpbSize()
            self.sh = h
            self.picSh = h
            h264StartPicture()
        }
        if newPic {
            self.picHadMb0 = false
        }
        if h.firstMb == 0 {
            self.picHadMb0 = true
        }
        self.pps = pps
        self.sh = h
        h264DecodeSlice(rbsp)
    }

    // Sets up the per-macroblock tables for a new sequence size.
    fn h264SetGeometry() {
        let s = self.sps
        self.mbW = s.mbWidth
        self.mbH = s.mbHeight
        self.numMbs = self.mbW * self.mbH
        self.lumaW = self.mbW * 16
        self.lumaH = self.mbH * 16
        self.hasChroma = s.chromaFormatIdc != 0 && self.doChroma
        self.chromaW = self.lumaW / 2
        self.chromaH = self.lumaH / 2
        let n = self.numMbs
        self.mbTypes = h264Zeros(n)
        self.sliceTab = core.filled(n, -1)
        self.qpTab = h264Zeros(n)
        self.cbpTab = h264Zeros(n)
        self.nzTab = h264Zeros(n * 24)
        self.predTab = h264Zeros(n * 16)
        self.chromaPredTab = h264Zeros(n)
        self.mvdx0 = h264Zeros(n * 16)
        self.mvdy0 = h264Zeros(n * 16)
        self.mvdx1 = h264Zeros(n * 16)
        self.mvdy1 = h264Zeros(n * 16)
        self.directTab = h264Zeros(n * 4)
        self.zeroY = if self.mode == 1 || !self.doLuma { [] } else { h264Zeros(self.lumaW * self.lumaH) }
        self.zeroC = if self.mode == 1 { [] } else { h264Zeros(self.chromaW * self.chromaH) }
        self.zeroMb16 = h264Zeros(n * 16)
        self.zeroMb4 = h264Zeros(n * 4)
    }

    fn h264NewPlane(_ chroma: Bool) -> [Int] {
        if chroma { self.zeroC } else { self.zeroY }
    }

    // Starts decoding a picture: a frame, a first field (a new frame whose
    // other field comes next) or the second field of the frame held in
    // `cur` (7.4.1.2.4, 8.2.1). Sets the plane layout: a field uses every
    // other row of the frame's planes, and its macroblock rows are the
    // even (top) or odd (bottom) rows of the frame-sized tables.
    fn h264StartPicture() {
        let h = self.sh
        let maxFrameNum = 1 << self.sps.log2MaxFrameNum
        let parity = if !h.fieldPic { 3 } else if h.bottomField { 2 } else { 1 }
        var second = false
        if self.pendingField {
            if h.fieldPic && (self.cur.fields & parity) == 0 && self.cur.frameNum == h.frameNum && (!h.isIdr || self.cur.isIdr) {
                second = true
            } else {
                h264FlushPending()
            }
        }
        if !second {
            if h.isIdr {
                self.prevRefFrameNum = 0
                self.recoveryPoint = false
            } else if h.frameNum != self.prevRefFrameNum && h.frameNum != (self.prevRefFrameNum + 1) % maxFrameNum {
                h264FillFrameNumGap()
            }
            var f = Frame()
            if self.pool.count > 0 {
                let old = self.pool.removeLast()
                f.y = old.y
                f.u = old.u
                f.v = old.v
            } else {
                f.y = self.zeroY
                f.u = if self.hasChroma { self.zeroC } else { [] }
                f.v = if self.hasChroma { self.zeroC } else { [] }
            }
            f.mvx0 = self.zeroMb16
            f.mvy0 = self.zeroMb16
            f.mvx1 = self.zeroMb16
            f.mvy1 = self.zeroMb16
            f.ref0 = self.zeroMb4
            f.ref1 = self.zeroMb4
            f.pic0 = self.zeroMb4
            f.pic1 = self.zeroMb4
            f.id = self.nextId
            self.nextId += 1
            f.frameNum = h.frameNum
            f.isIdr = h.isIdr
            f.pts = self.curPts
            f.key = h.isIdr || self.curKey
            f.fields = 0
            f.fieldPicture = h.fieldPic
            f.mbaffFrame = !h.fieldPic && self.sps.mbAff
            self.cur = f
        }
        self.cur.fields = self.cur.fields | parity
        self.curStructure = parity
        self.picFirstSlice = self.sliceNum + 1
        self.sliceDisable = []
        self.sliceSp = []
        self.sliceAlpha = []
        self.sliceBeta = []
        if h.fieldPic {
            let b = if parity == 2 { 1 } else { 0 }
            self.pStride = 2 * self.lumaW
            self.pOff = b * self.lumaW
            self.cStride = 2 * self.chromaW
            self.cOff = b * self.chromaW
            self.picH = self.lumaH / 2
            self.picMbH = self.mbH / 2
            self.rowStep = 2
            self.mbRowOff = b
            self.fieldDecoding = true
            self.fieldFlag = mbInterlaced
            self.mbField = true
            self.mbaffFrame = false
        } else {
            self.mbField = false
            self.mbaffFrame = self.sps.mbAff
            self.pStride = self.lumaW
            self.pOff = 0
            self.cStride = self.chromaW
            self.cOff = 0
            self.picH = self.lumaH
            self.picMbH = self.mbH
            self.rowStep = 1
            self.mbRowOff = 0
            self.fieldDecoding = false
            self.fieldFlag = 0
        }
        self.dropOutput = false
        h264ComputePoc()
        self.havePic = true
        if self.debugTrace {
            var d = ""
            for f in self.dpb {
                d += " [fn {f.frameNum} poc {f.poc} s {f.shortRef} l {f.longRef} out {f.outputNeeded}]"
            }
            print("pic {self.frames} fn {h.frameNum} st {parity} ref {h.nalRefIdc} type {h.sliceType} poc {self.cur.poc} dpb{d}")
        }
    }

    // Stores a first field whose second field never came.
    fn h264FlushPending() {
        if self.pendingField {
            self.pendingField = false
            h264StoreFrame()
        }
    }

    // Finishes the picture being decoded: conceals what no slice covered,
    // deblocks, marks references (8.2.5) and, once a frame is complete,
    // stores it in the DPB.
    fn h264FinishPicture() {
        if !self.havePic {
            return
        }
        if self.mode == 1 {
            self.pOps.append(3)
            h264Snapshot()
        } else if self.mode == 2 && !self.rInstalled {
            h264Install()
        }
        h264FinishPictureBody()
        if self.mode == 1 {
            h264EmitRecord(true)
        }
    }

    // End of stream: the first field still held, then every picture
    // waiting for output.
    fn h264Flush() {
        h264FinishPicture()
        if self.mode == 1 {
            self.pOps.append(4)
        }
        h264FlushPending()
        while h264Bump() {
        }
        if self.mode == 1 {
            h264EmitRecord(false)
        }
    }

    // After a seek: no references, nothing held, wait for a key picture.
    fn h264Reset() {
        self.havePic = false
        self.pendingField = false
        self.dpb = []
        self.out = []
        self.waitKey = true
        self.skipRun = -1
        self.prevRefFrameNum = 0
        self.prevFrameNum = 0
        self.prevFrameNumOffset = 0
        self.prevPocMsb = 0
        self.prevPocLsb = 0
        self.pOps = []
        self.pHeaders = []
        self.pPps = []
        self.pSps = []
        self.pRec = []
        self.pCoef = []
        self.pCoefMb = 0
        self.pSnap = ParsedPicture()
        self.pDone = []
    }

    // Parse mode: the tables of the picture being finished, as
    // reconstruction needs them (before concealment, which both sides do).
    fn h264Snapshot() {
        var r = ParsedPicture()
        r.hasPicture = true
        r.mbTypes = self.mbTypes
        r.qpTab = self.qpTab
        r.cbpTab = self.cbpTab
        r.nzTab = self.nzTab
        r.mvx0 = self.cur.mvx0
        r.mvy0 = self.cur.mvy0
        r.mvx1 = self.cur.mvx1
        r.mvy1 = self.cur.mvy1
        r.ref0 = self.cur.ref0
        r.ref1 = self.cur.ref1
        r.pic0 = self.cur.pic0
        r.pic1 = self.cur.pic1
        self.pSnap = r
    }

    // Parse mode: hands the operations since the last record (and the
    // picture snapshot when one was finished) to pDone.
    fn h264EmitRecord(_ picture: Bool) {
        var r = if picture { self.pSnap } else { ParsedPicture() }
        if !picture && self.pOps.isEmpty {
            return
        }
        r.ops = self.pOps
        r.headers = self.pHeaders
        r.ppss = self.pPps
        r.spss = self.pSps
        r.rec = self.pRec
        r.coefs = self.pCoef
        if picture {
            r.bsTab = self.pBs
        }
        self.pBs = []
        self.pDone.append(r)
        self.pSnap = ParsedPicture()
        self.pOps = []
        self.pHeaders = []
        self.pPps = []
        self.pSps = []
        self.pRec = []
        self.pCoef = []
        self.pCoefMb = 0
    }

    // Reconstruct mode: the parsed picture's tables become the current
    // ones.
    fn h264Install() {
        self.rInstalled = true
        if !self.rp.hasPicture {
            return
        }
        self.mbTypes = self.rp.mbTypes
        self.qpTab = self.rp.qpTab
        self.cbpTab = self.rp.cbpTab
        self.nzTab = self.rp.nzTab
        self.cur.mvx0 = self.rp.mvx0
        self.cur.mvy0 = self.rp.mvy0
        self.cur.mvx1 = self.rp.mvx1
        self.cur.mvy1 = self.rp.mvy1
        self.cur.ref0 = self.rp.ref0
        self.cur.ref1 = self.rp.ref1
        self.cur.pic0 = self.rp.pic0
        self.cur.pic1 = self.rp.pic1
    }

    // Reconstruct mode: replays the operations of one parsed picture.
    fn h264Replay(_ r: ParsedPicture) {
        self.rp = r
        self.rRec = 0
        self.rCoef = 0
        self.rInstalled = false
        let ops = r.ops
        var i = 0
        while i < ops.count {
            let op = ops[i]
            if op == 1 {
                self.curPts = ops[i + 1]
                self.curKey = ops[i + 2] == 1
                i += 3
            } else if op == 2 {
                // The parser's slice count (they differ after a reset that
                // dropped records still in flight).
                self.sliceNum = ops[i + 1]
                let k = ops[i + 2]
                self.rSliceMbs = ops[i + 4]
                h264StartSlice(r.headers[k], r.ppss[k], r.spss[k], ops[i + 3] == 1, Data())
                i += 5
            } else if op == 3 {
                h264FinishPicture()
                i += 1
            } else if op == 4 {
                h264FlushPending()
                while h264Bump() {
                }
                i += 1
            } else {
                break
            }
        }
        self.rp = ParsedPicture()
    }

    fn h264FinishPictureBody() {
        self.havePic = false
        if self.mbaffFrame {
            self.pStride = self.lumaW
            self.cStride = self.chromaW
            self.picH = self.lumaH
        }
        h264Conceal()
        let t0 = if self.timing { now() } else { 0.0 }
        if self.debugNoDeblock == false {
            // Edges in SP slices filter as intra ones (8.7.2.1).
            var saved: [Int] = []
            var anySp = false
            for v in self.sliceSp {
                if v != 0 {
                    anySp = true
                }
            }
            if anySp {
                saved = self.mbTypes
                for m in 0..self.numMbs {
                    let sl = self.sliceTab[m] - self.picFirstSlice
                    if self.sliceTab[m] >= 0 && sl >= 0 && sl < self.sliceSp.count && self.sliceSp[sl] != 0 {
                        self.mbTypes[m] = self.mbTypes[m] | mbIntra4x4
                    }
                }
            }
            h264DeblockPicture()
            if anySp {
                self.mbTypes = saved
            }
        }
        if self.timing {
            self.tDeblock += now() - t0
        }
        self.cur.mbType = self.mbTypes
        let h = self.picSh
        if h.nalRefIdc != 0 {
            h264MarkReferences()
        }
        let mmco5 = self.cur.mmco5
        let st = self.curStructure
        if mmco5 {
            // After memory_management_control_operation 5 the picture's
            // order counts are relative to itself (8.2.1).
            if st == 3 {
                let t = min(self.cur.topPoc, self.cur.botPoc)
                self.cur.topPoc -= t
                self.cur.botPoc -= t
            } else if st == 1 {
                self.cur.topPoc = 0
            } else {
                self.cur.botPoc = 0
            }
            self.cur.poc = h264FramePoc()
            self.cur.frameNum = 0
        }
        if h.nalRefIdc != 0 {
            self.prevPocMsb = if mmco5 { 0 } else { self.pocMsb }
            if mmco5 {
                self.prevPocLsb = if st == 2 { 0 } else { self.cur.topPoc }
            } else {
                self.prevPocLsb = h.pocLsb
            }
            self.prevRefFrameNum = if mmco5 { 0 } else { h.frameNum }
        }
        self.prevFrameNumOffset = if mmco5 { 0 } else { self.frameNumOffset }
        self.prevFrameNum = if mmco5 { 0 } else { h.frameNum }
        self.frames += 1
        if st != 3 && self.cur.fields != 3 {
            // A first field: wait for the second one.
            self.pendingField = true
            return
        }
        self.pendingField = false
        h264StoreFrame()
    }

    // PicOrderCnt of the current frame from the fields decoded so far.
    fn h264FramePoc() -> Int {
        let f = self.cur.fields
        if f == 3 {
            return min(self.cur.topPoc, self.cur.botPoc)
        }
        if f == 1 { self.cur.topPoc } else { self.cur.botPoc }
    }

    // Frame number gaps (8.2.5.2): "non-existing" frames take the missing
    // frame numbers through sliding window marking; their samples copy the
    // latest reference (they are never shown).
    fn h264FillFrameNumGap() {
        let maxFrameNum = 1 << self.sps.log2MaxFrameNum
        var unwrapped = self.prevRefFrameNum
        if unwrapped > self.sh.frameNum {
            unwrapped -= maxFrameNum
        }
        if self.sh.frameNum - unwrapped > self.sps.maxNumRefFrames + 1 {
            unwrapped = self.sh.frameNum - self.sps.maxNumRefFrames - 1
        }
        var fnum = (unwrapped + 1 + maxFrameNum) % maxFrameNum
        let save = self.sh
        var guard = 0
        while fnum != save.frameNum && guard < 32 {
            guard += 1
            var src = -1
            for i in 0..self.dpb.count {
                if self.dpb[i].shortRef != 0 && (src < 0 || self.dpb[i].id > self.dpb[src].id) {
                    src = i
                }
            }
            var f = Frame()
            if src >= 0 {
                f = self.dpb[src]
                f.poc = f.poc + 2
                f.topPoc = f.poc
                f.botPoc = f.poc
            } else {
                f.y = self.zeroY
                f.u = self.zeroC
                f.v = self.zeroC
                f.mbType = self.zeroMb4
                f.mvx0 = self.zeroMb16
                f.mvy0 = self.zeroMb16
                f.mvx1 = self.zeroMb16
                f.mvy1 = self.zeroMb16
                f.ref0 = self.zeroMb4
                f.ref1 = self.zeroMb4
                f.pic0 = self.zeroMb4
                f.pic1 = self.zeroMb4
            }
            f.id = self.nextId
            self.nextId += 1
            f.frameNum = fnum
            f.shortRef = 0
            f.longRef = 0
            f.nonExisting = true
            f.outputNeeded = false
            f.isIdr = false
            f.mmco5 = false
            var gsh = save
            gsh.frameNum = fnum
            self.sh = gsh
            h264SlidingWindow()
            f.shortRef = 3
            self.cur = f
            h264StoreFrame()
            self.prevRefFrameNum = fnum
            self.prevFrameNum = fnum
            fnum = (fnum + 1) % maxFrameNum
        }
        self.sh = save
    }

    // The macroblock to slice group map (8.2.2) of the current picture for
    // its total macroblock addresses, from the map unit map of the map type
    // (8.2.2.1 to 8.2.2.7) and the frame/field structure (8.2.2.8).
    fn h264SliceGroupMap(_ total: Int) {
        let p = self.pps
        let w = self.sps.mbWidth
        let hMap = if self.sps.frameMbsOnly { self.sps.mbHeight } else { self.sps.mbHeight / 2 }
        let size = w * hMap
        let num = p.numSliceGroups
        var mu: [Int] = h264Zeros(size)
        let t = p.sliceGroupMapType
        let dir = p.changeDirection
        let inGroup0 = min(self.sh.sliceGroupChangeCycle * p.changeRate, size)
        if t == 0 {
            // Interleaved (8.2.2.1).
            var i = 0
            while i < size {
                var g = 0
                while g < num && i < size {
                    var j = 0
                    while j < p.runLength[g] && i + j < size {
                        mu[i + j] = g
                        j += 1
                    }
                    i += p.runLength[g]
                    g += 1
                }
            }
        } else if t == 1 {
            // Dispersed (8.2.2.2).
            for i in 0..size {
                mu[i] = ((i % w) + (((i / w) * num) / 2)) % num
            }
        } else if t == 2 {
            // Foreground with left-over (8.2.2.3).
            for i in 0..size {
                mu[i] = num - 1
            }
            var g = num - 2
            while g >= 0 {
                let tl = p.topLeft[g]
                let br = p.bottomRight[g]
                var y = tl / w
                while y <= br / w {
                    var x = tl % w
                    while x <= br % w {
                        if y * w + x < size {
                            mu[y * w + x] = g
                        }
                        x += 1
                    }
                    y += 1
                }
                g -= 1
            }
        } else if t == 3 {
            // Box-out (8.2.2.4).
            for i in 0..size {
                mu[i] = 1
            }
            var x = (w - dir) / 2
            var y = (hMap - dir) / 2
            var left = x
            var top = y
            var right = x
            var bottom = y
            var xDir = dir - 1
            var yDir = dir
            var k = 0
            var guard = 0
            while k < inGroup0 && guard < 4 * size + 16 {
                guard += 1
                let vacant = mu[y * w + x] == 1
                if vacant {
                    mu[y * w + x] = 0
                }
                if xDir == -1 && x == left {
                    left = max(left - 1, 0)
                    x = left
                    xDir = 0
                    yDir = 2 * dir - 1
                } else if xDir == 1 && x == right {
                    right = min(right + 1, w - 1)
                    x = right
                    xDir = 0
                    yDir = 1 - 2 * dir
                } else if yDir == -1 && y == top {
                    top = max(top - 1, 0)
                    y = top
                    xDir = 1 - 2 * dir
                    yDir = 0
                } else if yDir == 1 && y == bottom {
                    bottom = min(bottom + 1, hMap - 1)
                    y = bottom
                    xDir = 2 * dir - 1
                    yDir = 0
                } else {
                    x += xDir
                    y += yDir
                }
                if vacant {
                    k += 1
                }
            }
        } else if t == 4 {
            // Raster scan (8.2.2.5).
            let upperLeft = if dir == 1 { size - inGroup0 } else { inGroup0 }
            for i in 0..size {
                mu[i] = if i < upperLeft { dir } else { 1 - dir }
            }
        } else if t == 5 {
            // Wipe (8.2.2.6).
            let upperLeft = if dir == 1 { size - inGroup0 } else { inGroup0 }
            var k = 0
            for j in 0..w {
                for i in 0..hMap {
                    mu[i * w + j] = if k < upperLeft { dir } else { 1 - dir }
                    k += 1
                }
            }
        } else {
            // Explicit (8.2.2.7).
            for i in 0..min(size, p.sliceGroupId.count) {
                mu[i] = p.sliceGroupId[i]
            }
        }
        var m: [Int] = h264Zeros(total)
        let field = self.curStructure != 3
        for i in 0..total {
            var u = i
            if self.sps.frameMbsOnly || field {
                u = i
            } else if self.mbaffFrame {
                u = i / 2
            } else {
                u = (i / (2 * w)) * w + i % w
            }
            m[i] = if u < size { mu[u] } else { 0 }
        }
        self.sgMap = m
    }

    fn h264DecodeSlice(_ rbsp: Data) {
        let h = self.sh
        var st = h.sliceType
        self.spSlice = st == sliceSP
        self.qsY = max(0, min(51, self.pps.picInitQs + h.sliceQsDelta))
        if st == sliceSP {
            // Parsed as P; reconstruction follows 8.6.1 (h264SpResidual).
            st = sliceP
            if h.spForSwitch {
                h264Warn("switching SP slices are decoded as primary SP slices")
            }
        } else if st == sliceSI {
            st = sliceI
            h264Warn("SI slices are decoded as I slices")
        }
        self.sliceType = st
        self.sliceNum += 1
        self.sliceDisable.append(h.disableDeblock)
        self.sliceSp.append(if self.spSlice { 1 } else { 0 })
        self.sliceAlpha.append(h.alphaOffset)
        self.sliceBeta.append(h.betaOffset)
        self.qp = self.pps.picInitQp + h.sliceQpDelta
        h264SetChromaQp()
        self.listCount = if st == sliceB { 2 } else if st == sliceP { 1 } else { 0 }
        self.refCount0 = if st == sliceI { 0 } else { h.numRefIdx0 }
        self.refCount1 = if st == sliceB { h.numRefIdx1 } else { 0 }
        if st != sliceI {
            if !h264BuildRefLists() || self.list0[0] == -1 || (st == sliceB && self.list1[0] == -1) {
                h264Warn("missing reference pictures")
                return
            }
        }
        h264SetupWeights()
        if self.mode == 2 {
            h264ReconSlice()
            return
        }
        h264SetupDirect()
        self.rbsp = rbsp
        self.skipRun = -1
        self.lastQpDelta = 0
        self.prevMbSkipped = false
        let cabac = self.pps.cabac
        var stopBit = 0
        if cabac {
            let at = (h.dataBit + 7) / 8
            self.cab.start(rbsp, at: at, end: rbsp.count)
            self.cab.initContexts(sliceQp: self.qp, isIntra: st == sliceI, initIdc: h.cabacInitIdc)
        } else {
            self.br = core.bitReader(rbsp)
            self.br.seek(toBit: h.dataBit)
            var last = rbsp.count - 1
            while last >= 0 && rbsp[last] == 0 {
                last -= 1
            }
            if last >= 0 {
                let b = rbsp[last]
                var low = 0
                while (b >> low) & 1 == 0 {
                    low += 1
                }
                stopBit = last * 8 + 7 - low
            }
        }
        let total = self.mbW * self.picMbH
        let mbaff = self.mbaffFrame
        let firstAddr = if mbaff { 2 * h.firstMb } else { h.firstMb }
        let fmo = self.pps.numSliceGroups > 1
        if fmo {
            h264SliceGroupMap(total)
        }
        var addr = firstAddr
        self.pairField = false
        let ts = if self.timing { now() } else { 0.0 }
        while addr < total {
            if mbaff {
                // Macroblock pairs: top then bottom (7.3.4).
                let pair = addr >> 1
                self.mbX = pair % self.mbW
                self.mbY = 2 * (pair / self.mbW) + (addr & 1)
                self.mbXY = self.mbX + self.mbY * self.mbW
                if (addr & 1) == 0 && self.mbX == 0 && addr != firstAddr {
                    // Inferred from the pair above until decoded (7.4.4).
                    let a = self.mbXY - self.mbW
                    self.pairField = h264Avail(a) && (self.mbTypes[a] & mbInterlaced) != 0
                }
            } else {
                self.mbX = addr % self.mbW
                self.mbY = addr / self.mbW
                self.mbXY = self.mbX + (self.mbY * self.rowStep + self.mbRowOff) * self.mbW
            }
            h264SetMbAt()
            if self.debugTrace {
                for i in 0..384 {
                    if self.coef[i] != 0 {
                        print("stale coef at {i} before frame {self.frames} mb {self.mbXY}")
                        self.coef[i] = 0
                    }
                }
            }
            self.pCoefMb = self.pCoef.count
            let ok = if cabac { h264CabacMacroblock() } else { h264CavlcMacroblock() }
            if !ok {
                while self.pCoef.count > self.pCoefMb {
                    self.pCoef.removeLast()
                }
                h264Warn("damaged macroblock data")
                self.sliceTab[self.mbXY] = -1
                for i in 0..384 {
                    self.coef[i] = 0
                }
                for i in 0..16 {
                    self.dcY[i] = 0
                }
                for i in 0..8 {
                    self.dcC[i] = 0
                }
                break
            }
            if fmo {
                // NextMbAddress (8.2.2): the next one of the same slice group.
                let g = self.sgMap[addr]
                addr += 1
                while addr < total && self.sgMap[addr] != g {
                    addr += 1
                }
            } else {
                addr += 1
            }
            if cabac {
                // end_of_slice_flag follows each macroblock, but only the
                // bottom one of an MBAFF pair (7.3.4).
                if mbaff && (addr & 1) == 1 {
                    continue
                }
                if self.cab.terminate() == 1 {
                    break
                }
                if self.cab.overrun {
                    h264Warn("slice data ran out")
                    break
                }
            } else {
                if self.br.position >= stopBit && self.skipRun <= 0 {
                    break
                }
            }
        }
        if self.timing {
            self.tSlice += now() - ts
        }
    }

    // Copies macroblocks no slice covered from the most recent frame (or
    // leaves them grey).
    fn h264Conceal() {
        var src = -1
        for i in 0..self.dpb.count {
            if !self.dpb[i].nonExisting && (src < 0 || self.dpb[i].id > self.dpb[src].id) {
                src = i
            }
        }
        var missing = 0
        for fm in 0..(self.mbW * self.picMbH) {
            let mx = fm % self.mbW
            let my = fm / self.mbW
            let m = mx + (my * self.rowStep + self.mbRowOff) * self.mbW
            if self.sliceTab[m] >= self.picFirstSlice {
                continue
            }
            missing += 1
            if self.mode == 1 {
                self.mbTypes[m] = mbIntra4x4
                for i in 0..4 {
                    self.cur.ref0[m * 4 + i] = -1
                    self.cur.ref1[m * 4 + i] = -1
                    self.cur.pic0[m * 4 + i] = -1
                    self.cur.pic1[m * 4 + i] = -1
                }
                continue
            }
            let at = self.pOff + my * 16 * self.pStride + mx * 16
            let cat = self.cOff + my * 8 * self.cStride + mx * 8
            for y in 0..(if self.doLuma { 16 } else { 0 }) {
                for x in 0..16 {
                    self.cur.y[at + y * self.pStride + x] = if src >= 0 { self.dpb[src].y[at + y * self.pStride + x] } else { 128 }
                }
            }
            if self.hasChroma {
                for y in 0..8 {
                    for x in 0..8 {
                        self.cur.u[cat + y * self.cStride + x] = if src >= 0 { self.dpb[src].u[cat + y * self.cStride + x] } else { 128 }
                        self.cur.v[cat + y * self.cStride + x] = if src >= 0 { self.dpb[src].v[cat + y * self.cStride + x] } else { 128 }
                    }
                }
            }
            self.mbTypes[m] = mbIntra4x4
            for i in 0..4 {
                self.cur.ref0[m * 4 + i] = -1
                self.cur.ref1[m * 4 + i] = -1
                self.cur.pic0[m * 4 + i] = -1
                self.cur.pic1[m * 4 + i] = -1
            }
        }
        if missing > 0 {
            h264Warn("{missing} macroblocks missing, concealed")
        }
    }

    fn h264Warn(_ s: String) {
        // The reconstructor replays the parser's decisions: only its own
        // findings (in macroblock reconstruction) are new.
        if self.mode == 2 && !self.reconWarn {
            return
        }
        if self.warnings.count < 64 {
            self.warnings.append(s)
        }
    }

    // ----------------------------------------------------------------------
    // Picture order count, reference lists, marking and the DPB (8.2.1, 8.2.4, 8.2.5, C.4.5.3)
    // ----------------------------------------------------------------------

    // Picture order count of the current picture (8.2.1.1 - 8.2.1.3).
    fn h264ComputePoc() {
        let h = self.sh
        let s = self.sps
        let maxFrameNum = 1 << s.log2MaxFrameNum
        if h.isIdr {
            self.frameNumOffset = 0
        } else if self.prevFrameNum > h.frameNum {
            self.frameNumOffset = self.prevFrameNumOffset + maxFrameNum
        } else {
            self.frameNumOffset = self.prevFrameNumOffset
        }
        var top = 0
        var bot = 0
        if s.pocType == 0 {
            if h.isIdr {
                self.prevPocMsb = 0
                self.prevPocLsb = 0
            }
            let maxLsb = 1 << s.log2MaxPocLsb
            var msb = self.prevPocMsb
            if h.pocLsb < self.prevPocLsb && self.prevPocLsb - h.pocLsb >= maxLsb / 2 {
                msb = self.prevPocMsb + maxLsb
            } else if h.pocLsb > self.prevPocLsb && h.pocLsb - self.prevPocLsb > maxLsb / 2 {
                msb = self.prevPocMsb - maxLsb
            }
            self.pocMsb = msb
            if !h.fieldPic {
                top = msb + h.pocLsb
                bot = top + h.deltaPocBottom
            } else {
                top = msb + h.pocLsb
                bot = top
            }
        } else if s.pocType == 1 {
            let n = s.offsetForRefFrame.count
            var abs = if n != 0 { self.frameNumOffset + h.frameNum } else { 0 }
            if h.nalRefIdc == 0 && abs > 0 {
                abs -= 1
            }
            var expected = 0
            if abs > 0 {
                var delta = 0
                for v in s.offsetForRefFrame {
                    delta += v
                }
                let cycles = (abs - 1) / n
                let inCycle = (abs - 1) % n
                expected = cycles * delta
                for i in 0..(inCycle + 1) {
                    expected += s.offsetForRefFrame[i]
                }
            }
            if h.nalRefIdc == 0 {
                expected += s.offsetForNonRefPic
            }
            if !h.fieldPic {
                top = expected + h.deltaPoc0
                bot = top + s.offsetForTopToBottomField + h.deltaPoc1
            } else if !h.bottomField {
                top = expected + h.deltaPoc0
                bot = top
            } else {
                top = expected + s.offsetForTopToBottomField + h.deltaPoc0
                bot = top
            }
        } else {
            var t = 0
            if !h.isIdr {
                t = 2 * (self.frameNumOffset + h.frameNum)
                if h.nalRefIdc == 0 {
                    t -= 1
                }
            }
            top = t
            bot = t
        }
        if !h.fieldPic {
            self.cur.topPoc = top
            self.cur.botPoc = bot
            self.cur.poc = min(top, bot)
        } else if !h.bottomField {
            self.cur.topPoc = top
            self.curFieldPoc = top
            self.cur.poc = if (self.cur.fields & 2) != 0 { min(top, self.cur.botPoc) } else { top }
        } else {
            self.cur.botPoc = bot
            self.curFieldPoc = bot
            self.cur.poc = if (self.cur.fields & 1) != 0 { min(self.cur.topPoc, bot) } else { bot }
        }
    }

    // The POC of the current picture (frame or field) for list building.
    fn h264CurPoc() -> Int {
        if self.curStructure == 3 { self.cur.poc } else { self.curFieldPoc }
    }

    // Reference frame data by DPB position, where -2 stands for the frame
    // being decoded (whose first field the second field may use).
    fn h264FrShort(_ k: Int) -> Int {
        if k == -2 { self.cur.shortRef } else { self.dpb[k].shortRef }
    }

    fn h264FrLong(_ k: Int) -> Int {
        if k == -2 { self.cur.longRef } else { self.dpb[k].longRef }
    }

    fn h264FrWrap(_ k: Int) -> Int {
        let maxFrameNum = 1 << self.sps.log2MaxFrameNum
        let f = if k == -2 { self.cur.frameNum } else { self.dpb[k].frameNum }
        if f > self.sh.frameNum { f - maxFrameNum } else { f }
    }

    fn h264FrLtIdx(_ k: Int) -> Int {
        if k == -2 { self.cur.longTermFrameIdx } else { self.dpb[k].longTermFrameIdx }
    }

    // PicOrderCnt of a frame entry (or of one of its fields).
    fn h264FrPoc(_ k: Int, _ parity: Int) -> Int {
        if k == -2 {
            if parity == 1 { return self.cur.topPoc }
            if parity == 2 { return self.cur.botPoc }
            return h264FramePoc()
        }
        if parity == 1 { return self.dpb[k].topPoc }
        if parity == 2 { return self.dpb[k].botPoc }
        self.dpb[k].poc
    }

    fn h264FrId(_ k: Int) -> Int {
        if k == -2 { self.cur.id } else { self.dpb[k].id }
    }

    // Reference lists of the current slice (8.2.4.2). Entries are coded
    // (k + 2) * 4 + structure with k the DPB position (-2 the current
    // frame) and structure 1 top field, 2 bottom field, 3 frame.
    fn h264BuildRefLists() -> Bool {
        let field = self.curStructure != 3
        let par = self.curStructure
        // Frames holding short-term / long-term references (the current
        // frame too when its first field is one, for the second field).
        var shorts: [Int] = []
        var longs: [Int] = []
        let n = self.dpb.count
        for k in -2..n {
            if k == -1 || (k == -2 && (!field || self.cur.fields == par)) {
                continue
            }
            let sr = h264FrShort(k)
            let lr = h264FrLong(k)
            if field {
                if sr != 0 {
                    shorts.append(k)
                } else if lr != 0 {
                    longs.append(k)
                }
            } else {
                if sr == 3 {
                    shorts.append(k)
                } else if lr == 3 {
                    longs.append(k)
                }
            }
        }
        longs = h264SortBy(longs, 2, true)
        var init0: [Int] = []
        var init1: [Int] = []
        if self.sliceType == sliceB {
            let poc = h264CurPoc()
            var before: [Int] = []
            var after: [Int] = []
            for k in shorts {
                let p = h264FrPoc(k, 3)
                if p < poc || (field && p == poc) {
                    before.append(k)
                } else {
                    after.append(k)
                }
            }
            before = h264SortBy(before, 1, false)
            after = h264SortBy(after, 1, true)
            if field {
                init0 = h264AlternateFields(before + after, par, false) + h264AlternateFields(longs, par, true)
                init1 = h264AlternateFields(after + before, par, false) + h264AlternateFields(longs, par, true)
            } else {
                init0 = h264FrameEntries(before + after + longs)
                init1 = h264FrameEntries(after + before + longs)
            }
            if init1.count > 1 && init0 == init1 {
                let t = init1[0]
                init1[0] = init1[1]
                init1[1] = t
            }
        } else {
            let s = h264SortBy(shorts, 0, false)
            if field {
                init0 = h264AlternateFields(s, par, false) + h264AlternateFields(longs, par, true)
            } else {
                init0 = h264FrameEntries(s + longs)
            }
        }
        if !h264ModifyList(init0, 0) {
            return false
        }
        if self.sliceType == sliceB {
            if !h264ModifyList(init1, 1) {
                return false
            }
        }
        true
    }

    fn h264FrameEntries(_ ks: [Int]) -> [Int] {
        var out: [Int] = []
        for k in ks {
            out.append((k + 2) * 4 + 3)
        }
        out
    }

    // Sorts frame positions by FrameNumWrap (key 0), PicOrderCnt (1) or
    // LongTermFrameIdx (2), ascending or descending (insertion sort; the
    // lists are short).
    fn h264SortBy(_ ks: [Int], _ key: Int, _ ascending: Bool) -> [Int] {
        var a = ks
        var vals: [Int] = []
        for k in a {
            if key == 0 {
                vals.append(h264FrWrap(k))
            } else if key == 1 {
                vals.append(h264FrPoc(k, 3))
            } else {
                vals.append(h264FrLtIdx(k))
            }
        }
        var i = 1
        while i < a.count {
            var j = i
            while j > 0 && (if ascending { vals[j - 1] > vals[j] } else { vals[j - 1] < vals[j] }) {
                let t = a[j]
                a[j] = a[j - 1]
                a[j - 1] = t
                let tv = vals[j]
                vals[j] = vals[j - 1]
                vals[j - 1] = tv
                j -= 1
            }
            i += 1
        }
        a
    }

    // Fields from an ordered list of frames, alternating parity starting
    // with the current one, skipping frames whose field of the wanted
    // parity is not a reference of that kind (8.2.4.2.5).
    fn h264AlternateFields(_ ks: [Int], _ par: Int, _ long: Bool) -> [Int] {
        var out: [Int] = []
        let opp = 3 - par
        var i0 = 0
        var i1 = 0
        let n = ks.count
        while i0 < n || i1 < n {
            while i0 < n && ((if long { h264FrLong(ks[i0]) } else { h264FrShort(ks[i0]) }) & par) == 0 {
                i0 += 1
            }
            if i0 < n {
                out.append((ks[i0] + 2) * 4 + par)
                i0 += 1
            }
            while i1 < n && ((if long { h264FrLong(ks[i1]) } else { h264FrShort(ks[i1]) }) & opp) == 0 {
                i1 += 1
            }
            if i1 < n {
                out.append((ks[i1] + 2) * 4 + opp)
                i1 += 1
            }
        }
        out
    }

    // Applies ref_pic_list_modification (8.2.4.3) to an initial list and
    // stores the result (num_ref_idx_active entries) in list0 / list1.
    fn h264ModifyList(_ initial: [Int], _ list: Int) -> Bool {
        let n = if list == 0 { self.refCount0 } else { self.refCount1 }
        var l: [Int] = []
        for i in 0..(n + 1) {
            l.append(if i < initial.count { initial[i] } else { -1 })
        }
        let mods = if list == 0 { self.sh.mods0 } else { self.sh.mods1 }
        let field = self.curStructure != 3
        let maxPicNum = if field { 2 << self.sps.log2MaxFrameNum } else { 1 << self.sps.log2MaxFrameNum }
        let currPicNum = if field { 2 * self.sh.frameNum + 1 } else { self.sh.frameNum }
        var pred = currPicNum
        var refIdx = 0
        var k = 0
        while k + 1 < mods.count && refIdx < n {
            let idc = mods[k]
            let v = mods[k + 1]
            k += 2
            var ent = -1
            if idc == 0 || idc == 1 {
                let absDiff = v + 1
                var noWrap = 0
                if idc == 0 {
                    noWrap = pred - absDiff
                    if noWrap < 0 {
                        noWrap += maxPicNum
                    }
                } else {
                    noWrap = pred + absDiff
                    if noWrap >= maxPicNum {
                        noWrap -= maxPicNum
                    }
                }
                pred = noWrap
                let picNum = if noWrap > currPicNum { noWrap - maxPicNum } else { noWrap }
                ent = h264FindByPicNum(picNum, false)
            } else if idc == 2 {
                ent = h264FindByPicNum(v, true)
            } else {
                return false
            }
            if ent < 0 {
                h264Warn("reference picture missing in list modification")
                if l[0] < 0 {
                    continue
                }
                ent = l[0]
            }
            var c = n
            while c > refIdx {
                l[c] = l[c - 1]
                c -= 1
            }
            l[refIdx] = ent
            refIdx += 1
            var nIdx = refIdx
            for ci in refIdx..(n + 1) {
                if l[ci] != ent {
                    l[nIdx] = l[ci]
                    nIdx += 1
                }
            }
        }
        // Missing entries take the first one (as concealment).
        for i in 0..n {
            if l[i] < 0 {
                l[i] = l[0]
            }
        }
        for i in 0..n {
            let ent = l[i]
            var kk = -1
            var par = 3
            var id = -1
            var poc = 0
            var isL = false
            if ent >= 0 {
                kk = ent / 4 - 2
                par = ent & 3
                id = h264FrId(kk) * 4 + par
                poc = h264FrPoc(kk, par)
                isL = (h264FrLong(kk) & par) != 0
            }
            if list == 0 {
                self.list0[i] = kk
                self.listPar0[i] = par
                self.listId0[i] = id
                self.listPoc0[i] = poc
                self.listLong0[i] = isL
            } else {
                self.list1[i] = kk
                self.listPar1[i] = par
                self.listId1[i] = id
                self.listPoc1[i] = poc
                self.listLong1[i] = isL
            }
        }
        true
    }

    // The list entry whose PicNum (or LongTermPicNum when long) is picNum
    // (8.2.4.1): for fields 2 * FrameNumWrap + 1 for the current parity
    // and 2 * FrameNumWrap for the other one. -1 when none.
    fn h264FindByPicNum(_ picNum: Int, _ long: Bool) -> Int {
        let par = self.curStructure
        let field = par != 3
        for k in -2..self.dpb.count {
            if k == -1 || (k == -2 && (!field || self.cur.fields == par)) {
                continue
            }
            let marks = if long { h264FrLong(k) } else { h264FrShort(k) }
            let base = if long { h264FrLtIdx(k) } else { h264FrWrap(k) }
            if !field {
                if marks == 3 && base == picNum {
                    return (k + 2) * 4 + 3
                }
            } else {
                for p in 1..3 {
                    if (marks & p) != 0 && 2 * base + (if p == par { 1 } else { 0 }) == picNum {
                        return (k + 2) * 4 + p
                    }
                }
            }
        }
        -1
    }

    // Decoded reference picture marking (8.2.5) for the current frame or
    // field.
    fn h264MarkReferences() {
        let h = self.picSh
        let pb = self.curStructure
        let field = pb != 3
        if h.isIdr {
            for i in 0..self.dpb.count {
                self.dpb[i].shortRef = 0
                self.dpb[i].longRef = 0
            }
            if h.longTermReference {
                self.cur.longRef = self.cur.longRef | pb
                self.cur.longTermFrameIdx = 0
                self.maxLongTermFrameIdx = 0
            } else {
                self.cur.shortRef = self.cur.shortRef | pb
                self.maxLongTermFrameIdx = -1
            }
            return
        }
        var currentLong = false
        let currPicNum = if field { 2 * h.frameNum + 1 } else { h.frameNum }
        if h.adaptiveMarking {
            var k = 0
            while k + 2 < h.mmco.count {
                let op = h.mmco[k]
                let a = h.mmco[k + 1]
                let b = h.mmco[k + 2]
                k += 3
                if op == 1 || op == 3 {
                    let ent = h264FindByPicNum(currPicNum - (a + 1), false)
                    if ent < 0 {
                        h264Warn("MMCO refers to a missing picture")
                        continue
                    }
                    let tk = ent / 4 - 2
                    let tp = ent & 3
                    if op == 1 {
                        h264SetMarks(tk, h264FrShort(tk) & ~tp, h264FrLong(tk))
                    } else {
                        // Another frame using this LongTermFrameIdx loses it.
                        for i in 0..self.dpb.count {
                            if i != tk && self.dpb[i].longRef != 0 && self.dpb[i].longTermFrameIdx == b {
                                self.dpb[i].longRef = 0
                            }
                        }
                        if tk != -2 && field && self.cur.longRef != 0 && self.cur.longTermFrameIdx == b {
                            self.cur.longRef = 0
                        }
                        if h264FrLong(tk) != 0 && h264FrLtIdx(tk) != b {
                            h264SetMarks(tk, h264FrShort(tk), 0)
                        }
                        h264SetMarks(tk, h264FrShort(tk) & ~tp, h264FrLong(tk) | tp)
                        h264SetLtIdx(tk, b)
                    }
                } else if op == 2 {
                    let ent = h264FindByPicNum(a, true)
                    if ent >= 0 {
                        let tk = ent / 4 - 2
                        h264SetMarks(tk, h264FrShort(tk), h264FrLong(tk) & ~(ent & 3))
                    }
                } else if op == 4 {
                    self.maxLongTermFrameIdx = b - 1
                    for i in 0..self.dpb.count {
                        if self.dpb[i].longRef != 0 && self.dpb[i].longTermFrameIdx > self.maxLongTermFrameIdx {
                            self.dpb[i].longRef = 0
                        }
                    }
                    if field && self.cur.longRef != 0 && self.cur.longTermFrameIdx > self.maxLongTermFrameIdx {
                        self.cur.longRef = 0
                    }
                } else if op == 5 {
                    for i in 0..self.dpb.count {
                        self.dpb[i].shortRef = 0
                        self.dpb[i].longRef = 0
                    }
                    self.maxLongTermFrameIdx = -1
                    self.cur.mmco5 = true
                } else if op == 6 {
                    for i in 0..self.dpb.count {
                        if self.dpb[i].longRef != 0 && self.dpb[i].longTermFrameIdx == b {
                            self.dpb[i].longRef = 0
                        }
                    }
                    if self.cur.longRef != 0 && self.cur.longTermFrameIdx != b {
                        self.cur.longRef = 0
                    }
                    self.cur.longRef = self.cur.longRef | pb
                    self.cur.longTermFrameIdx = b
                    currentLong = true
                }
            }
        } else if !(field && self.cur.shortRef != 0) {
            h264SlidingWindow()
        }
        if !currentLong {
            self.cur.shortRef = self.cur.shortRef | pb
        }
        // Too many references (a damaged stream): drop the oldest short one.
        var count = 1
        for f in self.dpb {
            if f.isRef {
                count += 1
            }
        }
        if count > max(self.sps.maxNumRefFrames, 1) {
            h264SlidingWindow()
        }
    }

    fn h264SetMarks(_ k: Int, _ s: Int, _ l: Int) {
        if k == -2 {
            self.cur.shortRef = s
            self.cur.longRef = l
        } else {
            self.dpb[k].shortRef = s
            self.dpb[k].longRef = l
        }
    }

    fn h264SetLtIdx(_ k: Int, _ v: Int) {
        if k == -2 {
            self.cur.longTermFrameIdx = v
        } else {
            self.dpb[k].longTermFrameIdx = v
        }
    }

    // Sliding window marking (8.2.5.3): when the references are full, the
    // short-term frame with the smallest FrameNumWrap is no longer used.
    fn h264SlidingWindow() {
        var numShort = 0
        var numLong = 0
        for f in self.dpb {
            if f.shortRef != 0 {
                numShort += 1
            } else if f.longRef != 0 {
                numLong += 1
            }
        }
        if numShort + numLong >= max(self.sps.maxNumRefFrames, 1) && numShort > 0 {
            var best = -1
            var bestWrap = 0
            for i in 0..self.dpb.count {
                if self.dpb[i].shortRef != 0 {
                    let wrap = h264FrWrap(i)
                    if best < 0 || wrap < bestWrap {
                        best = i
                        bestWrap = wrap
                    }
                }
            }
            self.dpb[best].shortRef = 0
        }
    }

    // Weighted prediction tables of the slice (8.4.2.3).
    fn h264SetupWeights() {
        self.weightMode = 0
        if self.sh.hasWeights {
            self.weightMode = 1
            self.lumaLog2 = self.sh.lumaLog2
            self.chromaLog2 = self.sh.chromaLog2
            for i in 0..32 {
                self.lumaW0[i] = self.sh.lumaW[i]
                self.lumaO0[i] = self.sh.lumaO[i]
                self.lumaW1[i] = self.sh.lumaW[32 + i]
                self.lumaO1[i] = self.sh.lumaO[32 + i]
                for c in 0..2 {
                    self.chromaW0[i * 2 + c] = self.sh.chromaW[i * 2 + c]
                    self.chromaO0[i * 2 + c] = self.sh.chromaO[i * 2 + c]
                    self.chromaW1[i * 2 + c] = self.sh.chromaW[(32 + i) * 2 + c]
                    self.chromaO1[i * 2 + c] = self.sh.chromaO[(32 + i) * 2 + c]
                }
            }
            // References whose explicit weights change nothing (weight
            // 2^logWD, offset 0 for all planes): their predictions equal
            // the unweighted ones (8-270, 8-271, 8-301).
            let lw = 1 << self.lumaLog2
            let cw = 1 << self.chromaLog2
            for i in 0..32 {
                let d0 = self.lumaW0[i] == lw && self.lumaO0[i] == 0 && self.chromaW0[i * 2] == cw && self.chromaW0[i * 2 + 1] == cw && self.chromaO0[i * 2] == 0 && self.chromaO0[i * 2 + 1] == 0
                let d1 = self.lumaW1[i] == lw && self.lumaO1[i] == 0 && self.chromaW1[i * 2] == cw && self.chromaW1[i * 2 + 1] == cw && self.chromaO1[i * 2] == 0 && self.chromaO1[i * 2 + 1] == 0
                self.wDef0[i] = if d0 { 1 } else { 0 }
                self.wDef1[i] = if d1 { 1 } else { 0 }
            }
        } else if self.sliceType == sliceB && self.pps.weightedBipredIdc == 2 {
            self.weightMode = 2
            let cur = h264CurPoc()
            for i in 0..self.refCount0 {
                for j in 0..self.refCount1 {
                    var w = 32
                    if !self.listLong0[i] && !self.listLong1[j] {
                        let poc0 = self.listPoc0[i]
                        let td = h264Clip8(self.listPoc1[j] - poc0)
                        if td != 0 {
                            let tb = h264Clip8(cur - poc0)
                            let a = if td < 0 { -td } else { td }
                            let tx = (16384 + (a >> 1)) / td
                            let dsf = (tb * tx + 32) >> 8
                            if dsf >= -64 && dsf <= 128 {
                                w = dsf
                            }
                        }
                    }
                    self.implicitW[i * 32 + j] = w
                }
            }
            if self.mbaffFrame {
                // Field macroblocks: weights from the field order counts.
                for par in 1..3 {
                    let cf = h264FrPoc(-2, par)
                    for i in 0..(2 * self.refCount0) {
                        for j in 0..(2 * self.refCount1) {
                            var w = 32
                            if !self.listLong0[i >> 1] && !self.listLong1[j >> 1] {
                                let p0 = h264FrPoc(self.list0[i >> 1], if (i & 1) == 0 { par } else { 3 - par })
                                let p1 = h264FrPoc(self.list1[j >> 1], if (j & 1) == 0 { par } else { 3 - par })
                                let td = h264Clip8(p1 - p0)
                                if td != 0 {
                                    let tb = h264Clip8(cf - p0)
                                    let a = if td < 0 { -td } else { td }
                                    let tx = (16384 + (a >> 1)) / td
                                    let dsf = (tb * tx + 32) >> 8
                                    if dsf >= -64 && dsf <= 128 {
                                        w = dsf
                                    }
                                }
                            }
                            self.implicitWF[(par - 1) * 4096 + i * 64 + j] = w
                        }
                    }
                }
            }
        }
    }

    // DistScaleFactor for temporal direct (8.4.1.2.3), and for frames whose
    // RefPicList1[0] was coded as fields, which field is colocated.
    fn h264SetupDirect() {
        if self.sliceType != sliceB {
            return
        }
        let cur = h264CurPoc()
        let k = self.list1[0]
        if self.curStructure == 3 && k != -1 {
            let top = h264FrPoc(k, 1)
            let bot = h264FrPoc(k, 2)
            let dt = h264Abs(top - cur)
            let db = h264Abs(bot - cur)
            self.colParity = if dt >= db { 1 } else { 0 }
        }
        if self.sh.directSpatial {
            return
        }
        if self.mbaffFrame {
            for par in 1..3 {
                let cf = h264FrPoc(-2, par)
                let p1 = h264FrPoc(self.list1[0], par)
                for i in 0..(2 * self.refCount0) {
                    let fr = self.list0[i >> 1]
                    let rp = if (i & 1) == 0 { par } else { 3 - par }
                    let p0 = h264FrPoc(fr, rp)
                    let td = h264Clip8(p1 - p0)
                    var v = 256
                    if td != 0 && !self.listLong0[i >> 1] {
                        let tb = h264Clip8(cf - p0)
                        let a = if td < 0 { -td } else { td }
                        let tx = (16384 + (a >> 1)) / td
                        v = max(-1024, min(1023, (tb * tx + 32) >> 6))
                    }
                    self.distScaleF[(par - 1) * 64 + i] = v
                }
            }
        }
        let poc1 = self.listPoc1[0]
        for i in 0..self.refCount0 {
            let poc0 = self.listPoc0[i]
            let td = h264Clip8(poc1 - poc0)
            if td == 0 || self.listLong0[i] {
                self.distScale[i] = 256
            } else {
                let tb = h264Clip8(cur - poc0)
                let a = if td < 0 { -td } else { td }
                let tx = (16384 + (a >> 1)) / td
                self.distScale[i] = max(-1024, min(1023, (tb * tx + 32) >> 6))
            }
        }
    }

    // The output picture of a DPB frame (frame cropping 7.4.2.1.1).
    fn h264ToPicture(_ f: Frame) -> core.Picture {
        let s = self.sps
        var p = core.Picture(width: s.width, height: s.height)
        p.y = f.y
        p.yStride = self.lumaW
        p.yOffset = s.cropTop * self.lumaW + s.cropLeft
        if self.hasChroma {
            p.u = f.u
            p.v = f.v
            p.cStride = self.chromaW
            p.cOffset = (s.cropTop >> 1) * self.chromaW + (s.cropLeft >> 1)
        } else {
            p.chroma = .gray
        }
        p.pts = f.pts
        p.key = f.key
        // Streams that may code fields (frame_mbs_only_flag 0): interlaced;
        // the field with the smaller order count comes first.
        if !s.frameMbsOnly {
            p.interlaced = true
            p.topFieldFirst = f.topPoc <= f.botPoc
        }
        if s.sarNum > 0 && s.sarDen > 0 {
            p.sarNum = s.sarNum
            p.sarDen = s.sarDen
        }
        p.fullRange = s.fullRange
        let m = s.matrixCoeffs
        if m == 1 {
            p.matrix = .bt709
        } else if m == 5 || m == 6 {
            p.matrix = .bt601
        } else if m == 9 || m == 10 {
            p.matrix = .bt2020
        } else {
            p.matrix = core.guessMatrix(width: s.width, height: s.height)
        }
        p
    }

    // Outputs the waiting frame with the smallest POC. False when none waits.
    fn h264Bump() -> Bool {
        var best = -1
        for i in 0..self.dpb.count {
            if self.dpb[i].outputNeeded && (best < 0 || self.dpb[i].poc < self.dpb[best].poc) {
                best = i
            }
        }
        if best < 0 {
            return false
        }
        self.dpb[best].outputNeeded = false
        if !self.dpb[best].nonExisting && self.mode != 1 {
            let pic = h264ToPicture(self.dpb[best])
            self.out.append(pic)
        }
        if !self.dpb[best].isRef {
            h264RemoveFrame(best)
        }
        true
    }

    fn h264RemoveFrame(_ i: Int) {
        let f = self.dpb.remove(at: i)
        if self.pool.count < 4 && (f.y.count == self.lumaW * self.lumaH || (!self.doLuma && !f.u.isEmpty)) {
            self.pool.append(f)
        }
    }

    // Removes frames no longer needed for reference or output.
    fn h264CleanDpb() {
        var i = 0
        while i < self.dpb.count {
            if !self.dpb[i].isRef && !self.dpb[i].outputNeeded {
                h264RemoveFrame(i)
            } else {
                i += 1
            }
        }
    }

    // Stores the finished current frame in the DPB and outputs what the
    // bumping process (C.4.5.3) allows.
    fn h264StoreFrame() {
        if self.cur.isIdr || self.cur.mmco5 {
            while h264Bump() {
            }
        }
        h264CleanDpb()
        self.cur.outputNeeded = !self.cur.nonExisting && !self.dropOutput
        self.dpb.append(self.cur)
        self.cur = Frame()
        var waiting = 0
        for f in self.dpb {
            if f.outputNeeded {
                waiting += 1
            }
        }
        while waiting > self.reorder {
            if !h264Bump() {
                break
            }
            waiting -= 1
        }
        while self.dpb.count > self.maxFrames {
            if !h264Bump() {
                // Nothing to output: drop the oldest non-reference frame, or
                // as a last resort the oldest frame.
                var k = -1
                for i in 0..self.dpb.count {
                    if !self.dpb[i].isRef {
                        k = i
                        break
                    }
                }
                if k < 0 {
                    k = 0
                }
                h264RemoveFrame(k)
            }
        }
    }

    // DPB size and output delay for the active SPS.
    fn h264SetDpbSize() {
        let s = self.sps
        let fromLevel = min(16, max(1, h264MaxDpbMbs(s.levelIdc, (s.constraintFlags & 0x10) != 0) / max(1, s.mbWidth * s.mbHeight)))
        var size = fromLevel
        if s.bitstreamRestriction {
            size = max(1, s.maxDecFrameBuffering)
        }
        size = max(size, max(1, s.maxNumRefFrames))
        self.maxFrames = size
        if s.bitstreamRestriction {
            self.reorder = s.numReorderFrames
        } else if s.maxNumRefFrames == 0 {
            self.reorder = 0
        } else {
            self.reorder = fromLevel
        }
    }

    // ----------------------------------------------------------------------
    // Macroblock neighbours and caches (6.4.11, 6.4.12)
    // ----------------------------------------------------------------------

    // Whether macroblock m of the current picture is available to the
    // current one: decoded already, in the same slice.
    fn h264Avail(_ m: Int) -> Bool {
        m >= 0 && m < self.numMbs && self.sliceTab[m] == self.sliceNum
    }

    // Finds the neighbouring macroblocks A (left; in MBAFF frames two: the
    // left pair's macroblocks covering the upper and lower half), B
    // (above), C (above right) and D (above left) of the current one, and
    // their types (0 when not available: outside the picture or in another
    // slice). MBAFF follows 6.4.12.2 (Table 6-4).
    fn h264FillNeighbors() {
        let xy = self.mbXY
        let w = self.mbW
        let topStep = if self.mbField { 2 * w } else { w }
        var top = xy - topStep
        var topLeft = top - 1
        var topRight = top + 1
        var leftT = xy - 1
        var leftB = xy - 1
        self.leftBlock = 0
        self.topLeftPart = -1
        let mx = self.mbX
        if self.mbaffFrame && mx > 0 {
            let leftField = (self.mbTypes[xy - 1] & mbInterlaced) != 0
            let curField = self.mbField
            if (self.mbY & 1) == 1 {
                if leftField != curField {
                    leftT = xy - w - 1
                    leftB = leftT
                    if curField {
                        leftB += w
                        self.leftBlock = 3
                    } else {
                        topLeft += w
                        self.topLeftPart = 0
                        self.leftBlock = 1
                    }
                }
            } else {
                if leftField != curField {
                    if curField {
                        leftB += w
                        self.leftBlock = 3
                    } else {
                        self.leftBlock = 2
                    }
                }
            }
        }
        if self.mbaffFrame && self.mbField && (self.mbY & 1) == 0 && top >= 0 {
            if mx > 0 && (self.mbTypes[top - 1] & mbInterlaced) == 0 {
                topLeft += w
            }
            if mx + 1 < w && (self.mbTypes[top + 1] & mbInterlaced) == 0 {
                topRight += w
            }
            if (self.mbTypes[top] & mbInterlaced) == 0 {
                top += w
            }
        }
        self.topXY = top
        self.leftXY = leftT
        self.leftXY2 = leftB
        self.topLeftXY = topLeft
        self.topRightXY = topRight
        self.leftType = 0
        self.leftType2 = 0
        self.topType = 0
        self.topLeftType = 0
        self.topRightType = 0
        if mx > 0 && h264Avail(leftT) {
            self.leftType = self.mbTypes[leftT]
            self.leftType2 = self.mbTypes[leftB]
        }
        if h264Avail(top) {
            self.topType = self.mbTypes[top]
        }
        if mx > 0 && h264Avail(topLeft) {
            self.topLeftType = self.mbTypes[topLeft]
        }
        if mx + 1 < w && h264Avail(topRight) {
            self.topRightType = self.mbTypes[topRight]
        }
    }

    // Intra sample availability as the 16-bit masks of the reference
    // decoder: bit 15 - n for 4x4 block n (decoding order) says whether its
    // left / above / above-left / above-right samples exist, which
    // constrained_intra_pred and MBAFF can make differ inside a macroblock.
    fn h264FillIntraAvail() {
        let ci = self.pps.constrainedIntraPred
        let mask = if ci { mbIntraMask } else { -1 }
        var tl = 0xFFFF
        var t = 0xFFFF
        var l = 0xFFFF
        var tr = 0xEEEA
        if (self.topType & mask) == 0 {
            tl = 0xB3FF
            t = 0x33FF
            tr = 0x26EA
        }
        let curField = (self.mbType & mbInterlaced) != 0 || self.mbField
        let leftField = (self.leftType & mbInterlaced) != 0
        if self.mbaffFrame && curField != leftField && self.leftType != 0 {
            if curField {
                if (self.leftType & mask) == 0 {
                    tl = tl & 0xDFFF
                    l = l & 0x5FFF
                }
                if (self.leftType2 & mask) == 0 {
                    tl = tl & 0xFF5F
                    l = l & 0xFF5F
                }
            } else {
                let other = self.mbTypes[self.leftXY + self.mbW]
                if !((other & mask) != 0 && (self.leftType & mask) != 0) {
                    tl = tl & 0xDF5F
                    l = l & 0x5F5F
                }
            }
        } else if (self.leftType & mask) == 0 {
            tl = tl & 0xDF5F
            l = l & 0x5F5F
        }
        if (self.topLeftType & mask) == 0 {
            tl = tl & 0x7FFF
        }
        if (self.topRightType & mask) == 0 {
            tr = tr & 0xFBFF
        }
        self.tlAvail = tl
        self.tAvail = t
        self.lAvail = l
        self.trAvail = tr
        self.availLeft = (l & 0x8080) == 0x8080
        self.availTop = (t & 0x8000) != 0
        self.availTopLeft = (tl & 0x8000) != 0
    }

    // Fills the intra, coefficient-count and CABAC caches of a macroblock
    // that isn't skipped, and the motion caches of an inter macroblock.
    fn h264FillCaches(_ mbType: Int) {
        let isIntra = (mbType & mbIntraMask) != 0
        let cabac = self.pps.cabac
        let lb = self.leftBlock * 4
        let lbc = self.leftBlock * 2
        if isIntra {
            h264FillIntraAvail()
            if (mbType & mbIntra4x4) != 0 {
                let mask = if self.pps.constrainedIntraPred { mbIntraMask } else { -1 }
                if (self.topType & mbIntra4x4) != 0 {
                    let b = self.topXY * 16 + 12
                    self.predCache[4] = self.predTab[b]
                    self.predCache[5] = self.predTab[b + 1]
                    self.predCache[6] = self.predTab[b + 2]
                    self.predCache[7] = self.predTab[b + 3]
                } else {
                    let v = if (self.topType & mask) == 0 { -1 } else { 2 }
                    self.predCache[4] = v
                    self.predCache[5] = v
                    self.predCache[6] = v
                    self.predCache[7] = v
                }
                for i in 0..2 {
                    let lt = if i == 0 { self.leftType } else { self.leftType2 }
                    let lxy = if i == 0 { self.leftXY } else { self.leftXY2 }
                    if (lt & mbIntra4x4) != 0 {
                        let b = lxy * 16 + 3
                        self.predCache[11 + 16 * i] = self.predTab[b + 4 * h264LeftRows[lb + 2 * i]]
                        self.predCache[19 + 16 * i] = self.predTab[b + 4 * h264LeftRows[lb + 2 * i + 1]]
                    } else {
                        let v = if (lt & mask) == 0 { -1 } else { 2 }
                        self.predCache[11 + 16 * i] = v
                        self.predCache[19 + 16 * i] = v
                    }
                }
            }
        }
        // Coefficient counts of the neighbouring blocks (9.2.1 nA/nB; also
        // the coded_block_flag contexts of 9.3.3.1.1.9).
        if self.topType != 0 {
            let b = self.topXY * 24
            self.nzCache[4] = self.nzTab[b + 12]
            self.nzCache[5] = self.nzTab[b + 13]
            self.nzCache[6] = self.nzTab[b + 14]
            self.nzCache[7] = self.nzTab[b + 15]
            self.nzCache[44] = self.nzTab[b + 18]
            self.nzCache[45] = self.nzTab[b + 19]
            self.nzCache[68] = self.nzTab[b + 22]
            self.nzCache[69] = self.nzTab[b + 23]
        } else {
            let v = if cabac && !isIntra { 0 } else { 64 }
            self.nzCache[4] = v
            self.nzCache[5] = v
            self.nzCache[6] = v
            self.nzCache[7] = v
            self.nzCache[44] = v
            self.nzCache[45] = v
            self.nzCache[68] = v
            self.nzCache[69] = v
        }
        for i in 0..2 {
            let lt = if i == 0 { self.leftType } else { self.leftType2 }
            if lt != 0 {
                let b = (if i == 0 { self.leftXY } else { self.leftXY2 }) * 24
                self.nzCache[11 + 16 * i] = self.nzTab[b + 3 + 4 * h264LeftRows[lb + 2 * i]]
                self.nzCache[19 + 16 * i] = self.nzTab[b + 3 + 4 * h264LeftRows[lb + 2 * i + 1]]
                let cr = h264LeftChromaRows[lbc + i]
                self.nzCache[51 + 8 * i] = self.nzTab[b + 17 + 2 * cr]
                self.nzCache[75 + 8 * i] = self.nzTab[b + 21 + 2 * cr]
            } else {
                let v = if cabac && !isIntra { 0 } else { 64 }
                self.nzCache[11 + 16 * i] = v
                self.nzCache[19 + 16 * i] = v
                self.nzCache[51 + 8 * i] = v
                self.nzCache[75 + 8 * i] = v
            }
        }
        if cabac {
            if self.topType != 0 {
                self.topCbp = self.cbpTab[self.topXY]
            } else {
                self.topCbp = if isIntra { 0x7CF } else { 0x00F }
            }
            if self.leftType != 0 {
                let a = self.cbpTab[self.leftXY]
                let b = self.cbpTab[self.leftXY2]
                self.leftCbp = (a & 0x7F0) | ((a >> (h264LeftRows[lb] & ~1)) & 2) | (((b >> (h264LeftRows[lb + 2] & ~1)) & 2) << 2)
            } else {
                self.leftCbp = if isIntra { 0x7CF } else { 0x00F }
            }
        }
        if (mbType & (mb16x16 | mb16x8 | mb8x16 | mb8x8)) != 0 || ((mbType & mbDirect) != 0 && self.sh.directSpatial) {
            for list in 0..self.listCount {
                h264FillMotionCache(mbType, list)
            }
        }
        let t8 = if (self.topType & mbDct8x8) != 0 { 1 } else { 0 }
        let l8 = if (self.leftType & mbDct8x8) != 0 { 1 } else { 0 }
        self.neighborTransform = t8 + l8
    }

    // The motion caches of one list (8.4.1.3.2 neighbours A, B, C, D;
    // in MBAFF frames the neighbours' vectors and reference indices are
    // converted between frame and field units, 8.4.1.3.1).
    fn h264FillMotionCache(_ mbType: Int, _ list: Int) {
        let lb = list * 40
        let useMask = if list == 0 { mbL0 } else { mbL1 }
        if (mbType & useMask) == 0 {
            return
        }
        let rowsBase = self.leftBlock * 4
        // Above: bottom row of B.
        if (self.topType & useMask) != 0 {
            let b = self.topXY * 16 + 12
            let r = self.topXY * 4
            let ra = h264RefAt(list, r + 2)
            let rb = h264RefAt(list, r + 3)
            for i in 0..4 {
                self.mvxCache[lb + 4 + i] = h264MvxAt(list, b + i)
                self.mvyCache[lb + 4 + i] = h264MvyAt(list, b + i)
            }
            self.refCache[lb + 4] = ra
            self.refCache[lb + 5] = ra
            self.refCache[lb + 6] = rb
            self.refCache[lb + 7] = rb
        } else {
            let v = if self.topType != 0 { listNotUsed } else { partNotAvailable }
            for i in 0..4 {
                self.mvxCache[lb + 4 + i] = 0
                self.mvyCache[lb + 4 + i] = 0
                self.refCache[lb + 4 + i] = v
            }
        }
        // Left: right column of A (all four rows when partitions need them).
        let full = (mbType & (mb16x8 | mb8x8)) != 0
        for half in 0..2 {
            if half == 1 && !full {
                break
            }
            let lt = if half == 0 { self.leftType } else { self.leftType2 }
            let lxy = if half == 0 { self.leftXY } else { self.leftXY2 }
            let n = if full { 2 } else { 1 }
            for j in 0..n {
                let c = lb + 11 + (2 * half + j) * 8
                if (lt & useMask) != 0 {
                    let row = h264LeftRows[rowsBase + 2 * half + j]
                    self.mvxCache[c] = h264MvxAt(list, lxy * 16 + 3 + 4 * row)
                    self.mvyCache[c] = h264MvyAt(list, lxy * 16 + 3 + 4 * row)
                    self.refCache[c] = h264RefAt(list, lxy * 4 + 1 + (row & ~1))
                } else {
                    self.mvxCache[c] = 0
                    self.mvyCache[c] = 0
                    self.refCache[c] = if lt != 0 { listNotUsed } else { partNotAvailable }
                }
            }
        }
        // Above right: bottom left block of C.
        if (self.topRightType & useMask) != 0 {
            self.mvxCache[lb + 8] = h264MvxAt(list, self.topRightXY * 16 + 12)
            self.mvyCache[lb + 8] = h264MvyAt(list, self.topRightXY * 16 + 12)
            self.refCache[lb + 8] = h264RefAt(list, self.topRightXY * 4 + 2)
        } else {
            self.mvxCache[lb + 8] = 0
            self.mvyCache[lb + 8] = 0
            self.refCache[lb + 8] = if self.topRightType != 0 { listNotUsed } else { partNotAvailable }
        }
        // Above left: bottom right block of D (only needed when C is
        // missing); the middle right one when topLeftPart is 0 (MBAFF).
        if self.refCache[lb + 6] < 0 || self.refCache[lb + 8] < 0 {
            if (self.topLeftType & useMask) != 0 {
                let row = if self.topLeftPart == 0 { 1 } else { 3 }
                self.mvxCache[lb + 3] = h264MvxAt(list, self.topLeftXY * 16 + 3 + 4 * row)
                self.mvyCache[lb + 3] = h264MvyAt(list, self.topLeftXY * 16 + 3 + 4 * row)
                self.refCache[lb + 3] = h264RefAt(list, self.topLeftXY * 4 + (if self.topLeftPart == 0 { 1 } else { 3 }))
            } else {
                self.mvxCache[lb + 3] = 0
                self.mvyCache[lb + 3] = 0
                self.refCache[lb + 3] = if self.topLeftType != 0 { listNotUsed } else { partNotAvailable }
            }
        }
        if (mbType & (mbSkip | mbDirect)) == 0 {
            // Blocks of the macroblock not decoded yet when their neighbours
            // need them (above right of blocks 3 and 11).
            self.refCache[lb + 14] = partNotAvailable
            self.refCache[lb + 30] = partNotAvailable
            self.mvxCache[lb + 14] = 0
            self.mvyCache[lb + 14] = 0
            self.mvxCache[lb + 30] = 0
            self.mvyCache[lb + 30] = 0
            if self.pps.cabac {
                // Absolute mvd of neighbours (9.3.3.1.1.7).
                if (self.topType & useMask) != 0 {
                    let b = self.topXY * 16 + 12
                    for i in 0..4 {
                        self.mvdxCache[lb + 4 + i] = h264MvdxAt(list, b + i)
                        self.mvdyCache[lb + 4 + i] = h264MvdyAt(list, b + i)
                    }
                } else {
                    for i in 0..4 {
                        self.mvdxCache[lb + 4 + i] = 0
                        self.mvdyCache[lb + 4 + i] = 0
                    }
                }
                for y in 0..4 {
                    let lt = if y < 2 { self.leftType } else { self.leftType2 }
                    let lxy = if y < 2 { self.leftXY } else { self.leftXY2 }
                    let c = lb + 11 + y * 8
                    if (lt & useMask) != 0 {
                        let row = h264LeftRows[rowsBase + y]
                        self.mvdxCache[c] = h264MvdxAt(list, lxy * 16 + 3 + 4 * row)
                        self.mvdyCache[c] = h264MvdyAt(list, lxy * 16 + 3 + 4 * row)
                    } else {
                        self.mvdxCache[c] = 0
                        self.mvdyCache[c] = 0
                    }
                }
                self.mvdxCache[lb + 14] = 0
                self.mvdyCache[lb + 14] = 0
                self.mvdxCache[lb + 30] = 0
                self.mvdyCache[lb + 30] = 0
                if self.sliceType == sliceB {
                    // Whether neighbouring 8x8 blocks are direct predicted
                    // (refIdxZeroFlag in 9.3.3.1.1.6).
                    for i in 0..16 {
                        self.directCache[12 + (i & 3) + (i >> 2) * 8] = 0
                    }
                    if (self.topType & mbDirect) != 0 {
                        self.directCache[4] = 1
                        self.directCache[5] = 1
                        self.directCache[6] = 1
                        self.directCache[7] = 1
                    } else if (self.topType & mb8x8) != 0 {
                        let d2 = self.directTab[self.topXY * 4 + 2]
                        let d3 = self.directTab[self.topXY * 4 + 3]
                        self.directCache[4] = d2
                        self.directCache[5] = d2
                        self.directCache[6] = d3
                        self.directCache[7] = d3
                    } else {
                        self.directCache[4] = 0
                        self.directCache[5] = 0
                        self.directCache[6] = 0
                        self.directCache[7] = 0
                    }
                    for half in 0..2 {
                        let lt = if half == 0 { self.leftType } else { self.leftType2 }
                        let lxy = if half == 0 { self.leftXY } else { self.leftXY2 }
                        var d = 0
                        if (lt & mbDirect) != 0 {
                            d = 1
                        } else if (lt & mb8x8) != 0 {
                            d = self.directTab[lxy * 4 + 1 + (h264LeftRows[rowsBase + 2 * half] & ~1)]
                        }
                        self.directCache[11 + 16 * half] = d
                        self.directCache[19 + 16 * half] = d
                    }
                }
            }
        }
        if self.mbaffFrame {
            h264MapNeighbourMotion(lb)
        }
    }

    // MBAFF: neighbours coded the other way (frame vs field) have their
    // reference index doubled or halved and vertical vector (and mvd)
    // halved or doubled (8.4.1.3.1, 9.3.3.1.1.7).
    fn h264MapNeighbourMotion(_ lb: Int) {
        let cur = self.mbField
        for k in 0..10 {
            var c = 0
            var t = 0
            if k == 0 {
                c = 3
                t = self.topLeftType
            } else if k <= 4 {
                c = 3 + k
                t = self.topType
            } else if k == 5 {
                c = 8
                t = self.topRightType
            } else {
                let row = k - 6
                c = 11 + row * 8
                t = if row < 2 { self.leftType } else { self.leftType2 }
            }
            let f = (t & mbInterlaced) != 0
            let i = lb + c
            if self.refCache[i] < 0 || f == cur {
                continue
            }
            if cur {
                self.refCache[i] = self.refCache[i] * 2
                self.mvyCache[i] = self.mvyCache[i] / 2
                self.mvdyCache[i] = self.mvdyCache[i] >> 1
            } else {
                self.refCache[i] = self.refCache[i] >> 1
                self.mvyCache[i] = self.mvyCache[i] * 2
                self.mvdyCache[i] = self.mvdyCache[i] << 1
            }
        }
    }

    fn h264MvxAt(_ list: Int, _ i: Int) -> Int {
        if list == 0 { self.cur.mvx0[i] } else { self.cur.mvx1[i] }
    }

    fn h264MvyAt(_ list: Int, _ i: Int) -> Int {
        if list == 0 { self.cur.mvy0[i] } else { self.cur.mvy1[i] }
    }

    fn h264RefAt(_ list: Int, _ i: Int) -> Int {
        if list == 0 { self.cur.ref0[i] } else { self.cur.ref1[i] }
    }

    fn h264MvdxAt(_ list: Int, _ i: Int) -> Int {
        if list == 0 { self.mvdx0[i] } else { self.mvdx1[i] }
    }

    fn h264MvdyAt(_ list: Int, _ i: Int) -> Int {
        if list == 0 { self.mvdy0[i] } else { self.mvdy1[i] }
    }

    // Plane positions of the current macroblock.
    // Plane positions of the current macroblock and, in MBAFF frames, its
    // frame/field layout: a field macroblock of a pair takes every other
    // row of the pair's 32 rows, starting at row 0 (top) or 1 (bottom).
    fn h264SetMbAt() {
        if self.mbaffFrame {
            self.mbField = self.pairField
            let pairTop = self.mbY & ~1
            let b = self.mbY & 1
            if self.mbField {
                self.pStride = 2 * self.lumaW
                self.cStride = 2 * self.chromaW
                self.lumaAt = pairTop * 16 * self.lumaW + b * self.lumaW + self.mbX * 16
                self.chromaAt = pairTop * 8 * self.chromaW + b * self.chromaW + self.mbX * 8
                self.picH = self.lumaH / 2
                self.mcRow = (self.mbY >> 1) * 16
                self.mcParity = b + 1
                self.fieldDecoding = true
                self.fieldFlag = mbInterlaced
                self.mbRefCount0 = 2 * self.refCount0
                self.mbRefCount1 = 2 * self.refCount1
            } else {
                self.pStride = self.lumaW
                self.cStride = self.chromaW
                self.lumaAt = self.mbY * 16 * self.lumaW + self.mbX * 16
                self.chromaAt = self.mbY * 8 * self.chromaW + self.mbX * 8
                self.picH = self.lumaH
                self.mcRow = self.mbY * 16
                self.mcParity = 3
                self.fieldDecoding = false
                self.fieldFlag = 0
                self.mbRefCount0 = self.refCount0
                self.mbRefCount1 = self.refCount1
            }
            return
        }
        self.lumaAt = self.pOff + self.mbY * 16 * self.pStride + self.mbX * 16
        self.chromaAt = self.cOff + self.mbY * 8 * self.cStride + self.mbX * 8
        self.mcRow = self.mbY * 16
        self.mcParity = self.curStructure
        self.mbRefCount0 = self.refCount0
        self.mbRefCount1 = self.refCount1
    }

    // ----------------------------------------------------------------------
    // Shared macroblock layer parts: skipped macroblocks, I_PCM, write-back (7.3.5)
    // ----------------------------------------------------------------------

    fn h264SetChromaQp() {
        self.qpCb = self.pps.chromaQp[self.qp]
        self.qpCr = self.pps.chromaQp[52 + self.qp]
    }

    // predIntra4x4PredMode / predIntra8x8PredMode (8.3.1.1, 8.3.2.1) from the
    // cached modes of the left and upper blocks (-1: not available).
    fn h264PredIntraMode(_ c: Int) -> Int {
        let left = self.predCache[c - 1]
        let top = self.predCache[c - 8]
        let m = min(left, top)
        if m < 0 { 2 } else { m }
    }

    fn h264WriteBackPredModes() {
        let b = self.mbXY * 16
        for y in 0..4 {
            for x in 0..4 {
                self.predTab[b + x + y * 4] = self.predCache[12 + x + y * 8]
            }
        }
    }

    fn h264WriteBackNz() {
        let b = self.mbXY * 24
        for y in 0..4 {
            for x in 0..4 {
                self.nzTab[b + x + y * 4] = self.nzCache[12 + x + y * 8]
            }
        }
        for y in 0..2 {
            for x in 0..2 {
                self.nzTab[b + 16 + x + y * 2] = self.nzCache[52 + x + y * 8]
                self.nzTab[b + 20 + x + y * 2] = self.nzCache[76 + x + y * 8]
            }
        }
    }

    // Motion tables of an intra macroblock: no vectors, no references.
    fn h264WriteBackIntraMotion() {
        let b = self.mbXY * 16
        let r = self.mbXY * 4
        for i in 0..16 {
            self.cur.mvx0[b + i] = 0
            self.cur.mvy0[b + i] = 0
            self.cur.mvx1[b + i] = 0
            self.cur.mvy1[b + i] = 0
        }
        for i in 0..4 {
            self.cur.ref0[r + i] = listNotUsed
            self.cur.ref1[r + i] = listNotUsed
            self.cur.pic0[r + i] = -1
            self.cur.pic1[r + i] = -1
        }
        if self.pps.cabac {
            for i in 0..16 {
                self.mvdx0[b + i] = 0
                self.mvdy0[b + i] = 0
                self.mvdx1[b + i] = 0
                self.mvdy1[b + i] = 0
            }
            for i in 0..4 {
                self.directTab[r + i] = 0
            }
        }
    }

    // Stores the motion caches into the picture's tables (and the CABAC mvd
    // tables, and which 8x8 blocks were direct).
    fn h264WriteBackMotion(_ mbType: Int) {
        let b = self.mbXY * 16
        let r = self.mbXY * 4
        for list in 0..2 {
            let lb = list * 40
            let useMask = if list == 0 { mbL0 } else { mbL1 }
            if (mbType & useMask) == 0 || list >= self.listCount {
                for i in 0..16 {
                    if list == 0 {
                        self.cur.mvx0[b + i] = 0
                        self.cur.mvy0[b + i] = 0
                    } else {
                        self.cur.mvx1[b + i] = 0
                        self.cur.mvy1[b + i] = 0
                    }
                }
                for i in 0..4 {
                    if list == 0 {
                        self.cur.ref0[r + i] = listNotUsed
                        self.cur.pic0[r + i] = -1
                    } else {
                        self.cur.ref1[r + i] = listNotUsed
                        self.cur.pic1[r + i] = -1
                    }
                }
                if self.pps.cabac {
                    for i in 0..16 {
                        if list == 0 {
                            self.mvdx0[b + i] = 0
                            self.mvdy0[b + i] = 0
                        } else {
                            self.mvdx1[b + i] = 0
                            self.mvdy1[b + i] = 0
                        }
                    }
                }
                continue
            }
            for y in 0..4 {
                for x in 0..4 {
                    let c = lb + 12 + x + y * 8
                    if list == 0 {
                        self.cur.mvx0[b + x + y * 4] = self.mvxCache[c]
                        self.cur.mvy0[b + x + y * 4] = self.mvyCache[c]
                    } else {
                        self.cur.mvx1[b + x + y * 4] = self.mvxCache[c]
                        self.cur.mvy1[b + x + y * 4] = self.mvyCache[c]
                    }
                }
            }
            if self.pps.cabac {
                let skip = (mbType & mbSkip) != 0
                for y in 0..4 {
                    for x in 0..4 {
                        let c = lb + 12 + x + y * 8
                        let dx = if skip { 0 } else { self.mvdxCache[c] }
                        let dy = if skip { 0 } else { self.mvdyCache[c] }
                        if list == 0 {
                            self.mvdx0[b + x + y * 4] = dx
                            self.mvdy0[b + x + y * 4] = dy
                        } else {
                            self.mvdx1[b + x + y * 4] = dx
                            self.mvdy1[b + x + y * 4] = dy
                        }
                    }
                }
            }
            for i in 0..4 {
                let ref = self.refCache[lb + 12 + (i & 1) * 2 + (i >> 1) * 16]
                var pic = -1
                if ref >= 0 {
                    if self.mbaffFrame && self.mbField {
                    let f = if list == 0 { self.listId0[ref >> 1] } else { self.listId1[ref >> 1] }
                    let par = if (ref & 1) == 0 { self.mcParity } else { 3 - self.mcParity }
                    pic = (f & ~3) | par
                } else {
                    pic = if list == 0 { self.listId0[ref] } else { self.listId1[ref] }
                }
                }
                if list == 0 {
                    self.cur.ref0[r + i] = ref
                    self.cur.pic0[r + i] = pic
                } else {
                    self.cur.ref1[r + i] = ref
                    self.cur.pic1[r + i] = pic
                }
            }
        }
        if self.sliceType == sliceB && self.pps.cabac {
            if (mbType & mbDirect) != 0 && (mbType & mb8x8) == 0 {
                for i in 0..4 {
                    self.directTab[r + i] = 1
                }
            } else if (mbType & mb8x8) != 0 {
                for i in 0..4 {
                    self.directTab[r + i] = if (self.subMbType[i] & mbDirect) != 0 { 1 } else { 0 }
                }
            } else {
                for i in 0..4 {
                    self.directTab[r + i] = 0
                }
            }
        }
    }

    // transform_size_8x8_flag is only sent for B_8x8/P_8x8 when no
    // sub-macroblock is split below 8x8 (7.3.5, NumSubMbPart == 1 and, for
    // direct ones, direct_8x8_inference_flag).
    fn h264Dct8x8Allowed() -> Bool {
        for i in 0..4 {
            let t = self.subMbType[i]
            if (t & (mb16x8 | mb8x16 | mb8x8)) != 0 {
                return false
            }
            if !self.sps.direct8x8Inference && (t & mbDirect) != 0 {
                return false
            }
        }
        true
    }

    // P_Skip and B_Skip macroblocks (7.4.5, 8.4.1.1, 8.4.1.2).
    fn h264DecodeSkip() {
        let xy = self.mbXY
        var mbType = 0
        for i in 0..24 {
            self.nzCache[self.s8[i]] = 0
        }
        if self.sliceType == sliceB {
            mbType = mbL0 | mbL1 | mbDirect | mbSkip
            self.mbType = mbType
            if self.sh.directSpatial {
                h264FillCaches(mbType)
            }
            h264PredDirect()
            mbType = self.mbType | mbSkip
        } else {
            mbType = mb16x16 | mbP0L0 | mbP1L0 | mbSkip
            self.mbType = mbType
            h264PredPSkip()
        }
        self.mbType = mbType
        h264WriteBackMotion(mbType)
        self.mbTypes[xy] = mbType | self.fieldFlag
        self.qpTab[xy] = self.qp
        self.sliceTab[xy] = self.sliceNum
        self.cbp = 0
        self.cbpTab[xy] = 0
        h264WriteBackNz()
        self.prevMbSkipped = true
        h264MbDone(0)
    }

    // Reads the 384 (or 256 in 4:0:0) pcm_sample bytes at byte p of the
    // slice data into pcmBytes. False when the data is too short.
    fn h264ReadPcm(_ p: Int) -> Bool {
        let n = if self.hasChroma { 384 } else { 256 }
        if p + n > self.rbsp.count {
            return false
        }
        if self.pcmBytes.count < 384 {
            self.pcmBytes = core.zeros(384)
        }
        for i in 0..n {
            self.pcmBytes[i] = self.rbsp[p + i]
        }
        true
    }

    // ----------------------------------------------------------------------
    // CAVLC macroblock layer and residual blocks (7.3.5, 9.1, 9.2)
    // ----------------------------------------------------------------------

    // Decodes one macroblock of a CAVLC slice. Returns false on damage.
    fn h264CavlcMacroblock() -> Bool {
        let xy = self.mbXY
        var dct8Allowed = self.pps.transform8x8Mode
        let mbaffTop = self.mbaffFrame && (self.mbY & 1) == 0
        if self.sliceType != sliceI {
            if self.skipRun < 0 {
                self.skipRun = self.br.ue()
                if self.skipRun > self.numMbs {
                    return false
                }
            }
            if self.skipRun > 0 {
                self.skipRun -= 1
                if mbaffTop && self.skipRun == 0 {
                    // The bottom macroblock is coded: the pair's
                    // mb_field_decoding_flag comes now (7.3.4).
                    self.pairField = self.br.bits(1) == 1
                }
                h264SetMbAt()
                h264FillNeighbors()
                h264DecodeSkip()
                return true
            }
            self.skipRun = -1
        }
        if mbaffTop {
            self.pairField = self.br.bits(1) == 1
        }
        h264SetMbAt()
        h264FillNeighbors()
        self.prevMbSkipped = false
        var code = self.br.ue()
        var mbType = 0
        var partCount = 0
        var cbp = 0
        var intra = false
        if self.sliceType == sliceB {
            if code < 23 {
                mbType = bMbTypeInfo[code]
                partCount = bMbPartCount[code]
            } else {
                code -= 23
                intra = true
            }
        } else if self.sliceType == sliceP {
            if code < 5 {
                mbType = pMbTypeInfo[code]
                partCount = pMbPartCount[code]
            } else {
                code -= 5
                intra = true
            }
        } else {
            intra = true
        }
        if intra {
            if code > 25 {
                return false
            }
            cbp = iMbCbp[code]
            self.i16Mode = iMbPredMode[code]
            mbType = iMbTypeInfo[code]
        }
        self.sliceTab[xy] = self.sliceNum
        if (mbType & mbPcm) != 0 {
            self.br.alignToByte()
            let p = self.br.position / 8
            if !h264ReadPcm(p) {
                return false
            }
            let n = if self.hasChroma { 384 } else { 256 }
            self.br.skip(n * 8)
            self.qpTab[xy] = 0
            self.cbpTab[xy] = 0x7EF
            for i in 0..24 {
                self.nzTab[xy * 24 + i] = 16
            }
            self.mbType = mbType
            self.mbTypes[xy] = mbType | self.fieldFlag
            h264WriteBackIntraMotion()
            h264MbDone(2)
            return true
        }
        self.mbType = mbType
        h264FillCaches(mbType)
        if intra {
            if (mbType & mbIntra4x4) != 0 {
                var di = 1
                if dct8Allowed && self.br.bits(1) == 1 {
                    mbType = mbType | mbDct8x8
                    di = 4
                }
                var i = 0
                while i < 16 {
                    let c = self.s8[i]
                    var mode = h264PredIntraMode(c)
                    if self.br.bits(1) == 0 {
                        let rem = self.br.bits(3)
                        mode = if rem >= mode { rem + 1 } else { rem }
                    }
                    if di == 4 {
                        self.predCache[c] = mode
                        self.predCache[c + 1] = mode
                        self.predCache[c + 8] = mode
                        self.predCache[c + 9] = mode
                    } else {
                        self.predCache[c] = mode
                    }
                    i += di
                }
                h264WriteBackPredModes()
            }
            if self.hasChroma {
                self.chromaMode = self.br.ue()
                if self.chromaMode > 3 {
                    return false
                }
            }
            h264WriteBackIntraMotion()
        } else if partCount == 4 {
            if self.sliceType == sliceB {
                var anyDirect = false
                for i in 0..4 {
                    let t = self.br.ue()
                    if t >= 13 {
                        return false
                    }
                    self.subPartCount[i] = bSubPartCount[t]
                    self.subMbType[i] = bSubMbTypeInfo[t]
                    if (self.subMbType[i] & mbDirect) != 0 {
                        anyDirect = true
                    }
                }
                if anyDirect {
                    self.mbType = mbType
                    h264PredDirect()
                    mbType = self.mbType
                    self.refCache[14] = partNotAvailable
                    self.refCache[54] = partNotAvailable
                    self.refCache[30] = partNotAvailable
                    self.refCache[70] = partNotAvailable
                }
            } else {
                for i in 0..4 {
                    let t = self.br.ue()
                    if t >= 4 {
                        return false
                    }
                    self.subPartCount[i] = pSubPartCount[t]
                    self.subMbType[i] = pSubMbTypeInfo[t]
                }
            }
            for list in 0..self.listCount {
                var rc = if list == 0 { self.mbRefCount0 } else { self.mbRefCount1 }
                if (mbType & mbRef0) != 0 {
                    rc = 1
                }
                let usesMask = if list == 0 { mbP0L0 } else { mbP0L1 }
                for i in 0..4 {
                    if (self.subMbType[i] & mbDirect) != 0 {
                        continue
                    }
                    if (self.subMbType[i] & usesMask) != 0 {
                        var t = 0
                        if rc == 2 {
                            t = 1 - self.br.bits(1)
                        } else if rc > 2 {
                            t = self.br.ue()
                            if t >= rc {
                                return false
                            }
                        }
                        self.tmp[list * 4 + i] = t
                    } else {
                        self.tmp[list * 4 + i] = -1
                    }
                }
            }
            if dct8Allowed {
                dct8Allowed = h264Dct8x8Allowed()
            }
            for list in 0..self.listCount {
                let usesMask = if list == 0 { mbP0L0 } else { mbP0L1 }
                for i in 0..4 {
                    let c = 12 + (i & 1) * 2 + (i >> 1) * 16
                    if (self.subMbType[i] & mbDirect) != 0 {
                        self.refCache[list * 40 + c] = self.refCache[list * 40 + c + 1]
                        continue
                    }
                    h264FillRef(list, c, 2, 2, self.tmp[list * 4 + i])
                    let st = self.subMbType[i]
                    if (st & usesMask) != 0 {
                        let bw = if (st & (mb16x16 | mb16x8)) != 0 { 2 } else { 1 }
                        for j in 0..self.subPartCount[i] {
                            let idx = 4 * i + bw * j
                            let cc = self.s8[idx]
                            h264PredMotion(cc, bw, list, self.refCache[list * 40 + cc])
                            let mx = self.predMvx + self.br.se()
                            let my = self.predMvy + self.br.se()
                            if self.frames == self.traceFrame && self.mbXY == self.traceMb {
                                print("  sub {i} part {j} c {cc} pred {self.predMvx},{self.predMvy} mv {mx},{my} A {self.refCache[cc - 1]}:{self.mvxCache[cc - 1]} B {self.refCache[cc - 8]}:{self.mvxCache[cc - 8]} C {self.refCache[cc - 8 + bw]}:{self.mvxCache[cc - 8 + bw]} D {self.refCache[cc - 9]}:{self.mvxCache[cc - 9]}")
                            }
                            if (st & mb16x16) != 0 {
                                h264FillMv(list, cc, 2, 2, mx, my)
                            } else if (st & mb16x8) != 0 {
                                h264FillMv(list, cc, 2, 1, mx, my)
                            } else if (st & mb8x16) != 0 {
                                h264FillMv(list, cc, 1, 2, mx, my)
                            } else {
                                h264FillMv(list, cc, 1, 1, mx, my)
                            }
                        }
                    } else {
                        h264FillMv(list, c, 2, 2, 0, 0)
                    }
                }
            }
        } else if (mbType & mbDirect) != 0 {
            self.mbType = mbType
            h264PredDirect()
            mbType = self.mbType
            if dct8Allowed {
                dct8Allowed = self.sps.direct8x8Inference
            }
        } else {
            // ref_idx_l0 of every partition, then ref_idx_l1, then the mvds
            // (7.3.5.1).
            for list in 0..self.listCount {
                for part in 0..partCount {
                    let usesMask = (if list == 0 { mbP0L0 } else { mbP0L1 }) << part
                    let rc = if list == 0 { self.mbRefCount0 } else { self.mbRefCount1 }
                    var v = listNotUsed
                    if (mbType & usesMask) != 0 {
                        v = 0
                        if rc == 2 {
                            v = 1 - self.br.bits(1)
                        } else if rc > 2 {
                            v = self.br.ue()
                            if v >= rc {
                                return false
                            }
                        }
                    }
                    if (mbType & mb16x16) != 0 {
                        h264FillRef(list, 12, 4, 4, v)
                    } else if (mbType & mb16x8) != 0 {
                        h264FillRef(list, 12 + part * 16, 4, 2, v)
                    } else {
                        h264FillRef(list, 12 + part * 2, 2, 4, v)
                    }
                }
            }
            for list in 0..self.listCount {
                for part in 0..partCount {
                    let usesMask = (if list == 0 { mbP0L0 } else { mbP0L1 }) << part
                    if (mbType & mb16x16) != 0 {
                        if (mbType & usesMask) != 0 {
                            h264PredMotion(12, 4, list, self.refCache[list * 40 + 12])
                            let mx = self.predMvx + self.br.se()
                            let my = self.predMvy + self.br.se()
                            h264FillMv(list, 12, 4, 4, mx, my)
                        }
                    } else if (mbType & mb16x8) != 0 {
                        let c = 12 + part * 16
                        if (mbType & usesMask) != 0 {
                            h264Pred16x8(part, list, self.refCache[list * 40 + c])
                            let mx = self.predMvx + self.br.se()
                            let my = self.predMvy + self.br.se()
                            h264FillMv(list, c, 4, 2, mx, my)
                        } else {
                            h264FillMv(list, c, 4, 2, 0, 0)
                        }
                    } else {
                        let c = 12 + part * 2
                        if (mbType & usesMask) != 0 {
                            h264Pred8x16(part, list, self.refCache[list * 40 + c])
                            let mx = self.predMvx + self.br.se()
                            let my = self.predMvy + self.br.se()
                            h264FillMv(list, c, 2, 4, mx, my)
                        } else {
                            h264FillMv(list, c, 2, 4, 0, 0)
                        }
                    }
                }
            }
        }
        if (mbType & (mb16x16 | mb16x8 | mb8x16 | mb8x8)) != 0 {
            h264WriteBackMotion(mbType)
        }
        if (mbType & mbIntra16x16) == 0 {
            let c = self.br.ue()
            if self.hasChroma {
                if c > 47 {
                    return false
                }
                cbp = if (mbType & mbIntra4x4) != 0 { golombToIntra4x4Cbp[c] } else { golombToInterCbp[c] }
            } else {
                if c > 15 {
                    return false
                }
                cbp = if (mbType & mbIntra4x4) != 0 { golombToIntra4x4CbpGray[c] } else { golombToInterCbpGray[c] }
            }
        }
        if dct8Allowed && (cbp & 15) != 0 && (mbType & mbIntraMask) == 0 {
            if self.br.bits(1) == 1 {
                mbType = mbType | mbDct8x8
            }
        }
        self.cbp = cbp
        self.cbpTab[xy] = cbp
        self.mbType = mbType
        self.mbTypes[xy] = mbType | self.fieldFlag
        if cbp != 0 || (mbType & mbIntra16x16) != 0 {
            let d = self.br.se()
            self.qp += d
            if self.qp < 0 {
                self.qp += 52
            } else if self.qp > 51 {
                self.qp -= 52
            }
            if self.qp < 0 || self.qp > 51 {
                self.qp = max(0, min(51, self.qp))
                return false
            }
            h264SetChromaQp()
            if !h264CavlcResidual(mbType, cbp) {
                return false
            }
        } else {
            for i in 0..24 {
                self.nzCache[self.s8[i]] = 0
            }
        }
        self.qpTab[xy] = self.qp
        h264WriteBackNz()
        if self.br.overrun {
            return false
        }
        h264MbDone(if intra { 1 } else { 0 })
        true
    }

    // The residual of a CAVLC macroblock (7.3.5.3, 7.3.5.3.2).
    fn h264CavlcResidual(_ mbType: Int, _ cbp: Int) -> Bool {
        let intra = (mbType & mbIntraMask) != 0
        let field = self.fieldDecoding
        let scan = if field { fieldScan4x4 } else { zigzag4x4 }
        let scan8x8 = if field { fieldScan8x8 } else { zigzag8x8 }
        let qp = self.qp
        self.hasDcY = false
        if (mbType & mbIntra16x16) != 0 {
            for i in 0..16 {
                self.dcY[i] = 0
            }
            let nC = h264PredNz(self.s8[0])
            let n = h264CavlcBlock(target: 1, at: 0, nC: nC, maxCoeff: 16, scan: scan, scanStart: 0, scanStep: 1, qBase: 0, use8: false)
            if n < 0 {
                return false
            }
            self.hasDcY = n > 0
            if (cbp & 15) != 0 {
                let qBase = qp * 16
                for i in 0..16 {
                    let c = self.s8[i]
                    let k = h264CavlcBlock(target: 0, at: 16 * i, nC: h264PredNz(c), maxCoeff: 15, scan: scan, scanStart: 1, scanStep: 1, qBase: qBase, use8: false)
                    if k < 0 {
                        return false
                    }
                    self.nzCache[c] = k
                }
            } else {
                for i in 0..16 {
                    self.nzCache[self.s8[i]] = 0
                }
            }
        } else {
            let list = if intra { 0 } else { 3 }
            for i8 in 0..4 {
                if (cbp & (1 << i8)) != 0 {
                    if (mbType & mbDct8x8) != 0 {
                        let qBase = (list * 52 + qp) * 64
                        for i4 in 0..4 {
                            let idx = 4 * i8 + i4
                            let c = self.s8[idx]
                            let k = h264CavlcBlock(target: 0, at: 64 * i8, nC: h264PredNz(c), maxCoeff: 16, scan: scan8x8, scanStart: i4, scanStep: 4, qBase: qBase, use8: true)
                            if k < 0 {
                                return false
                            }
                            self.nzCache[c] = k
                        }
                    } else {
                        let qBase = (list * 52 + qp) * 16
                        for i4 in 0..4 {
                            let idx = 4 * i8 + i4
                            let c = self.s8[idx]
                            let k = h264CavlcBlock(target: 0, at: 16 * idx, nC: h264PredNz(c), maxCoeff: 16, scan: scan, scanStart: 0, scanStep: 1, qBase: qBase, use8: false)
                            if k < 0 {
                                return false
                            }
                            self.nzCache[c] = k
                        }
                    }
                } else {
                    let c = self.s8[4 * i8]
                    self.nzCache[c] = 0
                    self.nzCache[c + 1] = 0
                    self.nzCache[c + 8] = 0
                    self.nzCache[c + 9] = 0
                }
            }
        }
        self.hasDcC = 0
        if !self.hasChroma {
            return true
        }
        if (cbp & 0x30) != 0 {
            for c in 0..2 {
                for i in 0..4 {
                    self.dcC[c * 4 + i] = 0
                }
                let n = h264CavlcBlock(target: 2, at: c * 4, nC: -1, maxCoeff: 4, scan: h264Identity, scanStart: 0, scanStep: 1, qBase: 0, use8: false)
                if n < 0 {
                    return false
                }
                if n > 0 {
                    self.hasDcC = self.hasDcC | (1 << c)
                }
            }
        }
        if (cbp & 0x20) != 0 {
            for c in 0..2 {
                let cq = if c == 0 { self.qpCb } else { self.qpCr }
                let list = (if intra { 1 } else { 4 }) + c
                let qBase = (list * 52 + cq) * 16
                for i in 0..4 {
                    let cc = self.s8[16 + c * 4 + i]
                    let k = h264CavlcBlock(target: 0, at: 256 + 64 * c + 16 * i, nC: h264PredNz(cc), maxCoeff: 15, scan: scan, scanStart: 1, scanStep: 1, qBase: qBase, use8: false)
                    if k < 0 {
                        return false
                    }
                    self.nzCache[cc] = k
                }
            }
        } else {
            for i in 16..24 {
                self.nzCache[self.s8[i]] = 0
            }
        }
        true
    }

    // residual_block_cavlc (7.3.5.3.2) for a block of up to maxCoeff
    // coefficients. nC selects the coeff_token table (-1: chroma DC 4:2:0).
    // Levels go to coef[at + scan position] times the dequantisation factor
    // (dq4 or dq8 of the PPS from qBase, see params.tsl), or for DC blocks
    // (target 1: dcY, 2: dcC) unscaled to dcY/dcC[at + scan position].
    // `scan` maps coefficient index k to scan[scanStart + k * scanStep].
    // Returns TotalCoeff, or -1 for damaged data.
    fn h264CavlcBlock(target: Int, at: Int, nC: Int, maxCoeff: Int, scan: [Int], scanStart: Int, scanStep: Int, qBase: Int, use8: Bool) -> Int {
        var token = 0
        if nC < 0 {
            token = h264ReadVlc(self.br, cavlcChromaDcTab, 0, 8)
        } else {
            let t = if nC < 2 { 0 } else if nC < 4 { 1 } else if nC < 8 { 2 } else { 3 }
            token = h264ReadVlc(self.br, cavlcTokenTabs[t], 0, cavlcTokenBits[t])
        }
        if token < 0 {
            return -1
        }
        let total = token >> 2
        let t1 = token & 3
        if total == 0 {
            return 0
        }
        if total > maxCoeff || t1 > total {
            return -1
        }
        // Levels, highest frequency first (9.2.2).
        var suffixLength = if total > 10 && t1 < 3 { 1 } else { 0 }
        var i = 0
        while i < total {
            if i < t1 {
                self.tmp[i] = 1 - 2 * self.br.bits(1)
            } else {
                // level_prefix: leading zeros.
                var prefix = 0
                while self.br.bits(1) == 0 {
                    prefix += 1
                    if prefix > 32 {
                        return -1
                    }
                }
                var levelCode = min(15, prefix) << suffixLength
                if suffixLength > 0 || prefix >= 14 {
                    var size = suffixLength
                    if prefix == 14 && suffixLength == 0 {
                        size = 4
                    }
                    if prefix >= 15 {
                        size = prefix - 3
                    }
                    if size > 0 {
                        levelCode += self.br.bits(size)
                    }
                }
                if prefix >= 15 && suffixLength == 0 {
                    levelCode += 15
                }
                if prefix >= 16 {
                    levelCode += (1 << (prefix - 3)) - 4096
                }
                if i == t1 && t1 < 3 {
                    levelCode += 2
                }
                var level = 0
                if levelCode % 2 == 0 {
                    level = (levelCode + 2) >> 1
                } else {
                    level = (-levelCode - 1) >> 1
                }
                self.tmp[i] = level
                if suffixLength == 0 {
                    suffixLength = 1
                }
                let a = if level < 0 { -level } else { level }
                if a > (3 << (suffixLength - 1)) && suffixLength < 6 {
                    suffixLength += 1
                }
            }
            i += 1
        }
        // total_zeros (9.2.3).
        var zerosLeft = 0
        if total < maxCoeff {
            if nC < 0 {
                zerosLeft = h264ReadVlc(self.br, cavlcChromaDcZerosTab, (total - 1) * 8, 3)
            } else {
                zerosLeft = h264ReadVlc(self.br, cavlcZerosTab, (total - 1) * 512, 9)
            }
            if zerosLeft < 0 {
                return -1
            }
        }
        if zerosLeft + total > maxCoeff {
            return -1
        }
        if self.frames == self.traceFrame && self.mbXY == self.traceMb {
            var lv = ""
            for k in 0..total {
                lv += " {self.tmp[k]}"
            }
            print("cavlc total {total} t1 {t1} zeros {zerosLeft} levels{lv} nC {nC}")
        }
        // run_before and placement (9.2.4): coefficient i (from the highest
        // frequency) sits after the runs of the ones before it.
        var coeffNum = total - 1 + zerosLeft
        i = 0
        while i < total {
            let pos = scan[scanStart + coeffNum * scanStep]
            if self.mode == 1 {
                // Parse mode: recorded as in h264CabacBlock.
                if target == 1 {
                    self.pCoef.append((self.tmp[i] << 9) | (384 + at + pos))
                } else if target == 2 {
                    self.pCoef.append((self.tmp[i] << 9) | (400 + at + pos))
                } else if use8 {
                    self.pCoef.append((((self.tmp[i] * self.pps.dq8[qBase + pos] + 32) >> 6) << 9) | (at + pos))
                } else {
                    self.pCoef.append((((self.tmp[i] * self.pps.dq4[qBase + pos] + 32) >> 6) << 9) | (at + pos))
                }
            } else if target == 1 {
                self.dcY[at + pos] = self.tmp[i]
            } else if target == 2 {
                self.dcC[at + pos] = self.tmp[i]
            } else if use8 {
                self.coef[at + pos] = (self.tmp[i] * self.pps.dq8[qBase + pos] + 32) >> 6
            } else {
                self.coef[at + pos] = (self.tmp[i] * self.pps.dq4[qBase + pos] + 32) >> 6
            }
            if self.frames == self.traceFrame && self.mbXY == self.traceMb {
                print("  place {i} num {coeffNum} pos {pos} -> {self.coef[at + pos]}")
            }
            if i == total - 1 {
                break
            }
            var run = 0
            if zerosLeft > 0 {
                if zerosLeft <= 6 {
                    run = h264ReadVlc(self.br, cavlcRunTab, (zerosLeft - 1) * 8, 3)
                } else {
                    run = h264ReadVlc(self.br, cavlcRunTab, 48, 11)
                }
                if run < 0 || run > zerosLeft {
                    return -1
                }
            }
            zerosLeft -= run
            coeffNum -= run + 1
            i += 1
        }
        total
    }

    // nC for luma or chroma block cache position c (9.2.1): the rounded mean
    // of the left and upper blocks' coefficient counts, 64 marking a block
    // that isn't available.
    fn h264PredNz(_ c: Int) -> Int {
        let left = self.nzCache[c - 1]
        let top = self.nzCache[c - 8]
        var i = left + top
        if i < 64 {
            i = (i + 1) >> 1
        }
        i & 31
    }

    // ----------------------------------------------------------------------
    // CABAC macroblock layer and residual blocks (7.3.5, 9.3)
    // ----------------------------------------------------------------------

    // Decodes one macroblock in a CABAC slice. Returns false on damage.
    fn h264CabacMacroblock() -> Bool {
        let xy = self.mbXY
        var mbType = 0
        var partCount = 0
        var cbp = 0
        var dct8Allowed = self.pps.transform8x8Mode
        let mbaffTop = self.mbaffFrame && (self.mbY & 1) == 0
        if self.sliceType != sliceI {
            var skip = false
            if self.mbaffFrame && !mbaffTop && self.prevMbSkipped {
                skip = self.nextMbSkipped
            } else {
                skip = h264CabacSkip(self.mbX, self.mbY)
            }
            if skip {
                if mbaffTop {
                    // The bottom macroblock's skip flag comes next; when it is
                    // coded, so is the pair's mb_field_decoding_flag.
                    self.mbTypes[xy] = mbSkip
                    self.nextMbSkipped = h264CabacSkip(self.mbX, self.mbY + 1)
                    if !self.nextMbSkipped {
                        self.pairField = h264CabacFieldFlag()
                    }
                }
                h264SetMbAt()
                h264FillNeighbors()
                h264DecodeSkip()
                self.cbpTab[xy] = 0
                self.chromaPredTab[xy] = 0
                self.lastQpDelta = 0
                return true
            }
        }
        if mbaffTop {
            self.pairField = h264CabacFieldFlag()
        }
        self.prevMbSkipped = false
        h264SetMbAt()
        h264FillNeighbors()
        var intraCode = -1
        if self.sliceType == sliceB {
            var ctx = 0
            if self.leftType != 0 && (self.leftType & mbDirect) == 0 {
                ctx += 1
            }
            if self.topType != 0 && (self.topType & mbDirect) == 0 {
                ctx += 1
            }
            var t = 0
            if self.cab.decision(27 + ctx) == 0 {
                t = 0
            } else if self.cab.decision(30) == 0 {
                t = 1 + self.cab.decision(32)
            } else {
                var bits = self.cab.decision(31) << 3
                bits += self.cab.decision(32) << 2
                bits += self.cab.decision(32) << 1
                bits += self.cab.decision(32)
                if bits < 8 {
                    t = bits + 3
                } else if bits == 13 {
                    intraCode = h264CabacIntraMbType(32, false)
                } else if bits == 14 {
                    t = 11
                } else if bits == 15 {
                    t = 22
                } else {
                    bits = (bits << 1) + self.cab.decision(32)
                    t = bits - 4
                }
            }
            if intraCode < 0 {
                mbType = bMbTypeInfo[t]
                partCount = bMbPartCount[t]
            }
        } else if self.sliceType == sliceP {
            if self.cab.decision(14) == 0 {
                var t = 0
                if self.cab.decision(15) == 0 {
                    t = 3 * self.cab.decision(16)
                } else {
                    t = 2 - self.cab.decision(17)
                }
                mbType = pMbTypeInfo[t]
                partCount = pMbPartCount[t]
            } else {
                intraCode = h264CabacIntraMbType(17, false)
            }
        } else {
            intraCode = h264CabacIntraMbType(3, true)
        }
        if intraCode >= 0 {
            if intraCode > 25 {
                return false
            }
            partCount = 0
            cbp = iMbCbp[intraCode]
            self.i16Mode = iMbPredMode[intraCode]
            mbType = iMbTypeInfo[intraCode]
        }
        self.sliceTab[xy] = self.sliceNum
        if (mbType & mbPcm) != 0 {
            // pcm samples follow the terminate bin, byte aligned (7.3.5).
            var p = (self.cab.bitPosition + 7) / 8
            if !h264ReadPcm(p) {
                return false
            }
            p += 384
            if !self.hasChroma {
                p -= 128
            }
            self.cab.start(self.rbsp, at: p, end: self.rbsp.count)
            self.cbpTab[xy] = 0x7EF
            self.chromaPredTab[xy] = 0
            self.qpTab[xy] = 0
            for i in 0..24 {
                self.nzTab[xy * 24 + i] = 16
            }
            self.mbType = mbType
            self.mbTypes[xy] = mbType | self.fieldFlag
            self.lastQpDelta = 0
            h264WriteBackIntraMotion()
            h264MbDone(2)
            return true
        }
        self.mbType = mbType
        let tq = if self.timing { now() } else { 0.0 }
        h264FillCaches(mbType)
        if self.timing {
            self.tA += now() - tq
        }
        if (mbType & mbIntraMask) != 0 {
            if (mbType & mbIntra4x4) != 0 {
                if dct8Allowed && self.cab.decision(399 + self.neighborTransform) == 1 {
                    mbType = mbType | mbDct8x8
                    var i = 0
                    while i < 16 {
                        let c = self.s8[i]
                        let pred = h264PredIntraMode(c)
                        let mode = h264CabacIntra4x4Mode(pred)
                        self.predCache[c] = mode
                        self.predCache[c + 1] = mode
                        self.predCache[c + 8] = mode
                        self.predCache[c + 9] = mode
                        i += 4
                    }
                } else {
                    for i in 0..16 {
                        let c = self.s8[i]
                        let pred = h264PredIntraMode(c)
                        self.predCache[c] = h264CabacIntra4x4Mode(pred)
                    }
                }
                h264WriteBackPredModes()
            }
            if self.hasChroma {
                let m = h264CabacChromaMode()
                self.chromaPredTab[xy] = m
                self.chromaMode = m
            }
            h264WriteBackIntraMotion()
        } else if partCount == 4 {
            if self.sliceType == sliceB {
                var anyDirect = false
                for i in 0..4 {
                    let t = h264CabacBSubType()
                    self.subPartCount[i] = bSubPartCount[t]
                    self.subMbType[i] = bSubMbTypeInfo[t]
                    if (self.subMbType[i] & mbDirect) != 0 {
                        anyDirect = true
                    }
                }
                if anyDirect {
                    self.mbType = mbType
                    h264PredDirect()
                    mbType = self.mbType
                    self.refCache[14] = partNotAvailable
                    self.refCache[54] = partNotAvailable
                    self.refCache[30] = partNotAvailable
                    self.refCache[70] = partNotAvailable
                    for i in 0..4 {
                        let d = if (self.subMbType[i] & mbDirect) != 0 { 1 } else { 0 }
                        h264FillRect(self.directCache, 12 + (i & 1) * 2 + (i >> 1) * 16, 2, 2, d)
                    }
                }
            } else {
                for i in 0..4 {
                    let t = h264CabacPSubType()
                    self.subPartCount[i] = pSubPartCount[t]
                    self.subMbType[i] = pSubMbTypeInfo[t]
                }
            }
            for list in 0..self.listCount {
                let rc = if list == 0 { self.mbRefCount0 } else { self.mbRefCount1 }
                let usesMask = if list == 0 { mbP0L0 } else { mbP0L1 }
                for i in 0..4 {
                    if (self.subMbType[i] & mbDirect) != 0 {
                        continue
                    }
                    let c = 12 + (i & 1) * 2 + (i >> 1) * 16
                    var ref = -1
                    if (self.subMbType[i] & usesMask) != 0 {
                        ref = 0
                        if rc > 1 {
                            ref = h264CabacRef(list, c)
                            if ref < 0 || ref >= rc {
                                return false
                            }
                        }
                    }
                    self.refCache[list * 40 + c + 1] = ref
                    self.refCache[list * 40 + c + 8] = ref
                    self.refCache[list * 40 + c + 9] = ref
                }
            }
            if dct8Allowed {
                dct8Allowed = h264Dct8x8Allowed()
            }
            for list in 0..self.listCount {
                let usesMask = if list == 0 { mbP0L0 } else { mbP0L1 }
                for i in 0..4 {
                    let c = 12 + (i & 1) * 2 + (i >> 1) * 16
                    self.refCache[list * 40 + c] = self.refCache[list * 40 + c + 1]
                    if (self.subMbType[i] & mbDirect) != 0 {
                        h264FillMvd(list, c, 2, 2, 0, 0)
                        continue
                    }
                    let st = self.subMbType[i]
                    if (st & usesMask) != 0 {
                        let bw = if (st & (mb16x16 | mb16x8)) != 0 { 2 } else { 1 }
                        for j in 0..self.subPartCount[i] {
                            let idx = 4 * i + bw * j
                            let cc = self.s8[idx]
                            h264PredMotion(cc, bw, list, self.refCache[list * 40 + cc])
                            h264CabacMvdPair(list, cc)
                            let mx = self.predMvx + self.mvdX
                            let my = self.predMvy + self.mvdY
                            if (st & mb16x16) != 0 {
                                h264FillMv(list, cc, 2, 2, mx, my)
                                h264FillMvd(list, cc, 2, 2, self.mvdAx, self.mvdAy)
                            } else if (st & mb16x8) != 0 {
                                h264FillMv(list, cc, 2, 1, mx, my)
                                h264FillMvd(list, cc, 2, 1, self.mvdAx, self.mvdAy)
                            } else if (st & mb8x16) != 0 {
                                h264FillMv(list, cc, 1, 2, mx, my)
                                h264FillMvd(list, cc, 1, 2, self.mvdAx, self.mvdAy)
                            } else {
                                h264FillMv(list, cc, 1, 1, mx, my)
                                h264FillMvd(list, cc, 1, 1, self.mvdAx, self.mvdAy)
                            }
                        }
                    } else {
                        h264FillMv(list, c, 2, 2, 0, 0)
                        h264FillMvd(list, c, 2, 2, 0, 0)
                    }
                }
            }
        } else if (mbType & mbDirect) != 0 {
            self.mbType = mbType
            h264PredDirect()
            mbType = self.mbType
            h264FillMvd(0, 12, 4, 4, 0, 0)
            h264FillMvd(1, 12, 4, 4, 0, 0)
            if dct8Allowed {
                dct8Allowed = self.sps.direct8x8Inference
            }
        } else {
            if (mbType & mb16x16) != 0 {
                for list in 0..self.listCount {
                    let usesMask = if list == 0 { mbP0L0 } else { mbP0L1 }
                    if (mbType & usesMask) != 0 {
                        let rc = if list == 0 { self.mbRefCount0 } else { self.mbRefCount1 }
                        var ref = 0
                        if rc > 1 {
                            ref = h264CabacRef(list, 12)
                            if ref < 0 || ref >= rc {
                                return false
                            }
                        }
                        h264FillRef(list, 12, 4, 4, ref)
                    } else {
                        h264FillRef(list, 12, 4, 4, listNotUsed)
                    }
                }
                for list in 0..self.listCount {
                    let usesMask = if list == 0 { mbP0L0 } else { mbP0L1 }
                    if (mbType & usesMask) != 0 {
                        h264PredMotion(12, 4, list, self.refCache[list * 40 + 12])
                        h264CabacMvdPair(list, 12)
                        h264FillMvd(list, 12, 4, 4, self.mvdAx, self.mvdAy)
                        h264FillMv(list, 12, 4, 4, self.predMvx + self.mvdX, self.predMvy + self.mvdY)
                    }
                }
            } else if (mbType & mb16x8) != 0 {
                for list in 0..self.listCount {
                    let rc = if list == 0 { self.mbRefCount0 } else { self.mbRefCount1 }
                    for i in 0..2 {
                        let usesMask = (if list == 0 { mbP0L0 } else { mbP0L1 }) << i
                        let c = 12 + i * 16
                        if (mbType & usesMask) != 0 {
                            var ref = 0
                            if rc > 1 {
                                ref = h264CabacRef(list, c)
                                if ref < 0 || ref >= rc {
                                    return false
                                }
                            }
                            h264FillRef(list, c, 4, 2, ref)
                        } else {
                            h264FillRef(list, c, 4, 2, listNotUsed)
                        }
                    }
                }
                for list in 0..self.listCount {
                    for i in 0..2 {
                        let usesMask = (if list == 0 { mbP0L0 } else { mbP0L1 }) << i
                        let c = 12 + i * 16
                        if (mbType & usesMask) != 0 {
                            h264Pred16x8(i, list, self.refCache[list * 40 + c])
                            h264CabacMvdPair(list, c)
                            h264FillMvd(list, c, 4, 2, self.mvdAx, self.mvdAy)
                            h264FillMv(list, c, 4, 2, self.predMvx + self.mvdX, self.predMvy + self.mvdY)
                        } else {
                            h264FillMvd(list, c, 4, 2, 0, 0)
                            h264FillMv(list, c, 4, 2, 0, 0)
                        }
                    }
                }
            } else {
                for list in 0..self.listCount {
                    let rc = if list == 0 { self.mbRefCount0 } else { self.mbRefCount1 }
                    for i in 0..2 {
                        let usesMask = (if list == 0 { mbP0L0 } else { mbP0L1 }) << i
                        let c = 12 + i * 2
                        if (mbType & usesMask) != 0 {
                            var ref = 0
                            if rc > 1 {
                                ref = h264CabacRef(list, c)
                                if ref < 0 || ref >= rc {
                                    return false
                                }
                            }
                            h264FillRef(list, c, 2, 4, ref)
                        } else {
                            h264FillRef(list, c, 2, 4, listNotUsed)
                        }
                    }
                }
                for list in 0..self.listCount {
                    for i in 0..2 {
                        let usesMask = (if list == 0 { mbP0L0 } else { mbP0L1 }) << i
                        let c = 12 + i * 2
                        if (mbType & usesMask) != 0 {
                            h264Pred8x16(i, list, self.refCache[list * 40 + c])
                            h264CabacMvdPair(list, c)
                            h264FillMvd(list, c, 2, 4, self.mvdAx, self.mvdAy)
                            h264FillMv(list, c, 2, 4, self.predMvx + self.mvdX, self.predMvy + self.mvdY)
                        } else {
                            h264FillMvd(list, c, 2, 4, 0, 0)
                            h264FillMv(list, c, 2, 4, 0, 0)
                        }
                    }
                }
            }
        }
        let tw = if self.timing { now() } else { 0.0 }
        if (mbType & (mb16x16 | mb16x8 | mb8x16 | mb8x8)) != 0 {
            self.chromaPredTab[xy] = 0
            h264WriteBackMotion(mbType)
        }
        if self.timing {
            self.tB += now() - tw
        }
        if (mbType & mbIntra16x16) == 0 {
            cbp = h264CabacCbpLuma()
            if self.hasChroma {
                cbp = cbp | (h264CabacCbpChroma() << 4)
            }
        }
        self.cbpTab[xy] = cbp
        self.cbp = cbp
        if dct8Allowed && (cbp & 15) != 0 && (mbType & mbIntraMask) == 0 {
            if self.cab.decision(399 + self.neighborTransform) == 1 {
                mbType = mbType | mbDct8x8
            }
        }
        self.mbType = mbType
        self.mbTypes[xy] = mbType | self.fieldFlag
        if cbp != 0 || (mbType & mbIntra16x16) != 0 {
            // mb_qp_delta (9.3.2.7, ctxIdx 60..63).
            let first = if self.lastQpDelta != 0 { 61 } else { 60 }
            if self.cab.decision(first) == 1 {
                var v = 1
                var ctx = 62
                while self.cab.decision(ctx) == 1 {
                    ctx = 63
                    v += 1
                    if v > 104 {
                        return false
                    }
                }
                let d = if (v & 1) == 1 { (v + 1) >> 1 } else { -((v + 1) >> 1) }
                self.lastQpDelta = d
                self.qp = self.qp + d
                if self.qp < 0 {
                    self.qp += 52
                } else if self.qp > 51 {
                    self.qp -= 52
                }
                h264SetChromaQp()
            } else {
                self.lastQpDelta = 0
            }
            let tr = if self.timing { now() } else { 0.0 }
            h264CabacResidual(mbType, cbp)
            if self.timing {
                self.tC += now() - tr
            }
        } else {
            for i in 0..16 {
                self.nzCache[self.s8[i]] = 0
            }
            for i in 16..24 {
                self.nzCache[self.s8[i]] = 0
            }
            self.lastQpDelta = 0
        }
        self.qpTab[xy] = self.qp
        h264WriteBackNz()
        if self.cab.overrun {
            return false
        }
        h264MbDone(if (mbType & mbIntraMask) != 0 { 1 } else { 0 })
        true
    }

    // mb_skip_flag (ctxIdx 11..13 in P, 24..26 in B; ctxIdxInc from
    // the neighbours A and B that are not skipped, 9.3.3.1.1.1) of the
    // macroblock at (mx, my) (frame macroblock rows; my + 1 for the bottom
    // macroblock of an MBAFF pair whose top was skipped).
    fn h264CabacSkip(_ mx: Int, _ my: Int) -> Bool {
        let w = self.mbW
        var ctx = 0
        var a = -1
        var b = -1
        if self.mbaffFrame {
            let pairTop = mx + (my & ~1) * w
            if mx > 0 {
                a = pairTop - 1
                if (my & 1) == 1 && h264Avail(a) && self.pairField == ((self.mbTypes[a] & mbInterlaced) != 0) {
                    a += w
                }
            }
            if self.pairField {
                b = pairTop - w
                if (my & 1) == 0 && h264Avail(b) && (self.mbTypes[b] & mbInterlaced) != 0 {
                    b -= w
                }
            } else {
                b = mx + (my - 1) * w
            }
        } else {
            let xy = mx + (my * self.rowStep + self.mbRowOff) * w
            if mx > 0 {
                a = xy - 1
            }
            b = xy - self.rowStep * w
        }
        if a >= 0 && h264Avail(a) && (self.mbTypes[a] & mbSkip) == 0 {
            ctx += 1
        }
        if b >= 0 && h264Avail(b) && (self.mbTypes[b] & mbSkip) == 0 {
            ctx += 1
        }
        if self.sliceType == sliceB {
            ctx += 13
        }
        self.cab.decision(11 + ctx) == 1
    }

    // mb_field_decoding_flag (ctxIdx 70..72): ctxIdxInc counts the left
    // and upper pairs that are field pairs (9.3.3.1.1.2).
    fn h264CabacFieldFlag() -> Bool {
        var ctx = 0
        if self.pairField && self.mbX > 0 {
            ctx += 1
        }
        let b = self.mbX + ((self.mbY & ~1) - 2) * self.mbW
        if b >= 0 && h264Avail(b) && (self.mbTypes[b] & mbInterlaced) != 0 {
            ctx += 1
        }
        self.cab.decision(70 + ctx) == 1
    }

    // mb_type of I macroblocks (9.3.2.5, Table 9-36): ctxBase 3 in I slices,
    // 17 in P and 32 in B (prefix handled by the caller).
    fn h264CabacIntraMbType(_ ctxBase: Int, _ intraSlice: Bool) -> Int {
        var st = ctxBase
        if intraSlice {
            var ctx = 0
            if (self.leftType & (mbIntra16x16 | mbPcm)) != 0 {
                ctx += 1
            }
            if (self.topType & (mbIntra16x16 | mbPcm)) != 0 {
                ctx += 1
            }
            if self.cab.decision(st + ctx) == 0 {
                return 0
            }
            st += 2
        } else {
            if self.cab.decision(st) == 0 {
                return 0
            }
        }
        if self.cab.terminate() == 1 {
            return 25
        }
        let i = if intraSlice { 1 } else { 0 }
        var t = 1
        t += 12 * self.cab.decision(st + 1)
        if self.cab.decision(st + 2) == 1 {
            t += 4 + 4 * self.cab.decision(st + 2 + i)
        }
        t += 2 * self.cab.decision(st + 3 + i)
        t += self.cab.decision(st + 3 + 2 * i)
        t
    }

    fn h264CabacIntra4x4Mode(_ pred: Int) -> Int {
        if self.cab.decision(68) == 1 {
            return pred
        }
        var mode = self.cab.decision(69)
        mode += 2 * self.cab.decision(69)
        mode += 4 * self.cab.decision(69)
        if mode >= pred { mode + 1 } else { mode }
    }

    fn h264CabacChromaMode() -> Int {
        var ctx = 0
        if self.leftType != 0 && self.chromaPredTab[self.leftXY] != 0 {
            ctx += 1
        }
        if self.topType != 0 && self.chromaPredTab[self.topXY] != 0 {
            ctx += 1
        }
        if self.cab.decision(64 + ctx) == 0 {
            return 0
        }
        if self.cab.decision(67) == 0 {
            return 1
        }
        if self.cab.decision(67) == 0 {
            return 2
        }
        3
    }

    fn h264CabacCbpLuma() -> Int {
        let a = self.leftCbp
        let b = self.topCbp
        var cbp = 0
        var ctx = (if (a & 2) == 0 { 1 } else { 0 }) + 2 * (if (b & 4) == 0 { 1 } else { 0 })
        cbp += self.cab.decision(73 + ctx)
        ctx = (if (cbp & 1) == 0 { 1 } else { 0 }) + 2 * (if (b & 8) == 0 { 1 } else { 0 })
        cbp += self.cab.decision(73 + ctx) << 1
        ctx = (if (a & 8) == 0 { 1 } else { 0 }) + 2 * (if (cbp & 1) == 0 { 1 } else { 0 })
        cbp += self.cab.decision(73 + ctx) << 2
        ctx = (if (cbp & 4) == 0 { 1 } else { 0 }) + 2 * (if (cbp & 2) == 0 { 1 } else { 0 })
        cbp += self.cab.decision(73 + ctx) << 3
        cbp
    }

    fn h264CabacCbpChroma() -> Int {
        let a = (self.leftCbp >> 4) & 3
        let b = (self.topCbp >> 4) & 3
        var ctx = 0
        if a > 0 {
            ctx += 1
        }
        if b > 0 {
            ctx += 2
        }
        if self.cab.decision(77 + ctx) == 0 {
            return 0
        }
        ctx = 4
        if a == 2 {
            ctx += 1
        }
        if b == 2 {
            ctx += 2
        }
        1 + self.cab.decision(77 + ctx)
    }

    fn h264CabacPSubType() -> Int {
        if self.cab.decision(21) == 1 {
            return 0
        }
        if self.cab.decision(22) == 0 {
            return 1
        }
        if self.cab.decision(23) == 1 {
            return 2
        }
        3
    }

    fn h264CabacBSubType() -> Int {
        if self.cab.decision(36) == 0 {
            return 0
        }
        if self.cab.decision(37) == 0 {
            return 1 + self.cab.decision(39)
        }
        var t = 3
        if self.cab.decision(38) == 1 {
            if self.cab.decision(39) == 1 {
                return 11 + self.cab.decision(39)
            }
            t += 4
        }
        t += 2 * self.cab.decision(39)
        t += self.cab.decision(39)
        t
    }

    // ref_idx (9.3.3.1.1.6) for the partition at cache position c.
    fn h264CabacRef(_ list: Int, _ c: Int) -> Int {
        let lb = list * 40
        let refa = self.refCache[lb + c - 1]
        let refb = self.refCache[lb + c - 8]
        var ctx = 0
        if self.sliceType == sliceB {
            if refa > 0 && self.directCache[c - 1] == 0 {
                ctx += 1
            }
            if refb > 0 && self.directCache[c - 8] == 0 {
                ctx += 2
            }
        } else {
            if refa > 0 {
                ctx += 1
            }
            if refb > 0 {
                ctx += 2
            }
        }
        var ref = 0
        while self.cab.decision(54 + ctx) == 1 {
            ref += 1
            ctx = (ctx >> 2) + 4
            if ref >= 32 {
                return -1
            }
        }
        ref
    }

    // One mvd component (9.3.2.3 UEG3, 9.3.3.1.1.7); ctxBase 40 (x) or 47
    // (y), amvd the sum of the neighbours' absolute mvd. Sets self.mvdAbs.
    fn h264CabacMvd(_ ctxBase: Int, _ amvd: Int) -> Int {
        var inc = 0
        if amvd > 32 {
            inc = 2
        } else if amvd >= 3 {
            inc = 1
        }
        if self.cab.decision(ctxBase + inc) == 0 {
            self.mvdAbs = 0
            return 0
        }
        var mvd = 1
        var ctx = ctxBase + 3
        while mvd < 9 && self.cab.decision(ctx) == 1 {
            if mvd < 4 {
                ctx += 1
            }
            mvd += 1
        }
        if mvd >= 9 {
            var k = 3
            while self.cab.bypass() == 1 {
                mvd += 1 << k
                k += 1
                if k > 24 {
                    self.cab.overrun = true
                    return 0
                }
            }
            while k > 0 {
                k -= 1
                mvd += self.cab.bypass() << k
            }
        }
        self.mvdAbs = mvd
        if self.cab.bypass() == 1 { -mvd } else { mvd }
    }

    // Reads both mvd components for the partition at cache position c and
    // returns them in self.mvdX / self.mvdY (and their magnitudes in mvdAx/Ay).
    fn h264CabacMvdPair(_ list: Int, _ c: Int) {
        let lb = list * 40
        let ax = self.mvdxCache[lb + c - 1] + self.mvdxCache[lb + c - 8]
        let ay = self.mvdyCache[lb + c - 1] + self.mvdyCache[lb + c - 8]
        self.mvdX = h264CabacMvd(40, ax)
        self.mvdAx = self.mvdAbs
        self.mvdY = h264CabacMvd(47, ay)
        self.mvdAy = self.mvdAbs
    }

    // coded_block_flag context (9.3.3.1.1.9) for a non-DC block at cache
    // position c of category cat.
    fn h264CabacCbfCtx(_ cat: Int, _ c: Int) -> Int {
        var ctx = 0
        if self.nzCache[c - 1] > 0 {
            ctx += 1
        }
        if self.nzCache[c - 8] > 0 {
            ctx += 2
        }
        cabacCbfOffset[cat] + ctx
    }

    // The residual of a CABAC macroblock (7.3.5.3).
    fn h264CabacResidual(_ mbType: Int, _ cbp: Int) {
        let intra = (mbType & mbIntraMask) != 0
        let field = self.fieldDecoding
        let scan = if field { fieldScan4x4 } else { zigzag4x4 }
        let scan8x8 = if field { fieldScan8x8 } else { zigzag8x8 }
        let qp = self.qp
        let xy = self.mbXY
        if (mbType & mbIntra16x16) != 0 {
            for i in 0..16 {
                self.dcY[i] = 0
            }
            // Luma DC: coded_block_flag ctx from the neighbours' DC flags.
            var ctx = 0
            if (self.leftCbp & 0x100) != 0 {
                ctx += 1
            }
            if (self.topCbp & 0x100) != 0 {
                ctx += 2
            }
            self.hasDcY = false
            if self.cab.decision(85 + ctx) == 1 {
                let n = h264CabacBlock(cat: 0, target: 1, at: 0, maxCoeff: 16, scan: scan, scanStart: 0, qBase: 0, use8: false)
                self.cbpTab[xy] = self.cbpTab[xy] | 0x100
                self.hasDcY = n > 0
            }
            if (cbp & 15) != 0 {
                let qBase = (0 * 52 + qp) * 16
                for i in 0..16 {
                    let c = self.s8[i]
                    if self.cab.decision(h264CabacCbfCtx(1, c)) == 1 {
                        self.nzCache[c] = h264CabacBlock(cat: 1, target: 0, at: 16 * i, maxCoeff: 15, scan: scan, scanStart: 1, qBase: qBase, use8: false)
                    } else {
                        self.nzCache[c] = 0
                    }
                }
            } else {
                for i in 0..16 {
                    self.nzCache[self.s8[i]] = 0
                }
            }
        } else {
            let list = if intra { 0 } else { 3 }
            for i8 in 0..4 {
                if (cbp & (1 << i8)) != 0 {
                    if (mbType & mbDct8x8) != 0 {
                        let l8 = if intra { 0 } else { 3 }
                        let qBase = (l8 * 52 + qp) * 64
                        let n = h264CabacBlock(cat: 5, target: 0, at: 64 * i8, maxCoeff: 64, scan: scan8x8, scanStart: 0, qBase: qBase, use8: true)
                        let c = self.s8[4 * i8]
                        self.nzCache[c] = n
                        self.nzCache[c + 1] = n
                        self.nzCache[c + 8] = n
                        self.nzCache[c + 9] = n
                    } else {
                        let qBase = (list * 52 + qp) * 16
                        for i4 in 0..4 {
                            let idx = 4 * i8 + i4
                            let c = self.s8[idx]
                            if self.cab.decision(h264CabacCbfCtx(2, c)) == 1 {
                                self.nzCache[c] = h264CabacBlock(cat: 2, target: 0, at: 16 * idx, maxCoeff: 16, scan: scan, scanStart: 0, qBase: qBase, use8: false)
                            } else {
                                self.nzCache[c] = 0
                            }
                        }
                    }
                } else {
                    let c = self.s8[4 * i8]
                    self.nzCache[c] = 0
                    self.nzCache[c + 1] = 0
                    self.nzCache[c + 8] = 0
                    self.nzCache[c + 9] = 0
                }
            }
        }
        if !self.hasChroma {
            return
        }
        self.hasDcC = 0
        if (cbp & 0x30) != 0 {
            for c in 0..2 {
                for i in 0..4 {
                    self.dcC[c * 4 + i] = 0
                }
                var ctx = 0
                if ((self.leftCbp >> (6 + c)) & 1) != 0 {
                    ctx += 1
                }
                if ((self.topCbp >> (6 + c)) & 1) != 0 {
                    ctx += 2
                }
                if self.cab.decision(97 + ctx) == 1 {
                    let n = h264CabacBlock(cat: 3, target: 2, at: c * 4, maxCoeff: 4, scan: h264Identity, scanStart: 0, qBase: 0, use8: false)
                    self.cbpTab[xy] = self.cbpTab[xy] | (0x40 << c)
                    if n > 0 {
                        self.hasDcC = self.hasDcC | (1 << c)
                    }
                }
            }
        }
        if (cbp & 0x20) != 0 {
            for c in 0..2 {
                let cq = if c == 0 { self.qpCb } else { self.qpCr }
                let list = (if intra { 1 } else { 4 }) + c
                let qBase = (list * 52 + cq) * 16
                for i in 0..4 {
                    let n = 16 + c * 4 + i
                    let cc = self.s8[n]
                    if self.cab.decision(h264CabacCbfCtx(4, cc)) == 1 {
                        self.nzCache[cc] = h264CabacBlock(cat: 4, target: 0, at: 256 + 64 * c + 16 * i, maxCoeff: 15, scan: scan, scanStart: 1, qBase: qBase, use8: false)
                    } else {
                        self.nzCache[cc] = 0
                    }
                }
            }
        } else {
            for i in 16..24 {
                self.nzCache[self.s8[i]] = 0
            }
        }
    }

    // residual_block_cabac (7.3.5.3.3) after its coded_block_flag: decodes
    // the significance map and levels of a block of category cat with
    // maxCoeff coefficients. Coefficients go (scaled by the PPS factors from
    // qBase, or unscaled for DC blocks) to coef/dcY/dcC as for CAVLC.
    // Returns the number of non-zero coefficients.
    fn h264CabacBlock(cat: Int, target: Int, at: Int, maxCoeff: Int, scan: [Int], scanStart: Int, qBase: Int, use8: Bool) -> Int {
        let field = if self.fieldDecoding { 6 } else { 0 }
        let n = self.cab.residual(sigBase: self.cabacSigOffset[cat + field], lastBase: self.cabacLastOffset[cat + field], absBase: self.cabacAbsOffset[cat], maxCoeff: maxCoeff, chromaDc: cat == 3, f8: if self.fieldDecoding { 64 } else { 0 })
        if self.mode == 1 {
            // Parse mode: (value << 9) | index, index 0..383 coefficients,
            // 384.. luma DC, 400.. chroma DC (see h264ReconMb).
            let base = if target == 1 { 384 + at } else if target == 2 { 400 + at } else { at }
            for i in 0..n {
                let pos = scan[scanStart + self.cab.resPos[i]]
                let level = self.cab.resLev[i]
                var v = level
                if target == 0 {
                    v = if use8 { (level * self.pps.dq8[qBase + pos] + 32) >> 6 } else { (level * self.pps.dq4[qBase + pos] + 32) >> 6 }
                }
                self.pCoef.append((v << 9) | (base + pos))
            }
            return n
        }
        for i in 0..n {
            let pos = scan[scanStart + self.cab.resPos[i]]
            let level = self.cab.resLev[i]
            if target == 1 {
                self.dcY[at + pos] = level
            } else if target == 2 {
                self.dcC[at + pos] = level
            } else if use8 {
                self.coef[at + pos] = (level * self.pps.dq8[qBase + pos] + 32) >> 6
            } else {
                self.coef[at + pos] = (level * self.pps.dq4[qBase + pos] + 32) >> 6
            }
        }
        n
    }

    // ----------------------------------------------------------------------
    // Motion vector prediction and direct prediction (8.4.1)
    // ----------------------------------------------------------------------

    fn h264PredMotion(_ c: Int, _ partWidth: Int, _ list: Int, _ ref: Int) {
        let lb = list * 40
        let topRef = self.refCache[lb + c - 8]
        let leftRef = self.refCache[lb + c - 1]
        var cIdx = c - 8 + partWidth
        var diagRef = self.refCache[lb + cIdx]
        var cx = 0
        var cy = 0
        var special = false
        if diagRef == partNotAvailable && self.mbaffFrame && c >= 20 && (c & 7) == 4 && self.refCache[lb + 11] != partNotAvailable {
            // MBAFF: block D of a partition at the left edge lies in the
            // left pair, coded the other way (6.4.12.2).
            let leftField = (self.leftType & mbInterlaced) != 0
            if !self.mbField && leftField {
                special = true
                let xy = self.leftXY + self.mbW
                let y4 = (self.mbY & 1) * 2 + (if c >= 32 { 1 } else { 0 })
                diagRef = h264DiagFrom(list, xy, y4, true)
                cx = self.diagX
                cy = self.diagY
            } else if self.mbField && !leftField {
                special = true
                let xy = if c >= 36 { self.leftXY2 } else { self.leftXY }
                let y4 = (c >> 2) & 3
                diagRef = h264DiagFrom(list, xy, y4, false)
                cx = self.diagX
                cy = self.diagY
            }
        }
        if !special {
            if diagRef == partNotAvailable {
                cIdx = c - 9
                diagRef = self.refCache[lb + cIdx]
            }
            cx = self.mvxCache[lb + cIdx]
            cy = self.mvyCache[lb + cIdx]
        }
        let ax = self.mvxCache[lb + c - 1]
        let ay = self.mvyCache[lb + c - 1]
        let bx = self.mvxCache[lb + c - 8]
        let by = self.mvyCache[lb + c - 8]
        var matches = 0
        if diagRef == ref {
            matches += 1
        }
        if topRef == ref {
            matches += 1
        }
        if leftRef == ref {
            matches += 1
        }
        if matches > 1 {
            self.predMvx = h264Median(ax, bx, cx)
            self.predMvy = h264Median(ay, by, cy)
        } else if matches == 1 {
            if leftRef == ref {
                self.predMvx = ax
                self.predMvy = ay
            } else if topRef == ref {
                self.predMvx = bx
                self.predMvy = by
            } else {
                self.predMvx = cx
                self.predMvy = cy
            }
        } else {
            if topRef == partNotAvailable && diagRef == partNotAvailable && leftRef != partNotAvailable {
                self.predMvx = ax
                self.predMvy = ay
            } else {
                self.predMvx = h264Median(ax, bx, cx)
                self.predMvy = h264Median(ay, by, cy)
            }
        }
    }

    // Sets self.predMvx/predMvy to the motion vector predictor of the partition
    // whose top-left block is at cache position c, partWidth 1, 2 or 4 blocks
    // wide, for reference index ref of a list (8.4.1.3).
    // The vector and reference of row y4 (4x4 rows, right column) of
    // macroblock xy for the MBAFF special case of 8.4.1.3.2: converted to
    // frame units (toFrame) or to field units.
    fn h264DiagFrom(_ list: Int, _ xy: Int, _ y4: Int, _ toFrame: Bool) -> Int {
        let useMask = if list == 0 { mbL0 } else { mbL1 }
        self.diagX = 0
        self.diagY = 0
        if (self.mbTypes[xy] & useMask) == 0 {
            return listNotUsed
        }
        let bi = xy * 16 + 3 + 4 * y4
        self.diagX = h264MvxAt(list, bi)
        let my = h264MvyAt(list, bi)
        let ref = h264RefAt(list, xy * 4 + 1 + (y4 & ~1))
        if toFrame {
            self.diagY = my * 2
            return ref >> 1
        }
        self.diagY = my / 2
        ref * 2
    }

    // Directional prediction of 16x8 partitions (8.4.1.3, part n = 0 or 1).
    fn h264Pred16x8(_ part: Int, _ list: Int, _ ref: Int) {
        let lb = list * 40
        if part == 0 {
            if self.refCache[lb + 4] == ref {
                self.predMvx = self.mvxCache[lb + 4]
                self.predMvy = self.mvyCache[lb + 4]
                return
            }
            h264PredMotion(12, 4, list, ref)
        } else {
            if self.refCache[lb + 27] == ref {
                self.predMvx = self.mvxCache[lb + 27]
                self.predMvy = self.mvyCache[lb + 27]
                return
            }
            h264PredMotion(28, 4, list, ref)
        }
    }

    // Directional prediction of 8x16 partitions.
    fn h264Pred8x16(_ part: Int, _ list: Int, _ ref: Int) {
        let lb = list * 40
        if part == 0 {
            if self.refCache[lb + 11] == ref {
                self.predMvx = self.mvxCache[lb + 11]
                self.predMvy = self.mvyCache[lb + 11]
                return
            }
            h264PredMotion(12, 2, list, ref)
        } else {
            var cIdx = 8
            var diagRef = self.refCache[lb + 8]
            if diagRef == partNotAvailable {
                cIdx = 5
                diagRef = self.refCache[lb + 5]
            }
            if diagRef == ref {
                self.predMvx = self.mvxCache[lb + cIdx]
                self.predMvy = self.mvyCache[lb + cIdx]
                return
            }
            h264PredMotion(14, 2, list, ref)
        }
    }

    fn h264FillMv(_ list: Int, _ c: Int, _ w: Int, _ h: Int, _ mx: Int, _ my: Int) {
        let lb = list * 40 + c
        for y in 0..h {
            for x in 0..w {
                self.mvxCache[lb + x + y * 8] = mx
                self.mvyCache[lb + x + y * 8] = my
            }
        }
    }

    fn h264FillRef(_ list: Int, _ c: Int, _ w: Int, _ h: Int, _ r: Int) {
        let lb = list * 40 + c
        for y in 0..h {
            for x in 0..w {
                self.refCache[lb + x + y * 8] = r
            }
        }
    }

    fn h264FillMvd(_ list: Int, _ c: Int, _ w: Int, _ h: Int, _ dx: Int, _ dy: Int) {
        let lb = list * 40 + c
        for y in 0..h {
            for x in 0..w {
                self.mvdxCache[lb + x + y * 8] = dx
                self.mvdyCache[lb + x + y * 8] = dy
            }
        }
    }

    // P_Skip motion (8.4.1.1): zero when A or B is missing or has a zero
    // vector with reference 0, else the 16x16 prediction for reference 0.
    fn h264PredPSkip() {
        h264FillRef(0, 12, 4, 4, 0)
        if self.leftType == 0 || self.topType == 0 {
            h264FillMv(0, 12, 4, 4, 0, 0)
            return
        }
        h264FillMotionCache(mb16x16 | mbP0L0 | mbSkip, 0)
        // A or B with reference 0 and a zero vector (after MBAFF frame/field
        // conversion) give a zero vector (8.4.1.1).
        if (self.refCache[11] == 0 && self.mvxCache[11] == 0 && self.mvyCache[11] == 0) || (self.refCache[4] == 0 && self.mvxCache[4] == 0 && self.mvyCache[4] == 0) {
            h264FillMv(0, 12, 4, 4, 0, 0)
            return
        }
        h264PredMotion(12, 4, 0, 0)
        h264FillMv(0, 12, 4, 4, self.predMvx, self.predMvy)
    }

    // Direct prediction for B_Skip, B_Direct_16x16 and direct 8x8 blocks of
    // B_8x8; may change the macroblock type's partition bits (as the spec's
    // derivation works on 8x8 or 4x4 blocks, and whole-macroblock prediction
    // gives the same result when they agree).
    fn h264PredDirect() {
        if self.sh.directSpatial {
            h264DirectSpatial()
        } else {
            h264DirectTemporal()
        }
    }

    // Picks the colocated macroblock(s) of RefPicList1[0] for direct
    // prediction (8.4.1.2.1). Kind 0: same structure (frame/frame or
    // field/field); 1: the current field takes the two frame macroblocks
    // covering it; 2: the current frame macroblock takes one field
    // macroblock (the field closer in POC, colParity).
    fn h264ColSetup() {
        let k = self.list1[0]
        self.colK = k
        if k == -1 {
            self.colKind = 0
            self.colMbA = self.mbXY
            self.colMbB = self.mbXY
            self.colTypeA = mbIntra4x4
            self.colTypeB = mbIntra4x4
            return
        }
        let curField = self.curStructure != 3 || (self.mbaffFrame && self.mbField)
        let colFieldPic = if k == -2 { self.cur.fieldPicture } else { self.dpb[k].fieldPicture }
        let colMbaff = if k == -2 { self.cur.mbaffFrame } else { self.dpb[k].mbaffFrame }
        // Frame-table row of the current macroblock.
        let row = if self.curStructure != 3 { 2 * self.mbY + self.mbRowOff } else { self.mbY }
        var colField = colFieldPic
        if !colField && colMbaff {
            colField = (h264ColType(self.mbX + row * self.mbW) & mbInterlaced) != 0
        }
        if colField {
            if curField {
                self.colKind = 0
                if self.curStructure != 3 && !colMbaff {
                    let p = if self.listPar1[0] == 2 { 1 } else { 0 }
                    self.colMbA = self.mbX + (2 * self.mbY + p) * self.mbW
                } else {
                    self.colMbA = self.mbX + row * self.mbW
                }
            } else {
                self.colKind = 2
                self.colMbA = self.mbX + ((row & ~1) + self.colParity) * self.mbW
                self.colRowSel = row & 1
            }
            self.colMbB = self.colMbA
        } else {
            if curField {
                self.colKind = 1
                self.colMbA = self.mbX + (row & ~1) * self.mbW
                self.colMbB = self.colMbA + self.mbW
            } else {
                self.colKind = 0
                self.colMbA = self.mbX + row * self.mbW
                self.colMbB = self.colMbA
            }
        }
        self.colTypeA = h264ColType(self.colMbA)
        self.colTypeB = h264ColType(self.colMbB)
    }

    fn h264ColType(_ m: Int) -> Int {
        if self.colK == -2 { self.mbTypes[m] } else { self.dpb[self.colK].mbType[m] }
    }

    fn h264ColRef(_ list: Int, _ i: Int) -> Int {
        let k = self.colK
        if k == -2 {
            return if list == 0 { self.cur.ref0[i] } else { self.cur.ref1[i] }
        }
        if list == 0 { self.dpb[k].ref0[i] } else { self.dpb[k].ref1[i] }
    }

    fn h264ColPic(_ list: Int, _ i: Int) -> Int {
        let k = self.colK
        if k == -2 {
            return if list == 0 { self.cur.pic0[i] } else { self.cur.pic1[i] }
        }
        if list == 0 { self.dpb[k].pic0[i] } else { self.dpb[k].pic1[i] }
    }

    fn h264ColMvx(_ list: Int, _ i: Int) -> Int {
        let k = self.colK
        if k == -2 {
            return if list == 0 { self.cur.mvx0[i] } else { self.cur.mvx1[i] }
        }
        if list == 0 { self.dpb[k].mvx0[i] } else { self.dpb[k].mvx1[i] }
    }

    fn h264ColMvy(_ list: Int, _ i: Int) -> Int {
        let k = self.colK
        if k == -2 {
            return if list == 0 { self.cur.mvy0[i] } else { self.cur.mvy1[i] }
        }
        if list == 0 { self.dpb[k].mvy0[i] } else { self.dpb[k].mvy1[i] }
    }

    // Position (in the reference index tables) of the colocated 8x8 block
    // for 8x8 block i8 of the current macroblock.
    fn h264ColRefIdx(_ i8: Int) -> Int {
        let x8 = i8 & 1
        let y8 = i8 >> 1
        if self.colKind == 1 {
            return if y8 == 0 { self.colMbA * 4 + x8 } else { self.colMbB * 4 + x8 + 2 }
        }
        if self.colKind == 2 {
            return self.colMbA * 4 + x8 + 2 * self.colRowSel
        }
        self.colMbA * 4 + i8
    }

    // Position (in the vector tables) of the colocated corner 4x4 block
    // used with direct_8x8_inference for 8x8 block i8.
    fn h264ColMvIdx(_ i8: Int) -> Int {
        let x8 = i8 & 1
        let y8 = i8 >> 1
        if self.colKind == 1 {
            return if y8 == 0 { self.colMbA * 16 + 3 * x8 } else { self.colMbB * 16 + 3 * x8 + 8 }
        }
        if self.colKind == 2 {
            return self.colMbA * 16 + 3 * x8 + 4 * (2 * self.colRowSel + y8)
        }
        self.colMbA * 16 + 3 * x8 + 12 * y8
    }

    // Spatial direct prediction (8.4.1.2.2) for B_Skip, B_Direct_16x16 and
    // the direct 8x8 blocks of B_8x8.
    fn h264DirectSpatial() {
        let isB8x8 = (self.mbType & mb8x8) != 0
        var subType = mbL0 | mbL1
        var ref0 = -1
        var ref1 = -1
        var mvx0 = 0
        var mvy0 = 0
        var mvx1 = 0
        var mvy1 = 0
        for list in 0..2 {
            let lb = list * 40
            let leftRef = self.refCache[lb + 11]
            let topRef = self.refCache[lb + 4]
            var refC = self.refCache[lb + 8]
            var cIdx = 8
            if refC == partNotAvailable {
                refC = self.refCache[lb + 3]
                cIdx = 3
            }
            // MinPositive of the three.
            var r = -1
            if leftRef >= 0 {
                r = leftRef
            }
            if topRef >= 0 && (r < 0 || topRef < r) {
                r = topRef
            }
            if refC >= 0 && (r < 0 || refC < r) {
                r = refC
            }
            var mx = 0
            var my = 0
            if r >= 0 {
                let ax = self.mvxCache[lb + 11]
                let ay = self.mvyCache[lb + 11]
                let bx = self.mvxCache[lb + 4]
                let by = self.mvyCache[lb + 4]
                let cx = self.mvxCache[lb + cIdx]
                let cy = self.mvyCache[lb + cIdx]
                var matches = 0
                if leftRef == r {
                    matches += 1
                }
                if topRef == r {
                    matches += 1
                }
                if refC == r {
                    matches += 1
                }
                if matches > 1 {
                    mx = h264Median(ax, bx, cx)
                    my = h264Median(ay, by, cy)
                } else if leftRef == r {
                    mx = ax
                    my = ay
                } else if topRef == r {
                    mx = bx
                    my = by
                } else {
                    mx = cx
                    my = cy
                }
            } else {
                let mask = if list == 0 { mbL0 } else { mbL1 }
                if !isB8x8 {
                    self.mbType = self.mbType & ~mask
                }
                subType = subType & ~mask
            }
            if list == 0 {
                ref0 = r
                mvx0 = mx
                mvy0 = my
            } else {
                ref1 = r
                mvx1 = mx
                mvy1 = my
            }
        }
        if ref0 < 0 && ref1 < 0 {
            ref0 = 0
            ref1 = 0
            if !isB8x8 {
                self.mbType = self.mbType | mbL0 | mbL1
            }
            subType = subType | mbL0 | mbL1
        }
        if !isB8x8 && mvx0 == 0 && mvy0 == 0 && mvx1 == 0 && mvy1 == 0 {
            h264FillRef(0, 12, 4, 4, ref0)
            h264FillRef(1, 12, 4, 4, ref1)
            h264FillMv(0, 12, 4, 4, 0, 0)
            h264FillMv(1, 12, 4, 4, 0, 0)
            self.mbType = (self.mbType & ~(mb8x8 | mb16x8 | mb8x16 | mbP1L0 | mbP1L1)) | mb16x16 | mbDirect
            return
        }
        h264ColSetup()
        let colLong = self.listLong1[0]
        let missing = self.colK == -1
        subType = subType | mb16x16 | mbDirect
        let kind = self.colKind
        let typeA = self.colTypeA
        if kind == 1 {
            if (typeA & (mb16x16 | mbIntraMask)) != 0 && (self.colTypeB & (mb16x16 | mbIntraMask)) != 0 && !isB8x8 {
                self.mbType = self.mbType | mb16x8 | mbDirect
            } else {
                self.mbType = self.mbType | mb8x8
            }
        } else if !isB8x8 && (typeA & (mb16x16 | mbIntraMask)) != 0 {
            self.mbType = self.mbType | mb16x16 | mbDirect
        } else if !isB8x8 && (typeA & (mb16x8 | mb8x16)) != 0 {
            self.mbType = self.mbType | mbDirect | (typeA & (mb16x8 | mb8x16))
        } else {
            if !self.sps.direct8x8Inference {
                subType = subType + (mb8x8 - mb16x16)
            }
            self.mbType = self.mbType | mb8x8
        }
        if kind != 0 {
            // Frame/field mismatch: one colocated 8x8 block per 8x8 block.
            var n = 0
            for i8 in 0..4 {
                if isB8x8 && (self.subMbType[i8] & mbDirect) == 0 {
                    continue
                }
                self.subMbType[i8] = subType
                let c = 12 + (i8 & 1) * 2 + (i8 >> 1) * 16
                h264FillRef(0, c, 2, 2, ref0)
                h264FillRef(1, c, 2, 2, ref1)
                let ct = if (i8 >> 1) == 0 { typeA } else { self.colTypeB }
                var ax = mvx0
                var ay = mvy0
                var bx = mvx1
                var by = mvy1
                if !missing && (ct & mbIntraMask) == 0 && !colLong {
                    let ri = h264ColRefIdx(i8)
                    let mi = h264ColMvIdx(i8)
                    let r0 = h264ColRef(0, ri)
                    let r1 = h264ColRef(1, ri)
                    var zero = false
                    if r0 == 0 && h264Abs(h264ColMvx(0, mi)) <= 1 && h264Abs(h264ColMvy(0, mi)) <= 1 {
                        zero = true
                    } else if r0 < 0 && r1 == 0 && h264Abs(h264ColMvx(1, mi)) <= 1 && h264Abs(h264ColMvy(1, mi)) <= 1 {
                        zero = true
                    }
                    if zero {
                        if ref0 <= 0 {
                            ax = 0
                            ay = 0
                        }
                        if ref1 <= 0 {
                            bx = 0
                            by = 0
                        }
                        n += 1
                    }
                }
                h264FillMv(0, c, 2, 2, ax, ay)
                h264FillMv(1, c, 2, 2, bx, by)
            }
            if !isB8x8 && (n & 3) == 0 {
                self.mbType = (self.mbType & ~(mb8x8 | mb16x8 | mb8x16 | mbP1L0 | mbP1L1)) | mb16x16 | mbDirect
            }
            return
        }
        let colIntra = (typeA & mbIntraMask) != 0
        let colMb = self.colMbA
        if (self.mbType & mb16x16) != 0 {
            h264FillRef(0, 12, 4, 4, ref0)
            h264FillRef(1, 12, 4, 4, ref1)
            var ax = mvx0
            var ay = mvy0
            var bx = mvx1
            var by = mvy1
            if !colIntra && !colLong && !missing {
                let r0 = h264ColRef(0, colMb * 4)
                let r1 = h264ColRef(1, colMb * 4)
                let base = colMb * 16
                var zero = false
                if r0 == 0 && h264Abs(h264ColMvx(0, base)) <= 1 && h264Abs(h264ColMvy(0, base)) <= 1 {
                    zero = true
                } else if r0 < 0 && r1 == 0 && h264Abs(h264ColMvx(1, base)) <= 1 && h264Abs(h264ColMvy(1, base)) <= 1 {
                    zero = true
                }
                if zero {
                    if ref0 == 0 {
                        ax = 0
                        ay = 0
                    }
                    if ref1 == 0 {
                        bx = 0
                        by = 0
                    }
                }
            }
            h264FillMv(0, 12, 4, 4, ax, ay)
            h264FillMv(1, 12, 4, 4, bx, by)
            return
        }
        var n = 0
        for i8 in 0..4 {
            let x8 = i8 & 1
            let y8 = i8 >> 1
            if isB8x8 && (self.subMbType[i8] & mbDirect) == 0 {
                continue
            }
            self.subMbType[i8] = subType
            let c = 12 + x8 * 2 + y8 * 16
            h264FillMv(0, c, 2, 2, mvx0, mvy0)
            h264FillMv(1, c, 2, 2, mvx1, mvy1)
            h264FillRef(0, c, 2, 2, ref0)
            h264FillRef(1, c, 2, 2, ref1)
            if colIntra || colLong || missing {
                continue
            }
            let r0 = h264ColRef(0, colMb * 4 + i8)
            let r1 = h264ColRef(1, colMb * 4 + i8)
            if !(r0 == 0 || (r0 < 0 && r1 == 0)) {
                continue
            }
            let lst = if r0 == 0 { 0 } else { 1 }
            if (subType & mb16x16) != 0 {
                // direct_8x8_inference: the corner 4x4 block's vector.
                let bi = colMb * 16 + x8 * 3 + y8 * 12
                if h264Abs(h264ColMvx(lst, bi)) <= 1 && h264Abs(h264ColMvy(lst, bi)) <= 1 {
                    if ref0 == 0 {
                        h264FillMv(0, c, 2, 2, 0, 0)
                    }
                    if ref1 == 0 {
                        h264FillMv(1, c, 2, 2, 0, 0)
                    }
                    n += 4
                }
            } else {
                var m = 0
                for i4 in 0..4 {
                    let bx4 = x8 * 2 + (i4 & 1)
                    let by4 = y8 * 2 + (i4 >> 1)
                    let bi = colMb * 16 + bx4 + by4 * 4
                    if h264Abs(h264ColMvx(lst, bi)) <= 1 && h264Abs(h264ColMvy(lst, bi)) <= 1 {
                        let cc = 12 + bx4 + by4 * 8
                        if ref0 == 0 {
                            self.mvxCache[cc] = 0
                            self.mvyCache[cc] = 0
                        }
                        if ref1 == 0 {
                            self.mvxCache[40 + cc] = 0
                            self.mvyCache[40 + cc] = 0
                        }
                        m += 1
                    }
                }
                if (m & 3) == 0 {
                    self.subMbType[i8] = self.subMbType[i8] + (mb16x16 - mb8x8)
                }
                n += m
            }
        }
        if !isB8x8 && (n & 15) == 0 {
            self.mbType = (self.mbType & ~(mb8x8 | mb16x8 | mb8x16 | mbP1L0 | mbP1L1)) | mb16x16 | mbDirect
        }
    }

    // Temporal direct prediction (8.4.1.2.3).
    fn h264DirectTemporal() {
        let isB8x8 = (self.mbType & mb8x8) != 0
        h264ColSetup()
        let kind = self.colKind
        let typeA = self.colTypeA
        var subType = mb16x16 | mbP0L0 | mbP0L1 | mbDirect
        if kind == 1 {
            if (typeA & (mb16x16 | mbIntraMask)) != 0 && (self.colTypeB & (mb16x16 | mbIntraMask)) != 0 && !isB8x8 {
                self.mbType = self.mbType | mb16x8 | mbL0 | mbL1 | mbDirect
            } else {
                self.mbType = self.mbType | mb8x8 | mbL0 | mbL1
            }
        } else if !isB8x8 && (typeA & (mb16x16 | mbIntraMask)) != 0 {
            self.mbType = self.mbType | mb16x16 | mbP0L0 | mbP0L1 | mbDirect
        } else if !isB8x8 && (typeA & (mb16x8 | mb8x16)) != 0 {
            self.mbType = self.mbType | mbL0 | mbL1 | mbDirect | (typeA & (mb16x8 | mb8x16))
        } else {
            if !self.sps.direct8x8Inference {
                subType = mb8x8 | mbP0L0 | mbP0L1 | mbDirect
            }
            self.mbType = self.mbType | mb8x8 | mbL0 | mbL1
        }
        let missing = self.colK == -1
        if kind != 0 {
            for i8 in 0..4 {
                if isB8x8 && (self.subMbType[i8] & mbDirect) == 0 {
                    continue
                }
                self.subMbType[i8] = subType
                let c = 12 + (i8 & 1) * 2 + (i8 >> 1) * 16
                h264FillRef(1, c, 2, 2, 0)
                let ct = if (i8 >> 1) == 0 { typeA } else { self.colTypeB }
                if missing || (ct & mbIntraMask) != 0 {
                    h264FillRef(0, c, 2, 2, 0)
                    h264FillMv(0, c, 2, 2, 0, 0)
                    h264FillMv(1, c, 2, 2, 0, 0)
                    continue
                }
                let ri = h264ColRefIdx(i8)
                let mi = h264ColMvIdx(i8)
                let lst = if h264ColRef(0, ri) >= 0 { 0 } else { 1 }
                let ref0 = h264MapColToList0(h264ColPic(lst, ri))
                let scale = h264DistScale(ref0)
                let cx = h264ColMvx(lst, mi)
                let cyRaw = h264ColMvy(lst, mi)
                // Field vectors are half the frame ones vertically.
                let cy = if kind == 1 { cyRaw / 2 } else { cyRaw * 2 }
                let mx = (scale * cx + 128) >> 8
                let my = (scale * cy + 128) >> 8
                h264FillRef(0, c, 2, 2, ref0)
                h264FillMv(0, c, 2, 2, mx, my)
                h264FillMv(1, c, 2, 2, mx - cx, my - cy)
            }
            return
        }
        let colMb = self.colMbA
        let colIntra = (typeA & mbIntraMask) != 0 || missing
        if (self.mbType & mb16x16) != 0 {
            h264FillRef(1, 12, 4, 4, 0)
            if colIntra {
                h264FillRef(0, 12, 4, 4, 0)
                h264FillMv(0, 12, 4, 4, 0, 0)
                h264FillMv(1, 12, 4, 4, 0, 0)
                return
            }
            let lst = if h264ColRef(0, colMb * 4) >= 0 { 0 } else { 1 }
            let ref0 = h264MapColToList0(h264ColPic(lst, colMb * 4))
            let cx = h264ColMvx(lst, colMb * 16)
            let cy = h264ColMvy(lst, colMb * 16)
            let scale = h264DistScale(ref0)
            let mx = (scale * cx + 128) >> 8
            let my = (scale * cy + 128) >> 8
            h264FillRef(0, 12, 4, 4, ref0)
            h264FillMv(0, 12, 4, 4, mx, my)
            h264FillMv(1, 12, 4, 4, mx - cx, my - cy)
            return
        }
        for i8 in 0..4 {
            let x8 = i8 & 1
            let y8 = i8 >> 1
            if isB8x8 && (self.subMbType[i8] & mbDirect) == 0 {
                continue
            }
            self.subMbType[i8] = subType
            let c = 12 + x8 * 2 + y8 * 16
            h264FillRef(1, c, 2, 2, 0)
            if colIntra {
                h264FillRef(0, c, 2, 2, 0)
                h264FillMv(0, c, 2, 2, 0, 0)
                h264FillMv(1, c, 2, 2, 0, 0)
                continue
            }
            let lst = if h264ColRef(0, colMb * 4 + i8) >= 0 { 0 } else { 1 }
            let ref0 = h264MapColToList0(h264ColPic(lst, colMb * 4 + i8))
            let scale = h264DistScale(ref0)
            h264FillRef(0, c, 2, 2, ref0)
            if (subType & mb16x16) != 0 {
                let bi = colMb * 16 + x8 * 3 + y8 * 12
                let cx = h264ColMvx(lst, bi)
                let cy = h264ColMvy(lst, bi)
                let mx = (scale * cx + 128) >> 8
                let my = (scale * cy + 128) >> 8
                h264FillMv(0, c, 2, 2, mx, my)
                h264FillMv(1, c, 2, 2, mx - cx, my - cy)
            } else {
                for i4 in 0..4 {
                    let bx4 = x8 * 2 + (i4 & 1)
                    let by4 = y8 * 2 + (i4 >> 1)
                    let bi = colMb * 16 + bx4 + by4 * 4
                    let cx = h264ColMvx(lst, bi)
                    let cy = h264ColMvy(lst, bi)
                    let mx = (scale * cx + 128) >> 8
                    let my = (scale * cy + 128) >> 8
                    let cc = 12 + bx4 + by4 * 8
                    self.mvxCache[cc] = mx
                    self.mvyCache[cc] = my
                    self.mvxCache[40 + cc] = mx - cx
                    self.mvyCache[40 + cc] = my - cy
                }
            }
        }
    }

    // refIdxL0 for temporal direct: the lowest list 0 index holding the
    // picture (frame, or field of it) the colocated block used (8.4.1.2.3);
    // pictures are coded id * 4 + structure. 0 when it isn't there.
    // DistScaleFactor of list 0 index ref0 for the current macroblock
    // (per field parity for MBAFF field macroblocks).
    fn h264DistScale(_ ref0: Int) -> Int {
        if self.mbaffFrame && self.mbField {
            return self.distScaleF[(self.mcParity - 1) * 64 + ref0]
        }
        self.distScale[ref0]
    }

    fn h264MapColToList0(_ pic: Int) -> Int {
        if pic < 0 {
            return 0
        }
        if self.mbaffFrame && self.mbField {
            // Field references of an MBAFF field macroblock: frame entry i,
            // index 2i for the same parity, 2i + 1 for the other.
            let par = if (pic & 3) == 3 { self.mcParity } else { pic & 3 }
            for i in 0..self.refCount0 {
                if (self.listId0[i] & ~3) == (pic & ~3) {
                    return 2 * i + (if par == self.mcParity { 0 } else { 1 })
                }
            }
            return 0
        }
        var target = pic
        if self.curStructure == 3 {
            target = (pic & ~3) | 3
        } else if (pic & 3) == 3 {
            target = (pic & ~3) | self.curStructure
        }
        for i in 0..self.refCount0 {
            if self.listId0[i] == target {
                return i
            }
        }
        0
    }

    // ----------------------------------------------------------------------
    // Reconstruction: intra prediction, residual and inter prediction (8.3, 8.4.2, 8.5)
    // ----------------------------------------------------------------------

    // An Intra 4x4 / 8x8 mode whose neighbours are missing (damaged data)
    // becomes DC prediction.
    fn h264SafeMode(_ m: Int, _ left: Bool, _ top: Bool, _ topLeft: Bool) -> Int {
        var ok = true
        if m == 0 || m == 3 || m == 7 {
            ok = top
        } else if m == 1 || m == 8 {
            ok = left
        } else if m == 4 || m == 5 || m == 6 {
            ok = top && left && topLeft
        } else if m > 8 || m < 0 {
            ok = false
        }
        if ok {
            return m
        }
        h264Warn("intra mode needs missing neighbours")
        2
    }

    fn h264ReconIntra() {
        if self.debugTrace && (self.availTop || self.availTopLeft) && self.chromaAt - self.cStride - 1 < 0 {
            print("bad top: mb {self.mbX},{self.mbY} field {self.mbField} topXY {self.topXY} type {self.topType} t {self.tAvail}")
        }
        if self.noRecon {
            for i in 0..384 {
                self.coef[i] = 0
            }
            return
        }
        if self.debugTrace && self.frames == self.traceFrame && (self.mbXY == self.traceMb || self.traceMb < 0) {
            print("mb {self.mbXY} ({self.mbX},{self.mbY}) field {self.mbField} type {self.mbType} cbp {self.cbp} qp {self.qp} i16 {self.i16Mode} chroma {self.chromaMode} avail l {self.lAvail} t {self.tAvail} tl {self.tlAvail} tr {self.trAvail}")
            var modes = ""
            for n in 0..16 {
                modes += " {self.predCache[self.s8[n]]}"
            }
            print(" modes{modes}")
            var c0 = ""
            for i in 0..16 {
                c0 += " {self.coef[i]}"
            }
            print(" coef0{c0} nz {self.nzCache[12]}")
        }
        let at = self.lumaAt
        let s = self.pStride
        let t = self.mbType
        if !self.doLuma {
        } else if (t & mbIntra16x16) != 0 {
            var m16 = self.i16Mode
        if (m16 == 0 && !self.availTop) || (m16 == 1 && !self.availLeft) || (m16 == 3 && !(self.availTop && self.availLeft && self.availTopLeft)) {
            h264Warn("intra 16x16 mode needs missing neighbours")
            m16 = 2
        }
        h264Pred16x16(self.cur.y, at, s, mode: m16, left: self.availLeft, top: self.availTop, topLeft: self.availTopLeft)
            if self.hasDcY {
                let m = self.pps.dq4[self.qp * 16]
                h264LumaDc(self.coef, self.dcY, m)
            }
            for n in 0..16 {
                let a = at + self.by4[n] * 4 * s + self.bx4[n] * 4
                if self.nzCache[self.s8[n]] > 0 {
                    h264Idct4Add(self.cur.y, a, s, self.coef, 16 * n)
                } else if self.coef[16 * n] != 0 {
                    h264DcAdd(self.cur.y, a, s, self.coef, 16 * n)
                }
            }
        } else if (t & mbDct8x8) != 0 {
            for b8 in 0..4 {
                let x8 = b8 & 1
                let y8 = b8 >> 1
                let a = at + y8 * 8 * s + x8 * 8
                let n4 = 4 * b8
            let left = ((self.lAvail << n4) & 0x8000) != 0
            let top = ((self.tAvail << n4) & 0x8000) != 0
            let topLeft = ((self.tlAvail << n4) & 0x8000) != 0
            let topRight = ((self.trAvail << (n4 + 1)) & 0x8000) != 0
            h264GatherEdge(self.edgeTop, self.cur.y, a, s, n: 8, left: left, top: top, topLeft: topLeft, topRight: topRight)
                h264Filter8x8Edge(self.edgeLeft, self.edgeTop, left: left, top: top, topLeft: topLeft)
                h264PredNxN(self.cur.y, a, s, self.edgeLeft, self.edgeA, self.edgeF, n: 8, mode: h264SafeMode(self.predCache[self.s8[4 * b8]], left, top, topLeft), left: left, top: top)
                let c = self.s8[4 * b8]
                if self.nzCache[c] > 0 || self.nzCache[c + 1] > 0 || self.nzCache[c + 8] > 0 || self.nzCache[c + 9] > 0 {
                    h264Idct8Add(self.cur.y, a, s, self.coef, 64 * b8)
                }
            }
        } else {
            for n in 0..16 {
                let bx = self.bx4[n]
                let by = self.by4[n]
                let a = at + by * 4 * s + bx * 4
                let left = ((self.lAvail << n) & 0x8000) != 0
            let top = ((self.tAvail << n) & 0x8000) != 0
            let topLeft = ((self.tlAvail << n) & 0x8000) != 0
            let topRight = ((self.trAvail << n) & 0x8000) != 0
            h264GatherEdge(self.edgeTop, self.cur.y, a, s, n: 4, left: left, top: top, topLeft: topLeft, topRight: topRight)
                h264PredNxN(self.cur.y, a, s, self.edgeTop, self.edgeA, self.edgeF, n: 4, mode: h264SafeMode(self.predCache[self.s8[n]], left, top, topLeft), left: left, top: top)
                if self.nzCache[self.s8[n]] > 0 {
                    h264Idct4Add(self.cur.y, a, s, self.coef, 16 * n)
                }
            }
        }
        if self.hasChroma {
            var cm = self.chromaMode
            if (cm == 1 && !self.availLeft) || (cm == 2 && !self.availTop) || (cm == 3 && !(self.availTop && self.availLeft && self.availTopLeft)) {
                h264Warn("intra chroma mode needs missing neighbours")
                cm = 0
            }
            let lhalf = self.lAvail & 0x8080
            if cm == 0 && lhalf != 0 && lhalf != 0x8080 {
                let upper = (self.lAvail & 0x8000) != 0
                let v = (if self.availTop { 0 } else { 2 }) + (if upper { 0 } else { 1 })
                h264PredChromaHalfLeft(self.cur.u, self.chromaAt, self.cStride, v)
                h264PredChromaHalfLeft(self.cur.v, self.chromaAt, self.cStride, v)
            } else {
                h264PredChroma(self.cur.u, self.chromaAt, self.cStride, mode: cm, left: self.availLeft, top: self.availTop)
                h264PredChroma(self.cur.v, self.chromaAt, self.cStride, mode: cm, left: self.availLeft, top: self.availTop)
            }
            h264ChromaResidual()
        }
    }

    fn h264ChromaResidual() {
        if (self.cbp & 0x30) == 0 {
            return
        }
        let intra = (self.mbType & mbIntraMask) != 0
        for c in 0..2 {
            if (self.hasDcC & (1 << c)) != 0 {
                let list = (if intra { 1 } else { 4 }) + c
                let cq = if c == 0 { self.qpCb } else { self.qpCr }
                h264ChromaDc(self.coef, self.dcC, c, self.pps.dq4[(list * 52 + cq) * 16])
            }
            for i in 0..4 {
                let k = 256 + 64 * c + 16 * i
                let a = self.chromaAt + (i >> 1) * 4 * self.cStride + (i & 1) * 4
                let nz = self.nzCache[self.s8[16 + c * 4 + i]] > 0
                if c == 0 {
                    if nz {
                        h264Idct4Add(self.cur.u, a, self.cStride, self.coef, k)
                    } else if self.coef[k] != 0 {
                        h264DcAdd(self.cur.u, a, self.cStride, self.coef, k)
                    }
                } else {
                    if nz {
                        h264Idct4Add(self.cur.v, a, self.cStride, self.coef, k)
                    } else if self.coef[k] != 0 {
                        h264DcAdd(self.cur.v, a, self.cStride, self.coef, k)
                    }
                }
            }
        }
    }

    fn h264ReconInter() {
        if self.noRecon {
            for i in 0..384 {
                self.coef[i] = 0
            }
            return
        }
        if self.frames == self.traceFrame && (self.mbXY == self.traceMb || self.traceMb < 0) {
            h264TraceMb()
        }
        let t = self.mbType
        let t0 = if self.timing { now() } else { 0.0 }
        if (t & mb16x16) != 0 {
            h264McPart(12, 0, 0, 16, 16)
        } else if (t & mb16x8) != 0 {
            h264McPart(12, 0, 0, 16, 8)
            h264McPart(28, 0, 8, 16, 8)
        } else if (t & mb8x16) != 0 {
            h264McPart(12, 0, 0, 8, 16)
            h264McPart(14, 8, 0, 8, 16)
        } else {
            for i in 0..4 {
                let x8 = (i & 1) * 8
                let y8 = (i >> 1) * 8
                let c = 12 + (i & 1) * 2 + (i >> 1) * 16
                let st = self.subMbType[i]
                if (st & mb16x16) != 0 {
                    h264McPart(c, x8, y8, 8, 8)
                } else if (st & mb16x8) != 0 {
                    h264McPart(c, x8, y8, 8, 4)
                    h264McPart(c + 8, x8, y8 + 4, 8, 4)
                } else if (st & mb8x16) != 0 {
                    h264McPart(c, x8, y8, 4, 8)
                    h264McPart(c + 1, x8 + 4, y8, 4, 8)
                } else {
                    h264McPart(c, x8, y8, 4, 4)
                    h264McPart(c + 1, x8 + 4, y8, 4, 4)
                    h264McPart(c + 8, x8, y8 + 4, 4, 4)
                    h264McPart(c + 9, x8 + 4, y8 + 4, 4, 4)
                }
            }
        }
        if self.timing {
            self.tMc += now() - t0
        }
        if self.spSlice {
            h264SpResidual()
            return
        }
        if self.cbp == 0 {
            return
        }
        let at = self.lumaAt
        let s = self.pStride
        if !self.doLuma {
        } else if (t & mbDct8x8) != 0 {
            for b8 in 0..4 {
                let c = self.s8[4 * b8]
                if self.nzCache[c] > 0 || self.nzCache[c + 1] > 0 || self.nzCache[c + 8] > 0 || self.nzCache[c + 9] > 0 {
                    h264Idct8Add(self.cur.y, at + (b8 >> 1) * 8 * s + (b8 & 1) * 8, s, self.coef, 64 * b8)
                }
            }
        } else {
            for n in 0..16 {
                if self.nzCache[self.s8[n]] > 0 {
                    h264Idct4Add(self.cur.y, at + self.by4[n] * 4 * s + self.bx4[n] * 4, s, self.coef, 16 * n)
                }
            }
        }
        if self.hasChroma {
            h264ChromaResidual()
        }
    }

    // SP decoding of an inter macroblock in an SP slice (8.6.1 luma,
    // 8.6.2 chroma): the prediction goes to the transform domain, the
    // coefficient levels are added there, the sum is quantized with QS and
    // then decoded as residual alone (the prediction is inside it).
    fn h264SpResidual() {
        let qs = self.qsY
        let s = self.pStride
        let at = self.lumaAt
        var c: [Int] = core.zeros(16)
        for n in 0..(if self.doLuma { 16 } else { 0 }) {
            let a = at + self.by4[n] * 4 * s + self.bx4[n] * 4
            h264SpForward(self.cur.y, a, s, c)
            for pos in 0..16 {
                let k = 16 * n + pos
                let cls = h264SpClass(pos)
                // coef holds c_r * normAdjust(QPy) << (QPy / 6) already.
                let cs = c[pos] + ((self.coef[k] * h264SpA(cls)) >> 6)
                let q = h264SpQuant(cs, qs, cls, 15)
                self.coef[k] = (q * normAdjust4[(qs % 6) * 3 + cls]) << (qs / 6)
            }
            for y in 0..4 {
                for x in 0..4 {
                    self.cur.y[a + y * s + x] = 0
                }
            }
            h264Idct4Add(self.cur.y, a, s, self.coef, 16 * n)
        }
        if !self.hasChroma {
            return
        }
        let cs = self.cStride
        for comp in 0..2 {
            let qp = if comp == 0 { self.qpCb } else { self.qpCr }
            let qsc = self.pps.chromaQp[comp * 52 + qs]
            var dcp: [Int] = [0, 0, 0, 0]
            for i in 0..4 {
                let a = self.chromaAt + (i >> 1) * 4 * cs + (i & 1) * 4
                if comp == 0 {
                    h264SpForward(self.cur.u, a, cs, c)
                } else {
                    h264SpForward(self.cur.v, a, cs, c)
                }
                dcp[i] = c[0]
                for pos in 1..16 {
                    let k = 256 + 64 * comp + 16 * i + pos
                    let cls = h264SpClass(pos)
                    let v = c[pos] + ((self.coef[k] * h264SpA(cls)) >> 6)
                    let q = h264SpQuant(v, qsc, cls, 15)
                    self.coef[k] = (q * normAdjust4[(qsc % 6) * 3 + cls]) << (qsc / 6)
                }
            }
            // DC: 2x2 transform of the prediction DCs plus the scaled levels.
            let p0 = dcp[0]
            let p1 = dcp[1]
            let p2 = dcp[2]
            let p3 = dcp[3]
            let t: [Int] = [p0 + p1 + p2 + p3, p0 - p1 + p2 - p3, p0 + p1 - p2 - p3, p0 - p1 - p2 + p3]
            let na = normAdjust4[(qp % 6) * 3]
            for i in 0..4 {
                let r = self.dcC[comp * 4 + i]
                let v = t[i] + (((r * na * 16) << (qp / 6)) >> 5)
                self.dcC[comp * 4 + i] = h264SpQuant(v, qsc, 0, 16)
            }
            h264ChromaDc(self.coef, self.dcC, comp, self.pps.dq4[((4 + comp) * 52 + qsc) * 16])
            for i in 0..4 {
                let a = self.chromaAt + (i >> 1) * 4 * cs + (i & 1) * 4
                for y in 0..4 {
                    for x in 0..4 {
                        if comp == 0 {
                            self.cur.u[a + y * cs + x] = 0
                        } else {
                            self.cur.v[a + y * cs + x] = 0
                        }
                    }
                }
                if comp == 0 {
                    h264Idct4Add(self.cur.u, a, cs, self.coef, 256 + 16 * i)
                } else {
                    h264Idct4Add(self.cur.v, a, cs, self.coef, 320 + 16 * i)
                }
            }
        }
    }

    // A macroblock is parsed: reconstruct it, or in parse mode record what
    // reconstruction reads (kind 0 inter, 1 intra, 2 I_PCM).
    fn h264MbDone(_ kind: Int) {
        if self.mode != 1 {
            if kind == 2 {
                h264ReconPcm()
            } else if kind == 1 {
                h264ReconIntra()
            } else {
                h264ReconInter()
            }
            return
        }
        // Record: position * 2 + field pair flag, kind, type, cbp, qp, DC
        // flags, 16x16 and chroma modes, sub-macroblock types, coefficient
        // count; then (unless skipped) the 24 coefficient counts, the 16
        // intra NxN modes, the 384 PCM samples.
        let t = self.mbType
        self.pRec.append((self.mbY * self.mbW + self.mbX) * 2 + (if self.pairField { 1 } else { 0 }))
        self.pRec.append(kind)
        self.pRec.append(t)
        self.pRec.append(self.cbp)
        self.pRec.append(self.qp)
        self.pRec.append((if self.hasDcY { 1 } else { 0 }) | (self.hasDcC << 1))
        self.pRec.append(self.i16Mode)
        self.pRec.append(self.chromaMode)
        for i in 0..4 {
            self.pRec.append(self.subMbType[i])
        }
        self.pRec.append(self.pCoef.count - self.pCoefMb)
        if (t & mbSkip) == 0 {
            for i in 0..24 {
                self.pRec.append(self.nzCache[self.s8[i]])
            }
        }
        if kind == 1 && (t & (mbIntra4x4 | mbDct8x8)) != 0 && (t & mbIntra16x16) == 0 {
            for n in 0..16 {
                self.pRec.append(self.predCache[self.s8[n]])
            }
        }
        if kind == 2 {
            for i in 0..384 {
                self.pRec.append(self.pcmBytes[i])
            }
        }
        self.pCoefMb = self.pCoef.count
        self.pMbs += 1
    }

    // Reconstruct mode: the recorded macroblocks of the current slice.
    fn h264ReconSlice() {
        if !self.rInstalled {
            h264Install()
        }
        let ts = if self.timing { now() } else { 0.0 }
        for _ in 0..self.rSliceMbs {
            h264ReconMb()
        }
        if self.timing {
            self.tSlice += now() - ts
        }
    }

    // Reconstruct mode: one recorded macroblock (see h264MbDone).
    fn h264ReconMb() {
        let tl0 = if self.timing { now() } else { 0.0 }
        let rec = self.rp.rec
        var i = self.rRec
        let pos = rec[i]
        let kind = rec[i + 1]
        let t = rec[i + 2]
        self.pairField = (pos & 1) == 1
        let a = pos >> 1
        self.mbX = a % self.mbW
        self.mbY = a / self.mbW
        self.mbXY = if self.mbaffFrame { a } else { self.mbX + (self.mbY * self.rowStep + self.mbRowOff) * self.mbW }
        h264SetMbAt()
        // Decoded now: neighbour availability follows decoding order.
        self.sliceTab[self.mbXY] = self.sliceNum
        self.mbType = t
        self.cbp = rec[i + 3]
        self.qp = rec[i + 4]
        h264SetChromaQp()
        let dcFlags = rec[i + 5]
        self.hasDcY = (dcFlags & 1) != 0
        self.hasDcC = dcFlags >> 1
        self.i16Mode = rec[i + 6]
        self.chromaMode = rec[i + 7]
        for k in 0..4 {
            self.subMbType[k] = rec[i + 8 + k]
        }
        let nCoef = rec[i + 12]
        i += 13
        if (t & mbSkip) == 0 {
            for k in 0..24 {
                self.nzCache[self.s8[k]] = rec[i + k]
            }
            i += 24
        } else {
            for k in 0..24 {
                self.nzCache[self.s8[k]] = 0
            }
        }
        if kind == 1 && (t & (mbIntra4x4 | mbDct8x8)) != 0 && (t & mbIntra16x16) == 0 {
            for n in 0..16 {
                self.predCache[self.s8[n]] = rec[i + n]
            }
            i += 16
        }
        if kind == 2 {
            if self.pcmBytes.count < 384 {
                self.pcmBytes = core.zeros(384)
            }
            for k in 0..384 {
                self.pcmBytes[k] = rec[i + k]
            }
            i += 384
        }
        self.rRec = i
        // Coefficients: zero DC values first, then scatter.
        for k in 0..16 {
            self.dcY[k] = 0
        }
        for k in 0..8 {
            self.dcC[k] = 0
        }
        if nCoef > 0 {
            let cs = self.rp.coefs
            let c0 = self.rCoef
            let doL = self.doLuma
            let doC = self.hasChroma
            for k in c0..(c0 + nCoef) {
                let v = cs[k]
                let idx = v & 511
                // Only the planes this reconstructor makes (what it skips
                // would stay behind for the next macroblock).
                if idx < 256 {
                    if doL {
                        self.coef[idx] = v >> 9
                    }
                } else if idx < 384 {
                    if doC {
                        self.coef[idx] = v >> 9
                    }
                } else if idx < 400 {
                    if doL {
                        self.dcY[idx - 384] = v >> 9
                    }
                } else if doC {
                    self.dcC[idx - 400] = v >> 9
                }
            }
            self.rCoef = c0 + nCoef
        }
        self.reconWarn = true
        let tl1 = if self.timing { now() } else { 0.0 }
        if self.timing {
            self.tA += tl1 - tl0
        }
        if kind == 2 {
            h264ReconPcm()
        } else if kind == 1 {
            h264FillNeighbors()
            h264FillIntraAvail()
            h264ReconIntra()
            if self.timing {
                self.tC += now() - tl1
            }
        } else {
            h264LoadMotion()
            if self.timing {
                self.tB += now() - tl1
            }
            h264ReconInter()
        }
        self.reconWarn = false
    }

    // Reconstruct mode: the motion caches of the current macroblock from
    // the picture's motion tables.
    fn h264LoadMotion() {
        let m = self.mbXY
        for list in 0..self.listCount {
            let lb = list * 40 + 12
            for y in 0..4 {
                for x in 0..4 {
                    let c = lb + x + y * 8
                    let r = m * 4 + (y >> 1) * 2 + (x >> 1)
                    let v = m * 16 + x + y * 4
                    if list == 0 {
                        self.refCache[c] = self.cur.ref0[r]
                        self.mvxCache[c] = self.cur.mvx0[v]
                        self.mvyCache[c] = self.cur.mvy0[v]
                    } else {
                        self.refCache[c] = self.cur.ref1[r]
                        self.mvxCache[c] = self.cur.mvx1[v]
                        self.mvyCache[c] = self.cur.mvy1[v]
                    }
                }
            }
        }
    }

    fn h264ReconPcm() {
        let at = self.lumaAt
        let s = self.pStride
        for y in 0..(if self.doLuma { 16 } else { 0 }) {
            for x in 0..16 {
                self.cur.y[at + y * s + x] = self.pcmBytes[y * 16 + x]
            }
        }
        if self.hasChroma {
            for y in 0..8 {
                for x in 0..8 {
                    self.cur.u[self.chromaAt + y * self.cStride + x] = self.pcmBytes[256 + y * 8 + x]
                    self.cur.v[self.chromaAt + y * self.cStride + x] = self.pcmBytes[320 + y * 8 + x]
                }
            }
        }
    }

    // Motion compensation of one partition: w x h luma samples at (x, y) in
    // the macroblock, whose vectors are at cache position c.
    fn h264McPart(_ c: Int, _ x: Int, _ y: Int, _ w: Int, _ h: Int) {
        let r0 = self.refCache[c]
        let r1 = if self.listCount > 1 { self.refCache[40 + c] } else { -1 }
        let use0 = r0 >= 0
        let use1 = r1 >= 0
        if !use0 && !use1 {
            return
        }
        let lx = self.mbX * 16 + x
        let ly = self.mcRow + y
        // MBAFF field macroblocks index fields: frame entry refIdx >> 1, the
        // same parity for even refIdx (8.4.2.1).
        let fm = self.mbaffFrame && self.mbField
        let k0 = if use0 { self.list0[if fm { r0 >> 1 } else { r0 }] } else { -1 }
        let k1 = if use1 { self.list1[if fm { r1 >> 1 } else { r1 }] } else { -1 }
        let p0 = if !use0 { 3 } else if fm { (if (r0 & 1) == 0 { self.mcParity } else { 3 - self.mcParity }) } else { self.listPar0[r0] }
        let p1 = if !use1 { 3 } else if fm { (if (r1 & 1) == 0 { self.mcParity } else { 3 - self.mcParity }) } else { self.listPar1[r1] }
        var plain = self.weightMode == 0
        if self.weightMode == 1 {
            let w0i = if fm { r0 >> 1 } else { r0 }
            let w1i = if fm { r1 >> 1 } else { r1 }
            plain = (!use0 || self.wDef0[w0i] == 1) && (!use1 || self.wDef1[w1i] == 1)
        } else if self.weightMode == 2 {
            if !(use0 && use1) {
                plain = true
            } else {
                let w1 = if fm { self.implicitWF[(self.mcParity - 1) * 4096 + r0 * 64 + r1] } else { self.implicitW[r0 * 32 + r1] }
                plain = w1 == 32
            }
        }
        let direct = plain && k0 != -2 && k1 != -2
        if direct {
            // Unweighted: predict straight into the picture.
            var avg = false
            for list in 0..2 {
                let r = if list == 0 { r0 } else { r1 }
                if r < 0 {
                    continue
                }
                let k = if list == 0 { k0 } else { k1 }
                if k < 0 {
                    continue
                }
                let par = if list == 0 { p0 } else { p1 }
                let mx = self.mvxCache[list * 40 + c]
                let my = self.mvyCache[list * 40 + c]
                let fo = if par == 2 { 1 } else { 0 }
                let refY = self.dpb[k].y
                if self.doLuma {
                    h264McLuma(self.cur.y, self.lumaAt + y * self.pStride + x, self.pStride, self.mc.tmp, self.mc.buf, refY, fo * self.lumaW, self.pStride, self.lumaW, self.picH, lx + (mx >> 2), ly + (my >> 2), mx & 3, my & 3, w, h, avg)
                }
                if self.hasChroma {
                    let cx = (lx >> 1) * 8 + mx
                    let cy = (ly >> 1) * 8 + my + h264ChromaAdj(par)
                    let dc = self.chromaAt + (y >> 1) * self.cStride + (x >> 1)
                    let refU = self.dpb[k].u
                    let refV = self.dpb[k].v
                    h264McChroma2(self.cur.u, self.cur.v, dc, self.cStride, self.mc.buf, refU, refV, fo * self.chromaW, self.cStride, self.chromaW, self.picH >> 1, cx >> 3, cy >> 3, cx & 7, cy & 7, w >> 1, h >> 1, avg)

                }
                avg = true
            }
            return
        }
        for list in 0..2 {
            let r = if list == 0 { r0 } else { r1 }
            if r < 0 {
                continue
            }
            let k = if list == 0 { k0 } else { k1 }
            if k == -1 {
                continue
            }
            let par = if list == 0 { p0 } else { p1 }
            let mx = self.mvxCache[list * 40 + c]
            let my = self.mvyCache[list * 40 + c]
            h264McRef(k, par, list, lx, ly, mx, my, w, h, x, y)
        }
        h264Combine(r0, r1, x, y, w, h)
    }

    // Vertical chroma vector offset for a field referencing a field of
    // the other parity (Table 8-10), in eighth chroma samples.
    fn h264ChromaAdj(_ par: Int) -> Int {
        if self.mcParity == 3 || par == 3 {
            return 0
        }
        let cb = if self.mcParity == 2 { 1 } else { 0 }
        let rb = if par == 2 { 1 } else { 0 }
        2 * (cb - rb)
    }

    // Interpolates one list's prediction from DPB entry k (-2: the current
    // frame) into the prediction buffers.
    fn h264McRef(_ k: Int, _ par: Int, _ list: Int, _ lx: Int, _ ly: Int, _ mx: Int, _ my: Int, _ w: Int, _ h: Int, _ bx: Int, _ by: Int) {
        let fo = if par == 2 { 1 } else { 0 }
        let refY = if k == -2 { self.cur.y } else { self.dpb[k].y }
        if self.doLuma {
            self.mc.luma(refY, off: fo * self.lumaW, stride: self.pStride, pw: self.lumaW, ph: self.picH, px: lx + (mx >> 2), py0: ly + (my >> 2), fx: mx & 3, fy: my & 3, w: w, h: h, list: list, bx: bx, by: by)
        }
        if !self.hasChroma {
            return
        }
        let cx = (lx >> 1) * 8 + mx
        let cy = (ly >> 1) * 8 + my + h264ChromaAdj(par)
        let refU = if k == -2 { self.cur.u } else { self.dpb[k].u }
        self.mc.chroma(refU, off: fo * self.chromaW, stride: self.cStride, pw: self.chromaW, ph: self.picH >> 1, px: cx >> 3, py0: cy >> 3, fx: cx & 7, fy: cy & 7, w: w >> 1, h: h >> 1, slot: list, bx: bx >> 1, by: by >> 1)
        let refV = if k == -2 { self.cur.v } else { self.dpb[k].v }
        self.mc.chroma(refV, off: fo * self.chromaW, stride: self.cStride, pw: self.chromaW, ph: self.picH >> 1, px: cx >> 3, py0: cy >> 3, fx: cx & 7, fy: cy & 7, w: w >> 1, h: h >> 1, slot: 2 + list, bx: bx >> 1, by: by >> 1)
    }

    // Writes the (weighted) prediction of a partition into the picture
    // (8.4.2.3).
    fn h264Combine(_ r0: Int, _ r1: Int, _ x: Int, _ y: Int, _ w: Int, _ h: Int) {
        let at = self.lumaAt + y * self.pStride + x
        let s = self.pStride
        let cat = self.chromaAt + (y >> 1) * self.cStride + (x >> 1)
        let cs = self.cStride
        let cw = w >> 1
        let ch = h >> 1
        let mode = self.weightMode
        let hl = if self.doLuma { h } else { 0 }
        let fm = self.mbaffFrame && self.mbField
        let w0i = if fm { r0 >> 1 } else { r0 }
        let w1i = if fm { r1 >> 1 } else { r1 }
        if r0 >= 0 && r1 >= 0 {
            if mode == 0 {
                for j in 0..hl {
                    for i in 0..w {
                        let q = (y + j) * 16 + x + i
                        self.cur.y[at + j * s + i] = (self.mc.py[q] + self.mc.py[256 + q] + 1) >> 1
                    }
                }
                if self.hasChroma {
                    for j in 0..ch {
                        for i in 0..cw {
                            let q = ((y >> 1) + j) * 8 + (x >> 1) + i
                            self.cur.u[cat + j * cs + i] = (self.mc.pc[q] + self.mc.pc[64 + q] + 1) >> 1
                            self.cur.v[cat + j * cs + i] = (self.mc.pc[128 + q] + self.mc.pc[192 + q] + 1) >> 1
                        }
                    }
                }
                return
            }
            var w0 = 0
            var w1 = 0
            var o = 0
            var logWD = 0
            if mode == 1 {
                w0 = self.lumaW0[w0i]
                w1 = self.lumaW1[w1i]
                o = (self.lumaO0[w0i] + self.lumaO1[w1i] + 1) >> 1
                logWD = self.lumaLog2
            } else {
                w1 = if fm { self.implicitWF[(self.mcParity - 1) * 4096 + r0 * 64 + r1] } else { self.implicitW[r0 * 32 + r1] }
                w0 = 64 - w1
                logWD = 5
            }
            for j in 0..hl {
                for i in 0..w {
                    let q = (y + j) * 16 + x + i
                    self.cur.y[at + j * s + i] = h264Clip(((self.mc.py[q] * w0 + self.mc.py[256 + q] * w1 + (1 << logWD)) >> (logWD + 1)) + o)
                }
            }
            if self.hasChroma {
                for c in 0..2 {
                    var cw0 = w0
                    var cw1 = w1
                    var co = 0
                    var cl = logWD
                    if mode == 1 {
                        cw0 = self.chromaW0[w0i * 2 + c]
                        cw1 = self.chromaW1[w1i * 2 + c]
                        co = (self.chromaO0[w0i * 2 + c] + self.chromaO1[w1i * 2 + c] + 1) >> 1
                        cl = self.chromaLog2
                    }
                    for j in 0..ch {
                        for i in 0..cw {
                            let q = ((y >> 1) + j) * 8 + (x >> 1) + i
                            if c == 0 {
                                self.cur.u[cat + j * cs + i] = h264Clip(((self.mc.pc[q] * cw0 + self.mc.pc[64 + q] * cw1 + (1 << cl)) >> (cl + 1)) + co)
                            } else {
                                self.cur.v[cat + j * cs + i] = h264Clip(((self.mc.pc[128 + q] * cw0 + self.mc.pc[192 + q] * cw1 + (1 << cl)) >> (cl + 1)) + co)
                            }
                        }
                    }
                }
            }
            return
        }
        let l1 = r1 >= 0
        let r = if l1 { r1 } else { r0 }
        if mode != 1 {
            for j in 0..hl {
                for i in 0..w {
                    let q = (y + j) * 16 + x + i
                    self.cur.y[at + j * s + i] = if l1 { self.mc.py[256 + q] } else { self.mc.py[q] }
                }
            }
            if self.hasChroma {
                for j in 0..ch {
                    for i in 0..cw {
                        let q = ((y >> 1) + j) * 8 + (x >> 1) + i
                        self.cur.u[cat + j * cs + i] = if l1 { self.mc.pc[64 + q] } else { self.mc.pc[q] }
                        self.cur.v[cat + j * cs + i] = if l1 { self.mc.pc[192 + q] } else { self.mc.pc[128 + q] }
                    }
                }
            }
            return
        }
        // Explicit weighting of one list.
        let wr = if fm { r >> 1 } else { r }
    let lw = if l1 { self.lumaW1[wr] } else { self.lumaW0[wr] }
        let lo = if l1 { self.lumaO1[wr] } else { self.lumaO0[wr] }
        let ll = self.lumaLog2
        let rnd = if ll >= 1 { 1 << (ll - 1) } else { 0 }
        for j in 0..hl {
            for i in 0..w {
                let q = (y + j) * 16 + x + i
                let p = if l1 { self.mc.py[256 + q] } else { self.mc.py[q] }
                self.cur.y[at + j * s + i] = h264Clip(((p * lw + rnd) >> ll) + lo)
            }
        }
        if self.hasChroma {
            let cl = self.chromaLog2
            let crnd = if cl >= 1 { 1 << (cl - 1) } else { 0 }
            for c in 0..2 {
                let cwt = if l1 { self.chromaW1[wr * 2 + c] } else { self.chromaW0[wr * 2 + c] }
                let co = if l1 { self.chromaO1[wr * 2 + c] } else { self.chromaO0[wr * 2 + c] }
                for j in 0..ch {
                    for i in 0..cw {
                        let q = ((y >> 1) + j) * 8 + (x >> 1) + i
                        if c == 0 {
                            let p = if l1 { self.mc.pc[64 + q] } else { self.mc.pc[q] }
                            self.cur.u[cat + j * cs + i] = h264Clip(((p * cwt + crnd) >> cl) + co)
                        } else {
                            let p = if l1 { self.mc.pc[192 + q] } else { self.mc.pc[128 + q] }
                            self.cur.v[cat + j * cs + i] = h264Clip(((p * cwt + crnd) >> cl) + co)
                        }
                    }
                }
            }
        }
    }

    fn h264TraceMb() {
        print("frame {self.frames} mb {self.mbXY} ({self.mbX},{self.mbY}) type {self.mbType} cbp {self.cbp} qp {self.qp} sub {self.subMbType[0]} {self.subMbType[1]} {self.subMbType[2]} {self.subMbType[3]}")
        for l in 0..self.listCount {
            var r = ""
            for y in 0..4 {
                for x in 0..4 {
                    let c = l * 40 + 12 + x + y * 8
                    r += " {self.refCache[c]}:{self.mvxCache[c]},{self.mvyCache[c]}"
                }
                r += " |"
            }
            print(" list {l}:{r}")
        }
        var nz = ""
        for n in 0..16 {
            nz += " {self.nzCache[self.s8[n]]}"
        }
        print(" nz{nz}")
    }

    // ----------------------------------------------------------------------
    // Deblocking filter (8.7)
    // ----------------------------------------------------------------------

    // Deblocks the current picture (frame, or one field: rows pOff, pStride).
    fn h264DeblockPicture() {
        if self.mode == 2 && !self.rp.bsTab.isEmpty && !self.mbaffFrame {
            h264DeblockFromBs()
            return
        }
        if self.mode == 1 && self.mbaffFrame {
            // MBAFF frames are deblocked by the reconstructor alone.
            return
        }
        // Parse mode: the boundary strengths go to pBs (8 per macroblock:
        // direction * 4 + edge, the 4 values 3 bits each) for
        // h264DeblockFromBs instead of filtering.
        let record = self.mode == 1
        if record {
            self.pBs = h264Zeros(self.numMbs * 8)
        }
        var bs: [Int] = [0, 0, 0, 0]
        let field = self.curStructure != 3
        let tb0 = now()
        // Which 4x4 luma blocks of each macroblock have coefficients.
        if self.codedMask.count != self.numMbs {
            self.codedMask = core.zeros(self.numMbs)
        }
        for m in 0..self.numMbs {
            var mask = 0
            if (self.mbTypes[m] & mbIntraMask) == 0 && self.sliceTab[m] >= self.picFirstSlice {
                for b in 0..16 {
                    if h264BlockCoded(m, b) {
                        mask = mask | (1 << b)
                    }
                }
            }
            self.codedMask[m] = mask
        }
        self.tMask += now() - tb0
        if self.mbaffFrame {
            h264DeblockMbaff()
            return
        }
        let limY = if field { 2 } else { 4 }
        let rows = self.picMbH
        let tb = now()
        var tFilt = 0.0
        for my in 0..rows {
            for mx in 0..self.mbW {
                let m = mx + (my * self.rowStep + self.mbRowOff) * self.mbW
                let sl = self.sliceTab[m] - self.picFirstSlice
                if self.sliceTab[m] < 0 || sl < 0 || sl >= self.sliceDisable.count {
                    continue
                }
                let dis = self.sliceDisable[sl]
                if dis == 1 {
                    continue
                }
                let offA = self.sliceAlpha[sl]
                let offB = self.sliceBeta[sl]
                let t = self.mbTypes[m]
                let intra = (t & mbIntraMask) != 0
                let qp = self.qpTab[m]
                let lumaAt = self.pOff + my * 16 * self.pStride + mx * 16
                let chromaAt = self.cOff + my * 8 * self.cStride + mx * 8
                let s = self.pStride
                let cs = self.cStride
                let tr8 = (t & mbDct8x8) != 0
                let noCoef = !intra && self.codedMask[m] == 0
                let qMask = self.codedMask[m]
                for dir in 0..2 {
                    // dir 0: vertical edges (neighbour on the left), 1: horizontal.
                    var nb = -1
                    if dir == 0 && mx > 0 {
                        nb = m - 1
                    } else if dir == 1 && my > 0 {
                        nb = m - self.rowStep * self.mbW
                    }
                    if nb >= 0 && (self.sliceTab[nb] < self.picFirstSlice || (dis == 2 && self.sliceTab[nb] != self.sliceTab[m])) {
                        nb = -1
                    }
                    for edge in 0..4 {
                        if edge == 0 && nb < 0 {
                            continue
                        }
                        if edge > 0 && tr8 && (edge & 1) == 1 {
                            continue
                        }
                        if edge > 0 && noCoef {
                            // Inside one partition with no coefficients bS is 0
                            // (same vectors and references on both sides).
                            if (t & mb16x16) != 0 {
                                continue
                            }
                            if (t & mb16x8) != 0 && (dir == 0 || (edge & 1) == 1) {
                                continue
                            }
                            if (t & mb8x16) != 0 && (dir == 1 || (edge & 1) == 1) {
                                continue
                            }
                        }
                        let pm = if edge == 0 { nb } else { m }
                        let pt = self.mbTypes[pm]
                        let pMask = self.codedMask[pm]
                        var any = false
                        for i in 0..4 {
                            // Blocks q (in m) and p across the edge, raster.
                            let bq = if dir == 0 { i * 4 + edge } else { edge * 4 + i }
                            var bp = 0
                            if edge == 0 {
                                bp = if dir == 0 { i * 4 + 3 } else { 12 + i }
                            } else {
                                bp = if dir == 0 { bq - 1 } else { bq - 4 }
                            }
                            var v = 0
                            if intra || (pt & mbIntraMask) != 0 {
                                if edge == 0 && (dir == 0 || !field) {
                                    v = 4
                                } else {
                                    v = 3
                                }
                            } else if ((qMask >> bq) & 1) != 0 || ((pMask >> bp) & 1) != 0 {
                                v = 2
                            } else {
                                v = h264MotionBs(pm, bp, m, bq, limY)
                            }
                            bs[i] = v
                            if v != 0 {
                                any = true
                            }
                        }
                        if !any {
                            continue
                        }
                        if record {
                            self.pBs[m * 8 + dir * 4 + edge] = bs[0] | (bs[1] << 3) | (bs[2] << 6) | (bs[3] << 9)
                            continue
                        }
                        self.dbgEdges += 1
                        let tf = if self.timing { now() } else { 0.0 }
                        let qpp = self.qpTab[pm]
                        let qav = (qp + qpp + 1) >> 1
                        let ia = max(0, min(51, qav + offA))
                        let ib = max(0, min(51, qav + offB))
                        if dir == 0 {
                            h264FilterEdge(self.cur.y, lumaAt + edge * 4, 1, s, 16, 4, bs, ia, ib, false)
                        } else {
                            h264FilterEdge(self.cur.y, lumaAt + edge * 4 * s, s, 1, 16, 4, bs, ia, ib, false)
                        }
                        if self.timing {
                            tFilt += now() - tf
                        }
                        if self.hasChroma && (edge & 1) == 0 {
                            for c in 0..2 {
                                let qc = self.pps.chromaQp[c * 52 + qp]
                                let qcp = self.pps.chromaQp[c * 52 + qpp]
                                let cav = (qc + qcp + 1) >> 1
                                let ca = max(0, min(51, cav + offA))
                                let cb = max(0, min(51, cav + offB))
                                let ce = edge >> 1
                                if c == 0 {
                                    if dir == 0 {
                                        h264FilterEdge(self.cur.u, chromaAt + ce * 4, 1, cs, 8, 2, bs, ca, cb, true)
                                    } else {
                                        h264FilterEdge(self.cur.u, chromaAt + ce * 4 * cs, cs, 1, 8, 2, bs, ca, cb, true)
                                    }
                                } else {
                                    if dir == 0 {
                                        h264FilterEdge(self.cur.v, chromaAt + ce * 4, 1, cs, 8, 2, bs, ca, cb, true)
                                    } else {
                                        h264FilterEdge(self.cur.v, chromaAt + ce * 4 * cs, cs, 1, 8, 2, bs, ca, cb, true)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        self.tB += tFilt
    }

    // Deblocking (8.7) with the boundary strengths the parser found (see
    // h264DeblockPicture): the same edges in the same order.
    fn h264DeblockFromBs() {
        var bs: [Int] = [0, 0, 0, 0]
        let tab = self.rp.bsTab
        let rows = self.picMbH
        let s = self.pStride
        let cs = self.cStride
        for my in 0..rows {
            for mx in 0..self.mbW {
                let m = mx + (my * self.rowStep + self.mbRowOff) * self.mbW
                let sl = self.sliceTab[m] - self.picFirstSlice
                if self.sliceTab[m] < 0 || sl < 0 || sl >= self.sliceDisable.count {
                    continue
                }
                let offA = self.sliceAlpha[sl]
                let offB = self.sliceBeta[sl]
                let qp = self.qpTab[m]
                let lumaAt = self.pOff + my * 16 * s + mx * 16
                let chromaAt = self.cOff + my * 8 * cs + mx * 8
                for dir in 0..2 {
                    for edge in 0..4 {
                        let packed = tab[m * 8 + dir * 4 + edge]
                        if packed == 0 {
                            continue
                        }
                        bs[0] = packed & 7
                        bs[1] = (packed >> 3) & 7
                        bs[2] = (packed >> 6) & 7
                        bs[3] = (packed >> 9) & 7
                        let pm = if edge > 0 { m } else if dir == 0 { m - 1 } else { m - self.rowStep * self.mbW }
                        let qpp = self.qpTab[pm]
                        let qav = (qp + qpp + 1) >> 1
                        let ia = max(0, min(51, qav + offA))
                        let ib = max(0, min(51, qav + offB))
                        if dir == 0 {
                            h264FilterEdge(self.cur.y, lumaAt + edge * 4, 1, s, 16, 4, bs, ia, ib, false)
                        } else {
                            h264FilterEdge(self.cur.y, lumaAt + edge * 4 * s, s, 1, 16, 4, bs, ia, ib, false)
                        }
                        if self.hasChroma && (edge & 1) == 0 {
                            let ce = edge >> 1
                            for c in 0..2 {
                                let qc = self.pps.chromaQp[c * 52 + qp]
                                let qcp = self.pps.chromaQp[c * 52 + qpp]
                                let cav = (qc + qcp + 1) >> 1
                                let ca = max(0, min(51, cav + offA))
                                let cb = max(0, min(51, cav + offB))
                                if c == 0 {
                                    if dir == 0 {
                                        h264FilterEdge(self.cur.u, chromaAt + ce * 4, 1, cs, 8, 2, bs, ca, cb, true)
                                    } else {
                                        h264FilterEdge(self.cur.u, chromaAt + ce * 4 * cs, cs, 1, 8, 2, bs, ca, cb, true)
                                    }
                                } else {
                                    if dir == 0 {
                                        h264FilterEdge(self.cur.v, chromaAt + ce * 4, 1, cs, 8, 2, bs, ca, cb, true)
                                    } else {
                                        h264FilterEdge(self.cur.v, chromaAt + ce * 4 * cs, cs, 1, 8, 2, bs, ca, cb, true)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Whether 4x4 luma block (raster b) of macroblock m has coefficients
    // (for transform 8x8 macroblocks: its 8x8 block has).
    fn h264BlockCoded(_ m: Int, _ b: Int) -> Bool {
        let base = m * 24
        if (self.mbTypes[m] & mbDct8x8) != 0 {
            let x8 = (b & 3) >> 1
            let y8 = b >> 3
            let f = base + y8 * 8 + x8 * 2
            return self.nzTab[f] > 0 || self.nzTab[f + 1] > 0 || self.nzTab[f + 4] > 0 || self.nzTab[f + 5] > 0
        }
        self.nzTab[base + b] > 0
    }

    // bS 1 or 0 from the motion of blocks (mp, bp) and (mq, bq) (8.7.2.1):
    // different reference pictures, a different number of vectors, or
    // vectors 4 quarter samples apart or more.
    fn h264MotionBs(_ mp: Int, _ bp: Int, _ mq: Int, _ bq: Int, _ limY: Int) -> Int {
        let b8p = mp * 4 + (bp >> 3) * 2 + ((bp & 3) >> 1)
        let b8q = mq * 4 + (bq >> 3) * 2 + ((bq & 3) >> 1)
        let p0 = self.cur.pic0[b8p]
        let p1 = self.cur.pic1[b8p]
        let q0 = self.cur.pic0[b8q]
        let q1 = self.cur.pic1[b8q]
        let ip = mp * 16 + bp
        let iq = mq * 16 + bq
        let np = (if p0 >= 0 { 1 } else { 0 }) + (if p1 >= 0 { 1 } else { 0 })
        let nq = (if q0 >= 0 { 1 } else { 0 }) + (if q1 >= 0 { 1 } else { 0 })
        if np != nq {
            return 1
        }
        if np == 1 {
            let pp = if p0 >= 0 { p0 } else { p1 }
            let qq = if q0 >= 0 { q0 } else { q1 }
            if pp != qq {
                return 1
            }
            let pax = if p0 >= 0 { self.cur.mvx0[ip] } else { self.cur.mvx1[ip] }
            let pay = if p0 >= 0 { self.cur.mvy0[ip] } else { self.cur.mvy1[ip] }
            let qax = if q0 >= 0 { self.cur.mvx0[iq] } else { self.cur.mvx1[iq] }
            let qay = if q0 >= 0 { self.cur.mvy0[iq] } else { self.cur.mvy1[iq] }
            return if h264MvFar(pax, pay, qax, qay, limY) { 1 } else { 0 }
        }
        if np == 0 {
            return 1
        }
        if !((p0 == q0 && p1 == q1) || (p0 == q1 && p1 == q0)) {
            return 1
        }
        let a0x = self.cur.mvx0[ip]
        let a0y = self.cur.mvy0[ip]
        let a1x = self.cur.mvx1[ip]
        let a1y = self.cur.mvy1[ip]
        let b0x = self.cur.mvx0[iq]
        let b0y = self.cur.mvy0[iq]
        let b1x = self.cur.mvx1[iq]
        let b1y = self.cur.mvy1[iq]
        let straight = h264MvFar(a0x, a0y, b0x, b0y, limY) || h264MvFar(a1x, a1y, b1x, b1y, limY)
        let crossed = h264MvFar(a0x, a0y, b1x, b1y, limY) || h264MvFar(a1x, a1y, b0x, b0y, limY)
        if p0 != p1 {
            if p0 == q0 {
                return if straight { 1 } else { 0 }
            }
            return if crossed { 1 } else { 0 }
        }
        if straight && crossed { 1 } else { 0 }
    }

    // Deblocking of an MBAFF frame (8.7 with mixedModeEdgeFlag): macroblock
    // pairs in decoding order; a field macroblock is filtered on its own
    // rows (every other row of the pair); edges between a field and a frame
    // macroblock get bS 1 at least, the left edge of such a pair is
    // filtered field line by field line, and the top edge of a frame
    // macroblock under a field pair once per field.
    fn h264DeblockMbaff() {
        var bs: [Int] = [0, 0, 0, 0]
        var bs2: [Int] = [0, 0, 0, 0]
        let w = self.mbW
        let lw = self.lumaW
        let cw = self.chromaW
        for pr in 0..(self.mbH / 2) {
            for mx in 0..w {
                for b in 0..2 {
                    let my = 2 * pr + b
                    let m = mx + my * w
                    let sl = self.sliceTab[m] - self.picFirstSlice
                    if sl < 0 || sl >= self.sliceDisable.count {
                        continue
                    }
                    let dis = self.sliceDisable[sl]
                    if dis == 1 {
                        continue
                    }
                    let offA = self.sliceAlpha[sl]
                    let offB = self.sliceBeta[sl]
                    let t = self.mbTypes[m]
                    let curField = (t & mbInterlaced) != 0
                    let intra = (t & mbIntraMask) != 0
                    let qp = self.qpTab[m]
                    var lumaAt = my * 16 * lw + mx * 16
                    var chromaAt = my * 8 * cw + mx * 8
                    var s = lw
                    var cs = cw
                    if curField {
                        lumaAt = 2 * pr * 16 * lw + b * lw + mx * 16
                        chromaAt = 2 * pr * 8 * cw + b * cw + mx * 8
                        s = 2 * lw
                        cs = 2 * cw
                    }
                    let limY = if curField { 2 } else { 4 }
                    let tr8 = (t & mbDct8x8) != 0
                    let qMask = self.codedMask[m]
                    let noCoef = !intra && qMask == 0
                    // Neighbours as the reference decoder's filter caches.
                    var leftT = m - 1
                    var leftB = m - 1
                    var leftField = false
                    var haveLeft = mx > 0
                    if haveLeft {
                        leftField = (self.mbTypes[m - 1] & mbInterlaced) != 0
                        if b == 1 {
                            if leftField != curField {
                                leftT -= w
                            }
                        } else if leftField != curField {
                            leftB += w
                        }
                        if !h264DbAvail(leftB, m, dis) {
                            haveLeft = false
                        }
                    }
                    var top = -1
                    if curField {
                        if pr > 0 {
                            top = m - 2 * w
                            if b == 0 && (self.mbTypes[top] & mbInterlaced) == 0 {
                                top += w
                            }
                        }
                    } else if my > 0 {
                        top = m - w
                    }
                    if top >= 0 && !h264DbAvail(top, m, dis) {
                        top = -1
                    }
                    var firstVerticalDone = false
                    if haveLeft && leftField != curField {
                        // Mixed left edge: 8 strengths, two neighbours.
                        firstVerticalDone = true
                        let ltT = self.mbTypes[leftT]
                        let ltB = self.mbTypes[leftB]
                        for half in 0..2 {
                            let ln = if half == 0 { leftT } else { leftB }
                            let lt = if half == 0 { ltT } else { ltB }
                            for k in 0..4 {
                                // Strength index i as the reference decoder
                                // orders them (field: i = 4 * half + k,
                                // frame: i = 2 * k + half).
                                let i = if curField { 4 * half + k } else { 2 * k + half }
                                var v = 4
                                if !intra && (lt & mbIntraMask) == 0 {
                                    let qb = (i >> 1) * 4
                                    var row = 0
                                    if curField {
                                        row = i & 3
                                    } else {
                                        row = (if b == 1 { 2 } else { 0 }) + (i >> 2)
                                    }
                                    let pc = ((self.codedMask[ln] >> (3 + 4 * row)) & 1) != 0
                                    let qc = ((qMask >> qb) & 1) != 0
                                    v = if pc || qc { 2 } else { 1 }
                                }
                                bs[k] = v
                            }
                            let qpp = self.qpTab[ln]
                            let qav = (qp + qpp + 1) >> 1
                            let ia = max(0, min(51, qav + offA))
                            let ib = max(0, min(51, qav + offB))
                            if curField {
                                h264FilterEdge(self.cur.y, lumaAt + half * 8 * s, 1, s, 8, 2, bs, ia, ib, false)
                            } else {
                                h264FilterEdge(self.cur.y, lumaAt + half * lw, 1, 2 * lw, 8, 2, bs, ia, ib, false)
                            }
                            if self.hasChroma {
                                for c in 0..2 {
                                    let cav = (self.pps.chromaQp[c * 52 + qp] + self.pps.chromaQp[c * 52 + qpp] + 1) >> 1
                                    let ca = max(0, min(51, cav + offA))
                                    let cb = max(0, min(51, cav + offB))
                                    let at = if curField { chromaAt + half * 4 * cs } else { chromaAt + half * cw }
                                    let along = if curField { cs } else { 2 * cw }
                                    if c == 0 {
                                        h264FilterEdge(self.cur.u, at, 1, along, 4, 1, bs, ca, cb, true)
                                    } else {
                                        h264FilterEdge(self.cur.v, at, 1, along, 4, 1, bs, ca, cb, true)
                                    }
                                }
                            }
                        }
                    }
                    for dir in 0..2 {
                        let nb = if dir == 0 { (if haveLeft { m - 1 } else { -1 }) } else { top }
                        for edge in 0..4 {
                            if edge == 0 && (nb < 0 || (dir == 0 && firstVerticalDone)) {
                                continue
                            }
                            if edge > 0 && tr8 && (edge & 1) == 1 {
                                continue
                            }
                            if edge > 0 && noCoef {
                                if (t & mb16x16) != 0 {
                                    continue
                                }
                                if (t & mb16x8) != 0 && (dir == 0 || (edge & 1) == 1) {
                                    continue
                                }
                                if (t & mb8x16) != 0 && (dir == 1 || (edge & 1) == 1) {
                                    continue
                                }
                            }
                            let pm = if edge == 0 { nb } else { m }
                            let pt = self.mbTypes[pm]
                            let pField = (pt & mbInterlaced) != 0
                            if edge == 0 && dir == 1 && !curField && b == 0 && pField {
                                // Frame macroblock under a field pair: its top
                                // edge once per field of the pair above.
                                for j in 0..2 {
                                    let mn = m - 2 * w + j * w
                                    let nt = self.mbTypes[mn]
                                    for i in 0..4 {
                                        if intra || (nt & mbIntraMask) != 0 {
                                            bs2[i] = 3
                                        } else {
                                            let pc = ((self.codedMask[mn] >> (12 + i)) & 1) != 0
                                            let qc = ((qMask >> i) & 1) != 0
                                            bs2[i] = if pc || qc { 2 } else { 1 }
                                        }
                                    }
                                    let qpp = self.qpTab[mn]
                                    let qav = (qp + qpp + 1) >> 1
                                    let ia = max(0, min(51, qav + offA))
                                    let ib = max(0, min(51, qav + offB))
                                    h264FilterEdge(self.cur.y, lumaAt + j * lw, 2 * lw, 1, 16, 4, bs2, ia, ib, false)
                                    if self.hasChroma {
                                        for c in 0..2 {
                                            let cav = (self.pps.chromaQp[c * 52 + qp] + self.pps.chromaQp[c * 52 + qpp] + 1) >> 1
                                            let ca = max(0, min(51, cav + offA))
                                            let cb = max(0, min(51, cav + offB))
                                            if c == 0 {
                                                h264FilterEdge(self.cur.u, chromaAt + j * cw, 2 * cw, 1, 8, 2, bs2, ca, cb, true)
                                            } else {
                                                h264FilterEdge(self.cur.v, chromaAt + j * cw, 2 * cw, 1, 8, 2, bs2, ca, cb, true)
                                            }
                                        }
                                    }
                                }
                                continue
                            }
                            let pMask = self.codedMask[pm]
                            let mixed = edge == 0 && dir == 1 && pField != curField
                            var any = false
                            for i in 0..4 {
                                let bq = if dir == 0 { i * 4 + edge } else { edge * 4 + i }
                                var bp = 0
                                if edge == 0 {
                                    bp = if dir == 0 { i * 4 + 3 } else { 12 + i }
                                } else {
                                    bp = if dir == 0 { bq - 1 } else { bq - 4 }
                                }
                                var v = 0
                                if intra || (pt & mbIntraMask) != 0 {
                                    if edge == 0 {
                                        v = if dir == 0 || (!curField && !pField) { 4 } else { 3 }
                                    } else {
                                        v = 3
                                    }
                                } else if ((qMask >> bq) & 1) != 0 || ((pMask >> bp) & 1) != 0 {
                                    v = 2
                                } else if mixed {
                                    v = 1
                                } else {
                                    v = h264MotionBs(pm, bp, m, bq, limY)
                                }
                                bs[i] = v
                                if v != 0 {
                                    any = true
                                }
                            }
                            if !any {
                                continue
                            }
                            let qpp = self.qpTab[pm]
                            let qav = (qp + qpp + 1) >> 1
                            let ia = max(0, min(51, qav + offA))
                            let ib = max(0, min(51, qav + offB))
                            if dir == 0 {
                                h264FilterEdge(self.cur.y, lumaAt + edge * 4, 1, s, 16, 4, bs, ia, ib, false)
                            } else {
                                h264FilterEdge(self.cur.y, lumaAt + edge * 4 * s, s, 1, 16, 4, bs, ia, ib, false)
                            }
                            if self.hasChroma && (edge & 1) == 0 {
                                for c in 0..2 {
                                    let cav = (self.pps.chromaQp[c * 52 + qp] + self.pps.chromaQp[c * 52 + qpp] + 1) >> 1
                                    let ca = max(0, min(51, cav + offA))
                                    let cb = max(0, min(51, cav + offB))
                                    let ce = edge >> 1
                                    if c == 0 {
                                        if dir == 0 {
                                            h264FilterEdge(self.cur.u, chromaAt + ce * 4, 1, cs, 8, 2, bs, ca, cb, true)
                                        } else {
                                            h264FilterEdge(self.cur.u, chromaAt + ce * 4 * cs, cs, 1, 8, 2, bs, ca, cb, true)
                                        }
                                    } else {
                                        if dir == 0 {
                                            h264FilterEdge(self.cur.v, chromaAt + ce * 4, 1, cs, 8, 2, bs, ca, cb, true)
                                        } else {
                                            h264FilterEdge(self.cur.v, chromaAt + ce * 4 * cs, cs, 1, 8, 2, bs, ca, cb, true)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Whether neighbour n of macroblock m takes part in deblocking: decoded
    // in this picture, and in the same slice when disable_deblocking_
    // filter_idc is 2.
    fn h264DbAvail(_ n: Int, _ m: Int, _ dis: Int) -> Bool {
        if n < 0 || self.sliceTab[n] < self.picFirstSlice {
            return false
        }
        dis != 2 || self.sliceTab[n] == self.sliceTab[m]
    }
}

fn h264NewEng() -> Eng {
    var e = Eng()
    for _ in 0..32 {
        e.spsList.append(Sps())
    }
    for _ in 0..256 {
        e.ppsList.append(Pps())
    }
    e.subMbType = core.zeros(4)
    e.subPartCount = core.zeros(4)
    e.predCache = core.zeros(40)
    e.nzCache = core.zeros(96)
    e.refCache = core.zeros(80)
    // Above-right of blocks 7, 13 and 15 lies in the next macroblock,
    // which is never decoded yet: these cache slots stay unavailable.
    for l in 0..2 {
        e.refCache[l * 40 + 16] = partNotAvailable
        e.refCache[l * 40 + 24] = partNotAvailable
        e.refCache[l * 40 + 32] = partNotAvailable
    }
    e.mvxCache = core.zeros(80)
    e.mvyCache = core.zeros(80)
    e.mvdxCache = core.zeros(80)
    e.mvdyCache = core.zeros(80)
    e.directCache = core.zeros(40)
    e.coef = core.zeros(384)
    e.dcY = core.zeros(16)
    e.dcC = core.zeros(8)
    e.tmp = core.zeros(64)
    e.edgeTop = core.zeros(40)
    e.edgeLeft = core.zeros(40)
    e.edgeA = core.zeros(40)
    e.edgeF = core.zeros(40)
    e.lumaW0 = core.filled(32, 1)
    e.wDef0 = core.zeros(32)
    e.wDef1 = core.zeros(32)
    e.lumaW1 = core.filled(32, 1)
    e.lumaO0 = core.zeros(32)
    e.lumaO1 = core.zeros(32)
    e.chromaW0 = core.filled(64, 1)
    e.chromaW1 = core.filled(64, 1)
    e.chromaO0 = core.zeros(64)
    e.chromaO1 = core.zeros(64)
    e.mc.setup()
    e.cavlcChromaDcTab = cavlcChromaDcTab
    e.cavlcZerosTab = cavlcZerosTab
    e.cavlcChromaDcZerosTab = cavlcChromaDcZerosTab
    e.cavlcRunTab = cavlcRunTab
    e.cabacSig8x8 = cabacSig8x8
    e.cabacLast8x8 = cabacLast8x8
    e.cabacAbsLevel1Ctx = cabacAbsLevel1Ctx
    e.cabacAbsLevelGt1Ctx = cabacAbsLevelGt1Ctx
    e.cabacAbsTrans1 = cabacAbsTrans1
    e.cabacAbsTransGt1 = cabacAbsTransGt1
    e.h264Identity = h264Identity
    e.zigzag8x8 = zigzag8x8
    e.zigzag4x4 = zigzag4x4
    e.fieldScan4x4 = fieldScan4x4
    e.fieldScan8x8 = fieldScan8x8
    e.iMbTypeInfo = iMbTypeInfo
    e.iMbPredMode = iMbPredMode
    e.iMbCbp = iMbCbp
    e.pMbTypeInfo = pMbTypeInfo
    e.pMbPartCount = pMbPartCount
    e.pSubMbTypeInfo = pSubMbTypeInfo
    e.pSubPartCount = pSubPartCount
    e.bMbTypeInfo = bMbTypeInfo
    e.bMbPartCount = bMbPartCount
    e.bSubMbTypeInfo = bSubMbTypeInfo
    e.bSubPartCount = bSubPartCount
    e.cavlcTokenBits = cavlcTokenBits
    e.cavlcTokenTabs = cavlcTokenTabs
    e.cabacSigOffset = cabacSigOffset
    e.cabacLastOffset = cabacLastOffset
    e.cabacAbsOffset = cabacAbsOffset
    e.cabacCbfOffset = cabacCbfOffset
    e.h264LeftRows = h264LeftRows
    e.h264LeftChromaRows = h264LeftChromaRows
    e.golombToIntra4x4Cbp = golombToIntra4x4Cbp
    e.golombToInterCbp = golombToInterCbp
    e.golombToIntra4x4CbpGray = golombToIntra4x4CbpGray
    e.golombToInterCbpGray = golombToInterCbpGray
    e.s8 = scan8
    e.bx4 = blkX
    e.by4 = blkY
    e.debugNoDeblock = environment(name: "H264_NODEBLOCK") != nil
    e.debugTrace = environment(name: "H264_TRACE") != nil
    e.timing = environment(name: "H264_TIMING") != nil
    e.noRecon = environment(name: "H264_NORECON") != nil

    e.traceFrame = Int(environment(name: "H264_FRAME") ?? "-1") ?? -1
    e.traceMb = Int(environment(name: "H264_MB") ?? "-1") ?? -1
    e.implicitW = core.filled(32 * 32, 32)
    e.implicitWF = core.filled(2 * 64 * 64, 32)
    e.distScale = core.zeros(32)
    e.distScaleF = core.zeros(128)
    for _ in 0..33 {
        e.list0.append(-1)
        e.list1.append(-1)
        e.listId0.append(-1)
        e.listId1.append(-1)
        e.listPoc0.append(0)
        e.listPoc1.append(0)
        e.listLong0.append(false)
        e.listLong1.append(false)
        e.listPar0.append(3)
        e.listPar1.append(3)
    }
    e
}

// A list of n zeros, made by doubling (faster than n appends).
fn h264Zeros(_ n: Int) -> [Int] {
    if n <= 0 {
        return []
    }
    var out: [Int] = [0]
    while out.count * 2 <= n {
        out += out
    }
    if out.count < n {
        out += out.slice(from: 0, to: n - out.count)
    }
    out
}

// SP helpers (8.6.1): forward core transform of the 4x4 samples at `at`
// into c (raster, rows first then columns).
fn h264SpForward(_ p: bind [Int], _ at: Int, _ s: Int, _ c: bind [Int]) {
    for y in 0..4 {
        let q = at + y * s
        let a0 = p[q]
        let a1 = p[q + 1]
        let a2 = p[q + 2]
        let a3 = p[q + 3]
        c[y * 4] = a0 + a1 + a2 + a3
        c[y * 4 + 1] = 2 * a0 + a1 - a2 - 2 * a3
        c[y * 4 + 2] = a0 - a1 - a2 + a3
        c[y * 4 + 3] = a0 - 2 * a1 + 2 * a2 - a3
    }
    for x in 0..4 {
        let a0 = c[x]
        let a1 = c[4 + x]
        let a2 = c[8 + x]
        let a3 = c[12 + x]
        c[x] = a0 + a1 + a2 + a3
        c[4 + x] = 2 * a0 + a1 - a2 - 2 * a3
        c[8 + x] = a0 - a1 - a2 + a3
        c[12 + x] = a0 - 2 * a1 + 2 * a2 - a3
    }
}

// Position class of a 4x4 coefficient: 0 both even, 1 both odd, 2 other.
fn h264SpClass(_ pos: Int) -> Int {
    let x = pos & 3
    let y = pos >> 2
    if (x & 1) == 0 && (y & 1) == 0 { 0 } else if (x & 1) == 1 && (y & 1) == 1 { 1 } else { 2 }
}

// A_ij of 8.6.1: 16, 25 or 20 by position class.
fn h264SpA(_ cls: Int) -> Int {
    if cls == 0 { 16 } else if cls == 1 { 25 } else { 20 }
}

// Quantisation with QS (8.6.1, 8.6.2): shift 15 for 4x4 coefficients, 16
// for chroma DC.
fn h264SpQuant(_ v: Int, _ qs: Int, _ cls: Int, _ shift: Int) -> Int {
    let m = h264SpLevelScale2[(qs % 6) * 3 + cls]
    let sh = shift + qs / 6
    let a = (h264Abs(v) * m + (1 << (sh - 1))) >> sh
    if v < 0 { -a } else { a }
}

// LevelScale2(m, i, j) of 8.6.1 by m and position class.
let h264SpLevelScale2: [Int] = [13107, 5243, 8066, 11916, 4660, 7490, 10082, 4194, 6554, 9362, 3647, 5825, 8192, 3355, 5243, 7282, 2893, 4559]
