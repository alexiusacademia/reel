// Small helpers shared by the decoder: median, absolute value, clipping
// and filling a rectangle of a neighbour cache.
//
// Author: Alexius Academia
// Date: 2026-10-25

fn h264Median(_ a: Int, _ b: Int, _ c: Int) -> Int {
    max(min(a, b), min(max(a, b), c))
}




// Fills a w x h rectangle of 4x4 blocks of a cache from position c.
fn h264FillRect(_ l: bind [Int], _ c: Int, _ w: Int, _ h: Int, _ v: Int) {
    for y in 0..h {
        for x in 0..w {
            l[c + x + y * 8] = v
        }
    }
}






fn h264Abs(_ v: Int) -> Int {
    if v < 0 { -v } else { v }
}

fn h264Clip8(_ v: Int) -> Int {
    max(-128, min(127, v))
}



















// MaxDpbMbs by level (Table A-1).
fn h264MaxDpbMbs(_ level: Int, _ constraint3: Bool) -> Int {
    if level == 9 || (level == 11 && constraint3) { return 396 }
    if level == 10 { return 396 }
    if level == 11 { return 900 }
    if level == 12 || level == 13 || level == 20 { return 2376 }
    if level == 21 { return 4752 }
    if level == 22 || level == 30 { return 8100 }
    if level == 31 { return 18000 }
    if level == 32 { return 20480 }
    if level == 40 || level == 41 { return 32768 }
    if level == 42 { return 34816 }
    if level == 50 { return 110400 }
    if level == 51 || level == 52 { return 184320 }
    696320
}
