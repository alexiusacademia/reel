// Keyboard shortcuts as data: actions (ids like "play-pause") bound to key
// combinations ("space", "cmd+shift+s", "alt+left"), with Reel's current
// keys as the defaults, the user's changes kept as overrides, conflict
// detection, parsing what people type ("Ctrl+Shift+S", "⇧⌘S") and
// formatting for menus and the preferences window (⌃⌥⇧⌘ on macOS,
// "Ctrl+Shift+S" elsewhere).
//
// Key names are those of Tessel's KeyEvent: a single character (the key
// without Shift: "=" for Shift+=) or "space" "enter" "escape" "tab"
// "backspace" "delete" "left" "right" "up" "down" "home" "end" "pageup"
// "pagedown" "insert" "f1"…"f12". "cmd" is Cmd on macOS and Ctrl on
// Windows (KeyEvent.command); "ctrl" is the Control key itself.
//
// Author: Alexius Academia
// Date: 2026-10-26

public struct KeyCombo {
    key: String
    command: Bool = false
    control: Bool = false
    alt: Bool = false
    shift: Bool = false

    // The canonical text: modifiers in the order cmd, ctrl, alt, shift,
    // then the key ("cmd+shift+s").
    text: String {
        var s = ""
        if command {
            s += "cmd+"
        }
        if control {
            s += "ctrl+"
        }
        if alt {
            s += "alt+"
        }
        if shift {
            s += "shift+"
        }
        s + key
    }
}

// An action the keys can run.
public struct KeyAction {
    id: String
    title: String
    // For grouping in the preferences window: "Playback" "Audio" "Video"
    // "Subtitles" "Media" "View".
    group: String
}

// Two or more actions on one combination, or a combination the system
// keeps for itself.
public struct KeyConflict {
    combo: String
    actions: [String]
    // Taken by the system (cmd+q, cmd+h, cmd+tab …).
    reserved: Bool = false
}

public struct KeyBinding {
    action: String
    combos: [String]
}

// The bindings, in the order of `keyActions`.
public struct Keymap {
    bindings: [KeyBinding] = []

    // The combinations of an action (canonical texts).
    fn combos(_ action: String) -> [String] {
        bindings.first(where: { b in b.action == action })?.combos ?? []
    }

    // The action a combination runs, or "".
    fn action(_ combo: String) -> String {
        let c = canonicalCombo(combo)
        if c.isEmpty {
            return ""
        }
        for b in bindings {
            if b.combos.contains(c) {
                return b.action
            }
        }
        ""
    }

    // The action for a key press (KeyEvent's fields), or "".
    fn actionFor(key: String, command: Bool = false, control: Bool = false, alt: Bool = false, shift: Bool = false) -> String {
        let k = canonicalKey(key)
        if k.isEmpty {
            return ""
        }
        action(KeyCombo(key: k, command: command, control: control, alt: alt, shift: shift).text)
    }

    // Binds an action to these combinations (replacing its own; other
    // actions keep theirs: use `conflicts` to show clashes).
    fn set(_ action: String, combos: [String]) {
        var cs: [String] = []
        for c in combos {
            let t = canonicalCombo(c)
            if !t.isEmpty && !cs.contains(t) {
                cs.append(t)
            }
        }
        if let i = bindings.firstIndex(where: { b in b.action == action }) {
            bindings[i].combos = cs
        } else {
            bindings.append(KeyBinding(action: action, combos: cs))
        }
    }

    // Binds one more combination, taking it away from any other action
    // (the usual "press a key to assign" behaviour).
    fn assign(_ action: String, combo: String) {
        let t = canonicalCombo(combo)
        if t.isEmpty {
            return
        }
        for i in 0..bindings.count {
            bindings[i].combos.removeAll(where: { c in c == t })
        }
        set(action, combos: combos(action) + [t])
    }

    // Combinations bound to several actions, and reserved ones in use.
    fn conflicts() -> [KeyConflict] {
        var byCombo: [String: [String]] = [:]
        var order: [String] = []
        for b in bindings {
            for c in b.combos {
                if byCombo[c] == nil {
                    byCombo[c] = []
                    order.append(c)
                }
                var list = byCombo[c] ?? []
                if !list.contains(b.action) {
                    list.append(b.action)
                }
                byCombo[c] = list
            }
        }
        var out: [KeyConflict] = []
        for c in order {
            let acts = byCombo[c] ?? []
            let reserved = reservedCombos.contains(c)
            if acts.count > 1 || reserved {
                out.append(KeyConflict(combo: c, actions: acts, reserved: reserved))
            }
        }
        out
    }

    // The combination to show on a menu item (`MenuItem(shortcut:)`): the
    // action's first one with cmd, as canonical text; "" when it has none.
    fn menuShortcut(_ action: String) -> String {
        for c in combos(action) {
            if c.hasPrefix("cmd+") {
                return c
            }
        }
        ""
    }

    // The user's changes against the defaults, for the preferences file:
    // action → combinations, only for actions that differ.
    fn overrides() -> [String: [String]] {
        let d = defaultKeymap()
        var out: [String: [String]] = [:]
        for b in bindings {
            if d.combos(b.action) != b.combos {
                out[b.action] = b.combos
            }
        }
        out
    }
}

