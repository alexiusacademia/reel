// Reel's keys (main.tsl's `key()` and menu shortcuts as of round 4),
// plus defaults for the new actions on keys that were free.
let defaultBindings: [(String, [String])] = [
    ("play-pause", ["space"]),
    ("stop", ["s"]),
    ("next", ["n"]),
    ("previous", ["p"]),
    ("next-episode", ["shift+n"]),
    ("jump-forward", ["right", "cmd+right"]),
    ("jump-back", ["left", "cmd+left"]),
    ("jump-forward-short", ["shift+right"]),
    ("jump-back-short", ["shift+left"]),
    ("jump-forward-long", ["alt+right"]),
    ("jump-back-long", ["alt+left"]),
    ("frame-step", ["e", "."]),
    ("frame-back", ["shift+e", ","]),
    ("jump-to-time", ["cmd+t"]),
    ("next-chapter", ["shift+cmd+right"]),
    ("previous-chapter", ["shift+cmd+left"]),
    ("sleep-timer", ["alt+s"]),
    ("faster", ["]", "cmd+="]),
    ("slower", ["[", "cmd+-"]),
    ("normal-speed", ["=", "cmd+0"]),
    ("ab-loop", ["l"]),
    ("bookmark-add", ["cmd+b"]),
    ("bookmark-next", ["shift+."]),
    ("bookmark-previous", ["shift+,"]),
    ("volume-up", ["up", "cmd+up"]),
    ("volume-down", ["down", "cmd+down"]),
    ("mute", ["m"]),
    ("cycle-audio", ["b"]),
    ("audio-delay-later", ["k"]),
    ("audio-delay-earlier", ["j"]),
    ("fullscreen", ["f", "cmd+ctrl+f"]),
    ("exit-fullscreen", ["escape"]),
    ("snapshot", ["cmd+shift+s"]),
    ("cycle-subtitle", ["v"]),
    ("subtitle-delay-later", ["h"]),
    ("subtitle-delay-earlier", ["g"]),
    ("cycle-secondary-subtitle", ["shift+v"]),
    ("find-dialogue", ["cmd+f"]),
    ("transcript", ["cmd+shift+t"]),
    ("open-file", ["cmd+o"]),
    ("open-folder", ["cmd+shift+o"]),
    ("close", ["cmd+w"]),
    ("media-info", ["i", "cmd+i"]),
    ("playlist", ["cmd+l"]),
    ("library", ["cmd+shift+l"]),
    ("preferences", ["cmd+,"]),
    ("effects", ["cmd+e"]),
    ("mini-player", ["cmd+shift+m"]),
    ("export-clip", ["cmd+shift+e"]),
]

// Combinations the system keeps (macOS and Windows), warned about when
// bound.
let reservedCombos: [String] = ["cmd+q", "cmd+h", "cmd+m", "cmd+tab", "cmd+space", "cmd+alt+escape", "cmd+c", "cmd+v", "cmd+x", "cmd+a", "cmd+z", "cmd+shift+z", "alt+f4", "cmd+`"]

// The default keymap.
public fn defaultKeymap() -> Keymap {
    var m = Keymap()
    for (a, cs) in defaultBindings {
        m.bindings.append(KeyBinding(action: a, combos: cs))
    }
    m
}

// The defaults with the user's overrides (action → combinations) on top;
// unknown actions are kept too (a newer Reel may know them).
public fn keymapWith(overrides: [String: [String]]) -> Keymap {
    var m = defaultKeymap()
    // First the actions' own lists, then each combination is taken away
    // from the default actions that had it (the user moved it).
    for (a, _) in overrides {
        m.set(a, combos: [])
    }
    for (a, cs) in overrides {
        for combo in cs {
            m.assign(a, combo: combo)
        }
    }
    m
}

let keyNames: [String] = ["space", "enter", "escape", "tab", "backspace", "delete", "left", "right", "up", "down", "home", "end", "pageup", "pagedown", "insert", "f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12"]

// A key name as KeyEvent gives it ("Esc" → "escape", " " → "space", "A" →
// "a", "←" → "left"), or "" when it isn't a key.
public fn canonicalKey(_ k0: String) -> String {
    if k0 == " " {
        return "space"
    }
    let k = k0.trim().lowercase()
    if k.isEmpty {
        return ""
    }
    let aliases: [String: String] = ["esc": "escape", "return": "enter", "del": "delete", "forwarddelete": "delete", "pgup": "pageup", "pgdn": "pagedown", "pageup": "pageup", "page up": "pageup", "page down": "pagedown", "spacebar": "space", "arrowleft": "left", "arrowright": "right", "arrowup": "up", "arrowdown": "down", "←": "left", "→": "right", "↑": "up", "↓": "down", "⎋": "escape", "↩": "enter", "⌫": "backspace", "⌦": "delete", "⇥": "tab", "ins": "insert", "plus": "+", "minus": "-", "comma": ",", "period": "."]
    if let a = aliases[k] {
        return a
    }
    if keyNames.contains(k) {
        return k
    }
    if k.count == 1 {
        return k
    }
    ""
}

// Parses a combination as people write it: "cmd+shift+s", "Ctrl+Alt+Left",
// "⇧⌘S", "Shift + Right", "cmd++" (the plus key). nil when it isn't one.
public fn parseCombo(_ text: String) -> KeyCombo? {
    var t = text.trim()
    if t.isEmpty {
        return nil
    }
    var c = KeyCombo(key: "")
    // macOS symbols in front of the key.
    var changed = true
    while changed && t.count > 1 {
        changed = false
        let first = t.character(at: 0) ?? ""
        if first == "⌘" {
            c.command = true
        } else if first == "⌃" {
            c.control = true
        } else if first == "⌥" {
            c.alt = true
        } else if first == "⇧" {
            c.shift = true
        } else {
            break
        }
        t = t.substring(from: 1, to: t.count)
        changed = true
    }
    var parts: [String] = []
    if t.hasSuffix("++") {
        parts = t.substring(from: 0, to: t.count - 2).split("+")
        parts.append("+")
    } else if t == "+" {
        parts = ["+"]
    } else {
        parts = t.split("+")
    }
    if parts.isEmpty {
        return nil
    }
    for (i, p0) in parts.enumerated() {
        let p = p0.trim().lowercase()
        if i == parts.count - 1 {
            c.key = canonicalKey(if p0.trim().isEmpty { p0 } else { p0.trim() })
            continue
        }
        if p == "cmd" || p == "command" || p == "meta" || p == "super" || p == "win" || p == "⌘" || p == "mod" {
            c.command = true
        } else if p == "ctrl" || p == "control" || p == "⌃" {
            c.control = true
        } else if p == "alt" || p == "option" || p == "opt" || p == "⌥" {
            c.alt = true
        } else if p == "shift" || p == "⇧" {
            c.shift = true
        } else if p.isEmpty {
            continue
        } else {
            return nil
        }
    }
    if c.key.isEmpty {
        return nil
    }
    c
}

// A combination's canonical text, or "" when it doesn't parse.
public fn canonicalCombo(_ text: String) -> String {
    parseCombo(text)?.text ?? ""
}

// A combination for people to read: "⇧⌘S", "⌥←" on macOS; "Ctrl+Shift+S",
// "Alt+Left" elsewhere. `os` is "macos" or "windows" ("" = this system).
public fn displayCombo(_ text: String, os: String = "") -> String {
    if let c = parseCombo(text) {
        let mac = (if os.isEmpty { platform() } else { os }) == "macos"
        let key = displayKey(c.key, mac: mac)
        if mac {
            var s = ""
            if c.control {
                s += "⌃"
            }
            if c.alt {
                s += "⌥"
            }
            if c.shift {
                s += "⇧"
            }
            if c.command {
                s += "⌘"
            }
            return s + key
        }
        var parts: [String] = []
        if c.command || c.control {
            parts.append("Ctrl")
        }
        if c.alt {
            parts.append("Alt")
        }
        if c.shift {
            parts.append("Shift")
        }
        parts.append(key)
        return parts.joined(separator: "+")
    }
    text
}

fn displayKey(_ k: String, mac: Bool) -> String {
    if mac {
        let symbols: [String: String] = ["left": "←", "right": "→", "up": "↑", "down": "↓", "enter": "↩", "escape": "⎋", "tab": "⇥", "backspace": "⌫", "delete": "⌦", "pageup": "⇞", "pagedown": "⇟", "home": "↖", "end": "↘", "space": "Space"]
        if let s = symbols[k] {
            return s
        }
    }
    if k.count == 1 {
        return k.uppercase()
    }
    if k.hasPrefix("f") && k.count <= 3 {
        return k.uppercase()
    }
    let names: [String: String] = ["pageup": "Page Up", "pagedown": "Page Down", "backspace": "Backspace", "escape": "Esc"]
    names[k] ?? k.capitalized()
}

// The title of an action id, or the id.
public fn actionTitle(_ id: String) -> String {
    keyActions.first(where: { a in a.id == id })?.title ?? id
}

// The action for a key event from `.onKeyEvent`, or "".
public fn keyAction(_ m: Keymap, _ e: KeyEvent) -> String {
    m.actionFor(key: e.key, command: e.command, control: e.control, alt: e.alt, shift: e.shift)
}
